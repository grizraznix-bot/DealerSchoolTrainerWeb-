@* The house's House Way and the ranking of the hands: used by Hand
   Setting's Help (PaiGowCombined) and the Pay Tables tool's House Way tab
   (ToolPayTables). One copy, so the two never disagree.
   A row of tabs picks a section (Two Pair, Three Pair, ... Ranking); "All"
   (the default) shows every section, like a printed sheet. Table Tools Lite
   (wwwroot/lite/lite.js) has its own copy of these rules: change both. *@

<div class="hw-tabs" role="tablist" aria-label="House Way section">
    <button type="button" class="hw-tab @(_sel < 0 ? "hw-on" : "")" role="tab" aria-selected="@(_sel < 0 ? "true" : "false")" @onclick="() => _sel = -1">All</button>
    @for (int i = 0; i < Sections.Length; i++)
    {
        int si = i;
        <button type="button" class="hw-tab @(_sel == si ? "hw-on" : "")" role="tab" aria-selected="@(_sel == si ? "true" : "false")" @onclick="() => _sel = si">@Sections[si].Tab</button>
    }
</div>

<table class="help-table sp-help-table hw-table">
    @for (int i = 0; i < Sections.Length; i++)
    {
        if (_sel >= 0 && _sel != i) continue;
        HwSection sec = Sections[i];
        <tr class="sp-pt-hd"><td colspan="2">@sec.Title</td></tr>
        @foreach (HwRule r in sec.Rules)
        {
            if (r.Letter is null)
            {
                <tr><td>@r.Num</td><td>@r.Text</td></tr>
            }
            else
            {
                <tr class="hw-sub"><td></td><td><b>@r.Letter</b>@r.Text</td></tr>
            }
        }
    }
</table>

@code {
    private sealed record HwRule(string Num, string? Letter, string Text);
    private sealed record HwSection(string Tab, string Title, HwRule[] Rules);

    private static HwRule N(string num, string text) => new(num, null, text);
    private static HwRule L(string letter, string text) => new("", letter, text);

    private static readonly HwSection[] Sections =
    {
        new("Two Pair", "Two Pair", new[]
        {
            N("1", "No Ace: split only if one pair is 7s or better."),
            N("2", "With an Ace: split only if Jacks or better AND 7s or better."),
            N("3", "Always split Aces and any other pair.")
        }),
        new("Three Pair", "Three Pair", new[]
        {
            N("1", "Always play the highest pair in front.")
        }),
        new("Three of a Kind", "Three of a Kind", new[]
        {
            N("1", "Always keep three of a kind together, unless they are Aces; then play a pair of Aces in back and one Ace in front."),
            N("2", "If the dealer has 3 Aces and at the same time has a straight or a flush, the straight or flush will be played.")
        }),
        new("Straights & Flushes", "Straights, Flushes, Straight Flushes and Royal Flushes", new[]
        {
            N("1", "Keep as the high hand, except:"),
            L("a", "6 and 7 card: play the low straight or flush to place the highest card in front."),
            L("b", "Play a straight over a flush anytime the second highest hand will be improved. This includes straight flushes and royal flushes."),
            L("c", "Play two pair (apply the two pair rule) except when both of the pairs are 6s or below."),
            L("d", "With a Full House, apply the Full House rules.")
        }),
        new("Full House", "Full House", new[]
        {
            N("1", "Always split, playing the pair in front, unless the pair is 2s and you have an Ace and a King to play in front."),
            N("2", "With an extra pair, play the higher of the two pairs in front.")
        }),
        new("Four of a Kind", "Four of a Kind", new[]
        {
            N("1", "Always keep 6s and under together."),
            N("2", "Always split 7s through 10s, playing a pair in each hand, unless the hand contains an Ace or better to play in front."),
            N("3", "Always split Jacks through Kings, playing a pair in each hand."),
            N("4", "Split four Aces unless with another pair:"),
            L("a", "If the other pair is 6s or below, play Aces in front, two pair in back."),
            L("b", "If the other pair is 7s or above, play four Aces in back, pair in front.")
        }),
        new("Five Aces", "Five Aces", new[]
        {
            N("1", "Split and play three in back and two in front, unless the hand also contains a pair of Kings; then play 5 Aces in back and Kings in front.")
        }),
        new("Ranking", "Ranking of the Hands (highest first)", new[]
        {
            N("1", "Five Aces"), N("2", "Royal Flush"), N("3", "Straight Flush"), N("4", "Four of a Kind"),
            N("5", "Full House"), N("6", "Flush"), N("7", "Straight (the wheel, A-2-3-4-5, is the 2nd highest)"),
            N("8", "Three of a Kind"), N("9", "Two Pair"), N("10", "One Pair"), N("11", "High Card")
        })
    };

    // -1 = All
    private int _sel = -1;
}
