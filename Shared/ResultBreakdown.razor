@using DealerSchoolTrainerWeb.Core

@* After-Submit feedback, the same in every game: the result line (when
   incorrect: "INCORRECT — Call the floor", with
   the detail such as "1 of 3 wrong" on the line under it), then
   a box with one line per wager -- a check and the answer, or a cross
   with what was picked and the right answer -- and the reason under it. *@

@* One feedback card: the result as a solid bar (blue CORRECT, red
   INCORRECT, white text) joined to the top of the wager box, the whole
   card with a soft drop shadow *@
<div class="bd-card @(IsCorrect ? "bd-card-ok" : "bd-card-bad")">
    @if (!IsCorrect && ResultText.StartsWith("INCORRECT"))
    {
        @* Incorrect: the floorperson reminder on the first line, the detail
           ("1 of 3 wrong") on its own line under it *@
        string detail = ResultText["INCORRECT".Length..].TrimStart(' ', '\u2014', '-').Trim();
        <p class="result-line breakdown-result txt-bad">
            INCORRECT &mdash; @BreakdownRow.FloorCall
            @if (detail.Length > 0)
            {
                <span class="result-detail">@detail</span>
            }
        </p>
    }
    else
    {
        <p class="result-line breakdown-result @(IsCorrect ? "txt-ok" : "txt-bad")">@ResultText</p>
    }
    @if (Rows.Count > 0)
    {
        <div class="breakdown">
            <table>
                @foreach (BreakdownRow row in Rows)
                {
                    <tr class="bd-row">
                        <td>@row.Name</td>
                        <td class="@(row.Ok ? "txt-ok" : "txt-bad")">
                            @if (row.Ok)
                            {
                                <text>&#x2713; <SuitText Text="@row.Answer" /></text>
                            }
                            else
                            {
                                <text>&#x2717; You: <SuitText Text="@row.You" /> &middot; Answer: <SuitText Text="@row.Answer" /></text>
                            }
                        </td>
                    </tr>
                    @if (row.Why.Length > 0)
                    {
                        <tr class="bd-why">
                            <td colspan="2"><SuitText Text="@row.Why" /></td>
                        </tr>
                    }
                    @if (row.Tip.Length > 0)
                    {
                        <tr class="bd-why bd-tip-row">
                            <td colspan="2"><span class="bd-tip">@row.Tip</span></td>
                        </tr>
                    }
                }
            </table>
            @if (Note.Length > 0)
            {
                <p class="bd-note"><strong>@NoteLabel</strong> <SuitText Text="@Note" /></p>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string ResultText { get; set; } = "";
    [Parameter] public bool IsCorrect { get; set; }
    [Parameter] public IReadOnlyList<BreakdownRow> Rows { get; set; } = Array.Empty<BreakdownRow>();

    // Optional line at the bottom of the box, e.g. "House Way:" + the rule
    [Parameter] public string NoteLabel { get; set; } = "";
    [Parameter] public string Note { get; set; } = "";
}
