@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject DealerSchoolTrainerWeb.Core.GameResetService GameReset

@* Mobile: below 768px wide the sidebar is hidden off-screen and a top
   bar with a menu button takes its place (see app.css, "Mobile layout").
   On desktop the top bar and backdrop are hidden by CSS, so this layout
   looks exactly as before. The menu closes itself on every navigation,
   so tapping a game link both opens the game and gets the menu out of
   the way. *@
<div class="page-layout">
    <header class="mobile-topbar">
        <button type="button" class="menu-toggle"
                aria-label="@(_menuOpen ? "Close menu" : "Open menu")"
                aria-expanded="@(_menuOpen ? "true" : "false")"
                @onclick="ToggleMenu">
            <span class="menu-toggle-bar"></span>
            <span class="menu-toggle-bar"></span>
            <span class="menu-toggle-bar"></span>
        </button>
        <span class="mobile-title">Dealer School Trainer</span>
    </header>

    <nav class="sidebar @(_menuOpen ? "open" : "")">
        <h2>Dealer School Trainer</h2>
        <ul>
            <li><NavLink href="" Match="NavLinkMatch.All">Home</NavLink></li>
            @* Hidden once the site is already running from its home-screen
               icon (see app.css, display-mode: standalone) *@
            <li class="install-link"><NavLink href="add-to-home-screen">Add to Home Screen</NavLink></li>
        </ul>

        <h3>Games</h3>
        <ul>
            @* Tapping the game that's already open sends it back to its
               start screen (same as its Back button) -- see MenuLinkClicked *@
            <li><NavLink href="blackjack-trainer" @onclick='() => MenuLinkClicked("blackjack-trainer")'>Blackjack</NavLink></li>
            <li><NavLink href="three-card-trainer" @onclick='() => MenuLinkClicked("three-card-trainer")'>Three Card Prime</NavLink></li>
            <li><NavLink href="pai-gow" @onclick='() => MenuLinkClicked("pai-gow")'>Pai Gow</NavLink></li>
            <li><NavLink href="holdem-trainer" @onclick='() => MenuLinkClicked("holdem-trainer")'>Heads-Up Hold'em</NavLink></li>
        </ul>

        @* Timed challenges, shaded so they stand apart from the trainers *@
        <ul>
            <li class="challenge-link"><NavLink href="challenge" @onclick='() => MenuLinkClicked("challenge")'>Challenge Mode</NavLink></li>
        </ul>

        <ul>
            <li><NavLink href="about">About</NavLink></li>
        </ul>
    </nav>

    @if (_menuOpen)
    {
        <div class="menu-backdrop" @onclick="CloseMenu"></div>
    }

    <main class="content">
        @Body
    </main>
</div>

@code {
    private bool _menuOpen;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;

    // A menu link pointing at the page that's already open doesn't change
    // the URL, so the page wouldn't react on its own. In that case, ask
    // the open game to return to its start screen, and close the phone
    // menu (normally closed by the page change, which doesn't happen here).
    private void MenuLinkClicked(string href)
    {
        string current = Nav.ToBaseRelativePath(Nav.Uri);
        int cut = current.IndexOfAny(new[] { '?', '#' });
        if (cut >= 0) current = current[..cut];

        if (string.Equals(current.TrimEnd('/'), href, StringComparison.OrdinalIgnoreCase))
        {
            _menuOpen = false;
            GameReset.RequestReset();
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!_menuOpen) return;

        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
