    private SideWagerPayoutRound _spRound = SideWagerPayouts.Deal(Random.Shared);
    private readonly string[] _spAnswer = { "", "" };   // [0] = 21 + 3, [1] = Lucky Ladies
    private readonly bool[] _spOk = new bool[2];
    private readonly bool[] _spLose = new bool[2];      // Lose tapped for that wager
    private int _spActive;
    private bool _spScored;
    private bool _spShowKeypad;
