    private Microsoft.AspNetCore.Components.ElementReference _spNextButtonRef;
    private int _spFocusInput = -1;
    private bool _spFocusNext;

    // The keypad types into whichever box is active
    private string SpActiveText
    {
        get => _spAnswer[_spActive];
        set
        {
            _spAnswer[_spActive] = SpDigitsOnly(value);
            _spLose[_spActive] = false;
            _spMessage = string.Empty;
        }
    }

    private void SpStartGame()
    {
        _spCorrect = 0;
        _spPlayed = 0;
        SpNewRound();
    }

    private void SpNewRound()
    {
        _spRound = SideWagerPayouts.Deal(Random.Shared);
        _spAnswer[0] = string.Empty;
        _spAnswer[1] = string.Empty;
        _spOk[0] = _spOk[1] = false;
        _spLose[0] = _spLose[1] = false;
        _spActive = 0;
        _spScored = false;
        _spMessage = string.Empty;
        _spResultText = string.Empty;
        _spRows.Clear();
        _spFocusInput = 0;
    }

    private void SpSelect(int index)
    {
        if (_spScored || _spActive == index) return;
        _spActive = index;
        _spFocusInput = index;
    }

    // Whole dollars only, at most 5 digits (the top pay is $25,000)
    private static string SpDigitsOnly(string? raw)
    {
        System.Text.StringBuilder sb = new();
        foreach (char c in raw ?? string.Empty)
        {
            if (char.IsDigit(c) && sb.Length < 5) sb.Append(c);
        }
        return sb.ToString();
    }

    private void SpInput(int index, Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _spAnswer[index] = SpDigitsOnly(e.Value?.ToString());
        _spLose[index] = false;
        _spActive = index;
        _spMessage = string.Empty;
    }

    // Keyboard Enter: first box -> next box; second box -> Submit
    private async Task SpKeyDown(int index, Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _spScored) return;
        _spActive = index;
        await SpKeypadEnter();
    }

    // Keypad Enter ("Next ↓" on the first box)
    private async Task SpKeypadEnter()
    {
        if (_spScored) return;

        if (_spActive == 0)
        {
            _spActive = 1;
            _spFocusInput = 1;
        }
        else
        {
            await SpSubmitAndShow();
        }
    }

    // Submit also scrolls to the feedback. The cursor moves onto Next only
    // after a short wait (same as Flash Cards and Payouts): moved at once,
    // the same Enter press that submitted would also press Next, dealing
    // the next round before the feedback could be seen.
    private async Task SpSubmitAndShow()
    {
        SpSubmit();
        if (!_spScored) return;

        _scrollToFeedback = true;
        StateHasChanged();

        await Task.Delay(200);
        _spFocusNext = true;
    }

    private void SpSubmit()
    {
        if (_spScored) return;

        // Both boxes need an amount (0 for a losing wager)
        for (int i = 0; i < 2; i++)
        {
            if (_spAnswer[i].Length == 0 && !_spLose[i])
            {
                _spMessage = i == 0
                    ? "Enter the 21 + 3 payout, or tap Lose."
                    : "Enter the Lucky Ladies payout, or tap Lose.";
                _spActive = i;
                _spFocusInput = i;
                return;
            }
        }

        int[] correct = { _spRound.TwentyOnePlus3Payout, _spRound.LuckyLadiesPayout };
        for (int i = 0; i < 2; i++)
        {
            _spOk[i] = _spLose[i]
                ? correct[i] == 0
                : long.TryParse(_spAnswer[i], out long v) && v == correct[i];
        }

        _spRows.Clear();
        _spRows.Add(new BreakdownRow("21 + 3",
            SpEnteredMoney(0), SpAnswerMoney(correct[0]), _spOk[0],
            SideWagerPayouts.Why21Plus3(_spRound)));
        _spRows.Add(new BreakdownRow("Lucky Ladies",
            SpEnteredMoney(1), SpAnswerMoney(correct[1]), _spOk[1],
            SideWagerPayouts.WhyLuckyLadies(_spRound)));

        _log.AddRows(_spRows);
        _spPlayed++;
        if (_spOk[0] && _spOk[1]) _spCorrect++;

        _spResultText = BreakdownRow.Summary(_spRows);
        _spMessage = string.Empty;
        _spScored = true;
    }

    // Lose button: marks the wager as losing (clears any amount typed) and
    // moves on to the next wager; tapped again it's undone.
    private void SpToggleLose(int index)
    {
        if (_spScored) return;
        _spMessage = string.Empty;

        if (_spLose[index])
        {
            _spLose[index] = false;
            _spActive = index;
            _spFocusInput = index;
            return;
        }

        _spLose[index] = true;
        _spAnswer[index] = string.Empty;
        int next = index == 0 ? 1 : index;
        _spActive = next;
        _spFocusInput = next;
    }

    // What was entered, for the payout box after Submit: "LOSE" or "1,000"
    private string SpEnteredText(int index) =>
        _spLose[index] ? "LOSE" : SpShowEntered(_spAnswer[index]).TrimStart('$');

    // ...and for the breakdown: "Lose" or "$1,000"
    private string SpEnteredMoney(int index) =>
        _spLose[index] ? "Lose" : SpShowEntered(_spAnswer[index]);

    private static string SpAnswerMoney(int dollars) =>
        dollars == 0 ? "Lose" : SideWagerPayouts.Money(dollars);

    // Chip color by the largest chip in the wager: $25 green, $10 blue,
    // $5 red, $1 grey
    private static string SpChipClass(int wager) =>
        wager >= 100 ? "sp-chip-100" : wager >= 25 ? "sp-chip-25" : wager >= 10 ? "sp-chip-10" : wager >= 5 ? "sp-chip-5" : "sp-chip-1";

    private static string SpShowEntered(string raw) =>
        long.TryParse(raw, out long v) ? $"${v:N0}" : raw;

    private void SpNextTop()
    {
        SpNewRound();
        _scrollToTopAfterNext = true;
    }

    // ============================================================
    // SIDE WAGERS (Sw prefix)
    // ============================================================

    private sealed class SwHandState
    {
        public Card Card1 = null!;
        public Card Card2 = null!;
        public WagerOutcome? LuckyLadiesSelection;
        public WagerOutcome? TwentyOnePlus3Selection;
        public bool LuckyLadiesWrong;
        public bool TwentyOnePlus3Wrong;
        // Chips on the rows (real-world betting pattern, $1-$50)
        public int LuckyLadiesWager;
        public int TwentyOnePlus3Wager;
    }

    private int _swHandCount = 1;
    private Deck _swDeck = new();
    private readonly List<SwHandState> _swHands = new();
    private Card? _swDealerCard;

    private int _swTotalCorrect;
    private int _swTotalAnswered;

    private bool _swSubmitEnabled;
    private bool _swRoundScored;
    private bool _swDealEnabled;
    private string _swResultText = string.Empty;
    private bool _swIsCorrect;
    private string _swScoreText = "Score: 0 / 0 (0.0%)";

    private void SwStartGame()
    {
        _swHandCount = Math.Clamp(_swHandCount, 1, 6);
        _swTotalCorrect = 0;
        _swTotalAnswered = 0;
        _swScoreText = "Score: 0 / 0 (0.0%)";

        SwDealNewRound();
    }

    private void SwDealNewRound()
    {
        _swDealEnabled = false;

        _swDeck = new Deck();
        _swDeck.Shuffle();

        _swHands.Clear();
        for (int h = 0; h < _swHandCount; h++)
        {
            _swHands.Add(new SwHandState
            {
                Card1 = _swDeck.Draw(),
                Card2 = _swDeck.Draw(),
                LuckyLadiesWager = SideWagerPayouts.SideWager(Random.Shared),
                TwentyOnePlus3Wager = SideWagerPayouts.SideWager(Random.Shared)
            });
        }

        _swDealerCard = _swDeck.Draw();

        _swResultText = string.Empty;
        _swRoundScored = false;
        _swSubmitEnabled = true;
    }

    // True once every hand has both of its wagers called (Win or Lose) --
    // Submit only shows up at that point.
    private bool SwAllAnswered => _swHands.Count > 0 && _swHands.All(h =>
        h.LuckyLadiesSelection is not null && h.TwentyOnePlus3Selection is not null);

    // After Submit: Lucky Ladies and 21 + 3 for each hand, with the right
    // answer and why
    private readonly List<BreakdownRow> _swRows = new();

    private void SwDealAgain()
    {
        _swRows.Clear();
        foreach (SwHandState hand in _swHands)
        {
            hand.LuckyLadiesSelection = null;
            hand.TwentyOnePlus3Selection = null;
            hand.LuckyLadiesWrong = false;
            hand.TwentyOnePlus3Wrong = false;
        }

        SwDealNewRound();
    }

    private void SwSubmitRound()
    {
        for (int h = 0; h < _swHands.Count; h++)
        {
            SwHandState hand = _swHands[h];
            if (hand.LuckyLadiesSelection is null || hand.TwentyOnePlus3Selection is null)
            {
                _swResultText = "Tap every wager to select an outcome before submitting.";
                _swIsCorrect = false;
                return;
            }
        }

        int roundCorrect = 0;

        foreach (SwHandState hand in _swHands)
        {
            bool actualLL = SideWagerRules.QualifiesLuckyLadies(hand.Card1, hand.Card2);
            bool actualTC = SideWagerRules.Qualifies21Plus3(hand.Card1, hand.Card2, _swDealerCard!);

            WagerOutcome actualLLOutcome = actualLL ? WagerOutcome.Win : WagerOutcome.Lose;
            WagerOutcome actualTCOutcome = actualTC ? WagerOutcome.Win : WagerOutcome.Lose;

            if (hand.LuckyLadiesSelection == actualLLOutcome)
            {
                hand.LuckyLadiesWrong = false;
                roundCorrect++;
            }
            else
            {
                hand.LuckyLadiesWrong = true;
            }

            if (hand.TwentyOnePlus3Selection == actualTCOutcome)
            {
                hand.TwentyOnePlus3Wrong = false;
                roundCorrect++;
            }
            else
            {
                hand.TwentyOnePlus3Wrong = true;
            }
        }

        _swTotalAnswered++;

        // Each wager with the right answer and why, hand by hand
        _swRows.Clear();
        for (int h = 0; h < _swHands.Count; h++)
        {
            SwHandState hand = _swHands[h];
            BlackjackHand two = new();
            two.AddCard(hand.Card1);
            two.AddCard(hand.Card2);
            bool ll = SideWagerRules.QualifiesLuckyLadies(hand.Card1, hand.Card2);
            bool tc = SideWagerRules.Qualifies21Plus3(hand.Card1, hand.Card2, _swDealerCard!);
            string tcName = !tc ? "no Flush, Straight or Three of a Kind"
                : ThreeCardEvaluator.GetCategory(new[] { hand.Card1, hand.Card2, _swDealerCard! }) switch
                {
                    ThreeCardCategory.StraightFlush => "a Straight Flush",
                    ThreeCardCategory.ThreeOfAKind => "Three of a Kind",
                    ThreeCardCategory.Straight => "a Straight",
                    _ => "a Flush"
                };
            string prefix = _swHands.Count > 1 ? $"Hand {h + 1} " : "";
            WagerOutcome llActual = ll ? WagerOutcome.Win : WagerOutcome.Lose;
            WagerOutcome tcActual = tc ? WagerOutcome.Win : WagerOutcome.Lose;

            _swRows.Add(new BreakdownRow($"{prefix}Lucky Ladies", $"{hand.LuckyLadiesSelection}", $"{llActual}",
                hand.LuckyLadiesSelection == llActual,
                ll ? "The first two cards total 20." : $"The first two cards total {two.Total} (needs 20)."));
            _swRows.Add(new BreakdownRow($"{prefix}21 + 3", $"{hand.TwentyOnePlus3Selection}", $"{tcActual}",
                hand.TwentyOnePlus3Selection == tcActual,
                $"With the dealer's up card: {tcName}."));
        }

        // Summary parts by wager ("Hand 2 Lucky Ladies" counts as Lucky Ladies)
        _log.AddRows(_swRows, r => r.Name.EndsWith("Lucky Ladies") ? "Lucky Ladies" : "21 + 3");

        if (roundCorrect == _swHandCount * 2)
        {
            _swTotalCorrect++;
            _swIsCorrect = true;
        }
        else
        {
            _swIsCorrect = false;
        }

        _swResultText = BreakdownRow.Summary(_swRows);

        double percentage = (double)_swTotalCorrect / _swTotalAnswered;
        _swScoreText = $"Score: {_swTotalCorrect} / {_swTotalAnswered} ({percentage:0.0%})";

        _swRoundScored = true;
        _swSubmitEnabled = false;
        _swDealEnabled = true;
    }

    // Scroll back to the top whenever this game switches between its
    // start screen and its play screen (Start, Back, menu, End Session).
    // Without this the browser keeps the old scroll position -- after
    // scrolling down to reach Start, the game would open scrolled down.
    private bool _lastRenderedStarted;

    private bool _scrollToSummary;

    // Side Wagers bar buttons: Submit also scrolls to the feedback;
    // Next also scrolls back to the top
    private void SwSubmitAndShow()
    {
        SwSubmitRound();
        if (_swRoundScored) _scrollToFeedback = true;
    }

    private void SwNextHandTop()
    {
        SwDealAgain();
        _scrollToTopAfterNext = true;
    }

    private bool _scrollToFeedback;
    private bool _scrollToTopAfterNext;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Submit: bring the feedback box into view (if it isn't already).
        // Next: back to the top for the new hand.
        if (_scrollToFeedback)
        {
            _scrollToFeedback = false;
            try { await JS.InvokeVoidAsync("dstRevealFeedback"); } catch { }
        }

        if (_scrollToTopAfterNext)
        {
            _scrollToTopAfterNext = false;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }
        }

        // End Session: bring the Session Summary into view (it's at the
        // bottom of the page, often below the screen on a phone)
        if (_scrollToSummary && _showSessionSummary)
        {
            _scrollToSummary = false;
            try { await JS.InvokeVoidAsync("dstScrollToEl", ".session-summary"); } catch { }
        }

        if (_started != _lastRenderedStarted)
        {
            _lastRenderedStarted = _started;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }

            // Desktop: open the number pad straight away when the window
            // is tall enough for it (123 still hides / shows it)
            if (_started && _mode != BlackjackMode.SideWagers)
            {
                bool fits = false;
                try { fits = await JS.InvokeAsync<bool>("dstKeypadFits", _mode == BlackjackMode.FlashCards ? 260 : 315); } catch { }
                if (_mode == BlackjackMode.FlashCards) _fcShowKeypad = fits;
                else if (_mode == BlackjackMode.SidePayouts) _spShowKeypad = fits;
                else _poShowKeypad = fits;
                if (fits) StateHasChanged();
            }
        }

        // preventScroll: true -- moving the cursor into the answer box (or
        // onto New Round) must not scroll the page to that element
        if (_fcShouldFocusAnswer)
        {
            _fcShouldFocusAnswer = false;
            try { await _fcAnswerInputRef.FocusAsync(preventScroll: true); } catch { }
        }

        if (_fcShouldFocusNewRound)
        {
            _fcShouldFocusNewRound = false;
            try { await _fcNewRoundButtonRef.FocusAsync(preventScroll: true); } catch { }
        }

        if (_poShouldFocusAnswer)
        {
            _poShouldFocusAnswer = false;
            try { await _poAnswerInputRef.FocusAsync(preventScroll: true); } catch { }
        }

        if (_poShouldFocusNewRound)
        {
            _poShouldFocusNewRound = false;
            try { await _poNewRoundButtonRef.FocusAsync(preventScroll: true); } catch { }
        }

        // Side Wager Payouts: cursor into the active payout box, or onto
        // Next once the round is scored (so Enter deals the next round)
        // Payouts, phones: size the wager box to the space above the keypad
        if (_started && _mode == BlackjackMode.SidePayouts)
        {
            try { await JS.InvokeVoidAsync("dstFitWagerBox"); } catch { }
        }

        if (_spFocusInput >= 0)
        {
            int i = _spFocusInput;
            _spFocusInput = -1;
            try { await _spInputRefs[i].FocusAsync(preventScroll: true); } catch { }
            try { await JS.InvokeVoidAsync("dstWagerRowIntoView", i); } catch { }
        }

        if (_spFocusNext)
        {
            _spFocusNext = false;
            try { await _spNextButtonRef.FocusAsync(preventScroll: true); } catch { }
        }
    }
}
