@page "/blackjack-trainer"
@using DealerSchoolTrainerWeb.Core
@using DealerSchoolTrainerWeb.Games.FlashCardTrainer
@using DealerSchoolTrainerWeb.Games.PayoutTrainer
@using DealerSchoolTrainerWeb.Games.SideWagerTrainer
@using DealerSchoolTrainerWeb.Games.ThreeCardTrainer
@implements IDisposable
@inject GameResetService GameReset
@inject IJSRuntime JS

<PageTitle>Blackjack</PageTitle>

@if (!_started)
{
    <div class="start-screen">
        <h1>BLACKJACK</h1>

        @* The Tutorial first (game 1 of the Dealer School course), then the
           three trainers, numbered in the suggested practice order. Each
           mode is a collapsible card: tap its title to open its settings
           and its own Start button (one card open at a time). *@
        <a class="tu-entry" href="blackjack-tutorial">
            <span class="tu-entry-cards">
                <img src="images/cards/AS.png" alt="" />
                <img src="images/cards/KH.png" alt="" />
            </span>
            <span class="tu-entry-text">
                <b>New to Blackjack?</b>
                <span>Start with the 3-minute tutorial.</span>
            </span>
            <span class="tu-entry-btn">Tutorial</span>
        </a>

        <div class="mode-list">
            <ModeCard Title="Flash Cards" Number="1"
                      Description="Type the dealer's total, press Enter to Submit."
                      Expanded="@IsModeOpen(BlackjackMode.FlashCards)"
                      OnToggle="() => ToggleMode(BlackjackMode.FlashCards)"
                      OnStart="StartGame">
                <TileChoice @bind-Second="_fcRemoveTens" Label="Cards dealt"
                            FirstTitle="All Cards" FirstText="Every card in the deck."
                            FirstIcon="@(__b => { TileChoice.MiniCard("♠")(__b); TileChoice.MiniCard("♥")(__b); })"
                            SecondTitle="No 10's" SecondText="All 10-value cards removed."
                            SecondIcon="@TileChoice.MiniCard("♠", struck: true)" />
            </ModeCard>

            <ModeCard Title="Blackjack Payouts" Number="2"
                      Description="Pay each blackjack. Type the payout, then press Enter or Submit."
                      Expanded="@IsModeOpen(BlackjackMode.Payouts)"
                      OnToggle="() => ToggleMode(BlackjackMode.Payouts)"
                      OnStart="StartGame">
                <TileChoice Second="@(_poRatio == PayoutRatio.SixToFive)"
                            SecondChanged="@(v => _poRatio = v ? PayoutRatio.SixToFive : PayoutRatio.ThreeToTwo)"
                            Label="Payout"
                            FirstTitle="3:2 Payouts" FirstText="Pays 3 to 2."
                            FirstIcon="@TileChoice.Chip("#1e8a4c", "3:2")"
                            SecondTitle="6:5 Payouts" SecondText="Single Deck Blackjack only."
                            SecondIcon="@TileChoice.Chip("#c62828", "6:5")" />
                <div class="mode-options">
                    <div class="mode-option-group">
                        <p class="mode-option-label">Difficulty</p>
                        <label class="mode-choice">
                            <input type="radio" name="difficulty" checked="@(_poDifficulty == PayoutDifficulty.Beginner)" @onchange="() => _poDifficulty = PayoutDifficulty.Beginner" />
                            Beginner
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="difficulty" checked="@(_poDifficulty == PayoutDifficulty.Intermediate)" @onchange="() => _poDifficulty = PayoutDifficulty.Intermediate" />
                            Intermediate
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="difficulty" checked="@(_poDifficulty == PayoutDifficulty.Advanced)" @onchange="() => _poDifficulty = PayoutDifficulty.Advanced" />
                            Advanced
                        </label>
                    </div>
                </div>
            </ModeCard>

            <ModeCard Title="Side Wagers" Number="3"
                      Description="The dealer's up-card and the player's two cards are dealt. Settle 21 + 3, then Lucky Ladies, then Submit."
                      Expanded="@IsModeOpen(BlackjackMode.SideWagers)"
                      OnToggle="() => ToggleMode(BlackjackMode.SideWagers)"
                      OnStart="StartGame">
                <PayoutChoice @bind-Pay="_swPay"
                              CallText="Call each wager Win or Lose."
                              PayText="Call each wager, then pay the winners." />
            </ModeCard>
        </div>

        <ProgressivesLink Key="bj" Game="Blackjack" />
    </div>
}
else if (_mode == BlackjackMode.FlashCards)
{
    @* keypad-screen: on phones the feedback line moves up above the
       answer box so it isn't hidden below the keypad (see app.css) *@
    <div class="play-screen keypad-screen fc-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Flash Cards" Correct="_fcRoundsCorrect" Played="_fcRoundsPlayed"
                    ContinueTitle="@($"Blackjack · Flash Cards{(_fcRemoveTens ? ", No 10's" : "")}")"
                    ContinueUrl="@(_fcRemoveTens ? "blackjack-trainer?open=flash-no10" : "blackjack-trainer?open=flash")" />

        @* On the felt: the cards fanned (each overlaps the previous one by
           30%, leaving every card's rank/suit corner visible; --n, the card
           count, lets the CSS size them to fit across a phone screen) and
           the table's printed rule *@
        <div class="felt fc-felt">
            <div class="card-row fc-fan" style="--n: @_fcHand.Count;">
                @for (int i = 0; i < _fcHand.Count; i++)
                {
                    var card = _fcHand.CardAt(i);
                    <img src="images/cards/@(card.Code).png" alt="@card.Name" class="card-image fc-card" />
                }
            </div>
            <p class="table-rule">DEALER MUST HIT SOFT 17</p>
        </div>

        <p class="prompt-line">@_fcPromptText</p>

        @* One fixed-height line shared by the Ace reminder and the feedback:
           feedback (when there is any) takes the reminder's place, and the
           next hand brings the reminder back -- so nothing below shifts. *@
        <p class="fc-msg @(_fcFeedbackText.Length > 0 ? $"txt-bold {_fcFeedbackColor}" : "fc-hint")">
            @if (_fcFeedbackText.Length > 0)
            {
                @_fcFeedbackText
            }
            else if (_fcShowHint)
            {
                <text>Remember: an Ace can count as 1 or 11.</text>
            }
        </p>

        @* Once the hand is over, the total box and BUST are hidden but keep
           their space (fc-answer-done), so the keypad doesn't move *@
        <div class="button-row answer-row keypad-answer @(_fcNewRoundEnabled ? "fc-answer-done" : "")">
            @* inputmode="none": on phones and tablets, tapping the box does
               NOT open the phone's own keyboard (which pushed the cards off
               screen) -- the on-screen keypad below is used instead. A
               physical keyboard on a PC still types into it normally. *@
            <input type="text"
                   inputmode="none"
                   @bind="_fcAnswerText"
                   @bind:event="oninput"
                   @onkeydown="FcHandleAnswerKeyDown"
                   @ref="_fcAnswerInputRef"
                   disabled="@(!_fcAnswerEnabled)"
                   placeholder="Total" />
            @* BUST: one tap when the dealer's total is over 21 (typing the
               total still counts too) *@
            @* Reveal: shows the current total in a pop-up (the hand counts
               as a miss), then the hand carries on as if it had been
               answered. Sits between the total box and BUST; the box
               narrows to make room. *@
            <button class="reveal-button" @onclick="FcReveal" disabled="@(!_fcSubmitEnabled)">Reveal</button>
            <button class="bust-button" @onclick="FcBust" disabled="@(!_fcSubmitEnabled)">BUST</button>
            <button class="keypad-toggle" @onclick="() => _fcShowKeypad = !_fcShowKeypad">123</button>
        </div>

        @* Desktop: shown only after pressing 123. Phones/touch screens: always
           shown, and the 123 button is hidden (see app.css, keypad-wrap). *@
        <div class="keypad-wrap @(_fcShowKeypad ? "keypad-open" : "")">
            <NumericKeypad AllowDecimal="false" @bind-Value="_fcAnswerText" OnEnter="FcKeypadEnter" EnterLabel="@(_fcNewRoundEnabled ? "Next" : "Enter")" />
        </div>

        @* Pinned bottom bar (Shared/GameBar): Help | Submit, or Next once
           the hand is over (same as the keypad's Enter) | End Session *@
        <GameBar HelpTitle="Flash Cards" OnEnd="EndSession">
            <ChildContent>
                <button class="game-bar-main" @onclick="FcKeypadEnter" disabled="@(!_fcSubmitEnabled && !_fcNewRoundEnabled)" @ref="_fcNewRoundButtonRef">@(_fcNewRoundEnabled ? "Next" : "Submit")</button>
            </ChildContent>
            <HelpContent>
                <ul>
                    <li>Number cards count their number; 10, J, Q and K count 10.</li>
                    <li>An Ace counts 11, or 1 when 11 would put the hand over 21. While it can still count 11, the hand is "soft".</li>
                    <li>The dealer must hit 16 or less and must hit soft 17; the dealer stands on 17 or more otherwise.</li>
                    <li>Enter the dealer's total each time a card is dealt. Over 21: tap BUST or enter the total.</li>
                    <li>Stuck? Reveal shows the total (the hand counts as a miss).</li>
                    <li>With No 10's, every 10, J, Q and K is taken out.</li>
                </ul>
            </HelpContent>
        </GameBar>

        @if (_fcShowReveal)
        {
            <RevealPopup Title="Dealer's Total" OnClose="FcCloseReveal">
                <p class="reveal-answer">@(_fcHand.IsBlackjack ? "21 - Blackjack" : _fcHand.IsBust ? $"BUST ({_fcHand.Total})" : _fcHand.Total.ToString())</p>
                @if (!_fcHand.IsBust && !_fcHand.IsBlackjack && _fcHand.IsSoft)
                {
                    <p>Soft @_fcHand.Total: the Ace counts as 11. Counting the Ace as 1 it's @(_fcHand.HardTotal)@(_fcHand.MustHit(FcHitSoft17) ? $", so {_fcHand.HardTotal} is also accepted" : "").</p>
                }
                <p>@FcNextStepText</p>
            </RevealPopup>
        }
    </div>
}
else if (_mode == BlackjackMode.Payouts)
{
    <div class="play-screen keypad-screen po-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="@($"Payouts {(_poRatio == PayoutRatio.ThreeToTwo ? "3:2" : "6:5")}")" Correct="_poCorrectCount" Played="_poTotalRounds"
                    ContinueTitle="@($"Blackjack · Payouts {(_poRatio == PayoutRatio.ThreeToTwo ? "3:2" : "6:5")}")"
                    ContinueUrl="@(_poRatio == PayoutRatio.ThreeToTwo ? "blackjack-trainer?open=payouts" : "blackjack-trainer?open=payouts-65")" />

        @* On the felt: the blackjack, two cards side by side, and the
           table's printed payout *@
        <div class="felt po-felt">
            <div class="card-row po-cards">
                <img src="images/cards/AS.png" alt="Ace of Spades" class="po-card" />
                <img src="images/cards/JS.png" alt="Jack of Spades" class="po-card" />
            </div>
            <p class="table-rule">BLACKJACK PAYS @(_poRatio == PayoutRatio.ThreeToTwo ? "3 TO 2" : "6 TO 5")</p>
        </div>

        <p class="po-wager">Wager: <strong>@PayoutWager.FormatCents(_poWagerCents)</strong></p>

        <div class="button-row answer-row keypad-answer">
            @* Phones: this display box takes the place of the text box --
               it shows the amount being keyed in, then the result (with the
               correct payout) in the same spot, so nothing shifts down. *@
            <div class="po-display @(_poPromptText.Length == 0 ? "txt-plain" : (_poIsCorrect ? "txt-ok" : "txt-bad"))">
                @if (_poPromptText.Length > 0)
                {
                    <div class="po-display-result">@_poPromptText</div>
                    <div class="po-display-detail">
                        @if (_poYouText.Length > 0)
                        {
                            @* Missed: what was entered (red), then the right
                               payout in a blue box so it stands out *@
                            <span>@_poYouText</span>
                            <span class="fb-ans">@_poPromptDetailText</span>
                        }
                        else
                        {
                            @_poPromptDetailText
                        }
                    </div>
                }
                else if (_poAnswerText.Length > 0)
                {
                    <div class="po-display-amount">$@_poAnswerText</div>
                }
                else
                {
                    <div class="po-display-placeholder">Enter payout</div>
                }
            </div>

            @* inputmode="none": see the Flash Cards answer box above *@
            <input type="text"
                   inputmode="none"
                   value="@_poAnswerText"
                   @oninput="PoHandleAnswerInput"
                   @onkeydown="PoHandleAnswerKeyDown"
                   @ref="_poAnswerInputRef"
                   readonly="@(!_poAnswerEnabled)"
                   placeholder="Amount" />
            <button class="keypad-toggle" @onclick="() => _poShowKeypad = !_poShowKeypad">123</button>
        </div>

        <div class="keypad-wrap @(_poShowKeypad ? "keypad-open" : "")">
            @* No Enter key: Submit / Next is on the bottom bar *@
            <NumericKeypad AllowDecimal="true" MaxDecimalDigits="2" @bind-Value="_poAnswerText" />
        </div>

        <div class="feedback-area">
            <p class="txt-bold @(_poIsCorrect ? "txt-ok" : "txt-bad")">@_poPromptText</p>
            <p class="@(_poIsCorrect ? "txt-ok" : "txt-bad")">@_poPromptDetailText</p>
        </div>

        @* Pinned bottom bar: Help | Submit, or Next once scored | End Session *@
        <GameBar HelpTitle="Blackjack Payouts" OnEnd="EndSession">
            <ChildContent>
                <button class="game-bar-main" @onclick="PoKeypadEnter" disabled="@(!_poSubmitEnabled && !_poNewRoundEnabled)" @ref="_poNewRoundButtonRef">@(_poNewRoundEnabled ? "Next" : "Submit")</button>
            </ChildContent>
            <HelpContent>
                <ul>
                    <li><strong>3 to 2:</strong> pay the wager plus half of it. $20 pays $30; $15 pays $22.50.</li>
                    <li><strong>6 to 5:</strong> pay $6 for every $5 wagered. $25 pays $30; $15 pays $18.</li>
                    <li>A wager with 50 cents at 3 to 2: the 50 cents is paid even money. $5.50 pays $7.50 + $0.50 = $8.00.</li>
                    <li>Enter only the payout, not the wager.</li>
                </ul>
            </HelpContent>
        </GameBar>
    </div>
}
else
{
    @* Side Wagers, played Call Only or Call & Pay: the dealer's up-card
       (when the house peeks -- a Queen of Hearts pair showing and an Ace
       or 10-value card up -- the hole card too, tucked behind, tilted,
       with a dashed gold outline and a HOLE CARD tag; it stays face down
       until the trainee taps Call Supervisor) and the player's two
       cards, then 21 + 3 and Lucky Ladies, each with a Call button. Call
       & Pay: calling Win opens that wager's payout box with the number
       pad; the other row hides until Enter (or Cancel) closes it. *@
    <div class="play-screen sp-screen swp-screen has-game-bar @(_swPay ? "" : "cr-screen") @(_swBox >= 0 ? "uc-open" : "")">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Side Wagers" Correct="_swCorrect" Played="_swPlayed"
                    ContinueTitle="@($"Blackjack · Side Wagers · {(_swPay ? "Call & Pay" : "Call Only")}")"
                    ContinueUrl="@(_swPay ? "blackjack-trainer?open=side-pay" : "blackjack-trainer?open=side")" />

        <div class="felt sp-felt">
            <div class="sp-col">
                <div class="sp-cap">DEALER</div>
                @if (_swRound.DealerHole is not null)
                {
                    <div class="sp-dealer">
                        @if (_swPeeked || _swScored)
                        {
                            <img src="images/cards/@(_swRound.DealerHole.Code).png" alt="Hole card: @_swRound.DealerHole.Name" class="sp-card sp-hole" />
                        }
                        else
                        {
                            <div class="sp-card sp-hole sw-back" role="img" aria-label="Hole card, face down"></div>
                        }
                        <img src="images/cards/@(_swRound.DealerUp.Code).png" alt="Up-card: @_swRound.DealerUp.Name" class="sp-card sp-up" />
                        <span class="sp-tag sp-uptag">UP</span>
                        <span class="sp-tag sp-holetag">HOLE CARD</span>
                    </div>
                    @* House procedure: a Queen of Hearts pair with an Ace or
                       10-value card up -- call a supervisor, who approves
                       the peek before Lucky Ladies is settled *@
                    @if (_swPeeked)
                    {
                        <div class="sw-peek-ok">✓ Peek approved</div>
                    }
                    else if (!_swScored)
                    {
                        <button type="button" class="sw-peek-btn" @onclick="SwCallSupervisor">Call Supervisor</button>
                    }
                }
                else
                {
                    <img src="images/cards/@(_swRound.DealerUp.Code).png" alt="Up-card: @_swRound.DealerUp.Name" class="sp-card" />
                }
            </div>
            <div class="sp-col">
                <div class="sp-cap">PLAYER</div>
                <div class="sp-cards">
                    <img src="images/cards/@(_swRound.Player1.Code).png" alt="@_swRound.Player1.Name" class="sp-card" />
                    <img src="images/cards/@(_swRound.Player2.Code).png" alt="@_swRound.Player2.Name" class="sp-card" />
                </div>
            </div>
        </div>

        <div class="sp-wagers">
            @for (int w = 0; w < 2; w++)
            {
                int wi = w;
                int wager = SwWager(wi);

                @if (_swBox >= 0 && wi != _swBox)
                {
                    continue;
                }

                @if (wi == _swBox)
                {
                    @* The open payout box (same as Three Card Prime): the number
                       pad below; a computer keyboard types straight in, Enter
                       confirms, Esc cancels *@
                    <div class="sp-wrow uc-boxrow">
                        <div class="sp-chip @CallRow.ChipCss(wager)">$@wager</div>
                        <div class="sp-wname">@SwNames[wi]<small>wager $@wager</small></div>
                        <label class="uc-amt">
                            <span class="uc-dollar">$</span>
                            <input type="text"
                                   inputmode="none"
                                   autocomplete="off"
                                   aria-label="@($"{SwNames[wi]} payout")"
                                   placeholder="Payout"
                                   value="@_swBoxText"
                                   @oninput="SwBoxInput"
                                   @onkeydown="SwBoxKeyDown"
                                   @ref="_swBoxInputRef" />
                        </label>
                    </div>
                    continue;
                }

                <CallRow Chip="@(!_swPay)" ChipAmount="@(_swPay ? wager : null)"
                         Name="@SwNames[wi]"
                         Sub="@(_swPay ? $"wager ${wager}" : null)"
                         Options="WagerPick.WinLose"
                         Value="@_swCall[wi]"
                         PickedText="@SwPickedText(wi)"
                         OnPick="k => SwPick(wi, k)"
                         Locked="_swScored" Wrong="!_swOk[wi]" AnswerText="@SwAnswerText(wi)" />
            }
        </div>

        @if (_swBox >= 0)
        {
            <div class="uc-keypad">
                <NumericKeypad AllowDecimal="false" @bind-Value="SwBoxText" OnEnter="SwBoxEnter" EnterLabel="Enter" EnterDisabled="@(_swBoxText.Length == 0)" />
            </div>
        }
        else if (_swPlayed == 0 && !_swScored)
        {
            @* First round only: what to do *@
            <p class="cr-howto">@(_swPay
                ? "Tap Call on each wager. Win opens its payout box."
                : "Tap Call on each wager and pick Win or Lose, then Submit.")</p>
        }

        <div class="feedback-area sp-feedback">
            @if (_swScored)
            {
                <ResultBreakdown ResultText="@_swResultText" IsCorrect="_swOk[0] && _swOk[1]" Rows="_swRows" />
            }
        </div>

        @if (_swPay)
        {
            @* Desktop: both pay tables stay in view (beside the game on a wide
               window, under it otherwise). Phones: in Help. *@
            <aside class="sp-paytable">
                <table class="sp-pt">
                    <tr class="sp-pt-hd"><td colspan="2">21 + 3</td></tr>
                    <tr><td>Straight Flush</td><td>30 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>20 to 1</td></tr>
                    <tr><td>Straight</td><td>10 to 1</td></tr>
                    <tr><td>Flush</td><td>5 to 1</td></tr>
                </table>
                <table class="sp-pt">
                    <tr class="sp-pt-hd"><td colspan="2">Lucky Ladies</td></tr>
                    <tr><td>Q&hearts; pair + dealer BJ</td><td>1000 to 1</td></tr>
                    <tr><td>Q&hearts; pair</td><td>125 to 1</td></tr>
                    <tr><td>Matched 20</td><td>19 to 1</td></tr>
                    <tr><td>Suited 20</td><td>9 to 1</td></tr>
                    <tr><td>Any 20</td><td>4 to 1</td></tr>
                </table>
                <p class="sp-pt-note">Winnings only.</p>
            </aside>
        }

        @* Pinned bottom bar: the main button counts the wagers left until
           both are called; while a payout box is open, End Session becomes
           Cancel *@
        <GameBar HelpTitle="Side Wager Pay Tables" OnEnd="SwEndOrCancel"
                 EndLabel="@(_swBox >= 0 ? "Cancel" : "End Session")"
                 EndClass="@(_swBox >= 0 ? "game-bar-cancel" : "")">
            <ChildContent>
                @if (!_swScored)
                {
                    int left = SwWagersLeft;
                    @if (left > 0 || _swBox >= 0)
                    {
                        <button class="game-bar-main" disabled>
                            <span class="gb-left-long">@left @(left == 1 ? "wager" : "wagers") left</span><span class="gb-left-short">@left left</span>
                        </button>
                    }
                    else
                    {
                        <button class="game-bar-main" @onclick="SwSubmitAndShow">Submit</button>
                    }
                }
                else
                {
                    <button class="game-bar-main" @onclick="SwNextTop">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <table class="help-table sp-help-table">
                    <tr class="sp-pt-hd"><td colspan="2">21 + 3 (your 2 cards + dealer up-card)</td></tr>
                    <tr><td>Straight Flush</td><td>30 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>20 to 1</td></tr>
                    <tr><td>Straight</td><td>10 to 1</td></tr>
                    <tr><td>Flush</td><td>5 to 1</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">Lucky Ladies (your 2 cards total 20)</td></tr>
                    <tr><td>Q&hearts; pair + dealer Blackjack</td><td>1000 to 1</td></tr>
                    <tr><td>Queen of Hearts pair</td><td>125 to 1</td></tr>
                    <tr><td>Matched 20 (identical cards)</td><td>19 to 1</td></tr>
                    <tr><td>Suited 20</td><td>9 to 1</td></tr>
                    <tr><td>Any 20</td><td>4 to 1</td></tr>
                </table>
                @if (_swPay)
                {
                    <p>Calling Win opens the wager's payout box: enter the winnings only (the wager stays on the layout), then Enter. Entering 0 counts as Lose; Cancel puts the wager back to Call.</p>
                    <p>Every hand wins at least one side wager. For practice, big pays come up far more often than at a live table.</p>
                }
                else
                {
                    <p>A wager wins with any hand on its table; otherwise it loses.</p>
                    <p>For practice, about half the hands win a side wager, more than at a live table.</p>
                }
                <p>A Queen of Hearts pair with an Ace or 10-value card up: tap Call Supervisor. The supervisor approves the peek, then settle Lucky Ladies.</p>
            </HelpContent>
        </GameBar>
    </div>
}

@if (_showSessionSummary)
{
    @switch (_mode)
    {
        case BlackjackMode.FlashCards:
            <SessionSummary ModeKey="bj-flashcards" Rounds="_fcRoundsPlayed" Correct="_fcRoundsCorrect" Log="_log"
                            RightText="right" ConfidentText="You're counting these with confidence" YouVerb="said"
                            OnAgain="PracticeAgain" OnDone="CloseSummary" />
            break;
        case BlackjackMode.Payouts:
            <SessionSummary ModeKey="bj-payouts" Rounds="_poTotalRounds" Correct="_poCorrectCount" Log="_log"
                            RightText="paid right" YouVerb="paid"
                            OnAgain="PracticeAgain" OnDone="CloseSummary" />
            break;
        default:
            @* Side Wagers: each way of playing keeps its own "last time"
               progress (the keys of the old separate modes) *@
            @if (_swPay)
            {
                <SessionSummary ModeKey="bj-sidepayouts" Rounds="_swPlayed" Correct="_swCorrect" Log="_log"
                                RightText="paid right" ConfidentText="You're paying these with confidence" YouVerb="paid"
                                OnAgain="PracticeAgain" OnDone="CloseSummary" />
            }
            else
            {
                <SessionSummary ModeKey="bj-sidewagers" Rounds="_swPlayed" Correct="_swCorrect" Log="_log"
                                RightText="rounds right" ConfidentText="You're calling these with confidence" YouVerb="called"
                                OnAgain="PracticeAgain" OnDone="CloseSummary" />
            }
            break;
    }
}

@code {
    // Menu link for this game tapped while it's already open: return to
    // the start screen, same as the Back button (hidden on phones).
    // ?open=flash / payouts / side (from the Tutorial's "Practice this"
    // links): that mode's card opens on the start screen. flash-no10,
    // payouts-65 and side-pay (Home's Continue card) also choose the
    // option last played.
    [SupplyParameterFromQuery(Name = "open")] public string? Open { get; set; }

    protected override void OnInitialized()
    {
        GameReset.ResetRequested += OnResetRequested;
        BlackjackMode? fromLink = Open switch
        {
            "flash" or "flash-no10" => BlackjackMode.FlashCards,
            "payouts" or "payouts-65" => BlackjackMode.Payouts,
            "side" or "side-pay" => BlackjackMode.SideWagers,
            _ => null
        };
        if (Open == "flash-no10") _fcRemoveTens = true;
        if (Open == "payouts-65") _poRatio = PayoutRatio.SixToFive;
        if (Open == "side-pay") _swPay = true;
        if (fromLink is BlackjackMode m)
        {
            _openMode = m;
            _mode = m;
        }
    }

    private void OnResetRequested()
    {
        _showSessionSummary = false;
        _started = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameReset.ResetRequested -= OnResetRequested;
    }

    private enum BlackjackMode { FlashCards, Payouts, SideWagers }

    // Shared across the modes -- which start screen/play screen
    // to show, and the session-summary overlay.
    private bool _started;
    private BlackjackMode _mode = BlackjackMode.FlashCards;

    // Start screen: which mode card is open (null = all closed). Opening
    // a card also selects its mode, so that card's Start button starts
    // it. The open card stays open after a session, so a returning
    // trainee lands right back on the mode they were using.
    private BlackjackMode? _openMode;

    private bool IsModeOpen(BlackjackMode mode) => _openMode == mode;

    private void ToggleMode(BlackjackMode mode)
    {
        _openMode = _openMode == mode ? null : mode;
        if (_openMode is not null) _mode = mode;
    }
    private bool _showSessionSummary;

    private void BackToStart()
    {
        _swBox = -1;
        _started = false;
    }

    private void CloseSummary()
    {
        _showSessionSummary = false;
        _started = false;
    }

    // End-of-session summary's Practice Again: a fresh session of the same
    // mode, back at the top of the page (as if started from the start screen)
    private void PracticeAgain()
    {
        _showSessionSummary = false;
        StartGame();
        _lastRenderedStarted = false;
    }

    // What happened this session, for the summary (Shared/SessionSummary)
    private SessionLog _log = new();

    private void StartGame()
    {
        _started = true;
        _log = new SessionLog();

        switch (_mode)
        {
            case BlackjackMode.FlashCards: FcStartGame(); break;
            case BlackjackMode.Payouts: PoStartGame(); break;
            default: SwStartGame(); break;
        }
    }

    // Side Wagers: the bar's right button is Cancel while a payout box is
    // open; End Session ignores taps for a moment right after a box closes
    private void SwEndOrCancel()
    {
        if (_swBox >= 0)
        {
            SwBoxCancel();
            return;
        }
        if (DateTime.UtcNow < _swEndBlockedUntil) return;
        EndSession();
    }

    private void EndSession()
    {
        bool anyRoundsPlayed = _mode switch
        {
            BlackjackMode.FlashCards => _fcRoundsPlayed > 0,
            BlackjackMode.Payouts => _poTotalRounds > 0,
            _ => _swPlayed > 0
        };

        if (anyRoundsPlayed)
        {
            _showSessionSummary = true;
            _scrollToSummary = true;
        }
        else
        {
            _started = false;
        }
    }

    // ============================================================
    // FLASH CARDS (Fc prefix)
    // ============================================================

    private const bool FcHitSoft17 = true;

    private bool _fcRemoveTens;
    private BlackjackShoe _fcShoe = new();
    private BlackjackHand _fcHand = new();

    private int _fcRoundsCorrect;
    private int _fcRoundsPlayed;
    private bool _fcRoundHasMistake;

    private string _fcAnswerText = string.Empty;
    private string _fcPromptText = string.Empty;
    private string _fcFeedbackText = string.Empty;
    // Blue for a correct answer, red for wrong -- same as the other games;
    // plain black for prompts like "Enter the dealer's total."
    private string _fcFeedbackColor = "txt-plain"; // CSS class: txt-ok / txt-bad / txt-plain
    private bool _fcShowHint;
    private int _fcMissCount; // wrong answers on the current card -- a hint after the 2nd
    private bool _fcAnswerEnabled;
    private bool _fcSubmitEnabled;
    private bool _fcShowKeypad;
    private bool _fcNewRoundEnabled;

    private Microsoft.AspNetCore.Components.ElementReference _fcAnswerInputRef;
    private Microsoft.AspNetCore.Components.ElementReference _fcNewRoundButtonRef;
    private bool _fcShouldFocusAnswer;
    private bool _fcShouldFocusNewRound;

    private void FcStartGame()
    {
        _fcRoundsCorrect = 0;
        _fcRoundsPlayed = 0;

        _fcShoe = new BlackjackShoe();
        if (_fcRemoveTens) _fcShoe.RemoveTenValueCards();

        FcStartNewRound();
    }

    private void FcStartNewRound()
    {
        _fcHand = new BlackjackHand();
        _fcHand.AddCard(_fcShoe.Draw());
        _fcHand.AddCard(_fcShoe.Draw());

        _fcRoundHasMistake = false;
        _fcMissCount = 0;
        _fcCardLogged = false;
        _fcShowReveal = false;
        _fcFeedbackText = string.Empty;
        _fcNewRoundEnabled = false;

        _fcAnswerText = string.Empty;
        _fcAnswerEnabled = true;
        _fcSubmitEnabled = true;

        _fcShowHint = _fcHand.HasAce;
        _fcPromptText = "What's the dealer's total?";

        _fcShouldFocusAnswer = true;
    }

    private async Task FcHandleAnswerKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _fcSubmitEnabled)
        {
            await FcSubmitTypedAnswer();
        }
    }

    // Keypad Enter key: submits the answer, or -- once the hand is over --
    // deals the next one, matching what the keyboard's Enter key does.
    private async Task FcKeypadEnter()
    {
        if (_fcSubmitEnabled)
        {
            await FcSubmitTypedAnswer();
        }
        else if (_fcNewRoundEnabled)
        {
            FcStartNewRound();
        }
    }

    // BUST button: correct when the dealer's hand is over 21 (graded the
    // same as typing the busted total); otherwise a wrong answer.
    private async Task FcBust()
    {
        if (!_fcSubmitEnabled) return;

        if (_fcHand.IsBust)
        {
            await FcEvaluateAnswer(_fcHand.Total);
        }
        else
        {
            FcLog(false, "BUST");
            _fcRoundHasMistake = true;
            _fcAnswerText = string.Empty;
            _fcFeedbackText = "INCORRECT \u2014 not a bust. Try again.";
            _fcFeedbackColor = "txt-bad";
        }
    }

    private async Task FcSubmitTypedAnswer()
    {
        string raw = _fcAnswerText.Trim();

        if (raw.Length == 0)
        {
            _fcFeedbackText = "Enter the dealer's total.";
            _fcFeedbackColor = "txt-plain";
            return;
        }

        if (!long.TryParse(raw, out long enteredValue) || enteredValue < 2)
        {
            _fcFeedbackText = "Enter a valid total.";
            _fcFeedbackColor = "txt-plain";
            return;
        }

        await FcEvaluateAnswer(enteredValue);
    }

    private async Task FcEvaluateAnswer(long enteredValue)
    {
        bool actualBlackjack = _fcHand.IsBlackjack;
        int actualTotal = _fcHand.Total;
        bool actualBust = _fcHand.IsBust;
        bool isCorrect;

        if (actualBlackjack)
        {
            isCorrect = enteredValue == 21;
        }
        else if (actualBust)
        {
            isCorrect = enteredValue == actualTotal;
        }
        else if (_fcHand.MustHit(FcHitSoft17))
        {
            isCorrect = enteredValue == actualTotal || (_fcHand.IsSoft && enteredValue == _fcHand.HardTotal);
        }
        else
        {
            isCorrect = enteredValue == actualTotal;
        }

        FcLog(isCorrect, enteredValue.ToString());

        if (!isCorrect)
        {
            _fcRoundHasMistake = true;
            _fcMissCount++;
            _fcAnswerText = string.Empty;
            // Says what was entered (catches a typo). From the 2nd miss on
            // the same card: a hint -- the Ace reminder when there's an Ace,
            // otherwise a pointer to Reveal.
            _fcFeedbackText = _fcMissCount < 2
                ? $"INCORRECT \u2014 not {enteredValue}. Try again."
                : _fcHand.HasAce
                    ? $"Not {enteredValue}. An Ace counts as 1 or 11."
                    : $"Not {enteredValue}. Recount, or tap Reveal.";
            _fcFeedbackColor = "txt-bad";
            return;
        }

        string msg = actualBlackjack
            ? "CORRECT \u2014 Blackjack!"
            : actualBust
                ? $"CORRECT \u2014 BUST ({actualTotal})"
                : _fcHand.IsSoft
                    ? $"CORRECT \u2014 {actualTotal} soft ({_fcHand.HardTotal} hard)"
                    : $"CORRECT \u2014 {actualTotal} (hard)";

        await FcAdvance(msg, "txt-ok");
    }

    // Reveal button: show the answer in a pop-up and count the hand as a miss
    private bool _fcShowReveal;

    private void FcReveal()
    {
        if (!_fcSubmitEnabled) return;
        FcLog(false, "Revealed");
        _fcRoundHasMistake = true;
        _fcShowReveal = true;
    }

    // Session summary: the first answer on each card counts -- by type
    // (hard / soft / bust), and a miss shows the cards and the total
    private bool _fcCardLogged;

    private void FcLog(bool ok, string you)
    {
        if (_fcCardLogged) return;
        _fcCardLogged = true;

        string part = _fcHand.IsBust ? "Busts" : _fcHand.IsSoft ? "Soft totals" : "Hard totals";
        _log.Part(part, ok);
        if (ok) return;

        var cards = string.Join(" ", Enumerable.Range(0, _fcHand.Count)
            .Select(i => SideWagerPayouts.Short(_fcHand.CardAt(i))));
        string answer = _fcHand.IsBlackjack ? "21 (Blackjack)"
            : _fcHand.IsBust ? $"BUST ({_fcHand.Total})"
            : _fcHand.IsSoft ? $"{_fcHand.Total} soft ({_fcHand.HardTotal} hard)"
            : $"{_fcHand.Total}";
        _log.Miss(cards, "", you, answer);
    }

    // Closing the pop-up moves the hand on exactly as a right answer would
    // (next card, or the end of the hand), with the answer shown in red
    private async Task FcCloseReveal()
    {
        _fcShowReveal = false;

        string msg = _fcHand.IsBlackjack
            ? "REVEALED \u2014 21, Blackjack"
            : _fcHand.IsBust
                ? $"REVEALED \u2014 BUST ({_fcHand.Total})"
                : _fcHand.IsSoft
                    ? $"REVEALED \u2014 {_fcHand.Total} soft ({_fcHand.HardTotal} hard)"
                    : $"REVEALED \u2014 {_fcHand.Total}";

        await FcAdvance(msg, "txt-bad");
    }

    private string FcNextStepText =>
        _fcHand.IsBlackjack ? "Dealer has Blackjack."
        : _fcHand.IsBust ? "Over 21: the dealer busts."
        : _fcHand.MustHit(FcHitSoft17) ? "Dealer must hit."
        : "Dealer stands.";

    // After a right answer (or a Reveal): deal the dealer's next card, or
    // end the hand when the dealer has Blackjack, busts or stands
    private async Task FcAdvance(string feedback, string color)
    {
        bool actualBlackjack = _fcHand.IsBlackjack;
        bool actualBust = _fcHand.IsBust;

        _fcFeedbackText = feedback;
        _fcFeedbackColor = color;
        _fcMissCount = 0;
        _fcAnswerText = string.Empty;
        _fcAnswerEnabled = false;
        _fcSubmitEnabled = false;

        if (actualBlackjack)
        {
            await FcEndRound("Dealer has Blackjack. Press Next for the next hand.");
        }
        else if (actualBust)
        {
            await FcEndRound("Dealer busts. Press Next for the next hand.");
        }
        else if (_fcHand.MustHit(FcHitSoft17))
        {
            _fcHand.AddCard(_fcShoe.Draw());
            _fcCardLogged = false;
            _fcShowHint = _fcHand.HasAce;
            _fcPromptText = "Dealer hits. What's the new total?";
            _fcAnswerEnabled = true;
            _fcSubmitEnabled = true;
            _fcShouldFocusAnswer = true;
        }
        else
        {
            await FcEndRound("Dealer stands. Press Next for the next hand.");
        }
    }

    private async Task FcEndRound(string message)
    {
        _fcRoundsPlayed++;
        if (!_fcRoundHasMistake) _fcRoundsCorrect++;

        _fcPromptText = message;
        _fcNewRoundEnabled = true;
        StateHasChanged();

        await Task.Delay(200);
        _fcShouldFocusNewRound = true;
    }

    // ============================================================
    // PAYOUTS (Po prefix)
    // ============================================================

    private PayoutRatio _poRatio = PayoutRatio.ThreeToTwo;
    private PayoutDifficulty _poDifficulty = PayoutDifficulty.Beginner;

    private long _poWagerCents;
    private int _poCorrectCount;
    private int _poTotalRounds;

    private string _poAnswerText = string.Empty;
    private bool _poAnswerEnabled;
    private bool _poSubmitEnabled;
    private bool _poShowKeypad;
    private bool _poNewRoundEnabled;
    private string _poPromptText = string.Empty;
    private string _poPromptDetailText = string.Empty;
    private string _poYouText = string.Empty;   // "You entered $X." on a miss
    private bool _poIsCorrect;

    private Microsoft.AspNetCore.Components.ElementReference _poAnswerInputRef;
    private Microsoft.AspNetCore.Components.ElementReference _poNewRoundButtonRef;
    private bool _poShouldFocusAnswer;
    private bool _poShouldFocusNewRound;

    private void PoStartGame()
    {
        _poCorrectCount = 0;
        _poTotalRounds = 0;
        PoStartNewRound();
    }

    private void PoStartNewRound()
    {
        _poWagerCents = PayoutWager.GenerateWagerCents(_poRatio, _poDifficulty);

        _poPromptText = string.Empty;
        _poPromptDetailText = string.Empty;
        _poYouText = string.Empty;
        _poAnswerText = string.Empty;

        _poNewRoundEnabled = false;
        _poAnswerEnabled = true;
        _poSubmitEnabled = true;
        _poShouldFocusAnswer = true;
    }

    private void PoHandleAnswerInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        string raw = e.Value?.ToString() ?? string.Empty;
        System.Text.StringBuilder filtered = new();
        bool hasDot = false;
        int decimalDigits = 0;

        foreach (char c in raw)
        {
            if (char.IsDigit(c))
            {
                if (!hasDot)
                {
                    filtered.Append(c);
                }
                else if (decimalDigits < 2)
                {
                    filtered.Append(c);
                    decimalDigits++;
                }
            }
            else if (c == '.' && !hasDot)
            {
                filtered.Append(c);
                hasDot = true;
            }
        }

        _poAnswerText = filtered.ToString();
    }

    private async Task PoHandleAnswerKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _poSubmitEnabled)
        {
            await PoSubmitTypedAnswer();
        }
    }

    // Keypad Enter key: submits the payout, or deals the next round once
    // this one has been scored.
    private async Task PoKeypadEnter()
    {
        if (_poSubmitEnabled)
        {
            await PoSubmitTypedAnswer();
        }
        else if (_poNewRoundEnabled)
        {
            PoStartNewRound();
        }
    }

    private async Task PoSubmitTypedAnswer()
    {
        string raw = _poAnswerText.Trim();

        if (raw.Length == 0)
        {
            _poPromptText = "Enter an amount before submitting.";
            _poIsCorrect = false;
            return;
        }

        long userCents = PayoutWager.ParseCents(raw);
        long correctCents = PayoutWager.CalculatePayoutCents(_poWagerCents, _poRatio);

        _poTotalRounds++;

        if (userCents == correctCents)
        {
            _poCorrectCount++;
            _poIsCorrect = true;
            _poPromptText = "CORRECT";
            _poPromptDetailText = PayoutWager.ExplainPayout(_poWagerCents, _poRatio);
        }
        else
        {
            _log.Miss(_poRatio == PayoutRatio.ThreeToTwo ? "Blackjack, 3 to 2" : "Blackjack, 6 to 5",
                PayoutWager.ExplainPayout(_poWagerCents, _poRatio),
                PayoutWager.FormatShort(userCents), PayoutWager.FormatShort(correctCents));
            _poIsCorrect = false;
            _poPromptText = $"INCORRECT \u2014 {BreakdownRow.FloorCall}";
            _poYouText = $"You entered {PayoutWager.FormatShort(userCents)}.";
            _poPromptDetailText = PayoutWager.ExplainPayout(_poWagerCents, _poRatio);
        }

        _poAnswerEnabled = false;
        _poSubmitEnabled = false;
        _poNewRoundEnabled = true;
        StateHasChanged();

        await Task.Delay(200);
        _poShouldFocusNewRound = true;
    }

    // ============================================================
    // SIDE WAGERS (Sw prefix): Call Only or Call & Pay
    // ============================================================

    private static readonly string[] SwNames = { "21 + 3", "Lucky Ladies" };

    // Start screen setting: false = Call Only, true = Call & Pay
    private bool _swPay;

    private SideWagerPayoutRound _swRound = SideWagerPayouts.Deal(Random.Shared, callAndPay: false);

    // Per wager ([0] = 21 + 3, [1] = Lucky Ladies): the call ("Win",
    // "Lose" or null = not called yet) and, Call & Pay, the payout entered
    private readonly string?[] _swCall = new string?[2];
    private readonly int?[] _swPaid = new int?[2];

    private int _swBox = -1;               // row whose payout box is open
    private string _swBoxText = string.Empty;
    private Microsoft.AspNetCore.Components.ElementReference _swBoxInputRef;
    private bool _swFocusBox;
    private DateTime _swEndBlockedUntil;

    private bool _swScored;
    private readonly bool[] _swOk = new bool[2];
    private readonly List<BreakdownRow> _swRows = new();
    private string _swResultText = string.Empty;
    private int _swPlayed;
    private int _swCorrect;

    private int SwWager(int i) => i == 0 ? _swRound.TwentyOnePlus3Wager : _swRound.LuckyLadiesWager;
    private int SwPayout(int i) => i == 0 ? _swRound.TwentyOnePlus3Payout : _swRound.LuckyLadiesPayout;
    private int SwWagersLeft => _swCall.Count(c => c is null);

    // The dealer peek (house procedure): when the house peeks, the hole
    // card stays face down until the trainee calls a supervisor.
    // _swPeeked: approved and turned over. _swLlBeforePeek: Lucky Ladies
    // was called before the supervisor -- a miss on that row.
    private bool _swPeeked;
    private bool _swLlBeforePeek;

    private void SwCallSupervisor()
    {
        if (_swScored) return;
        _swPeeked = true;
    }

    // Button / answer-box text once a payout is in, e.g. "Win $30"
    private string? SwPickedText(int i) =>
        _swPaid[i] is int v && _swCall[i] == "Win" ? $"Win ${v:N0}" : null;

    private void SwStartGame()
    {
        _swPlayed = 0;
        _swCorrect = 0;
        SwNewRound();
    }

    // Both ways deal from a 6-deck shoe with real-world wager amounts.
    // Call Only: the natural mix (most hands lose both); Call & Pay: every
    // hand wins at least one wager.
    private void SwNewRound()
    {
        _swRound = SideWagerPayouts.Deal(Random.Shared, callAndPay: _swPay);
        _swPeeked = false;
        _swLlBeforePeek = false;
        for (int i = 0; i < 2; i++)
        {
            _swCall[i] = null;
            _swPaid[i] = null;
            _swOk[i] = false;
        }
        _swBox = -1;
        _swBoxText = string.Empty;
        _swScored = false;
        _swRows.Clear();
        _swResultText = string.Empty;
    }

    private void SwPick(int i, string key)
    {
        if (_swScored) return;

        // Lucky Ladies called before the supervisor approved the peek
        if (i == 1 && _swRound.PeekNeeded && !_swPeeked) _swLlBeforePeek = true;

        // Call & Pay: Win opens the payout box
        if (_swPay && key == "Win")
        {
            _swCall[i] = null;
            _swPaid[i] = null;
            _swBox = i;
            _swBoxText = string.Empty;
            _swFocusBox = true;
            _scrollToTopAfterNext = true;
            return;
        }

        _swCall[i] = key;
        _swPaid[i] = null;
    }

    // ---- Payout box ----

    private string SwBoxText
    {
        get => _swBoxText;
        set => _swBoxText = SwDigitsOnly(value);
    }

    // Whole dollars, at most 5 digits (the top pay is $50,000); no
    // leading zeros, but a lone 0 stays (0 = Lose)
    private static string SwDigitsOnly(string? raw)
    {
        System.Text.StringBuilder sb = new();
        foreach (char c in raw ?? string.Empty)
        {
            if (char.IsDigit(c) && sb.Length < 5) sb.Append(c);
        }
        string digits = sb.ToString().TrimStart('0');
        return digits.Length == 0 && sb.Length > 0 ? "0" : digits;
    }

    private void SwBoxInput(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _swBoxText = SwDigitsOnly(e.Value?.ToString());

    private void SwBoxKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SwBoxEnter();
        else if (e.Key == "Escape") SwBoxCancel();
    }

    // Enter: the amount goes on the row and the box closes; 0 counts as Lose
    private void SwBoxEnter()
    {
        if (_swBox < 0 || _swBoxText.Length == 0) return;

        int i = _swBox;
        int amount = int.Parse(_swBoxText);
        _swCall[i] = amount == 0 ? "Lose" : "Win";
        _swPaid[i] = amount == 0 ? null : amount;
        SwCloseBox();
    }

    // Cancel: the row goes back to Call (no penalty)
    private void SwBoxCancel()
    {
        if (_swBox < 0) return;
        _swCall[_swBox] = null;
        _swPaid[_swBox] = null;
        SwCloseBox();
    }

    private void SwCloseBox()
    {
        _swBox = -1;
        _swBoxText = string.Empty;
        _swEndBlockedUntil = DateTime.UtcNow.AddMilliseconds(500);
    }

    // ---- Submit ----

    private void SwSubmitAndShow()
    {
        SwSubmit();
        if (_swScored) _scrollToFeedback = true;
    }

    private void SwSubmit()
    {
        if (_swScored || _swBox >= 0 || SwWagersLeft > 0) return;

        _swRows.Clear();
        string[] why = { SideWagerPayouts.Why21Plus3(_swRound), SideWagerPayouts.WhyLuckyLadies(_swRound) };
        for (int i = 0; i < 2; i++)
        {
            int payout = SwPayout(i);
            bool wins = payout > 0;
            _swOk[i] = _swCall[i] switch
            {
                "Lose" => !wins,
                "Win" => wins && (!_swPay || _swPaid[i] == payout),
                _ => false
            };
            string reason = why[i];
            if (i == 1 && _swLlBeforePeek)
            {
                _swOk[i] = false;
                reason = "Call a supervisor first: the peek needs approval before Lucky Ladies is settled. " + reason;
            }

            // Call & Pay: a missed payout gets its shortcut
            string tip = _swPay && !_swOk[i] && wins ? PayoutShortcut.For(SwWager(i) * 100L, payout * 100L) : "";
            _swRows.Add(new BreakdownRow(SwNames[i], SwYouText(i), SwAnswerText(i), _swOk[i], reason, tip));
        }

        _log.AddRows(_swRows);
        _swPlayed++;
        if (_swOk[0] && _swOk[1]) _swCorrect++;
        _swResultText = BreakdownRow.Summary(_swRows);
        _swScored = true;
    }

    // In the breakdown: "Win", "Lose" or (Call & Pay) "$150"
    private string SwYouText(int i) =>
        _swPaid[i] is int v && _swCall[i] == "Win" ? $"${v:N0}" : _swCall[i] ?? "";

    // The right answer on a missed row: "Win" / "Lose", "$150", or
    // "Supervisor first" (Lucky Ladies called before the peek)
    private string SwAnswerText(int i)
    {
        // Lucky Ladies called before the peek was approved
        if (i == 1 && _swLlBeforePeek) return "Supervisor first";
        int payout = SwPayout(i);
        if (payout == 0) return "Lose";
        return _swPay ? SideWagerPayouts.Money(payout) : "Win";
    }

    private void SwNextTop()
    {
        SwNewRound();
        _scrollToTopAfterNext = true;
    }

    // Scroll back to the top whenever this game switches between its
    // start screen and its play screen (Start, Back, menu, End Session).
    // Without this the browser keeps the old scroll position -- after
    // scrolling down to reach Start, the game would open scrolled down.
    private bool _lastRenderedStarted;

    private bool _scrollToSummary;

    private bool _scrollToFeedback;
    private bool _scrollToTopAfterNext;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Submit: bring the feedback box into view (if it isn't already).
        // Next: back to the top for the new hand.
        if (_scrollToFeedback)
        {
            _scrollToFeedback = false;
            try { await JS.InvokeVoidAsync("dstRevealFeedback"); } catch { }
        }

        if (_scrollToTopAfterNext)
        {
            _scrollToTopAfterNext = false;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }
        }

        // End Session: bring the Session Summary into view (it's at the
        // bottom of the page, often below the screen on a phone)
        if (_scrollToSummary && _showSessionSummary)
        {
            _scrollToSummary = false;
            try { await JS.InvokeVoidAsync("dstScrollToEl", ".session-summary"); } catch { }
        }

        if (_started != _lastRenderedStarted)
        {
            _lastRenderedStarted = _started;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }

            // Desktop: open the number pad straight away when the window
            // is tall enough for it (123 still hides / shows it)
            if (_started && _mode != BlackjackMode.SideWagers)
            {
                bool fits = false;
                try { fits = await JS.InvokeAsync<bool>("dstKeypadFits", _mode == BlackjackMode.FlashCards ? 260 : 315); } catch { }
                if (_mode == BlackjackMode.FlashCards) _fcShowKeypad = fits;
                else _poShowKeypad = fits;
                if (fits) StateHasChanged();
            }
        }

        // preventScroll: true -- moving the cursor into the answer box (or
        // onto New Round) must not scroll the page to that element
        if (_fcShouldFocusAnswer)
        {
            _fcShouldFocusAnswer = false;
            try { await _fcAnswerInputRef.FocusAsync(preventScroll: true); } catch { }
        }

        if (_fcShouldFocusNewRound)
        {
            _fcShouldFocusNewRound = false;
            try { await _fcNewRoundButtonRef.FocusAsync(preventScroll: true); } catch { }
        }

        if (_poShouldFocusAnswer)
        {
            _poShouldFocusAnswer = false;
            try { await _poAnswerInputRef.FocusAsync(preventScroll: true); } catch { }
        }

        if (_poShouldFocusNewRound)
        {
            _poShouldFocusNewRound = false;
            try { await _poNewRoundButtonRef.FocusAsync(preventScroll: true); } catch { }
        }

        // Side Wagers: the cursor into an open payout box (a computer
        // keyboard types there)
        if (_swFocusBox && _swBox >= 0)
        {
            _swFocusBox = false;
            try { await _swBoxInputRef.FocusAsync(preventScroll: true); } catch { }
        }
    }
}
