@page "/about"
@using System.Reflection
@inject IJSRuntime JS

<PageTitle>About - Dealer School Trainer</PageTitle>

<h1>About</h1>

<div class="mode-card narrow-card">
    <p>The Dealer School Trainer was created to give dealers in training a way to practice key skills and procedures outside of live training sessions.</p>

    <p>Games and procedures vary from casino to casino. Always follow the policies and procedures established by the property hosting your training.</p>

    <p>Special Thanks to:</p>

    <p>
        Jesse<br />
        Caryn<br />
        Nick
    </p>

    <p>for all the work on this project.</p>
</div>

@* Version = when this copy of the trainer was built (stamped by the
   build, see DealerSchoolTrainerWeb.csproj). Reload Latest Version
   fetches the newest publish without waiting for the browser's saved
   copy to expire (dstReloadLatest in index.html). *@
<div class="mode-card about-version narrow-card">
    <p class="about-version-line">Version: <strong>@_version</strong></p>

    <button type="button" class="mode-start" disabled="@_reloading" @onclick="ReloadLatest">
        @(_reloading ? "Loading..." : "Reload Latest Version")
    </button>

    <p class="about-version-note">Loads the newest version of the trainer. Your saved Challenge scores are kept. A new update takes a couple of minutes to appear after it's published.</p>
</div>

@code {
    private string _version = "unknown";
    private bool _reloading;

    protected override void OnInitialized()
    {
        string? stamp = typeof(About).Assembly
            .GetCustomAttributes<AssemblyMetadataAttribute>()
            .FirstOrDefault(a => a.Key == "BuildTimeUtc")?.Value;

        if (DateTime.TryParse(stamp, null, System.Globalization.DateTimeStyles.RoundtripKind, out DateTime builtUtc))
            _version = builtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt");
    }

    private async Task ReloadLatest()
    {
        _reloading = true;
        try
        {
            await JS.InvokeVoidAsync("dstReloadLatest");
        }
        catch
        {
            _reloading = false;
        }
    }
}
