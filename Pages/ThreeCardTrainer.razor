@page "/three-card-trainer"
@using Microsoft.AspNetCore.Components
@using DealerSchoolTrainerWeb.Core
@using DealerSchoolTrainerWeb.Games.ThreeCardTrainer
@implements IDisposable
@inject GameResetService GameReset
@inject IJSRuntime JS

<PageTitle>Three Card Prime</PageTitle>

@if (!_started)
{
    <div class="start-screen">
        <h1>THREE CARD PRIME</h1>

        @* A single mode, so its card is always open (no title to tap);
           styled like the other games' start screens for consistency. *@
        <div class="mode-list">
            <ModeCard Title="Three Card Prime"
                      Description="Settle the outcome of each wager (Win / Lose / Push), mark Ante Bonus if it pays, then Submit."
                      Collapsible="false"
                      OnStart="StartGame">
                @* Phones only: which screen edge the slide-out wager panel
                   comes from. Remembered on this device. *@
                <div class="mode-options tcp-panel-setting">
                    <div class="mode-option-group">
                        <p class="mode-option-label">Wager panel (phones)</p>
                        <label class="mode-choice">
                            <input type="radio" name="tcpPanelSide" checked="@(!_panelRight)" @onchange="() => SetPanelSide(false)" />
                            Bottom
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="tcpPanelSide" checked="@_panelRight" @onchange="() => SetPanelSide(true)" />
                            Right
                        </label>
                    </div>
                </div>
            </ModeCard>
        </div>
    </div>
}
else
{
    <div class="play-screen tcp-play @(_panelRight ? "tcp-panel-right" : "tcp-panel-bottom")">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <div class="tcp-table">
            <div class="tcp-hands">
                <h3>Player</h3>
                <div class="card-row">
                    @foreach (Card c in _playerCards)
                    {
                        <img src="images/cards/@(c.Code).png" alt="@c.Code" class="game-card" />
                    }
                </div>

                <p style="font-weight: bold;">DEALER PLAYS WITH A QUEEN OR BETTER</p>

                <h3>Dealer</h3>
                <div class="card-row">
                    @foreach (Card c in _dealerCards)
                    {
                        <img src="images/cards/@(c.Code).png" alt="@c.Code" class="game-card" />
                    }
                </div>
            </div>

            <div class="tcp-wagers">
                @RenderWager(_play)

                <!-- The Ante shape's box is kept at a fixed 90px width,
                     matching its actual size, so the outer column centers
                     it identically to Play/Pair Bonus above/below --
                     otherwise the checkbox's extra width would get
                     included in what's being centered and visibly shift
                     the diamond itself to the left. The checkbox is
                     positioned as an absolute overlay outside that box
                     instead, so it never factors into the centering. -->
                <div style="position: relative; width: 90px;">
                    @RenderWager(_ante)
                    <label class="ante-bonus-label" style="position: absolute; left: 100%; top: 50%; transform: translateY(-50%); margin-left: 0.75rem; white-space: nowrap; @(_anteBonusWrong ? "background-color: #f8d0d0;" : "")">
                        <input type="checkbox" @bind="_anteBonusChecked" @bind:after="() => _anteBonusWrong = false" />
                        Ante Bonus
                    </label>
                </div>

                @RenderWager(_pairBonus)
                <div class="tcp-wager-pair">
                    @RenderWager(_allSix)
                    @RenderWager(_prime)
                </div>
            </div>
        </div>

        <div class="feedback-area">
            <p style="font-weight: bold; color: @(_isCorrect ? "blue" : "red");">@_resultText</p>
            <p>@_scoreText</p>
        </div>

        @* Phones: Submit / Deal live in the wager panel, so this row keeps
           only End Session there *@
        <div class="button-row">
            <button class="tcp-main-action" @onclick="SubmitRound" disabled="@(!_submitEnabled)">Submit</button>
            <button class="tcp-main-action" @onclick="DealAgain" disabled="@(!_dealEnabled)">Deal</button>
            <button @onclick="EndSession">End Session</button>
        </div>

        @* Phones only (hidden on desktop by CSS): slide-out wager panel,
           anchored to the bottom or right edge per the start-screen
           setting. Tap the Wagers handle (or swipe it) to open/close. Each
           wager is a row of Win / Lose (/ Push) buttons, then Ante Bonus,
           then Submit / Deal and the result. *@
        <div class="tcp-panel @(_panelOpen ? "tcp-panel-open" : "")">
            <button class="tcp-panel-handle" aria-expanded="@(_panelOpen ? "true" : "false")"
                    @onclick="TogglePanel"
                    @ontouchstart="PanelTouchStart" @ontouchend="PanelTouchEnd">
                <span class="tcp-panel-grip" aria-hidden="true"></span>
                <span class="tcp-panel-handle-text">Wagers</span>
            </button>

            <div class="tcp-panel-body">
                @* One tile per wager, top to bottom in settling order. Tap a
                   tile to cycle Win / Lose (/ Push); the whole tile fills with
                   the result color. Ante Bonus is a chip inside the Ante tile.
                   After Submit: a check on right calls; on a wrong call, a
                   heavy red outline and the actual result. *@
                <div class="wt-list">
                    @foreach (WagerState w in PanelOrder)
                    {
                        WagerState wager = w;
                        <div class="wt @TileClass(wager) @(_roundScored && wager.Wrong ? "wt-wrong" : "") @(_roundScored ? "wt-locked" : "")"
                             role="button" aria-label="@wager.Name"
                             @onclick="() => TapTile(wager)">
                            <span class="wt-left">
                                @wager.Name
                                @if (wager == _ante)
                                {
                                    <button type="button" class="wt-bonus @(_anteBonusChecked ? "on" : "") @(_anteBonusWrong ? "wt-bonus-wrong" : "")"
                                            aria-pressed="@(_anteBonusChecked ? "true" : "false")"
                                            disabled="@_roundScored"
                                            @onclick="ToggleAnteBonus" @onclick:stopPropagation="true">Ante Bonus@(_anteBonusChecked ? " \u2713" : "")</button>
                                }
                            </span>
                            <span class="wt-state">@TileStateText(wager)</span>
                        </div>
                    }
                </div>

                @if (_resultText.Length > 0)
                {
                    <p class="tcp-panel-result" style="color: @(_isCorrect ? "blue" : "red");">@_resultText &middot; @_scoreText</p>
                }

                <div class="tcp-panel-actions">
                    @if (!_roundScored)
                    {
                        <button class="tcp-panel-primary" @onclick="SubmitRound">Submit</button>
                    }
                    else
                    {
                        <button class="tcp-panel-primary" @onclick="DealAgain">Deal</button>
                    }
                </div>
            </div>
        </div>

        @* Reference chart toggle kept at the bottom, out of the way *@
        <div class="button-row rules-row">
            <button @onclick="() => _showWagerRules = !_showWagerRules">@(_showWagerRules ? "Hide" : "Show") Wager Rules</button>
        </div>

        @if (_showWagerRules)
        {
            <div style="margin: 1rem 0;">
                <img src="images/cards/ThreeCardWagerRules.png" alt="Three Card Prime Wager Rules" style="max-width: 500px; width: 100%;" />
            </div>
        }
    </div>
}

@if (_showSessionSummary)
{
    <div class="session-summary">
        <h3>Session Summary</h3>
        <p>Rounds Played: @_totalRounds</p>
        <p>Correct: @_correctCount</p>
        <p>Incorrect: @(_totalRounds - _correctCount)</p>
        <button @onclick="CloseSummary">OK</button>
    </div>
}

@code {
    // Menu link for this game tapped while it's already open: return to
    // the start screen, same as the Back button (hidden on phones).
    protected override void OnInitialized()
    {
        GameReset.ResetRequested += OnResetRequested;
    }

    private void OnResetRequested()
    {
        _showSessionSummary = false;
        _started = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameReset.ResetRequested -= OnResetRequested;
    }

    // Scroll back to the top whenever this game switches between its
    // start screen and its play screen (Start, Back, menu, End Session).
    // Without this the browser keeps the old scroll position -- after
    // scrolling down to reach Start, the game would open scrolled down.
    private bool _lastRenderedStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_started != _lastRenderedStarted)
        {
            _lastRenderedStarted = _started;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }
        }
    }

    private sealed class WagerState
    {
        public required string Name;
        public bool IsDiamond;
        public bool AllowPush;
        public WagerOutcome? Selection;
        public bool Wrong;
        public WagerOutcome? Actual; // set at Submit, to outline the right answer when the call was wrong
    }

    private bool _started;

    private Deck _deck = new();
    private Card[] _playerCards = Array.Empty<Card>();
    private Card[] _dealerCards = Array.Empty<Card>();

    private readonly WagerState _play = new() { Name = "Play", IsDiamond = true, AllowPush = true };
    private readonly WagerState _ante = new() { Name = "Ante", IsDiamond = true, AllowPush = true };
    private readonly WagerState _pairBonus = new() { Name = "Pair Bonus", AllowPush = false };
    private readonly WagerState _prime = new() { Name = "Prime", AllowPush = false };
    private readonly WagerState _allSix = new() { Name = "All 6", AllowPush = false };

    private int _correctCount;
    private int _totalRounds;
    private bool _roundScored;
    private bool _anteBonusChecked;
    private bool _anteBonusWrong;

    private bool _submitEnabled;
    private bool _dealEnabled;
    private string _resultText = string.Empty;
    private bool _isCorrect;
    private string _scoreText = "Score: 0 / 0 (0.0%)";
    private bool _showSessionSummary;
    private bool _showWagerRules;

    // Phones: slide-out wager panel. _panelRight = anchored to the right
    // edge (else bottom); saved on this device under PanelSideKey.
    private const string PanelSideKey = "tcpPanelSide";
    private bool _panelRight;
    private bool _panelOpen;
    private double _touchStartX;
    private double _touchStartY;

    // Panel tiles in settling order, top to bottom
    private WagerState[] PanelOrder => new[] { _play, _ante, _pairBonus, _prime, _allSix };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            string? side = await JS.InvokeAsync<string?>("localStorage.getItem", PanelSideKey);
            _panelRight = side == "right";
        }
        catch { }
    }

    private async Task SetPanelSide(bool right)
    {
        _panelRight = right;
        try { await JS.InvokeVoidAsync("localStorage.setItem", PanelSideKey, right ? "right" : "bottom"); } catch { }
    }

    private void TogglePanel() => _panelOpen = !_panelOpen;

    private void PanelTouchStart(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length == 0) return;
        _touchStartX = e.ChangedTouches[0].ClientX;
        _touchStartY = e.ChangedTouches[0].ClientY;
    }

    // Swipe toward the screen's middle opens, toward the edge closes:
    // up/down for the bottom panel, left/right for the right panel. (A
    // swipe doesn't also produce a click, so it never double-toggles.)
    private void PanelTouchEnd(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length == 0) return;
        double dx = e.ChangedTouches[0].ClientX - _touchStartX;
        double dy = e.ChangedTouches[0].ClientY - _touchStartY;
        double d = _panelRight ? -dx : -dy; // positive = toward the middle
        if (Math.Abs(d) < 30) return;       // a tap, not a swipe
        _panelOpen = d > 0;
    }

    private void TapTile(WagerState w)
    {
        if (_roundScored) return;
        CycleWager(w);
    }

    private void ToggleAnteBonus()
    {
        if (_roundScored) return;
        _anteBonusChecked = !_anteBonusChecked;
        _anteBonusWrong = false;
    }

    private static string TileClass(WagerState w) => w.Selection switch
    {
        WagerOutcome.Win => "win",
        WagerOutcome.Lose => "lose",
        WagerOutcome.Push => "push",
        _ => ""
    };

    private string TileStateText(WagerState w)
    {
        if (w.Selection is null) return "Tap to settle";
        string picked = PillText(w.Selection);
        if (!_roundScored) return picked;
        return w.Wrong ? $"{picked} \u2717 actually {PillText(w.Actual)}" : $"{picked} \u2713";
    }

    private void StartGame()
    {
        _started = true;
        _correctCount = 0;
        _totalRounds = 0;
        _scoreText = "Score: 0 / 0 (0.0%)";

        DealNewRound();
    }

    private void BackToStart() => _started = false;

    private void DealNewRound()
    {
        _dealEnabled = false;

        _deck = new Deck();
        _deck.Shuffle();

        _playerCards = new[] { _deck.Draw(), _deck.Draw(), _deck.Draw() };
        _dealerCards = new[] { _deck.Draw(), _deck.Draw(), _deck.Draw() };

        SortDescending(_playerCards);
        SortDescending(_dealerCards);

        foreach (WagerState w in new[] { _play, _ante, _pairBonus, _prime, _allSix })
        {
            w.Selection = null;
            w.Wrong = false;
            w.Actual = null;
        }

        _anteBonusChecked = false;
        _anteBonusWrong = false;

        _resultText = string.Empty;
        _roundScored = false;
        _submitEnabled = true;
    }

    private void DealAgain() => DealNewRound();

    // Groups a pair or trips together ahead of an unrelated kicker, e.g.
    // a pair of 7s with a Ten kicker displays as 7,7,T -- not the Ten
    // first, even though a Ten outranks a 7 in plain high-to-low order.
    // Applies to both the player's and dealer's cards, since this same
    // method sorts both.
    private static void SortDescending(Card[] cards)
    {
        Dictionary<int, int> rankCounts = new();
        foreach (Card c in cards)
        {
            int rank = (int)c.Rank;
            rankCounts[rank] = rankCounts.GetValueOrDefault(rank) + 1;
        }

        Array.Sort(cards, (a, b) =>
        {
            int countA = rankCounts[(int)a.Rank];
            int countB = rankCounts[(int)b.Rank];
            if (countA != countB) return countB.CompareTo(countA); // higher count (pair/trips) first

            return ((int)b.Rank).CompareTo((int)a.Rank); // then higher rank first
        });
    }

    private void CycleWager(WagerState w)
    {
        if (w.AllowPush)
        {
            w.Selection = w.Selection switch
            {
                null => WagerOutcome.Win,
                WagerOutcome.Win => WagerOutcome.Lose,
                WagerOutcome.Lose => WagerOutcome.Push,
                _ => WagerOutcome.Win
            };
        }
        else
        {
            w.Selection = w.Selection switch
            {
                null => WagerOutcome.Win,
                WagerOutcome.Win => WagerOutcome.Lose,
                _ => WagerOutcome.Win
            };
        }

        w.Wrong = false;
    }

    private void SubmitRound()
    {
        WagerState[] all = { _play, _ante, _pairBonus, _prime, _allSix };

        foreach (WagerState w in all)
        {
            if (w.Selection is null)
            {
                _resultText = "Tap every wager to select an outcome before submitting.";
                _isCorrect = false;
                return;
            }
        }

        if (_roundScored) return;

        (WagerOutcome anteOutcome, WagerOutcome playOutcome) = ThreeCardEvaluator.ResolveAntePlay(_playerCards, _dealerCards);
        WagerOutcome pairPlusOutcome = ThreeCardEvaluator.ResolvePairPlus(_playerCards);
        WagerOutcome primeOutcome = ThreeCardEvaluator.ResolvePrime(_playerCards, _dealerCards);
        WagerOutcome allSixOutcome = ThreeCardEvaluator.ResolveAllSix(_playerCards, _dealerCards);

        bool allCorrect = true;
        allCorrect &= GradeWager(_play, playOutcome);
        allCorrect &= GradeWager(_ante, anteOutcome);
        allCorrect &= GradeWager(_pairBonus, pairPlusOutcome);
        allCorrect &= GradeWager(_prime, primeOutcome);
        allCorrect &= GradeWager(_allSix, allSixOutcome);

        bool anteBonusActual = ThreeCardEvaluator.QualifiesAnteBonus(_playerCards);
        if (_anteBonusChecked == anteBonusActual)
        {
            _anteBonusWrong = false;
        }
        else
        {
            _anteBonusWrong = true;
            allCorrect = false;
        }

        _totalRounds++;
        if (allCorrect) _correctCount++;

        _isCorrect = allCorrect;
        _resultText = allCorrect ? "CORRECT" : "INCORRECT";

        string pct = _totalRounds > 0
            ? ((double)_correctCount / _totalRounds).ToString("0.0%")
            : "0.0%";
        _scoreText = $"Score: {_correctCount} / {_totalRounds} ({pct})";

        _roundScored = true;
        _submitEnabled = false;
        _dealEnabled = true;
    }

    private static bool GradeWager(WagerState w, WagerOutcome actual)
    {
        w.Actual = actual;
        if (w.Selection == actual)
        {
            w.Wrong = false;
            return true;
        }

        w.Wrong = true;
        return false;
    }

    private void EndSession()
    {
        if (_totalRounds > 0)
        {
            _showSessionSummary = true;
        }
        else
        {
            _started = false;
        }
    }

    private void CloseSummary()
    {
        _showSessionSummary = false;
        _started = false;
    }

    private RenderFragment RenderWager(WagerState w) =>
        @<div class="wager-shape @(w.IsDiamond ? "" : "wager-circle") @(w.Wrong && !w.IsDiamond ? "wager-wrong" : "") @(_roundScored && w.Wrong && !w.IsDiamond ? "wager-shaded-wrong" : "")"
              @onclick="() => CycleWager(w)">
            @if (w.IsDiamond)
            {
                <svg viewBox="0 0 90 90" class="wager-diamond-svg">
                    <polygon points="45,3 87,45 45,87 3,45" fill="@(_roundScored && w.Wrong ? "#f8d0d0" : "white")" stroke="@(w.Wrong ? "black" : "#999")" stroke-width="@(w.Wrong ? 3 : 1)" />
                </svg>
            }
            <span class="wager-label">@w.Name</span>
            @if (w.Selection is not null)
            {
                <div class="wager-pill @PillClass(w.Selection)">@PillText(w.Selection)</div>
            }
        </div>;

    private static string PillClass(WagerOutcome? outcome) => outcome switch
    {
        WagerOutcome.Win => "pill-win",
        WagerOutcome.Lose => "pill-lose",
        WagerOutcome.Push => "pill-push",
        _ => ""
    };

    private static string PillText(WagerOutcome? outcome) => outcome switch
    {
        WagerOutcome.Win => "WIN",
        WagerOutcome.Lose => "LOSE",
        WagerOutcome.Push => "PUSH",
        _ => ""
    };
}
