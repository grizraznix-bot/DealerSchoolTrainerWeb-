@page "/three-card-trainer"
@using Microsoft.AspNetCore.Components
@using DealerSchoolTrainerWeb.Core
@using DealerSchoolTrainerWeb.Games.ThreeCardTrainer
@implements IDisposable
@inject GameResetService GameReset
@inject IJSRuntime JS

<PageTitle>Three Card Prime</PageTitle>

@if (!_started)
{
    <div class="start-screen">
        <h1>THREE CARD PRIME</h1>

        @* One mode, played Call Only (the default) or Call & Pay (winning
           bonus wagers are also paid) *@
        <div class="mode-list">
            <ModeCard Title="Three Card Prime" Collapsible="false"
                      Description="Both hands are dealt. Settle each wager in order, then Submit."
                      OnStart="StartGame">
                <PayoutChoice @bind-Pay="_pay" />
            </ModeCard>
        </div>
    </div>
}
else
{
    @* Dealer and player hands, then one row per wager in settling order
       (Play, Ante, Pair Bonus, Prime, All 6), each with a Call button.
       Payouts on: calling Win on a bonus wager (Pay on the Ante) opens
       that row's payout box with the number pad; the other rows hide
       until Enter (or Cancel) closes it. *@
    <div class="play-screen sp-screen tp-screen has-game-bar @(_pay ? "" : "cr-screen") @(_box >= 0 ? "uc-open" : "")">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Three Card Prime" Correct="_correct" Played="_played" />

        @* Payouts on: hand names and whether the dealer qualifies are shown
           (paying is the skill). Call only: no hand names -- that's the answer.
           Tap a hand (🔍 beside its label) to see its cards enlarged. *@
        <div class="felt tp-felt">
            <div class="tp-hand hz-tap @(_zoom == 1 ? "hz-on" : "")" role="button" @onclick="() => _zoom = 1">
                <div class="sp-cap">DEALER@(_pay ? $" · {_round.DealerHand}" : "")<span class="hz-mag" aria-hidden="true"></span></div>
                <div class="tp-cards">
                    @foreach (Card c in _round.DealerCards)
                    {
                        <img src="images/cards/@(c.Code).png" alt="@c.Name" class="tp-card" />
                    }
                </div>
                @if (_pay)
                {
                    <span class="tp-qtag @(_round.DealerQualifies ? "" : "tp-qtag-no")">@(_round.DealerQualifies ? "QUALIFIES" : "DOESN'T QUALIFY")</span>
                }
            </div>
            <div class="tp-hand tp-hand-player hz-tap @(_zoom == 2 ? "hz-on" : "")" role="button" @onclick="() => _zoom = 2">
                <div class="sp-cap">PLAYER@(_pay ? $" · {_round.PlayerHand}" : "")<span class="hz-mag" aria-hidden="true"></span></div>
                <div class="tp-cards">
                    @foreach (Card c in _round.PlayerCards)
                    {
                        <img src="images/cards/@(c.Code).png" alt="@c.Name" class="tp-card" />
                    }
                </div>
            </div>
        </div>

        <div class="sp-wagers">
            @for (int w = 0; w < 5; w++)
            {
                int wi = w;
                int wager = _round.Wagers[wi];

                @if (_box >= 0 && wi != _box)
                {
                    continue;
                }

                @if (wi == _box)
                {
                    @* The open payout box: chip, name, amount. Phones type with
                       the number pad below (inputmode none keeps the phone's
                       keyboard away); a computer keyboard types straight in,
                       Enter confirms, Esc cancels. *@
                    <div class="sp-wrow uc-boxrow">
                        <div class="sp-chip @CallRow.ChipCss(wager)">$@wager</div>
                        <div class="sp-wname">@TcpPayoutRound.Names[wi]<small>wager $@wager</small></div>
                        <label class="uc-amt">
                            <span class="uc-dollar">$</span>
                            <input type="text"
                                   inputmode="none"
                                   autocomplete="off"
                                   aria-label="@($"{TcpPayoutRound.Names[wi]} payout")"
                                   placeholder="Payout"
                                   value="@_boxText"
                                   @oninput="BoxInput"
                                   @onkeydown="BoxKeyDown"
                                   @ref="_boxInputRef" />
                        </label>
                    </div>
                    continue;
                }

                <CallRow Chip="@(!_pay)" ChipAmount="@(_pay ? wager : null)"
                         Name="@TcpPayoutRound.Names[wi]"
                         Sub="@(_pay ? $"wager ${wager}" : null)"
                         Options="@OptionsFor(wi)"
                         Value="@_call[wi]"
                         PickedText="@PickedText(wi)"
                         OnPick="k => Pick(wi, k)"
                         YouSuffix="@(!_pay && wi == TcpPayoutRound.Ante && _bonus ? " + Bonus" : "")"
                         Locked="_scored" Wrong="!_ok[wi]" AnswerText="@AnswerText(wi)">
                    @if (!_pay && wi == TcpPayoutRound.Ante && !_scored)
                    {
                        <button type="button" class="cr-bonus @(_bonus ? "cr-bonus-on" : "")"
                                aria-pressed="@(_bonus ? "true" : "false")"
                                @onclick="ToggleBonus">+ Bonus</button>
                    }
                </CallRow>
            }
        </div>

        @if (_box >= 0)
        {
            <div class="uc-keypad">
                <NumericKeypad AllowDecimal="false" @bind-Value="BoxText" OnEnter="BoxEnter" EnterLabel="Enter" EnterDisabled="@(_boxText.Length == 0)" />
            </div>
        }
        else if (_played == 0 && !_scored)
        {
            @* First round only: what to do *@
            <p class="cr-howto">@(_pay
                ? "Tap Call on each wager. Win on a bonus wager (Pay on the Ante) opens its payout box."
                : "Tap Call on each wager and pick Win, Lose or Push. Tap + Bonus if the Ante Bonus pays.")</p>
        }

        <div class="feedback-area sp-feedback">
            @if (_scored)
            {
                <ResultBreakdown ResultText="@_resultText" IsCorrect="_ok.All(o => o)" Rows="_rows" />
            }
        </div>

        @if (_pay)
        {
            @* Desktop: pay tables always in view (phones: in Help) *@
            <aside class="sp-paytable tp-paytable">
                <table class="sp-pt">
                    <tr class="sp-pt-hd"><td colspan="2">Play &amp; Ante</td></tr>
                    <tr><td>Player wins</td><td>1 to 1</td></tr>
                    <tr><td>Tie</td><td>Push</td></tr>
                    <tr><td colspan="2" class="tp-pt-wide">Dealer doesn't qualify: Ante 1 to 1, Play pushes</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">Ante Bonus</td></tr>
                    <tr><td>Straight Flush</td><td>5 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>4 to 1</td></tr>
                    <tr><td>Straight</td><td>1 to 1</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">Pair Bonus</td></tr>
                    <tr><td>Straight Flush</td><td>40 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>30 to 1</td></tr>
                    <tr><td>Straight</td><td>6 to 1</td></tr>
                    <tr><td>Flush</td><td>3 to 1</td></tr>
                    <tr><td>Any Pair</td><td>1 to 1</td></tr>
                </table>
                <table class="sp-pt">
                    <tr class="sp-pt-hd"><td colspan="2">Prime</td></tr>
                    <tr><td>All 6 cards same color</td><td>4 to 1</td></tr>
                    <tr><td>Player's 3 same color</td><td>3 to 1</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">All 6</td></tr>
                    <tr><td>Royal Flush</td><td>1,000 to 1</td></tr>
                    <tr><td>Straight Flush</td><td>200 to 1</td></tr>
                    <tr><td>Four of a Kind</td><td>50 to 1</td></tr>
                    <tr><td>Full House</td><td>25 to 1</td></tr>
                    <tr><td>Flush</td><td>20 to 1</td></tr>
                    <tr><td>Straight</td><td>10 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>5 to 1</td></tr>
                </table>
                <p class="sp-pt-note">Winnings only. Ante includes any Ante Bonus.</p>
            </aside>
        }

        @* Pinned bottom bar. Until every wager is called the main button is
           dimmed and counts the wagers left; while a payout box is open,
           End Session becomes Cancel. *@
        @if (_zoom != 0)
        {
            <HandZoom Title="@(_zoom == 1 ? "DEALER" : "PLAYER")"
                      Cards="@(_zoom == 1 ? _round.DealerCards : _round.PlayerCards)"
                      OnClose="CloseZoom" />
        }

        <GameBar HelpTitle="Three Card Prime Pay Tables" OnEnd="EndOrCancel"
                 EndLabel="@(_box >= 0 ? "Cancel" : "End Session")"
                 EndClass="@(_box >= 0 ? "game-bar-cancel" : "")">
            <ChildContent>
                @if (!_scored)
                {
                    int left = WagersLeft;
                    @if (left > 0 || _box >= 0)
                    {
                        <button class="game-bar-main" disabled>
                            <span class="gb-left-long">@left @(left == 1 ? "wager" : "wagers") left</span><span class="gb-left-short">@left left</span>
                        </button>
                    }
                    else
                    {
                        <button class="game-bar-main" @onclick="SubmitAndShow">Submit</button>
                    }
                }
                else
                {
                    <button class="game-bar-main" @onclick="NextFromTop">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <table class="help-table sp-help-table">
                    <tr class="sp-pt-hd"><td colspan="2">Play &amp; Ante (dealer qualifies with Queen high or better)</td></tr>
                    <tr><td>Player wins</td><td>Both 1 to 1</td></tr>
                    <tr><td>Dealer doesn't qualify: Ante</td><td>1 to 1</td></tr>
                    <tr><td>Dealer doesn't qualify: Play</td><td>Push</td></tr>
                    <tr><td>Tie</td><td>Both push</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">Ante Bonus (paid with the Ante, win or lose)</td></tr>
                    <tr><td>Straight Flush</td><td>5 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>4 to 1</td></tr>
                    <tr><td>Straight</td><td>1 to 1</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">Pair Bonus (player's 3 cards)</td></tr>
                    <tr><td>Straight Flush</td><td>40 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>30 to 1</td></tr>
                    <tr><td>Straight</td><td>6 to 1</td></tr>
                    <tr><td>Flush</td><td>3 to 1</td></tr>
                    <tr><td>Any Pair</td><td>1 to 1</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">Prime (color)</td></tr>
                    <tr><td>Player AND dealer cards same color</td><td>4 to 1</td></tr>
                    <tr><td>Player's cards same color</td><td>3 to 1</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">All 6 (best 5 of all 6 cards)</td></tr>
                    <tr><td>Royal Flush</td><td>1,000 to 1</td></tr>
                    <tr><td>Straight Flush</td><td>200 to 1</td></tr>
                    <tr><td>Four of a Kind</td><td>50 to 1</td></tr>
                    <tr><td>Full House</td><td>25 to 1</td></tr>
                    <tr><td>Flush</td><td>20 to 1</td></tr>
                    <tr><td>Straight</td><td>10 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>5 to 1</td></tr>
                </table>
                @if (_pay)
                {
                    <p>Call the Play Win, Lose or Push (it pays even money). Calling Win on Pair Bonus, Prime or All 6, or Pay on the Ante, opens its payout box: enter the winnings only, then Enter. The Ante's payout includes any Ante Bonus. Entering 0 counts as Lose; Cancel puts the wager back to Call.</p>
                }
                else
                {
                    <p>A wager wins with any hand on its table; otherwise it loses (Play and Ante can also push, as above). Tap + Bonus when the Ante Bonus pays.</p>
                }
            </HelpContent>
        </GameBar>
    </div>
}

@if (_showSessionSummary)
{
    @* Each Payouts setting keeps its own "last time" progress *@
    @if (_pay)
    {
        <SessionSummary ModeKey="tc-payouts" Rounds="_played" Correct="_correct" Log="_log"
                        RightText="paid right" ConfidentText="You're paying these with confidence" YouVerb="paid"
                        OnAgain="PracticeAgain" OnDone="CloseSummary" />
    }
    else
    {
        <SessionSummary ModeKey="tc-settle" Rounds="_played" Correct="_correct" Log="_log"
                        RightText="rounds right" ConfidentText="You're calling these with confidence" YouVerb="called"
                        OnAgain="PracticeAgain" OnDone="CloseSummary" />
    }
}

@code {
    // Menu link for this game tapped while it's already open: return to
    // the start screen, same as the Back button (hidden on phones).
    protected override void OnInitialized()
    {
        GameReset.ResetRequested += OnResetRequested;
    }

    private void OnResetRequested()
    {
        _showSessionSummary = false;
        _started = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameReset.ResetRequested -= OnResetRequested;
    }

    // ---- State ---------------------------------------------------------

    private bool _started;
    // Start screen setting: false = Call only, true = Call and pay winners
    private bool _pay;

    private TcpPayoutRound _round = ThreeCardPayouts.Deal(Random.Shared);

    // Per wager (settling order): the call ("Win", "Lose", "Push", "Pay"
    // or null = not called yet) and, Payouts on, the payout entered
    private readonly string?[] _call = new string?[5];
    private readonly int?[] _paid = new int?[5];
    private bool _bonus;                 // Call only: + Bonus on the Ante

    private int _box = -1;               // row whose payout box is open (-1 = none)
    private string _boxText = string.Empty;
    private ElementReference _boxInputRef;

    private bool _scored;
    private readonly bool[] _ok = new bool[5];
    private readonly List<BreakdownRow> _rows = new();
    private string _resultText = string.Empty;
    private int _played;
    private int _correct;

    // After a payout box closes, End Session ignores taps for a moment so
    // a quick second tap on Cancel doesn't end the session
    private DateTime _endBlockedUntil;

    private bool _showSessionSummary;
    private SessionLog _log = new();

    // Scrolling after render
    private bool _lastRenderedStarted;
    private bool _scrollToFeedback;
    private bool _scrollToTop;
    private bool _scrollToSummary;
    private bool _focusBox;

    // Tap-to-zoom: 0 = closed, 1 = dealer's hand, 2 = player's hand
    private int _zoom;

    // Closing the zoom puts the cursor back in an open payout box
    private void CloseZoom()
    {
        _zoom = 0;
        if (_box >= 0) _focusBox = true;
    }

    // ---- Rows ----------------------------------------------------------

    // Play and Ante can push; the bonus wagers win or lose. Payouts on, the
    // Ante is Pay / Push / Lose (Pay covers the Ante, Ante Bonus or both).
    private IReadOnlyList<WagerPickOption> OptionsFor(int i) => i switch
    {
        TcpPayoutRound.Play => WagerPick.WinLosePush,
        TcpPayoutRound.Ante => _pay ? WagerPick.PayPushLose : WagerPick.WinLosePush,
        _ => WagerPick.WinLose
    };

    // Payouts on: wagers paid through the payout box (everything but the Play)
    private bool Paid(int i) => _pay && i != TcpPayoutRound.Play;

    // Button / answer-box text once a payout is in, e.g. "Win $30"
    private string? PickedText(int i) =>
        _paid[i] is int v && (_call[i] is "Win" or "Pay") ? $"{_call[i]} ${v:N0}" : null;

    private int WagersLeft => _call.Count(c => c is null);

    private void Pick(int i, string key)
    {
        if (_scored) return;

        // Payouts on: Win (Pay on the Ante) opens the payout box
        if (Paid(i) && key is "Win" or "Pay")
        {
            _call[i] = null;
            _paid[i] = null;
            _box = i;
            _boxText = string.Empty;
            _focusBox = true;
            _scrollToTop = true;
            return;
        }

        _call[i] = key;
        _paid[i] = null;
    }

    private void ToggleBonus()
    {
        if (!_scored) _bonus = !_bonus;
    }

    // ---- Payout box ----------------------------------------------------

    // The number pad types into the open box
    private string BoxText
    {
        get => _boxText;
        set => _boxText = DigitsOnly(value);
    }

    // Whole dollars, at most 5 digits (the top pay is $5,000)
    private static string DigitsOnly(string? raw)
    {
        System.Text.StringBuilder sb = new();
        foreach (char c in raw ?? string.Empty)
        {
            if (char.IsDigit(c) && sb.Length < 5) sb.Append(c);
        }
        // No leading zeros ("05" is 5), but a lone 0 stays (0 = Lose)
        string digits = sb.ToString().TrimStart('0');
        return digits.Length == 0 && sb.Length > 0 ? "0" : digits;
    }

    private void BoxInput(ChangeEventArgs e) => _boxText = DigitsOnly(e.Value?.ToString());

    private void BoxKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") BoxEnter();
        else if (e.Key == "Escape") BoxCancel();
    }

    // Enter: the amount goes on the row and the box closes; 0 counts as Lose
    private void BoxEnter()
    {
        if (_box < 0 || _boxText.Length == 0) return;

        int i = _box;
        int amount = int.Parse(_boxText);
        if (amount == 0)
        {
            _call[i] = "Lose";
            _paid[i] = null;
        }
        else
        {
            _call[i] = i == TcpPayoutRound.Ante ? "Pay" : "Win";
            _paid[i] = amount;
        }
        CloseBox();
    }

    // Cancel: the row goes back to Call (no penalty)
    private void BoxCancel()
    {
        if (_box < 0) return;
        _call[_box] = null;
        _paid[_box] = null;
        CloseBox();
    }

    private void CloseBox()
    {
        _box = -1;
        _boxText = string.Empty;
        _endBlockedUntil = DateTime.UtcNow.AddMilliseconds(500);
    }

    // ---- Start / deal --------------------------------------------------

    private void StartGame()
    {
        _started = true;
        _log = new SessionLog();
        _played = 0;
        _correct = 0;
        NewRound();
    }

    private void BackToStart()
    {
        _box = -1;
        _started = false;
    }

    // Both settings deal the same way: every wager placed every hand, in
    // real-world amounts, with the All 6 training boost (ThreeCardPayouts)
    private void NewRound()
    {
        _zoom = 0;
        _round = ThreeCardPayouts.Deal(Random.Shared);
        for (int i = 0; i < 5; i++)
        {
            _call[i] = null;
            _paid[i] = null;
            _ok[i] = false;
        }
        _bonus = false;
        _box = -1;
        _boxText = string.Empty;
        _scored = false;
        _rows.Clear();
        _resultText = string.Empty;
    }

    private void NextFromTop()
    {
        NewRound();
        _scrollToTop = true;
    }

    // ---- Submit --------------------------------------------------------

    private void SubmitAndShow()
    {
        Submit();
        if (_scored) _scrollToFeedback = true;
    }

    private void Submit()
    {
        if (_scored || _box >= 0 || WagersLeft > 0) return;

        _rows.Clear();
        for (int i = 0; i < 5; i++)
        {
            _rows.Add(_pay ? PayRow(i) : CallRowResult(i));
        }

        _log.AddRows(_rows);
        _played++;
        if (_ok.All(o => o)) _correct++;
        _resultText = BreakdownRow.Summary(_rows);
        _scored = true;
    }

    // The right call for a wager, before any payout: "Win", "Lose" or "Push"
    private static string Outcome(TcpPay pay) => pay.IsPush ? "Push" : pay.IsLose ? "Lose" : "Win";

    private string ActualCall(int i) =>
        i == TcpPayoutRound.Ante ? _round.AnteOutcome.ToString() : Outcome(_round.Pays[i]);

    // Call only: the call (and + Bonus on the Ante) against the hand
    private BreakdownRow CallRowResult(int i)
    {
        string actual = ActualCall(i);
        bool ok = _call[i] == actual;
        string you = _call[i] ?? "";
        string answer = actual;

        if (i == TcpPayoutRound.Ante)
        {
            ok &= _bonus == _round.AnteBonusPays;
            if (_bonus) you += " + Bonus";
            if (_round.AnteBonusPays) answer += " + Bonus";
        }

        _ok[i] = ok;
        return new BreakdownRow(TcpPayoutRound.Names[i], you, answer, ok, _round.Why[i]);
    }

    // Payouts on: the Play's call, and every other wager's payout (or
    // Lose / Push); a missed payout gets its shortcut
    private BreakdownRow PayRow(int i)
    {
        TcpPay pay = _round.Pays[i];
        bool wins = !pay.IsLose && !pay.IsPush;
        bool ok = _call[i] switch
        {
            "Lose" => pay.IsLose,
            "Push" => pay.IsPush,
            "Win" when i == TcpPayoutRound.Play => wins,
            "Win" or "Pay" => wins && _paid[i] == pay.Amount,
            _ => false
        };
        _ok[i] = ok;

        string tip = !ok && i != TcpPayoutRound.Play && wins
            ? PayoutShortcut.For(_round.Wagers[i] * 100L, pay.Amount * 100L) : "";
        return new BreakdownRow(TcpPayoutRound.Names[i], YouText(i), AnswerText(i), ok, _round.Why[i], tip);
    }

    // In the breakdown: "Lose", "Push", "Win" (the Play) or "$150"
    private string YouText(int i) =>
        _paid[i] is int v && (_call[i] is "Win" or "Pay") ? $"${v:N0}" : _call[i] ?? "";

    // The right answer shown on a missed row
    private string AnswerText(int i)
    {
        if (!_pay)
        {
            string a = ActualCall(i);
            return i == TcpPayoutRound.Ante && _round.AnteBonusPays ? a + " + Bonus" : a;
        }

        TcpPay pay = _round.Pays[i];
        if (i == TcpPayoutRound.Play || pay.IsLose || pay.IsPush) return Outcome(pay);
        return ThreeCardPayouts.Money(pay.Amount);
    }

    // ---- End Session ---------------------------------------------------

    // The bar's right button: Cancel while a payout box is open, otherwise
    // End Session (ignored for a moment right after a box closes)
    private void EndOrCancel()
    {
        if (_box >= 0)
        {
            BoxCancel();
            return;
        }
        if (DateTime.UtcNow < _endBlockedUntil) return;
        EndSession();
    }

    private void EndSession()
    {
        if (_played > 0)
        {
            _showSessionSummary = true;
            _scrollToSummary = true;
        }
        else
        {
            _started = false;
        }
    }

    // End-of-session summary's Practice Again: a fresh session with the
    // same setting, back at the top of the page
    private void PracticeAgain()
    {
        _showSessionSummary = false;
        StartGame();
        _lastRenderedStarted = false;
    }

    private void CloseSummary()
    {
        _showSessionSummary = false;
        _started = false;
    }

    // ---- After render: scrolling and focus -----------------------------

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Start / Back / menu / End Session: back to the top
        if (_started != _lastRenderedStarted)
        {
            _lastRenderedStarted = _started;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }
        }

        // Next, or a payout box opening (the other rows just hid): top of
        // the page, so the cards, the box and the number pad are all in view
        if (_scrollToTop)
        {
            _scrollToTop = false;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }
        }

        // The cursor into the payout box (a computer keyboard types there)
        if (_focusBox && _box >= 0)
        {
            _focusBox = false;
            try { await _boxInputRef.FocusAsync(preventScroll: true); } catch { }
        }

        // Submit: bring the feedback into view (if it isn't already)
        if (_scrollToFeedback)
        {
            _scrollToFeedback = false;
            try { await JS.InvokeVoidAsync("dstRevealFeedback"); } catch { }
        }

        // End Session: bring the Session Summary into view
        if (_scrollToSummary && _showSessionSummary)
        {
            _scrollToSummary = false;
            try { await JS.InvokeVoidAsync("dstScrollToEl", ".session-summary"); } catch { }
        }
    }
}
