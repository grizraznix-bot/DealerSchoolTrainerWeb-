@page "/three-card-trainer"
@using Microsoft.AspNetCore.Components
@using DealerSchoolTrainerWeb.Core
@using DealerSchoolTrainerWeb.Games.ThreeCardTrainer
@using DealerSchoolTrainerWeb.Games.HoldemTrainer
@implements IDisposable
@inject GameResetService GameReset
@inject IJSRuntime JS

<PageTitle>Three Card Prime</PageTitle>

@if (!_started)
{
    <div class="start-screen">
        <h1>THREE CARD PRIME</h1>

        @* Two modes, each a collapsible card (one open at a time) *@
        <div class="mode-list">
            <ModeCard Title="Three Card Prime"
                      Description="Settle the outcome of each wager (Win / Lose / Push), mark Ante Bonus if it pays, then Submit."
                      Expanded="@(_openMode == TcMode.Settle)"
                      OnToggle="() => ToggleMode(TcMode.Settle)"
                      OnStart="StartGame" />

            <ModeCard Title="Three Card Prime Payouts"
                      Description="Pay every wager. Enter the winnings for each (the Ante includes any Ante Bonus), or tap Push / Lose, then Submit."
                      Expanded="@(_openMode == TcMode.Payouts)"
                      OnToggle="() => ToggleMode(TcMode.Payouts)"
                      OnStart="StartGame" />
        </div>
    </div>
}
else if (_tcMode == TcMode.Payouts)
{
    <div class="play-screen sp-screen tp-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Three Card Prime Payouts" Correct="_tpCorrect" Played="_tpPlayed" />

        @* Dealer's hand (with whether it qualifies) and the player's hand,
           side by side, each with its hand name *@
        <div class="felt tp-felt">
            <div class="tp-hand">
                <div class="sp-cap">DEALER &middot; @_tpRound.DealerHand</div>
                <div class="tp-cards">
                    @foreach (Card c in _tpRound.DealerCards)
                    {
                        <img src="images/cards/@(c.Code).png" alt="@c.Name" class="tp-card" />
                    }
                </div>
                <span class="tp-qtag @(_tpRound.DealerQualifies ? "" : "tp-qtag-no")">@(_tpRound.DealerQualifies ? "QUALIFIES" : "DOESN'T QUALIFY")</span>
            </div>
            <div class="tp-hand tp-hand-player">
                <div class="sp-cap">PLAYER &middot; @_tpRound.PlayerHand</div>
                <div class="tp-cards">
                    @foreach (Card c in _tpRound.PlayerCards)
                    {
                        <img src="images/cards/@(c.Code).png" alt="@c.Name" class="tp-card" />
                    }
                </div>
            </div>
        </div>

        @* The five wagers in settling order: chip, name, payout box, then
           Push (Play and Ante only) and Lose. Tap a row to key into it. *@
        <div class="pw-wrap">
            <div class="pw-box @(!_tpScored ? "pw-scroll" : "")">
            <div class="sp-wagers">
                @for (int w = 0; w < 5; w++)
                {
                    int wi = w;
                    int wager = _tpRound.Wagers[wi];
                    bool canPush = wi <= TcpPayoutRound.Ante;
                    <div class="sp-wrow @(!_tpScored && _tpActive == wi ? "sp-wrow-on" : "")" @onclick="() => TpSelect(wi)">
                        <div class="sp-chip @TpChipClass(wager)">$@wager</div>
                        <div class="sp-wname">@TcpPayoutRound.Names[wi]<small>wager $@wager</small></div>
                        @if (_tpScored)
                        {
                            <div class="sp-ans @(_tpOk[wi] ? "sp-ans-ok" : "sp-ans-bad")">
                                @if (_tpOk[wi])
                                {
                                    <text>&#x2713; @TpEnteredText(wi)</text>
                                }
                                else
                                {
                                    <text>&#x2717; @TpEnteredText(wi) &middot; Ans: @TpPayText(_tpRound.Pays[wi])</text>
                                }
                            </div>
                        }
                        else
                        {
                            @* inputmode="none": phones use the keypad; a PC keyboard
                               types normally. A row marked Lose / Push shows that in
                               its box; typing a number (or Backspace) clears it. *@
                            <input type="text"
                                   class="sp-input @(_tpMark[wi] == TpMark.Lose ? "sp-input-lose" : _tpMark[wi] == TpMark.Push ? "tp-input-push" : "")"
                                   inputmode="none"
                                   autocomplete="off"
                                   value="@TpBoxValue(wi)"
                                   @oninput="e => TpInput(wi, e)"
                                   @onkeydown="e => TpKeyDown(wi, e)"
                                   @onfocus="() => _tpActive = wi"
                                   @ref="_tpInputRefs[wi]"
                                   placeholder="Payout" />
                        }
                        @if (canPush)
                        {
                            <button type="button"
                                    class="sp-lose tp-push @(_tpMark[wi] == TpMark.Push ? "tp-push-on" : "")"
                                    disabled="@_tpScored"
                                    @onclick="() => TpToggleMark(wi, TpMark.Push)"
                                    @onclick:stopPropagation="true">Push</button>
                        }
                        <button type="button"
                                class="sp-lose @(_tpMark[wi] == TpMark.Lose ? "sp-lose-on" : "")"
                                disabled="@_tpScored"
                                @onclick="() => TpToggleMark(wi, TpMark.Lose)"
                                @onclick:stopPropagation="true">Lose</button>
                    </div>
                }
            </div>
            </div>
        </div>

        <div class="sp-hint-row">
            <span class="sp-desk-hint">Type each payout; Tab or Enter moves to the next box.</span>
            <button class="keypad-toggle" @onclick="() => _tpShowKeypad = !_tpShowKeypad">123</button>
        </div>

        @if (!_tpScored)
        {
            <div class="keypad-wrap sp-keypad @(_tpShowKeypad ? "keypad-open" : "")">
                <NumericKeypad AllowDecimal="false" @bind-Value="TpActiveText" OnEnter="TpKeypadEnter" EnterLabel="@(_tpActive < 4 ? "Next ↓" : "Enter")" />
            </div>
        }

        <div class="feedback-area sp-feedback">
            @if (_tpScored)
            {
                <ResultBreakdown ResultText="@_tpResultText" IsCorrect="_tpOk.All(o => o)" Rows="_tpRows" />
            }
            else if (_tpMessage.Length > 0)
            {
                <p class="result-line txt-bad">@_tpMessage</p>
            }
        </div>

        @* Desktop: pay tables always in view (phones: in Help) *@
        <aside class="sp-paytable tp-paytable">
            <table class="sp-pt">
                <tr class="sp-pt-hd"><td>Play &amp; Ante</td><td></td></tr>
                <tr><td>Player wins</td><td>1 to 1</td></tr>
                <tr><td>Tie</td><td>Push</td></tr>
                <tr><td colspan="2" class="tp-pt-wide">Dealer doesn't qualify: Ante 1 to 1, Play pushes</td></tr>
                <tr class="sp-pt-hd"><td>Ante Bonus</td><td></td></tr>
                <tr><td>Straight Flush</td><td>5 to 1</td></tr>
                <tr><td>Three of a Kind</td><td>4 to 1</td></tr>
                <tr><td>Straight</td><td>1 to 1</td></tr>
                <tr class="sp-pt-hd"><td>Pair Bonus</td><td></td></tr>
                <tr><td>Straight Flush</td><td>40 to 1</td></tr>
                <tr><td>Three of a Kind</td><td>30 to 1</td></tr>
                <tr><td>Straight</td><td>6 to 1</td></tr>
                <tr><td>Flush</td><td>3 to 1</td></tr>
                <tr><td>Any Pair</td><td>1 to 1</td></tr>
            </table>
            <table class="sp-pt">
                <tr class="sp-pt-hd"><td>Prime</td><td></td></tr>
                <tr><td>All 6 cards same color</td><td>4 to 1</td></tr>
                <tr><td>Player's 3 same color</td><td>3 to 1</td></tr>
                <tr class="sp-pt-hd"><td>All 6</td><td></td></tr>
                <tr><td>Royal Flush</td><td>1,000 to 1</td></tr>
                <tr><td>Straight Flush</td><td>200 to 1</td></tr>
                <tr><td>Four of a Kind</td><td>50 to 1</td></tr>
                <tr><td>Full House</td><td>25 to 1</td></tr>
                <tr><td>Flush</td><td>20 to 1</td></tr>
                <tr><td>Straight</td><td>10 to 1</td></tr>
                <tr><td>Three of a Kind</td><td>5 to 1</td></tr>
            </table>
            <p class="sp-pt-note">Winnings only. Ante includes any Ante Bonus.</p>
        </aside>

        <GameBar HelpTitle="Three Card Prime Pay Tables" OnEnd="EndSession">
            <ChildContent>
                @if (!_tpScored)
                {
                    <button class="game-bar-main" @onclick="TpSubmitAndShow">Submit</button>
                }
                else
                {
                    <button class="game-bar-main" @onclick="TpNextTop" @ref="_tpNextButtonRef">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <table class="help-table sp-help-table">
                    <tr class="sp-pt-hd"><td>Play &amp; Ante (dealer qualifies with Queen high or better)</td><td></td></tr>
                    <tr><td>Player wins</td><td>Both 1 to 1</td></tr>
                    <tr><td>Dealer doesn't qualify</td><td>Ante 1 to 1, Play push</td></tr>
                    <tr><td>Tie</td><td>Both push</td></tr>
                    <tr class="sp-pt-hd"><td>Ante Bonus (paid with the Ante, win or lose)</td><td></td></tr>
                    <tr><td>Straight Flush</td><td>5 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>4 to 1</td></tr>
                    <tr><td>Straight</td><td>1 to 1</td></tr>
                    <tr class="sp-pt-hd"><td>Pair Bonus (player's 3 cards)</td><td></td></tr>
                    <tr><td>Straight Flush</td><td>40 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>30 to 1</td></tr>
                    <tr><td>Straight</td><td>6 to 1</td></tr>
                    <tr><td>Flush</td><td>3 to 1</td></tr>
                    <tr><td>Any Pair</td><td>1 to 1</td></tr>
                    <tr class="sp-pt-hd"><td>Prime (color)</td><td></td></tr>
                    <tr><td>Player AND dealer cards same color</td><td>4 to 1</td></tr>
                    <tr><td>Player's cards same color</td><td>3 to 1</td></tr>
                    <tr class="sp-pt-hd"><td>All 6 (best 5 of all 6 cards)</td><td></td></tr>
                    <tr><td>Royal Flush</td><td>1,000 to 1</td></tr>
                    <tr><td>Straight Flush</td><td>200 to 1</td></tr>
                    <tr><td>Four of a Kind</td><td>50 to 1</td></tr>
                    <tr><td>Full House</td><td>25 to 1</td></tr>
                    <tr><td>Flush</td><td>20 to 1</td></tr>
                    <tr><td>Straight</td><td>10 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>5 to 1</td></tr>
                </table>
                <p>Enter the winnings only. The Ante's payout includes any Ante Bonus. For a losing or pushed wager, tap Lose or Push (0 also counts as Lose).</p>
            </HelpContent>
        </GameBar>
    </div>
}
else
{
    @* Win / Lose / Push mode, in the payout modes' layout: dealer and
       player hands side by side (no hand names -- that's the answer), then
       one row per wager in settling order with its chip and a Call button
       that pops Win / Lose (/ Push) out beside it. Ante Bonus is a toggle
       in the Ante row. *@
    <div class="play-screen sp-screen tp-screen cr-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Three Card Prime" Correct="_correctCount" Played="_totalRounds" />

        <div class="felt tp-felt">
            <div class="tp-hand">
                <div class="sp-cap">DEALER</div>
                <div class="tp-cards">
                    @foreach (Card c in _dealerCards)
                    {
                        <img src="images/cards/@(c.Code).png" alt="@c.Name" class="tp-card" />
                    }
                </div>
            </div>
            <div class="tp-hand tp-hand-player">
                <div class="sp-cap">PLAYER</div>
                <div class="tp-cards">
                    @foreach (Card c in _playerCards)
                    {
                        <img src="images/cards/@(c.Code).png" alt="@c.Name" class="tp-card" />
                    }
                </div>
            </div>
        </div>

        <div class="sp-wagers">
            @foreach (WagerState w in RailOrder)
            {
                WagerState wager = w;
                bool isAnte = wager == _ante;
                <CallRow Chip="wager.Wager" Name="@wager.Name" Sub="@($"wager ${wager.Wager}")"
                         Options="@(wager.AllowPush ? WagerPick.WinLosePush : WagerPick.WinLose)"
                         Value="@wager.Selection?.ToString()"
                         OnPick="key => PickWager(wager, Enum.Parse<WagerOutcome>(key))"
                         YouSuffix="@(isAnte && _anteBonusChecked ? " + Bonus" : "")"
                         Locked="_roundScored"
                         Wrong="@(wager.Wrong || (isAnte && _anteBonusWrong))"
                         AnswerText="@(isAnte ? AnteAnswerText : $"{wager.Actual}")">
                    @if (isAnte && !_roundScored)
                    {
                        <button type="button" class="cr-bonus @(_anteBonusChecked ? "cr-bonus-on" : "")"
                                aria-pressed="@(_anteBonusChecked ? "true" : "false")"
                                @onclick="ToggleAnteBonus">+ Bonus</button>
                    }
                </CallRow>
            }
        </div>

        @* First round only: what to do *@
        @if (_totalRounds == 0 && !_roundScored)
        {
            <p class="cr-howto">Tap Call on each wager and pick Win, Lose or Push. Tap + Bonus if the Ante Bonus pays.</p>
        }

        <div class="feedback-area">
            @if (_roundScored)
            {
                @* After Submit: each wager with the right answer and why *@
                <ResultBreakdown ResultText="@_resultText" IsCorrect="_isCorrect" Rows="_rows" />
            }
            else if (_resultText.Length > 0)
            {
                <p class="result-line txt-bad">@_resultText</p>
            }
        </div>

        @* Pinned bottom bar: Help | Submit, then Next | End Session *@
        <GameBar HelpTitle="Three Card Prime Wager Rules" OnEnd="EndSession">
            <ChildContent>
                @if (!_roundScored)
                {
                    <button class="game-bar-main" @onclick="SubmitAndShow" disabled="@(!_submitEnabled)">Submit</button>
                }
                else
                {
                    <button class="game-bar-main" @onclick="NextFromTop" disabled="@(!_dealEnabled)">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <img src="images/cards/ThreeCardWagerRules.png" alt="Three Card Prime Wager Rules" class="help-image" />
            </HelpContent>
        </GameBar>
    </div>
}

@if (_showSessionSummary)
{
    @if (_tcMode == TcMode.Payouts)
    {
        <SessionSummary ModeKey="tc-payouts" Rounds="_tpPlayed" Correct="_tpCorrect" Log="_log"
                        RightText="paid right" ConfidentText="You're paying these with confidence" YouVerb="paid"
                        OnAgain="PracticeAgain" OnDone="CloseSummary" />
    }
    else
    {
        <SessionSummary ModeKey="tc-settle" Rounds="_totalRounds" Correct="_correctCount" Log="_log"
                        RightText="rounds right" ConfidentText="You're calling these with confidence" YouVerb="called"
                        OnAgain="PracticeAgain" OnDone="CloseSummary" />
    }
}

@code {
    // Menu link for this game tapped while it's already open: return to
    // the start screen, same as the Back button (hidden on phones).
    protected override void OnInitialized()
    {
        GameReset.ResetRequested += OnResetRequested;
    }

    private void OnResetRequested()
    {
        _showSessionSummary = false;
        _started = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameReset.ResetRequested -= OnResetRequested;
    }

    // Scroll back to the top whenever this game switches between its
    // start screen and its play screen (Start, Back, menu, End Session).
    // Without this the browser keeps the old scroll position -- after
    // scrolling down to reach Start, the game would open scrolled down.
    private bool _lastRenderedStarted;

    private bool _scrollToSummary;

    // Bar buttons: Submit also scrolls to the feedback; Next also
    // scrolls back to the top
    private void SubmitAndShow()
    {
        SubmitRound();
        if (_roundScored) _scrollToFeedback = true;
    }

    private void NextFromTop()
    {
        DealAgain();
        _scrollToTopAfterNext = true;
    }

    private bool _scrollToFeedback;
    private bool _scrollToTopAfterNext;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Submit: bring the feedback box into view (if it isn't already).
        // Next: back to the top for the new hand.
        if (_scrollToFeedback)
        {
            _scrollToFeedback = false;
            try { await JS.InvokeVoidAsync("dstRevealFeedback"); } catch { }
        }

        if (_scrollToTopAfterNext)
        {
            _scrollToTopAfterNext = false;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }
        }

        // End Session: bring the Session Summary into view (it's at the
        // bottom of the page, often below the screen on a phone)
        if (_scrollToSummary && _showSessionSummary)
        {
            _scrollToSummary = false;
            try { await JS.InvokeVoidAsync("dstScrollToEl", ".session-summary"); } catch { }
        }

        if (_started != _lastRenderedStarted)
        {
            _lastRenderedStarted = _started;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }

            // Payouts on desktop: open the number pad straight away when
            // the window is tall enough for it (123 still hides / shows it)
            if (_started && _tcMode == TcMode.Payouts)
            {
                bool fits = false;
                try { fits = await JS.InvokeAsync<bool>("dstKeypadFits", 315); } catch { }
                _tpShowKeypad = fits;
                if (fits) StateHasChanged();
            }
        }

        // Payouts: cursor into the active payout box, or onto Next once
        // the round is scored (so Enter deals the next round)
        // Payouts, phones: size the wager box to the space above the keypad
        if (_started && _tcMode == TcMode.Payouts)
        {
            try { await JS.InvokeVoidAsync("dstFitWagerBox"); } catch { }
        }

        if (_tpFocusInput >= 0)
        {
            int i = _tpFocusInput;
            _tpFocusInput = -1;
            try { await _tpInputRefs[i].FocusAsync(preventScroll: true); } catch { }
            try { await JS.InvokeVoidAsync("dstWagerRowIntoView", i); } catch { }
        }

        if (_tpFocusNext)
        {
            _tpFocusNext = false;
            try { await _tpNextButtonRef.FocusAsync(preventScroll: true); } catch { }
        }
    }

    private sealed class WagerState
    {
        public required string Name;
        public int Wager;           // chip amount shown on the row (real-world betting pattern)
        public bool AllowPush;
        public WagerOutcome? Selection;
        public bool Wrong;
        public WagerOutcome? Actual; // set at Submit, to outline the right answer when the call was wrong
    }

    private bool _started;

    // Two modes: Settle (Win / Lose / Push calls) and Payouts. Start
    // screen: which mode card is open (null = all closed); opening a card
    // also selects its mode.
    private enum TcMode { Settle, Payouts }
    private TcMode _tcMode = TcMode.Settle;
    private TcMode? _openMode;

    private void ToggleMode(TcMode mode)
    {
        _openMode = _openMode == mode ? null : mode;
        if (_openMode is not null) _tcMode = mode;
    }

    private Deck _deck = new();
    private Card[] _playerCards = Array.Empty<Card>();
    private Card[] _dealerCards = Array.Empty<Card>();

    private readonly WagerState _play = new() { Name = "Play", AllowPush = true };
    private readonly WagerState _ante = new() { Name = "Ante", AllowPush = true };
    private readonly WagerState _pairBonus = new() { Name = "Pair Bonus", AllowPush = false };
    private readonly WagerState _prime = new() { Name = "Prime", AllowPush = false };
    private readonly WagerState _allSix = new() { Name = "All 6", AllowPush = false };

    private int _correctCount;
    private int _totalRounds;
    private bool _roundScored;
    private bool _anteBonusChecked;
    private bool _anteBonusWrong;

    private bool _submitEnabled;
    private bool _dealEnabled;
    private string _resultText = string.Empty;
    private bool _isCorrect;
    private string _scoreText = "Score: 0 / 0 (0.0%)";
    private bool _showSessionSummary;

    // Wager rows in settling order, top to bottom
    private WagerState[] RailOrder => new[] { _play, _ante, _pairBonus, _prime, _allSix };

    // A wager row's Call pick (locked after Submit)
    private void PickWager(WagerState w, WagerOutcome choice)
    {
        if (_roundScored) return;
        w.Selection = choice;
        w.Wrong = false;
    }

    // Ante row after Submit: the right call, with "+ Bonus" when it pays
    private string AnteAnswerText =>
        $"{_ante.Actual}{(ThreeCardEvaluator.QualifiesAnteBonus(_playerCards) ? " + Bonus" : "")}";

    // Ante Bonus toggle in the Ante row
    private void ToggleAnteBonus()
    {
        if (_roundScored) return;
        _anteBonusChecked = !_anteBonusChecked;
        _anteBonusWrong = false;
    }

    // What happened this session, for the summary (Shared/SessionSummary)
    private SessionLog _log = new();

    // End-of-session summary's Practice Again: a fresh session of the same
    // mode, back at the top of the page (as if started from the start screen)
    private void PracticeAgain()
    {
        _showSessionSummary = false;
        StartGame();
        _lastRenderedStarted = false;
    }

    private void StartGame()
    {
        _started = true;
        _log = new SessionLog();
        if (_tcMode == TcMode.Payouts)
        {
            TpStartGame();
            return;
        }

        _correctCount = 0;
        _totalRounds = 0;
        _scoreText = "Score: 0 / 0 (0.0%)";

        DealNewRound();
    }

    private void BackToStart() => _started = false;

    // Share of hands dealt so All 6 wins (see DealNewRound). 19% forced,
    // plus the ~7% the other 81% of plain deals win on their own, makes
    // All 6 win on about 25% of hands overall.
    private const double AllSixBoostRate = 0.19;

    private void DealNewRound()
    {
        _rows.Clear();
        _dealEnabled = false;

        // Training boost: All 6 (Three of a Kind or better from all six
        // cards) wins on about 1 hand in 4 overall, vs about 1 in 14 with
        // plain random deals. AllSixBoostRate of hands are forced winners. On those hands the cards are simply
        // re-dealt until the six qualify, so the winners still come in
        // their natural mix (trips, straights, flushes, full houses...).
        // Not shown or adjustable anywhere; every other hand is a plain
        // random deal.
        bool forceAllSix = Random.Shared.NextDouble() < AllSixBoostRate;
        do
        {
            _deck = new Deck();
            _deck.Shuffle();

            _playerCards = new[] { _deck.Draw(), _deck.Draw(), _deck.Draw() };
            _dealerCards = new[] { _deck.Draw(), _deck.Draw(), _deck.Draw() };
        }
        while (forceAllSix && ThreeCardEvaluator.ResolveAllSix(_playerCards, _dealerCards) != WagerOutcome.Win);

        SortDescending(_playerCards);
        SortDescending(_dealerCards);

        foreach (WagerState w in new[] { _play, _ante, _pairBonus, _prime, _allSix })
        {
            w.Selection = null;
            w.Wrong = false;
            w.Actual = null;
        }

        // Chips on the rows, as the payout mode bets them (Ante = Play)
        _ante.Wager = _play.Wager = ThreeCardPayouts.AntePlayWager(Random.Shared);
        _pairBonus.Wager = ThreeCardPayouts.SideWager(Random.Shared);
        _prime.Wager = ThreeCardPayouts.SideWager(Random.Shared);
        _allSix.Wager = ThreeCardPayouts.AllSixWager(Random.Shared);

        _anteBonusChecked = false;
        _anteBonusWrong = false;

        _resultText = string.Empty;
        _roundScored = false;
        _submitEnabled = true;
    }

    private void DealAgain() => DealNewRound();

    // Groups a pair or trips together ahead of an unrelated kicker, e.g.
    // a pair of 7s with a Ten kicker displays as 7,7,T -- not the Ten
    // first, even though a Ten outranks a 7 in plain high-to-low order.
    // Applies to both the player's and dealer's cards, since this same
    // method sorts both.
    private static void SortDescending(Card[] cards)
    {
        Dictionary<int, int> rankCounts = new();
        foreach (Card c in cards)
        {
            int rank = (int)c.Rank;
            rankCounts[rank] = rankCounts.GetValueOrDefault(rank) + 1;
        }

        Array.Sort(cards, (a, b) =>
        {
            int countA = rankCounts[(int)a.Rank];
            int countB = rankCounts[(int)b.Rank];
            if (countA != countB) return countB.CompareTo(countA); // higher count (pair/trips) first

            return ((int)b.Rank).CompareTo((int)a.Rank); // then higher rank first
        });
    }

    private void SubmitRound()
    {

        WagerState[] all = { _play, _ante, _pairBonus, _prime, _allSix };

        foreach (WagerState w in all)
        {
            if (w.Selection is null)
            {
                _resultText = "Tap every wager to select an outcome before submitting.";
                _isCorrect = false;
                return;
            }
        }

        if (_roundScored) return;

        (WagerOutcome anteOutcome, WagerOutcome playOutcome) = ThreeCardEvaluator.ResolveAntePlay(_playerCards, _dealerCards);
        WagerOutcome pairPlusOutcome = ThreeCardEvaluator.ResolvePairPlus(_playerCards);
        WagerOutcome primeOutcome = ThreeCardEvaluator.ResolvePrime(_playerCards, _dealerCards);
        WagerOutcome allSixOutcome = ThreeCardEvaluator.ResolveAllSix(_playerCards, _dealerCards);

        bool allCorrect = true;
        allCorrect &= GradeWager(_play, playOutcome);
        allCorrect &= GradeWager(_ante, anteOutcome);
        allCorrect &= GradeWager(_pairBonus, pairPlusOutcome);
        allCorrect &= GradeWager(_prime, primeOutcome);
        allCorrect &= GradeWager(_allSix, allSixOutcome);

        bool anteBonusActual = ThreeCardEvaluator.QualifiesAnteBonus(_playerCards);
        if (_anteBonusChecked == anteBonusActual)
        {
            _anteBonusWrong = false;
        }
        else
        {
            _anteBonusWrong = true;
            allCorrect = false;
        }

        _totalRounds++;
        if (allCorrect) _correctCount++;

        BuildRows(anteOutcome, playOutcome, pairPlusOutcome, primeOutcome, allSixOutcome, anteBonusActual);
        _log.AddRows(_rows);

        _isCorrect = allCorrect;
        _resultText = BreakdownRow.Summary(_rows);

        string pct = _totalRounds > 0
            ? ((double)_correctCount / _totalRounds).ToString("0.0%")
            : "0.0%";
        _scoreText = $"Score: {_correctCount} / {_totalRounds} ({pct})";

        _roundScored = true;
        _submitEnabled = false;
        _dealEnabled = true;
    }

    // After Submit: one line per wager (in settling order) with the right
    // answer and why, so a miss teaches the rule rather than just marking
    // it wrong
    private readonly List<BreakdownRow> _rows = new();

    private void BuildRows(WagerOutcome ante, WagerOutcome play, WagerOutcome pairBonus,
                           WagerOutcome prime, WagerOutcome allSix, bool anteBonus)
    {
        _rows.Clear();

        string player = DescribeThree(_playerCards);
        string dealer = DescribeThree(_dealerCards);
        bool qualifies = ThreeCardEvaluator.DealerQualifies(_dealerCards);

        string versus;
        if (!qualifies)
        {
            versus = $"Dealer {dealer} doesn't qualify (needs Queen high or better)";
        }
        else
        {
            int cmp = ThreeCardEvaluator.Compare(_playerCards, _dealerCards);
            string vs = cmp > 0 ? "beats" : cmp < 0 ? "loses to" : "ties";
            versus = $"Dealer qualifies with {dealer}. Player {player} {vs} the dealer";
        }

        _rows.Add(Row(_play, play, qualifies ? $"{versus}." : $"{versus}: Play pushes."));
        _rows.Add(Row(_ante, ante, qualifies ? $"{versus}." : $"{versus}: Ante wins."));

        _rows.Add(new BreakdownRow("Ante Bonus",
            _anteBonusChecked ? "Pays" : "No",
            anteBonus ? "Pays" : "No",
            !_anteBonusWrong,
            anteBonus ? $"Player has {player}." : $"Player has {player} (needs a Straight or better)."));

        _rows.Add(Row(_pairBonus, pairBonus,
            $"Player has {player}{(pairBonus == WagerOutcome.Win ? "" : " (needs a Pair or better)")}."));

        bool playerOneColor = _playerCards.All(IsRed) || !_playerCards.Any(IsRed);
        _rows.Add(Row(_prime, prime, prime == WagerOutcome.Win
            ? (playerOneColor ? "The player's 3 cards are all one color." : "All 6 cards are one color.")
            : "The player's cards are mixed colors."));

        List<Card> six = _playerCards.Concat(_dealerCards).ToList();
        _rows.Add(Row(_allSix, allSix,
            $"Best 5 of all 6 cards: {HandEvaluator.DescribeHand(six)}{(allSix == WagerOutcome.Win ? "" : " (needs Three of a Kind or better)")}."));
    }

    private static BreakdownRow Row(WagerState w, WagerOutcome actual, string why) =>
        new(w.Name, $"{w.Selection}", $"{actual}", w.Selection == actual, why);

    private static string Word(WagerOutcome o) => o.ToString();

    private static bool IsRed(Card c) => c.Suit is Suit.Hearts or Suit.Diamonds;

    // e.g. "a Pair of 7s", "King high", "a Straight"
    private static string DescribeThree(IReadOnlyList<Card> cards)
    {
        ThreeCardCategory cat = ThreeCardEvaluator.GetCategory(cards);
        switch (cat)
        {
            case ThreeCardCategory.StraightFlush: return "a Straight Flush";
            case ThreeCardCategory.ThreeOfAKind: return $"Three {RankPlural(cards[0].Rank)}";
            case ThreeCardCategory.Straight: return "a Straight";
            case ThreeCardCategory.Flush: return "a Flush";
            case ThreeCardCategory.Pair:
                Rank pair = cards.GroupBy(c => c.Rank).First(g => g.Count() == 2).Key;
                return $"a Pair of {RankPlural(pair)}";
            default:
                return $"{RankName(cards.Max(c => c.Rank))} high";
        }
    }

    private static string RankName(Rank r) => r switch
    {
        Rank.Ace => "Ace",
        Rank.King => "King",
        Rank.Queen => "Queen",
        Rank.Jack => "Jack",
        _ => ((int)r).ToString()
    };

    private static string RankPlural(Rank r) => r == Rank.Six ? "6s" : RankName(r) + "s";

    private static bool GradeWager(WagerState w, WagerOutcome actual)
    {
        w.Actual = actual;
        if (w.Selection == actual)
        {
            w.Wrong = false;
            return true;
        }

        w.Wrong = true;
        return false;
    }

    private void EndSession()
    {
        if (_tcMode == TcMode.Payouts ? _tpPlayed > 0 : _totalRounds > 0)
        {
            _showSessionSummary = true;
            _scrollToSummary = true;
        }
        else
        {
            _started = false;
        }
    }

    private void CloseSummary()
    {
        _showSessionSummary = false;
        _started = false;
    }

    // ============================================================
    // PAYOUTS (Tp prefix)
    // ============================================================

    private enum TpMark { None, Lose, Push }

    private TcpPayoutRound _tpRound = ThreeCardPayouts.Deal(Random.Shared);
    private readonly string[] _tpAnswer = new string[5];
    private readonly TpMark[] _tpMark = new TpMark[5];
    private readonly bool[] _tpOk = new bool[5];
    private int _tpActive;
    private bool _tpScored;
    private bool _tpShowKeypad;
    private string _tpMessage = string.Empty;
    private string _tpResultText = string.Empty;
    private readonly List<BreakdownRow> _tpRows = new();
    private int _tpCorrect;
    private int _tpPlayed;

    private readonly ElementReference[] _tpInputRefs = new ElementReference[5];
    private ElementReference _tpNextButtonRef;
    private int _tpFocusInput = -1;
    private bool _tpFocusNext;

    // The keypad types into whichever box is active
    private string TpActiveText
    {
        get => _tpAnswer[_tpActive] ?? string.Empty;
        set
        {
            _tpAnswer[_tpActive] = TpDigitsOnly(value);
            _tpMark[_tpActive] = TpMark.None;
            _tpMessage = string.Empty;
        }
    }

    private void TpStartGame()
    {
        _tpCorrect = 0;
        _tpPlayed = 0;
        TpNewRound();
    }

    private void TpNewRound()
    {
        _tpRound = ThreeCardPayouts.Deal(Random.Shared);
        for (int i = 0; i < 5; i++)
        {
            _tpAnswer[i] = string.Empty;
            _tpMark[i] = TpMark.None;
            _tpOk[i] = false;
        }
        _tpActive = 0;
        _tpScored = false;
        _tpMessage = string.Empty;
        _tpResultText = string.Empty;
        _tpRows.Clear();
        _tpFocusInput = 0;
    }

    private void TpSelect(int index)
    {
        if (_tpScored || _tpActive == index) return;
        _tpActive = index;
        _tpFocusInput = index;
    }

    // Whole dollars only, at most 5 digits (the top pay is $5,000)
    private static string TpDigitsOnly(string? raw)
    {
        System.Text.StringBuilder sb = new();
        foreach (char c in raw ?? string.Empty)
        {
            if (char.IsDigit(c) && sb.Length < 5) sb.Append(c);
        }
        return sb.ToString();
    }

    private string TpBoxValue(int i) => _tpMark[i] switch
    {
        TpMark.Lose => "LOSE",
        TpMark.Push => "PUSH",
        _ => _tpAnswer[i] ?? string.Empty
    };

    private void TpInput(int index, ChangeEventArgs e)
    {
        _tpAnswer[index] = TpDigitsOnly(e.Value?.ToString());
        _tpMark[index] = TpMark.None;
        _tpActive = index;
        _tpMessage = string.Empty;
    }

    // Keyboard Enter: on to the next box; on the last box, Submit
    private async Task TpKeyDown(int index, Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _tpScored) return;
        _tpActive = index;
        await TpKeypadEnter();
    }

    private async Task TpKeypadEnter()
    {
        if (_tpScored) return;

        if (_tpActive < 4)
        {
            _tpActive++;
            _tpFocusInput = _tpActive;
        }
        else
        {
            await TpSubmitAndShow();
        }
    }

    // Lose / Push: marks the wager (clearing any amount typed) and moves
    // on to the next wager; tapped again it's undone
    private void TpToggleMark(int index, TpMark mark)
    {
        if (_tpScored) return;
        _tpMessage = string.Empty;

        if (_tpMark[index] == mark)
        {
            _tpMark[index] = TpMark.None;
            _tpActive = index;
            _tpFocusInput = index;
            return;
        }

        _tpMark[index] = mark;
        _tpAnswer[index] = string.Empty;
        int next = index < 4 ? index + 1 : index;
        _tpActive = next;
        _tpFocusInput = next;
    }

    // Submit also scrolls to the feedback; the cursor moves onto Next
    // after a short wait so the same Enter press doesn't also press Next
    private async Task TpSubmitAndShow()
    {
        TpSubmit();
        if (!_tpScored) return;

        _scrollToFeedback = true;
        StateHasChanged();

        await Task.Delay(200);
        _tpFocusNext = true;
    }

    private void TpSubmit()
    {
        if (_tpScored) return;

        for (int i = 0; i < 5; i++)
        {
            if ((_tpAnswer[i] ?? "").Length == 0 && _tpMark[i] == TpMark.None)
            {
                _tpMessage = i <= TcpPayoutRound.Ante
                    ? $"Enter the {TcpPayoutRound.Names[i]} payout, or tap Push or Lose."
                    : $"Enter the {TcpPayoutRound.Names[i]} payout, or tap Lose.";
                _tpActive = i;
                _tpFocusInput = i;
                return;
            }
        }

        _tpRows.Clear();
        for (int i = 0; i < 5; i++)
        {
            TcpPay pay = _tpRound.Pays[i];
            _tpOk[i] = _tpMark[i] switch
            {
                TpMark.Lose => pay.IsLose,
                TpMark.Push => pay.IsPush,
                _ => long.TryParse(_tpAnswer[i], out long v) && (v == 0 ? pay.IsLose : !pay.IsPush && v == pay.Amount)
            };

            _tpRows.Add(new BreakdownRow(TcpPayoutRound.Names[i], TpEnteredMoney(i), TpPayMoney(pay), _tpOk[i], _tpRound.Why[i]));
        }

        _log.AddRows(_tpRows);
        _tpPlayed++;
        if (_tpOk.All(o => o)) _tpCorrect++;

        _tpResultText = BreakdownRow.Summary(_tpRows);
        _tpMessage = string.Empty;
        _tpScored = true;
    }

    private void TpNextTop()
    {
        TpNewRound();
        _scrollToTopAfterNext = true;
    }

    // In the payout box after Submit: "LOSE", "PUSH" or "150"
    private string TpEnteredText(int i) => _tpMark[i] switch
    {
        TpMark.Lose => "LOSE",
        TpMark.Push => "PUSH",
        _ => long.TryParse(_tpAnswer[i], out long v) ? v.ToString("N0") : _tpAnswer[i] ?? ""
    };

    private static string TpPayText(TcpPay pay) =>
        pay.IsPush ? "PUSH" : pay.IsLose ? "LOSE" : pay.Amount.ToString("N0");

    // In the breakdown: "Lose", "Push" or "$150"
    private string TpEnteredMoney(int i) => _tpMark[i] switch
    {
        TpMark.Lose => "Lose",
        TpMark.Push => "Push",
        _ => long.TryParse(_tpAnswer[i], out long v) ? $"${v:N0}" : _tpAnswer[i] ?? ""
    };

    private static string TpPayMoney(TcpPay pay) =>
        pay.IsPush ? "Push" : pay.IsLose ? "Lose" : ThreeCardPayouts.Money(pay.Amount);

    // Chip color by the largest chip in the wager: $100 black, $25 green,
    // $10 blue, $5 red, $1 grey
    private static string TpChipClass(int wager) =>
        wager >= 100 ? "sp-chip-100" : wager >= 25 ? "sp-chip-25" : wager >= 10 ? "sp-chip-10" : wager >= 5 ? "sp-chip-5" : "sp-chip-1";
}
