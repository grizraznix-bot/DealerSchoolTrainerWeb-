@code {
    private bool _android;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _android = await JS.InvokeAsync<string>("dstPhoneOs") == "android";
            if (_android) StateHasChanged();
        }
        catch
        {
            // Keep the iPhone steps if the check isn't available
        }
    }
}
