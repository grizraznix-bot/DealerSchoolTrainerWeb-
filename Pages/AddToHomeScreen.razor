        <button type="button" role="tab" class="ah-tab @(_android ? "on" : "")" aria-selected="@_android" @onclick="() => _android = true">Android</button>
    </div>

    @if (!_android)
    {
        <div class="ah-steps">
            <div class="ah-step">
