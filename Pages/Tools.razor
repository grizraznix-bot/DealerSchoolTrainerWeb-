@page "/tools"

<PageTitle>Table Tools</PageTitle>

@* Table Tools: companions for the training table, set down next to the layout.
   Table Screens first (a ready-made screen per game), then the single tools.
   The limit sign and the pay tables also go full screen with the phone
   held sideways. *@
<div class="start-screen tl-hub">
    <h1>TABLE TOOLS</h1>
    <p class="tl-intro">Companions for the training table: set your phone down next to the layout.</p>

    @* Table Screens: a ready-made screen per game (Pages/ToolTableScreen) *@
    <h2 class="tl-sec">Table Screens</h2>
    <div class="tl-tables">
        @foreach (var t in ToolTableScreen.Screens)
        {
            <a class="tl-table" href="@($"tools/table/{t.Key}")"><b>@t.Name</b><span>@t.Text</span></a>
        }
    </div>

    <h2 class="tl-sec">Tools</h2>

    <a class="tl-tool" href="tools/limit-sign">
        <span class="tl-ic" aria-hidden="true">$</span>
        <span class="tl-tool-text"><b>Table Limit Sign</b><span>Tap to change the min and max</span></span>
        <span class="tl-go" aria-hidden="true">&rsaquo;</span>
    </a>
    <a class="tl-tool" href="tools/pay-tables">
        <span class="tl-ic" aria-hidden="true">&#x2261;</span>
        <span class="tl-tool-text"><b>Pay Tables</b><span>Every game, every wager</span></span>
        <span class="tl-go" aria-hidden="true">&rsaquo;</span>
    </a>
    <a class="tl-tool" href="tools/shuffle-timer">
        <span class="tl-ic" aria-hidden="true">&#x23F1;</span>
        <span class="tl-tool-text"><b>Shuffle Timer</b><span>6-deck shuffle, 90 seconds ideal</span></span>
        <span class="tl-go" aria-hidden="true">&rsaquo;</span>
    </a>
    <a class="tl-tool" href="tools/pai-gow-number">
        <span class="tl-ic" aria-hidden="true">7</span>
        <span class="tl-tool-text"><b>Pai Gow Number &amp; Dice</b><span>A number 1-7, or 3 dice</span></span>
        <span class="tl-go" aria-hidden="true">&rsaquo;</span>
    </a>
    <a class="tl-tool" href="tools/player-tracking">
        <span class="tl-ic" aria-hidden="true">&#x263A;</span>
        <span class="tl-tool-text"><b>Player Tracking</b><span>Log in, seat a guest, enter the buy-in</span></span>
        <span class="tl-go" aria-hidden="true">&rsaquo;</span>
    </a>
    <a class="tl-tool tl-tool-gold" href="progressives?mode=ts">
        <span class="tl-ic tl-ic-chip" aria-hidden="true">$5</span>
        <span class="tl-tool-text"><b>Progressive Touchscreen</b><span>The Touchscreen only mode</span></span>
        <span class="tl-go" aria-hidden="true">&rsaquo;</span>
    </a>

    <p class="tl-intro">Turn your phone sideways on the Limit Sign, the Pay Tables, Player Tracking or the Progressive Touchscreen for full screen. The Table Screens work best on a tablet or computer.</p>
</div>
