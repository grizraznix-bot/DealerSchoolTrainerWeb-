@page "/holdem-trainer"
@using DealerSchoolTrainerWeb.Core
@using DealerSchoolTrainerWeb.Games.HoldemTrainer
@implements IDisposable
@inject GameResetService GameReset
@inject IJSRuntime JS

<PageTitle>Heads-Up Hold'em</PageTitle>

@if (!_started)
{
    <div class="start-screen">
        <h1>HEADS-UP HOLD'EM</h1>

        @* Each mode is a collapsible card: tap its title to open its
           settings and its own Start button (one card open at a time).
           Settle the Bets allows 1-6 player hands, defaulting to 1. *@
        <div class="mode-list">
            <ModeCard Title="Identify the Hands"
                      Description="The board and the dealer's 2 cards are dealt. Tap the 2 cards that are NOT part of the dealer's best 5-card hand, then Submit."
                      Expanded="@IsModeOpen(TrainerMode.IdentifyHands)"
                      OnToggle="() => ToggleMode(TrainerMode.IdentifyHands)"
                      OnStart="StartGame" />

            <ModeCard Title="Settle the Bets"
                      Description="The dealer's best hand is already set -- its 2 unused cards are dimmed. Call the player Win / Lose / Push against it with the Call button, then Submit."
                      Expanded="@IsModeOpen(TrainerMode.SettleBets)"
                      OnToggle="() => ToggleMode(TrainerMode.SettleBets)"
                      OnStart="StartGame" />

            <ModeCard Title="Hold'em Payouts"
                      Description="The hand is dealt and settled out. Tap a hand to see its rank. Pay each wager (Raise, Ante, Odds, Trips Plus, Pocket Bonus): enter the winnings, or tap Push / Lose, then Submit."
                      Expanded="@IsModeOpen(TrainerMode.Payouts)"
                      OnToggle="() => ToggleMode(TrainerMode.Payouts)"
                      OnStart="StartGame" />
        </div>
    </div>
}
else if (_mode == TrainerMode.Payouts)
{
    <div class="play-screen sp-screen hp-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Hold'em Payouts" Correct="_hpCorrect" Played="_hpPlayed" />

        @* The board on top (the dealer's 2 unused cards dimmed, wherever
           they are), then the dealer's and player's hole cards side by side
           under plain DEALER / PLAYER captions. Tap a hand for a bubble with
           its rank (the dealer's adds OPENS / DOESN'T OPEN), as in Pai Gow
           Payouts. Until the first tap this session, the board caption
           fades between the dimmed-card note and the tap prompt every 5
           seconds (CSS only; @key restarts it on each deal). After Submit
           each rank shows under its caption (the keypad is gone by then, so
           the extra line costs nothing). *@
        <div class="felt hp-felt">
            @if (_hpPeekUsed || _hpScored)
            {
                <div class="cr-cap hp-board-cap">BOARD &middot; dimmed = not in dealer's hand</div>
            }
            else
            {
                <div class="cr-cap hp-board-cap pp-alt" @key="@_hpDealNo">
                    <span class="pp-alt-a">BOARD &middot; dimmed = not in dealer's hand</span>
                    <span class="pp-alt-b">Tap Dealer or Player cards for rank</span>
                </div>
            }
            <div class="hp-cards">
                @foreach (Card c in _hpRound.Board)
                {
                    <img src="images/cards/@(c.Code).png" alt="@c.Name" class="hp-card @(HpDealerUnused(c) ? "hp-unused" : "")" />
                }
            </div>
            <div class="hp-pair">
                @foreach (bool isDealer in new[] { true, false })
                {
                    bool dealerHand = isDealer;
                    string rank = isDealer ? _hpRound.DealerHand : _hpRound.PlayerHand;
                    Card[] hole = isDealer ? _hpRound.DealerCards : _hpRound.PlayerCards;
                    bool peekOpen = !_hpScored && _hpPeek == (isDealer ? 2 : 1);
                    <div class="hp-hand @(!_hpScored ? "hp-tap" : "") @(peekOpen ? "hp-tap-on" : "")"
                         role="@(!_hpScored ? "button" : null)"
                         @onclick="() => HpTogglePeek(dealerHand)">
                        @if (peekOpen)
                        {
                            <div class="hp-bub">
                                <div>@rank</div>
                                @if (isDealer)
                                {
                                    <span class="tp-qtag @(_hpRound.DealerOpens ? "" : "tp-qtag-no")">@(_hpRound.DealerOpens ? "OPENS" : "DOESN'T OPEN")</span>
                                }
                            </div>
                        }
                        <div class="cr-cap">@(isDealer ? "DEALER" : "PLAYER")</div>
                        @if (_hpScored)
                        {
                            <div class="hp-rank">
                                @rank
                                @if (isDealer)
                                {
                                    <span class="tp-qtag @(_hpRound.DealerOpens ? "" : "tp-qtag-no")">@(_hpRound.DealerOpens ? "OPENS" : "DOESN'T OPEN")</span>
                                }
                            </div>
                        }
                        <div class="hp-cards">
                            @foreach (Card c in hole)
                            {
                                <img src="images/cards/@(c.Code).png" alt="@c.Name" class="hp-card @(isDealer && HpDealerUnused(c) ? "hp-unused" : "")" />
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        @if (_hpPeek != 0 && !_hpScored)
        {
            <div class="cr-backdrop" @onclick="HpClosePeek"></div>
        }

        @* The five wagers in settling order, in the shared wager box (on
           phones it scrolls when the rows don't all fit above the keypad) *@
        <div class="pw-wrap">
            <div class="pw-box @(!_hpScored ? "pw-scroll" : "")">
                <div class="sp-wagers">
                    @for (int w = 0; w < 5; w++)
                    {
                        int wi = w;
                        int wager = _hpRound.Wagers[wi];
                        bool canPush = wi <= HdPayoutRound.Odds;
                        <div class="sp-wrow @(!_hpScored && _hpActive == wi ? "sp-wrow-on" : "")" @onclick="() => HpSelect(wi)">
                            <div class="sp-chip @HpChipClass(wager)">$@wager</div>
                            <div class="sp-wname">@HdPayoutRound.Names[wi]<small>@(wi == HdPayoutRound.Raise ? $"${wager} · {_hpRound.RaiseTiming}" : $"wager ${wager}")</small></div>
                            @if (_hpScored)
                            {
                                <div class="sp-ans @(_hpOk[wi] ? "sp-ans-ok" : "sp-ans-bad")">
                                    @if (_hpOk[wi])
                                    {
                                        <text>&#x2713; @HpEnteredText(wi)</text>
                                    }
                                    else
                                    {
                                        <text>&#x2717; @HpEnteredText(wi) &middot; Ans: @HpPayText(_hpRound.Pays[wi])</text>
                                    }
                                </div>
                            }
                            else
                            {
                                <input type="text"
                                       class="sp-input @(_hpMark[wi] == HpMark.Lose ? "sp-input-lose" : _hpMark[wi] == HpMark.Push ? "tp-input-push" : "")"
                                       inputmode="none"
                                       autocomplete="off"
                                       value="@HpBoxValue(wi)"
                                       @oninput="e => HpInput(wi, e)"
                                       @onkeydown="e => HpKeyDown(wi, e)"
                                       @onfocus="() => _hpActive = wi"
                                       @ref="_hpInputRefs[wi]"
                                       placeholder="Payout" />
                            }
                            @if (canPush)
                            {
                                <button type="button"
                                        class="sp-lose tp-push @(_hpMark[wi] == HpMark.Push ? "tp-push-on" : "")"
                                        disabled="@_hpScored"
                                        @onclick="() => HpToggleMark(wi, HpMark.Push)"
                                        @onclick:stopPropagation="true">Push</button>
                            }
                            <button type="button"
                                    class="sp-lose @(_hpMark[wi] == HpMark.Lose ? "sp-lose-on" : "")"
                                    disabled="@_hpScored"
                                    @onclick="() => HpToggleMark(wi, HpMark.Lose)"
                                    @onclick:stopPropagation="true">Lose</button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="sp-hint-row">
            <span class="sp-desk-hint">Type each payout (cents allowed); Tab or Enter moves to the next box.</span>
            <button class="keypad-toggle" @onclick="() => _hpShowKeypad = !_hpShowKeypad">123</button>
        </div>

        @if (!_hpScored)
        {
            <div class="keypad-wrap sp-keypad @(_hpShowKeypad ? "keypad-open" : "")">
                <NumericKeypad AllowDecimal="true" MaxDecimalDigits="2" @bind-Value="HpActiveText" />
            </div>
        }

        <div class="feedback-area sp-feedback">
            @if (_hpScored)
            {
                <ResultBreakdown ResultText="@_hpResultText" IsCorrect="_hpOk.All(o => o)" Rows="_hpRows" />
            }
            else if (_hpMessage.Length > 0)
            {
                <p class="result-line txt-bad">@_hpMessage</p>
            }
        </div>

        @* Desktop: pay tables always in view (phones: in Help) *@
        <aside class="sp-paytable tp-paytable">
            <table class="sp-pt">
                <tr class="sp-pt-hd"><td>Raise &amp; Ante</td><td></td></tr>
                <tr><td>Player wins</td><td>1 to 1</td></tr>
                <tr><td>Tie</td><td>Push</td></tr>
                <tr><td colspan="2" class="tp-pt-wide">Dealer doesn't open (needs a pair): Ante pushes. Raise: 3x pre-flop, 2x after the flop, 1x after the river.</td></tr>
                <tr class="sp-pt-hd"><td>Odds (player wins)</td><td></td></tr>
                <tr><td>Royal Flush</td><td>500 to 1</td></tr>
                <tr><td>Straight Flush</td><td>50 to 1</td></tr>
                <tr><td>Four of a Kind</td><td>10 to 1</td></tr>
                <tr><td>Full House</td><td>3 to 1</td></tr>
                <tr><td>Flush</td><td>3 to 2</td></tr>
                <tr><td>Straight</td><td>1 to 1</td></tr>
                <tr><td>Less than a Straight</td><td>Push</td></tr>
                <tr class="sp-pt-hd"><td>Odds Bad Beat (player loses)</td><td></td></tr>
                <tr><td>Straight Flush</td><td>500 to 1</td></tr>
                <tr><td>Four of a Kind</td><td>25 to 1</td></tr>
                <tr><td>Full House</td><td>6 to 1</td></tr>
                <tr><td>Flush</td><td>5 to 1</td></tr>
                <tr><td>Straight</td><td>4 to 1</td></tr>
            </table>
            <table class="sp-pt">
                <tr class="sp-pt-hd"><td>Trips Plus</td><td></td></tr>
                <tr><td>Royal Flush</td><td>100 to 1</td></tr>
                <tr><td>Straight Flush</td><td>40 to 1</td></tr>
                <tr><td>Four of a Kind</td><td>30 to 1</td></tr>
                <tr><td>Full House</td><td>8 to 1</td></tr>
                <tr><td>Flush</td><td>7 to 1</td></tr>
                <tr><td>Straight</td><td>4 to 1</td></tr>
                <tr><td>Three of a Kind</td><td>3 to 1</td></tr>
                <tr class="sp-pt-hd"><td>Pocket Bonus</td><td></td></tr>
                <tr><td>Pocket Aces</td><td>25 to 1</td></tr>
                <tr><td>Ace-Face suited</td><td>20 to 1</td></tr>
                <tr><td>Ace-Face</td><td>10 to 1</td></tr>
                <tr><td>Pair</td><td>5 to 1</td></tr>
            </table>
            <p class="sp-pt-note">Winnings only. Ace-Face = A-K, A-Q or A-J.</p>
        </aside>

        <GameBar HelpTitle="Hold'em Pay Tables" OnEnd="EndSession">
            <ChildContent>
                @if (!_hpScored)
                {
                    <button class="game-bar-main" @onclick="HpSubmitAndShow">Submit</button>
                }
                else
                {
                    <button class="game-bar-main" @onclick="HpNextTop" @ref="_hpNextButtonRef">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <p>Tap the Dealer or Player cards to see that hand's rank (and whether the dealer opens). Dimmed cards are the 2 the dealer doesn't use.</p>
                <table class="help-table sp-help-table">
                    <tr class="sp-pt-hd"><td>Raise &amp; Ante</td><td></td></tr>
                    <tr><td>Player wins</td><td>Both 1 to 1</td></tr>
                    <tr><td>Dealer doesn't open (needs a pair)</td><td>Ante push</td></tr>
                    <tr><td>Tie</td><td>Push</td></tr>
                    <tr><td>Raise size</td><td>3x / 2x / 1x</td></tr>
                    <tr class="sp-pt-hd"><td>Odds (player wins; equals the Ante)</td><td></td></tr>
                    <tr><td>Royal Flush</td><td>500 to 1</td></tr>
                    <tr><td>Straight Flush</td><td>50 to 1</td></tr>
                    <tr><td>Four of a Kind</td><td>10 to 1</td></tr>
                    <tr><td>Full House</td><td>3 to 1</td></tr>
                    <tr><td>Flush</td><td>3 to 2</td></tr>
                    <tr><td>Straight</td><td>1 to 1</td></tr>
                    <tr><td>Less than a Straight</td><td>Push</td></tr>
                    <tr class="sp-pt-hd"><td>Odds Bad Beat (player loses with)</td><td></td></tr>
                    <tr><td>Straight Flush</td><td>500 to 1</td></tr>
                    <tr><td>Four of a Kind</td><td>25 to 1</td></tr>
                    <tr><td>Full House</td><td>6 to 1</td></tr>
                    <tr><td>Flush</td><td>5 to 1</td></tr>
                    <tr><td>Straight</td><td>4 to 1</td></tr>
                    <tr class="sp-pt-hd"><td>Trips Plus (player's best 5 of 7)</td><td></td></tr>
                    <tr><td>Royal Flush</td><td>100 to 1</td></tr>
                    <tr><td>Straight Flush</td><td>40 to 1</td></tr>
                    <tr><td>Four of a Kind</td><td>30 to 1</td></tr>
                    <tr><td>Full House</td><td>8 to 1</td></tr>
                    <tr><td>Flush</td><td>7 to 1</td></tr>
                    <tr><td>Straight</td><td>4 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>3 to 1</td></tr>
                    <tr class="sp-pt-hd"><td>Pocket Bonus (player's 2 cards)</td><td></td></tr>
                    <tr><td>Pocket Aces</td><td>25 to 1</td></tr>
                    <tr><td>Ace-Face suited (A-K, A-Q, A-J)</td><td>20 to 1</td></tr>
                    <tr><td>Ace-Face</td><td>10 to 1</td></tr>
                    <tr><td>Pair</td><td>5 to 1</td></tr>
                </table>
                <p>Enter the winnings only (cents allowed). For a losing or pushed wager, tap Lose or Push (0 also counts as Lose).</p>
            </HelpContent>
        </GameBar>
    </div>
}
else if (_mode == TrainerMode.SettleBets)
{
    @* Settle the Bets in the payout modes' layout: the dealer's two cards
       and the board on the felt, with the 2 cards the dealer doesn't use
       already marked (dropped and darkened), then one row per player with
       their two cards and a Call button that pops Win / Lose / Push out
       beside it. Every player is on screen (no paging). *@
    <div class="play-screen sp-screen hp-screen cr-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Settle the Bets" Correct="_correctCount" Played="_totalRounds" />

        @* One player. The felt is laid out from the dealer's side of the
           table: the player's cards across the top, then the board, then the
           dealer's two cards at the bottom (nearest the dealer). The 2 cards
           the dealer doesn't use are already dimmed and dropped. Then one Call
           row for the player. *@
        <div class="felt cr-felt">
            @if (_hands.Count > 0)
            {
                HandState player = _hands[0];
                <div class="cr-cap">PLAYER</div>
                <div class="cr-lane cr-mid">
                    <img src="images/cards/@(player.Card1.Code).png" alt="@player.Card1.Name" />
                    <img src="images/cards/@(player.Card2.Code).png" alt="@player.Card2.Name" />
                </div>
            }
            <div class="cr-sep"></div>
            <div class="cr-cap">BOARD &middot; dimmed = not in the dealer's hand</div>
            <div class="cr-lane cr-board">
                @for (int i = 0; i < _community.Length; i++)
                {
                    Card? c = _community[i];
                    <img src="images/cards/@(c?.Code).png" alt="@c?.Name" class="@(_communityRotated[i] ? "cr-unused" : "")" />
                }
            </div>
            <div class="cr-cap">DEALER</div>
            <div class="cr-lane cr-mid">
                <img src="images/cards/@(_dealerCard1?.Code).png" alt="@_dealerCard1?.Name" class="@(_dealerCard1Rotated ? "cr-unused" : "")" />
                <img src="images/cards/@(_dealerCard2?.Code).png" alt="@_dealerCard2?.Name" class="@(_dealerCard2Rotated ? "cr-unused" : "")" />
            </div>
        </div>

        <div class="sp-wagers">
            @for (int h = 0; h < _hands.Count; h++)
            {
                int handIndex = h;
                HandState hand = _hands[handIndex];
                <CallRow Name="Player vs dealer" Options="WagerPick.WinLosePush"
                         Value="@hand.WagerSelection?.ToString()"
                         OnPick="k => PickOutcome(handIndex, Enum.Parse<WagerOutcome>(k))"
                         Locked="_roundScored" Wrong="hand.WagerWrong"
                         AnswerText="@($"{hand.ActualOutcome}")" />
            }
        </div>

        @* First round only: what to do *@
        @if (_totalRounds == 0 && !_roundScored)
        {
            <p class="cr-howto">Tap Call and pick Win, Lose or Push for the player against the dealer's hand, then Submit.</p>
        }

        <div class="feedback-area sp-feedback">
            @if (_roundScored)
            {
                @* After Submit: each player with the right answer and why *@
                <ResultBreakdown ResultText="@_resultText" IsCorrect="_isCorrect" Rows="_rows" />
            }
            else if (_resultText.Length > 0)
            {
                <p class="result-line txt-bad">@_resultText</p>
            }
        </div>

        @* Pinned bottom bar: Help | Submit (once every player is called),
           then Next | End Session *@
        <GameBar HelpTitle="Hand Rankings" OnEnd="EndSession">
            <ChildContent>
                @if (!_roundScored)
                {
                    <button class="game-bar-main" @onclick="SubmitAndShow" disabled="@(!(_submitEnabled && AllHandsAnswered))">Submit</button>
                }
                else
                {
                    <button class="game-bar-main" @onclick="NextFromTop" disabled="@(!_dealEnabled)">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <p>Head's-Up Hold'em: the player and the dealer each use their two cards plus the five community cards to make the best five-card poker hand.</p>
                <table class="help-table sp-help-table hw-table">
                    <tr class="sp-pt-hd"><td colspan="2">Hand Rankings (highest first)</td></tr>
                    <tr><td>1</td><td>Royal Flush</td></tr>
                    <tr><td>2</td><td>Straight Flush</td></tr>
                    <tr><td>3</td><td>Four of a Kind</td></tr>
                    <tr><td>4</td><td>Full House</td></tr>
                    <tr><td>5</td><td>Flush</td></tr>
                    <tr><td>6</td><td>Straight</td></tr>
                    <tr><td>7</td><td>Three of a Kind</td></tr>
                    <tr><td>8</td><td>Two Pair</td></tr>
                    <tr><td>9</td><td>One Pair</td></tr>
                    <tr><td>10</td><td>High Card</td></tr>
                </table>
            </HelpContent>
        </GameBar>
    </div>
}
else
{
    @* Identify the Hands *@
    <div class="play-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Identify the Hands" Correct="_correctCount" Played="_totalRounds" />

        @* One stage: the board on top, the dealer's 2 cards below (the
           same felt as the other Hold'em modes). Tap the 2 cards the dealer
           doesn't use -- they dim and drop; tap again to un-mark -- then
           Submit. Graded on the cards: a wrong pair is a miss. After a miss
           the right 2 are dimmed and any card that should have played is
           outlined red. The feedback gives the hand the way a dealer calls
           it, e.g. "Two Pair, A's and 4's, K kicker". *@
        <div class="felt cr-felt id-felt">
            <div class="cr-cap">BOARD</div>
            <div class="cr-lane cr-board">
                @for (int i = 0; i < _community.Length; i++)
                {
                    int communityIndex = i;
                    Card? c = _community[communityIndex];
                    <img src="images/cards/@(c?.Code).png" alt="@c?.Name"
                         @onclick="() => ToggleCommunityRotation(communityIndex)"
                         class="@(_communityRotated[communityIndex] ? "cr-unused" : "") @(IdWrongDrop(c) ? "id-wrong" : "") @(CanMarkCards ? "id-tap" : "")" />
                }
            </div>
            <div class="cr-sep"></div>
            <div class="cr-cap">DEALER</div>
            <div class="cr-lane cr-mid">
                <img src="images/cards/@(_dealerCard1?.Code).png" alt="@_dealerCard1?.Name"
                     @onclick="() => ToggleDealerCard(1)"
                     class="@(_dealerCard1Rotated ? "cr-unused" : "") @(IdWrongDrop(_dealerCard1) ? "id-wrong" : "") @(CanMarkCards ? "id-tap" : "")" />
                <img src="images/cards/@(_dealerCard2?.Code).png" alt="@_dealerCard2?.Name"
                     @onclick="() => ToggleDealerCard(2)"
                     class="@(_dealerCard2Rotated ? "cr-unused" : "") @(IdWrongDrop(_dealerCard2) ? "id-wrong" : "") @(CanMarkCards ? "id-tap" : "")" />
            </div>
        </div>

        <div class="feedback-area">
            @if (_roundScored)
            {
                <ResultBreakdown ResultText="@_resultText" IsCorrect="_isCorrect" Rows="_rows" />
            }
            else
            {
                <p class="id-caption">@(SbRotatedCount == 2
                    ? "2 cards marked. Tap a card again to change it, or Submit."
                    : "Tap the 2 cards the dealer doesn't use, then Submit.")</p>
            }
        </div>

        @if (_showReveal)
        {
            <RevealPopup Title="Dealer's Hand" OnClose="() => _showReveal = false">
                <p class="reveal-answer">@HandEvaluator.DescribeHand(DealerPool())</p>
                <p><strong>Best 5 cards:</strong>
                    @foreach (Card c in OrderForShow(_revealBest))
                    {
                        <span class="reveal-card @(IsRedSuit(c) ? "reveal-red" : "")">@CardLabel(c)</span>
                    }
                </p>
                <p><strong>Not used:</strong>
                    @foreach (Card c in OrderForShow(DealerPool().Where(c => !_revealBest.Contains(c)).ToList()))
                    {
                        <span class="reveal-card @(IsRedSuit(c) ? "reveal-red" : "")">@CardLabel(c)</span>
                    }
                </p>
            </RevealPopup>
        }

        @* Pinned bottom bar: Help | (Identify the Hands: Reveal) Submit, then
           Deal | End Session. Submit is enabled once every player hand is
           called (Settle the Bets) or the hand is set (Identify the Hands). *@
        @* Identify the Hands has four buttons (with Reveal): "End" keeps
           them all at full size on a phone *@
        <GameBar HelpTitle="Hand Rankings" OnEnd="EndSession"
                 EndLabel="@(_mode == TrainerMode.IdentifyHands ? "End" : "End Session")">
            <ChildContent>
                @if (!_roundScored)
                {
                    @if (_mode == TrainerMode.IdentifyHands)
                    {
                        <button class="reveal-button" @onclick="RevealIdentify">Reveal</button>
                    }
                    <button class="game-bar-main" @onclick="SubmitAndShow"
                            disabled="@(!(_submitEnabled && (_mode == TrainerMode.IdentifyHands ? SbRotatedCount == 2 : AllHandsAnswered)))">Submit</button>
                }
                else
                {
                    <button class="game-bar-main" @onclick="NextFromTop" disabled="@(!_dealEnabled)">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <p>Head's-Up Hold'em: the player and the dealer each use their two cards plus the five community cards to make the best five-card poker hand.</p>
                <table class="help-table sp-help-table hw-table">
                    <tr class="sp-pt-hd"><td colspan="2">Hand Rankings (highest first)</td></tr>
                    <tr><td>1</td><td>Royal Flush</td></tr>
                    <tr><td>2</td><td>Straight Flush</td></tr>
                    <tr><td>3</td><td>Four of a Kind</td></tr>
                    <tr><td>4</td><td>Full House</td></tr>
