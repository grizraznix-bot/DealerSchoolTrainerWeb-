@page "/holdem-trainer"
@using DealerSchoolTrainerWeb.Core
@using DealerSchoolTrainerWeb.Games.HoldemTrainer
@implements IDisposable
@inject GameResetService GameReset
@inject IJSRuntime JS

<PageTitle>Heads-Up Hold'em</PageTitle>

@if (!_started)
{
    <div class="start-screen">
        <h1>HEADS-UP HOLD'EM</h1>

        @* Each mode is a collapsible card: tap its title to open its
           settings and its own Start button (one card open at a time).
           Settle the Bets is played Call Only or Call & Pay. *@
        <div class="mode-list">
            <ModeCard Title="Identify the Hands"
                      Description="The board and the dealer's 2 cards are dealt. Tap the 2 cards that are NOT part of the dealer's best 5-card hand, then Submit."
                      Expanded="@IsModeOpen(TrainerMode.IdentifyHands)"
                      OnToggle="() => ToggleMode(TrainerMode.IdentifyHands)"
                      OnStart="StartGame" />

            <ModeCard Title="Settle the Bets"
                      Description="The board and both hands are dealt; the dealer's 2 unused cards are dimmed. Settle the Raise, Ante, Odds, Trips Plus and Pocket Bonus in order, then Submit."
                      Expanded="@IsModeOpen(TrainerMode.Settle)"
                      OnToggle="() => ToggleMode(TrainerMode.Settle)"
                      OnStart="StartGame">
                <PayoutChoice @bind-Pay="_hpPay"
                              CallText="Call each wager Win, Lose or Push."
                              PayText="Call each wager, then pay the winners." />
            </ModeCard>
        </div>
    </div>
}
else if (_mode == TrainerMode.Settle)
{
    @* Settle the Bets, played Call Only or Call & Pay. The board on top
       (the dealer's 2 unused cards dimmed, wherever they are), then the
       dealer's and player's hole cards side by side. Call & Pay: tap a
       hand for a bubble with its rank (the dealer's adds OPENS / DOESN'T
       OPEN); until the first tap this session the board caption fades
       between the dimmed-card note and the tap prompt. Call Only: no
       ranks -- who wins is the skill. After Submit each rank shows under
       its caption. *@
    <div class="play-screen sp-screen hp-screen has-game-bar @(_hpPay ? "" : "cr-screen") @(_hpBox >= 0 ? "uc-open" : "")">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Settle the Bets" Correct="_hpCorrect" Played="_hpPlayed" />

        <div class="felt hp-felt">
            @if (!_hpPay || _hpPeekUsed || _hpScored)
            {
                <div class="cr-cap hp-board-cap">BOARD &middot; dimmed = not in dealer's hand</div>
            }
            else
            {
                <div class="cr-cap hp-board-cap pp-alt" @key="@_hpDealNo">
                    <span class="pp-alt-a">BOARD &middot; dimmed = not in dealer's hand</span>
                    <span class="pp-alt-b">Tap Dealer or Player cards for rank</span>
                </div>
            }
            <div class="hp-cards">
                @foreach (Card c in _hpRound.Board)
                {
                    <img src="images/cards/@(c.Code).png" alt="@c.Name" class="hp-card @(HpDealerUnused(c) ? "hp-unused" : "")" />
                }
            </div>
            <div class="hp-pair">
                @foreach (bool isDealer in new[] { true, false })
                {
                    bool dealerHand = isDealer;
                    string rank = isDealer ? _hpRound.DealerHand : _hpRound.PlayerHand;
                    Card[] hole = isDealer ? _hpRound.DealerCards : _hpRound.PlayerCards;
                    bool canPeek = _hpPay && !_hpScored && _hpBox < 0;
                    bool peekOpen = canPeek && _hpPeek == (isDealer ? 2 : 1);
                    <div class="hp-hand @(canPeek ? "hp-tap" : "") @(peekOpen ? "hp-tap-on" : "")"
                         role="@(canPeek ? "button" : null)"
                         @onclick="() => HpTogglePeek(dealerHand)">
                        @if (peekOpen)
                        {
                            <div class="hp-bub">
                                <div>@rank</div>
                                @if (isDealer)
                                {
                                    <span class="tp-qtag @(_hpRound.DealerOpens ? "" : "tp-qtag-no")">@(_hpRound.DealerOpens ? "OPENS" : "DOESN'T OPEN")</span>
                                }
                            </div>
                        }
                        <div class="cr-cap">@(isDealer ? "DEALER" : "PLAYER")</div>
                        @if (_hpScored)
                        {
                            <div class="hp-rank">
                                @rank
                                @if (isDealer)
                                {
                                    <span class="tp-qtag @(_hpRound.DealerOpens ? "" : "tp-qtag-no")">@(_hpRound.DealerOpens ? "OPENS" : "DOESN'T OPEN")</span>
                                }
                            </div>
                        }
                        <div class="hp-cards">
                            @foreach (Card c in hole)
                            {
                                <img src="images/cards/@(c.Code).png" alt="@c.Name" class="hp-card @(isDealer && HpDealerUnused(c) ? "hp-unused" : "")" />
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        @if (_hpPeek != 0 && !_hpScored)
        {
            <div class="cr-backdrop" @onclick="HpClosePeek"></div>
        }

        @* The five wagers in settling order, each with a Call button.
           Call & Pay: Raise and Ante are plain calls (even money); Pay on
           the Odds, or Win on Trips Plus / Pocket Bonus, opens that row's
           payout box (cents allowed) and hides the other rows. *@
        <div class="sp-wagers">
            @for (int w = 0; w < 5; w++)
            {
                int wi = w;
                int wager = _hpRound.Wagers[wi];
                string sub = wi == HdPayoutRound.Raise ? $"${wager} · {_hpRound.RaiseTiming}" : $"wager ${wager}";

                @if (_hpBox >= 0 && wi != _hpBox)
                {
                    continue;
                }

                @if (wi == _hpBox)
                {
                    @* The open payout box: the number pad below is  1-9 / . 0 Enter
                       with the backspace inside the box; a computer keyboard
                       types straight in, Enter confirms, Esc cancels *@
                    <div class="sp-wrow uc-boxrow">
                        <div class="sp-chip @CallRow.ChipCss(wager)">$@wager</div>
                        <div class="sp-wname">@HdPayoutRound.Names[wi]<small>@sub</small></div>
                        <label class="uc-amt">
                            <span class="uc-dollar">$</span>
                            <input type="text"
                                   inputmode="none"
                                   autocomplete="off"
                                   aria-label="@($"{HdPayoutRound.Names[wi]} payout")"
                                   placeholder="Payout"
                                   value="@_hpBoxText"
                                   @oninput="HpBoxInput"
                                   @onkeydown="HpBoxKeyDown"
                                   @ref="_hpBoxInputRef" />
                            <button type="button" class="uc-bs" aria-label="Backspace" @onclick="HpBoxBackspace">&#x232B;</button>
                        </label>
                    </div>
                    continue;
                }

                <CallRow Chip="@(!_hpPay)" ChipAmount="@(_hpPay ? wager : null)"
                         Name="@HdPayoutRound.Names[wi]"
                         Sub="@(_hpPay ? sub : null)"
                         Options="@HpOptionsFor(wi)"
                         Value="@_hpCall[wi]"
                         PickedText="@HpPickedText(wi)"
                         OnPick="k => HpPick(wi, k)"
                         Locked="_hpScored" Wrong="!_hpOk[wi]" AnswerText="@HpAnswerText(wi)" />
            }
        </div>

        @if (_hpBox >= 0)
        {
            <div class="uc-keypad">
                <NumericKeypad AllowDecimal="true" MaxDecimalDigits="2" BackspaceInBox="true" @bind-Value="HpBoxText"
                               OnEnter="HpBoxEnter" EnterLabel="Enter" EnterDisabled="@(HpCents(_hpBoxText) is null)" />
            </div>
        }
        else if (_hpPlayed == 0 && !_hpScored)
        {
            @* First round only: what to do *@
            <p class="cr-howto">@(_hpPay
                ? "Tap Call on each wager. Pay on the Odds, or Win on Trips Plus or Pocket Bonus, opens its payout box."
                : "Tap Call on each wager and pick Win, Lose or Push, then Submit.")</p>
        }

        <div class="feedback-area sp-feedback">
            @if (_hpScored)
            {
                <ResultBreakdown ResultText="@_hpResultText" IsCorrect="_hpOk.All(o => o)" Rows="_hpRows" />
            }
        </div>

        @if (_hpPay)
        {
            @* Desktop: pay tables always in view (phones: in Help) *@
            <aside class="sp-paytable tp-paytable">
                <table class="sp-pt">
                    <tr class="sp-pt-hd"><td colspan="2">Raise &amp; Ante</td></tr>
                    <tr><td>Player wins</td><td>1 to 1</td></tr>
                    <tr><td>Tie</td><td>Push</td></tr>
                    <tr><td colspan="2" class="tp-pt-wide">Dealer doesn't open (needs a pair): Ante pushes. Raise: 3x pre-flop, 2x after the flop, 1x after the river.</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">Odds (player wins)</td></tr>
                    <tr><td>Royal Flush</td><td>500 to 1</td></tr>
                    <tr><td>Straight Flush</td><td>50 to 1</td></tr>
                    <tr><td>Four of a Kind</td><td>10 to 1</td></tr>
                    <tr><td>Full House</td><td>3 to 1</td></tr>
                    <tr><td>Flush</td><td>3 to 2</td></tr>
                    <tr><td>Straight</td><td>1 to 1</td></tr>
                    <tr><td>Less than a Straight</td><td>Push</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">Odds Bad Beat (player loses)</td></tr>
                    <tr><td>Straight Flush</td><td>500 to 1</td></tr>
                    <tr><td>Four of a Kind</td><td>25 to 1</td></tr>
                    <tr><td>Full House</td><td>6 to 1</td></tr>
                    <tr><td>Flush</td><td>5 to 1</td></tr>
                    <tr><td>Straight</td><td>4 to 1</td></tr>
                </table>
                <table class="sp-pt">
                    <tr class="sp-pt-hd"><td colspan="2">Trips Plus</td></tr>
                    <tr><td>Royal Flush</td><td>100 to 1</td></tr>
                    <tr><td>Straight Flush</td><td>40 to 1</td></tr>
                    <tr><td>Four of a Kind</td><td>30 to 1</td></tr>
                    <tr><td>Full House</td><td>8 to 1</td></tr>
                    <tr><td>Flush</td><td>7 to 1</td></tr>
                    <tr><td>Straight</td><td>4 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>3 to 1</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">Pocket Bonus</td></tr>
                    <tr><td>Pocket Aces</td><td>25 to 1</td></tr>
                    <tr><td>Ace-Face suited</td><td>20 to 1</td></tr>
                    <tr><td>Ace-Face</td><td>10 to 1</td></tr>
                    <tr><td>Pair</td><td>5 to 1</td></tr>
                </table>
                <p class="sp-pt-note">Winnings only. Ace-Face = A-K, A-Q or A-J.</p>
            </aside>
        }

        @* Pinned bottom bar: the main button counts the wagers left until
           every one is called; while a payout box is open, End Session
           becomes Cancel *@
        <GameBar HelpTitle="Hold'em Pay Tables" OnEnd="HpEndOrCancel"
                 EndLabel="@(_hpBox >= 0 ? "Cancel" : "End Session")"
                 EndClass="@(_hpBox >= 0 ? "game-bar-cancel" : "")">
            <ChildContent>
                @if (!_hpScored)
                {
                    int left = HpWagersLeft;
                    @if (left > 0 || _hpBox >= 0)
                    {
                        <button class="game-bar-main" disabled>
                            <span class="gb-left-long">@left @(left == 1 ? "wager" : "wagers") left</span><span class="gb-left-short">@left left</span>
                        </button>
                    }
                    else
                    {
                        <button class="game-bar-main" @onclick="HpSubmitAndShow">Submit</button>
                    }
                }
                else
                {
                    <button class="game-bar-main" @onclick="HpNextTop">Next</button>
                }
            </ChildContent>
            <HelpContent>
                @if (_hpPay)
                {
                    <p>Tap the Dealer or Player cards to see that hand's rank (and whether the dealer opens). Dimmed cards are the 2 the dealer doesn't use.</p>
                }
                else
                {
                    <p>Dimmed cards are the 2 the dealer doesn't use.</p>
                }
                <table class="help-table sp-help-table">
                    <tr class="sp-pt-hd"><td colspan="2">Raise &amp; Ante</td></tr>
                    <tr><td>Player wins</td><td>Both 1 to 1</td></tr>
                    <tr><td>Dealer doesn't open (needs a pair)</td><td>Ante push</td></tr>
                    <tr><td>Tie</td><td>Push</td></tr>
                    <tr><td>Raise size</td><td>3x / 2x / 1x</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">Odds (player wins; equals the Ante)</td></tr>
                    <tr><td>Royal Flush</td><td>500 to 1</td></tr>
                    <tr><td>Straight Flush</td><td>50 to 1</td></tr>
                    <tr><td>Four of a Kind</td><td>10 to 1</td></tr>
                    <tr><td>Full House</td><td>3 to 1</td></tr>
                    <tr><td>Flush</td><td>3 to 2</td></tr>
                    <tr><td>Straight</td><td>1 to 1</td></tr>
                    <tr><td>Less than a Straight</td><td>Push</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">Odds Bad Beat (player loses with)</td></tr>
                    <tr><td>Straight Flush</td><td>500 to 1</td></tr>
                    <tr><td>Four of a Kind</td><td>25 to 1</td></tr>
                    <tr><td>Full House</td><td>6 to 1</td></tr>
                    <tr><td>Flush</td><td>5 to 1</td></tr>
                    <tr><td>Straight</td><td>4 to 1</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">Trips Plus (player's best 5 of 7)</td></tr>
                    <tr><td>Royal Flush</td><td>100 to 1</td></tr>
                    <tr><td>Straight Flush</td><td>40 to 1</td></tr>
                    <tr><td>Four of a Kind</td><td>30 to 1</td></tr>
                    <tr><td>Full House</td><td>8 to 1</td></tr>
                    <tr><td>Flush</td><td>7 to 1</td></tr>
                    <tr><td>Straight</td><td>4 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>3 to 1</td></tr>
                    <tr class="sp-pt-hd"><td colspan="2">Pocket Bonus (player's 2 cards)</td></tr>
                    <tr><td>Pocket Aces</td><td>25 to 1</td></tr>
                    <tr><td>Ace-Face suited (A-K, A-Q, A-J)</td><td>20 to 1</td></tr>
                    <tr><td>Ace-Face</td><td>10 to 1</td></tr>
                    <tr><td>Pair</td><td>5 to 1</td></tr>
                </table>
                @if (_hpPay)
                {
                    <p>Call the Raise and Ante Win, Lose or Push (they pay even money). Pay on the Odds, or Win on Trips Plus or Pocket Bonus, opens its payout box: enter the winnings only (cents allowed), then Enter. Entering 0 counts as Lose; Cancel puts the wager back to Call.</p>
                    <p>For practice, big hands and Bad Beats come up more often than at a live table.</p>
                }
                else
                {
                    <p>Call each wager Win, Lose or Push from the tables above. The Odds wins on a Bad Beat even when the player loses.</p>
                }
            </HelpContent>
        </GameBar>
    </div>
}
else
{
    @* Identify the Hands *@
    <div class="play-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Identify the Hands" Correct="_correctCount" Played="_totalRounds" />

        @* One stage: the board on top, the dealer's 2 cards below (the
           same felt as the other Hold'em modes). Tap the 2 cards the dealer
           doesn't use -- they dim and drop; tap again to un-mark -- then
           Submit. Graded on the cards: a wrong pair is a miss. After a miss
           the right 2 are dimmed and any card that should have played is
           outlined red. The feedback gives the hand the way a dealer calls
           it, e.g. "Two Pair, A's and 4's, K kicker". *@
        <div class="felt cr-felt id-felt">
            <div class="cr-cap">BOARD</div>
            <div class="cr-lane cr-board">
                @for (int i = 0; i < _community.Length; i++)
                {
                    int communityIndex = i;
                    Card? c = _community[communityIndex];
                    <img src="images/cards/@(c?.Code).png" alt="@c?.Name"
                         @onclick="() => ToggleCommunityRotation(communityIndex)"
                         class="@(_communityRotated[communityIndex] ? "cr-unused" : "") @(IdWrongDrop(c) ? "id-wrong" : "") @(CanMarkCards ? "id-tap" : "")" />
                }
            </div>
            <div class="cr-sep"></div>
            <div class="cr-cap">DEALER</div>
            <div class="cr-lane cr-mid">
                <img src="images/cards/@(_dealerCard1?.Code).png" alt="@_dealerCard1?.Name"
                     @onclick="() => ToggleDealerCard(1)"
                     class="@(_dealerCard1Rotated ? "cr-unused" : "") @(IdWrongDrop(_dealerCard1) ? "id-wrong" : "") @(CanMarkCards ? "id-tap" : "")" />
                <img src="images/cards/@(_dealerCard2?.Code).png" alt="@_dealerCard2?.Name"
                     @onclick="() => ToggleDealerCard(2)"
                     class="@(_dealerCard2Rotated ? "cr-unused" : "") @(IdWrongDrop(_dealerCard2) ? "id-wrong" : "") @(CanMarkCards ? "id-tap" : "")" />
            </div>
        </div>

        <div class="feedback-area">
            @if (_roundScored)
            {
                <ResultBreakdown ResultText="@_resultText" IsCorrect="_isCorrect" Rows="_rows" />
            }
            else
            {
                <p class="id-caption">@(SbRotatedCount == 2
                    ? "2 cards marked. Tap a card again to change it, or Submit."
                    : "Tap the 2 cards the dealer doesn't use, then Submit.")</p>
            }
        </div>

        @if (_showReveal)
        {
            <RevealPopup Title="Dealer's Hand" OnClose="() => _showReveal = false">
                <p class="reveal-answer">@HandEvaluator.DescribeHand(DealerPool())</p>
                <p><strong>Best 5 cards:</strong>
                    @foreach (Card c in OrderForShow(_revealBest))
                    {
                        <span class="reveal-card @(IsRedSuit(c) ? "reveal-red" : "")">@CardLabel(c)</span>
                    }
                </p>
                <p><strong>Not used:</strong>
                    @foreach (Card c in OrderForShow(DealerPool().Where(c => !_revealBest.Contains(c)).ToList()))
                    {
                        <span class="reveal-card @(IsRedSuit(c) ? "reveal-red" : "")">@CardLabel(c)</span>
                    }
                </p>
            </RevealPopup>
        }

        @* Pinned bottom bar: Help | Reveal | Submit, then Next | End.
           Submit is enabled once 2 cards are marked. *@
        @* Identify the Hands has four buttons (with Reveal): "End" keeps
           them all at full size on a phone *@
        <GameBar HelpTitle="Hand Rankings" OnEnd="EndSession" EndLabel="End">
            <ChildContent>
                @if (!_roundScored)
                {
                    <button class="reveal-button" @onclick="RevealIdentify">Reveal</button>
                    <button class="game-bar-main" @onclick="SubmitAndShow"
                            disabled="@(!(_submitEnabled && SbRotatedCount == 2))">Submit</button>
                }
                else
                {
                    <button class="game-bar-main" @onclick="NextFromTop" disabled="@(!_dealEnabled)">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <p>Tap the 2 cards the dealer doesn't use, then Submit.</p>
                <p>Heads-Up Hold'em: the player and the dealer each use their two cards plus the five community cards to make the best five-card poker hand.</p>
                <table class="help-table sp-help-table hw-table">
                    <tr class="sp-pt-hd"><td colspan="2">Hand Rankings (highest first)</td></tr>
                    <tr><td>1</td><td>Royal Flush</td></tr>
                    <tr><td>2</td><td>Straight Flush</td></tr>
                    <tr><td>3</td><td>Four of a Kind</td></tr>
                    <tr><td>4</td><td>Full House</td></tr>
                    <tr><td>5</td><td>Flush</td></tr>
                    <tr><td>6</td><td>Straight</td></tr>
                    <tr><td>7</td><td>Three of a Kind</td></tr>
                    <tr><td>8</td><td>Two Pair</td></tr>
                    <tr><td>9</td><td>One Pair</td></tr>
                    <tr><td>10</td><td>High Card</td></tr>
                </table>
            </HelpContent>
        </GameBar>
    </div>
}

@if (_showSessionSummary)
{
    @switch (_mode)
    {
        case TrainerMode.Settle:
            @* Each way of playing keeps its own "last time" progress (the
               keys of the old separate modes) *@
            @if (_hpPay)
            {
                <SessionSummary ModeKey="hd-payouts" Rounds="_hpPlayed" Correct="_hpCorrect" Log="_log"
                                RightText="paid right" ConfidentText="You're paying these with confidence" YouVerb="paid"
                                OnAgain="PracticeAgain" OnDone="CloseSummary" />
            }
            else
            {
                <SessionSummary ModeKey="hd-settle" Rounds="_hpPlayed" Correct="_hpCorrect" Log="_log"
                                RightText="rounds right" ConfidentText="You're calling these with confidence" YouVerb="called"
                                OnAgain="PracticeAgain" OnDone="CloseSummary" />
            }
            break;
        default:
            <SessionSummary ModeKey="hd-identify" Rounds="_totalRounds" Correct="_correctCount" Log="_log"
                            RightText="read right" ConfidentText="You're reading these with confidence" YouVerb="picked"
                            OnAgain="PracticeAgain" OnDone="CloseSummary" />
            break;
    }
}

@code {
    // Menu link for this game tapped while it's already open: return to
    // the start screen, same as the Back button (hidden on phones).
    protected override void OnInitialized()
    {
        GameReset.ResetRequested += OnResetRequested;
    }

    private void OnResetRequested()
    {
        _showSessionSummary = false;
        _started = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameReset.ResetRequested -= OnResetRequested;
    }

    // Scroll back to the top whenever this game switches between its
    // start screen and its play screen (Start, Back, menu, End Session).
    // Without this the browser keeps the old scroll position -- after
    // scrolling down to reach Start, the game would open scrolled down.
    private bool _lastRenderedStarted;

    private bool _scrollToSummary;

    // Bar buttons: Submit also scrolls to the feedback; Next also
    // scrolls back to the top
    private void SubmitAndShow()
    {
        SubmitRound();
        if (_roundScored) _scrollToFeedback = true;
    }

    private void NextFromTop()
    {
        DealAgain();
        _scrollToTopAfterNext = true;
    }

    private bool _scrollToFeedback;
    private bool _scrollToTopAfterNext;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Submit: bring the feedback box into view (if it isn't already).
        // Next: back to the top for the new hand.
        if (_scrollToFeedback)
        {
            _scrollToFeedback = false;
            try { await JS.InvokeVoidAsync("dstRevealFeedback"); } catch { }
        }

        if (_scrollToTopAfterNext)
        {
            _scrollToTopAfterNext = false;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }
        }

        // End Session: bring the Session Summary into view (it's at the
        // bottom of the page, often below the screen on a phone)
        if (_scrollToSummary && _showSessionSummary)
        {
            _scrollToSummary = false;
            try { await JS.InvokeVoidAsync("dstScrollToEl", ".session-summary"); } catch { }
        }

        if (_started != _lastRenderedStarted)
        {
            _lastRenderedStarted = _started;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }
        }

        // Settle the Bets: the cursor into an open payout box (a computer
        // keyboard types there)
        if (_hpFocusBox && _hpBox >= 0)
        {
            _hpFocusBox = false;
            try { await _hpBoxInputRef.FocusAsync(preventScroll: true); } catch { }
        }
    }

    private const int CommunityCount = 5;

    private enum TrainerMode { IdentifyHands, Settle }

    private bool _started;
    private TrainerMode _mode = TrainerMode.IdentifyHands;

    // Start screen: which mode card is open (null = all closed). Opening
    // a card also selects its mode, so that card's Start button starts
    // it. The open card stays open after a session, so a returning
    // trainee lands right back on the mode they were using.
    private TrainerMode? _openMode;

    private bool IsModeOpen(TrainerMode mode) => _openMode == mode;

    private void ToggleMode(TrainerMode mode)
    {
        _openMode = _openMode == mode ? null : mode;
        if (_openMode is not null) _mode = mode;
    }

    private Deck _deck = new();
    private readonly Card?[] _community = new Card?[CommunityCount];

    private int _correctCount;
    private int _totalRounds;
    private bool _roundScored;

    private bool _submitEnabled;
    private bool _dealEnabled;
    private string _resultText = string.Empty;
    private bool _isCorrect;

    // After Submit: the dealer's-hand line for the feedback box
    private readonly List<BreakdownRow> _rows = new();
    private string _scoreText = "Score: 0 / 0 (0.0%)";
    private bool _showSessionSummary;

    // Identify the Hands: the dealer's hole cards and which cards are marked
    private Card? _dealerCard1;
    private Card? _dealerCard2;
    private bool _dealerCard1Rotated;
    private bool _dealerCard2Rotated;
    private readonly bool[] _communityRotated = new bool[CommunityCount];

    // Cards can be marked until Submit
    private bool CanMarkCards => _mode == TrainerMode.IdentifyHands && !_roundScored;

    // How many of the 7 dealer cards (2 dealer + 5 community) are marked
    // unused. Identify the Hands can only be submitted with exactly 2.
    private int SbRotatedCount =>
        (_dealerCard1Rotated ? 1 : 0) + (_dealerCard2Rotated ? 1 : 0) + _communityRotated.Count(r => r);

    // What happened this session, for the summary (Shared/SessionSummary)
    private SessionLog _log = new();

    // End-of-session summary's Practice Again: a fresh session of the same
    // mode, back at the top of the page (as if started from the start screen)
    private void PracticeAgain()
    {
        _showSessionSummary = false;
        StartGame();
        _lastRenderedStarted = false;
    }

    private void StartGame()
    {
        _log = new SessionLog();
        if (_mode == TrainerMode.Settle)
        {
            _started = true;
            HpStartGame();
            return;
        }

        _started = true;
        _correctCount = 0;
        _totalRounds = 0;
        _roundScored = false;
        _scoreText = "Score: 0 / 0 (0.0%)";

        DealNewRound();
    }

    private void BackToStart() => _started = false;

    private void DealNewRound()
    {
        _showReveal = false;
        _dealEnabled = false;

        _deck = new Deck();
        _deck.Shuffle();

        for (int i = 0; i < CommunityCount; i++)
            _community[i] = _deck.Draw();

        Array.Clear(_communityRotated);
        _dealerCard1Rotated = false;
        _dealerCard2Rotated = false;
        _idWrongDrops.Clear();

        _dealerCard1 = _deck.Draw();
        _dealerCard2 = _deck.Draw();

        _resultText = string.Empty;
        _rows.Clear();
        _roundScored = false;
        _submitEnabled = true;
    }

    private void DealAgain() => DealNewRound();

    // Identify the Hands: tap marks / un-marks a card; at most 2 marked
    private void ToggleCommunityRotation(int index)
    {
        if (!CanMarkCards) return;
        if (!_communityRotated[index] && SbRotatedCount >= 2) return;
        _communityRotated[index] = !_communityRotated[index];
    }

    private void ToggleDealerCard(int which)
    {
        if (!CanMarkCards) return;
        bool marked = which == 1 ? _dealerCard1Rotated : _dealerCard2Rotated;
        if (!marked && SbRotatedCount >= 2) return;
        if (which == 1) _dealerCard1Rotated = !_dealerCard1Rotated;
        else _dealerCard2Rotated = !_dealerCard2Rotated;
    }

    // After a wrong Submit: the cards the trainee dropped that the dealer's
    // best hand uses (outlined red on the felt)
    private readonly List<Card> _idWrongDrops = new();

    private bool IdWrongDrop(Card? c) => c is not null && _idWrongDrops.Contains(c);

    // The cards the trainee marked unused
    private List<Card> MarkedCards()
    {
        List<Card> marked = new();
        if (_dealerCard1Rotated) marked.Add(_dealerCard1!);
        if (_dealerCard2Rotated) marked.Add(_dealerCard2!);
        for (int i = 0; i < CommunityCount; i++)
            if (_communityRotated[i]) marked.Add(_community[i]!);
        return marked;
    }

    // The 7 cards the dealer's hand is made from: 2 dealer + 5 community.
    private List<Card> DealerPool() => new()
    {
        _dealerCard1!, _dealerCard2!,
        _community[0]!, _community[1]!, _community[2]!, _community[3]!, _community[4]!
    };

    // The 5 cards left unmarked -- the dealer hand as the trainee set it.
    private List<Card> DeclaredDealerHand()
    {
        List<Card> declared = new();
        if (!_dealerCard1Rotated) declared.Add(_dealerCard1!);
        if (!_dealerCard2Rotated) declared.Add(_dealerCard2!);
        for (int i = 0; i < CommunityCount; i++)
            if (!_communityRotated[i]) declared.Add(_community[i]!);
        return declared;
    }

    // Correct only if the 5 unmarked cards are the dealer's best possible
    // 5-card hand, kickers included. Compared by full hand score, so when
    // two different sets of 5 score exactly the same (e.g. a straight
    // entirely on the board), either one counts.
    private bool DeclaredHandIsBest()
    {
        List<Card> declared = DeclaredDealerHand();
        if (declared.Count != 5) return false;
        long best = HandEvaluator.HandScore(HandEvaluator.BestFiveCards(DealerPool()));
        return HandEvaluator.HandScore(declared) == best;
    }

    // Identify the Hands, Reveal button: set the hand and rank correctly,
    // show them in a pop-up, and score the round as a miss
    private bool _showReveal;
    private List<Card> _revealBest = new();
    private HandRank _revealRank;

    private void RevealIdentify()
    {
        if (_mode != TrainerMode.IdentifyHands || _roundScored) return;

        _revealBest = HandEvaluator.BestFiveCards(DealerPool());
        _revealRank = HandEvaluator.BestHandRank(DealerPool());

        MarkCorrectUnusedCards();
        _idWrongDrops.Clear();

        _totalRounds++;
        _isCorrect = false;
        _resultText = "REVEALED";
        _rows.Clear();
        _rows.Add(new BreakdownRow("Dealer's hand", "Revealed", HandEvaluator.DescribeHand(DealerPool()), false, DealerHandWhy()));
        _log.AddRows(_rows, r => HandEvaluator.HandRankName(_revealRank));

        string pct = ((double)_correctCount / _totalRounds).ToString("0.0%");
        _scoreText = $"Score: {_correctCount} / {_totalRounds} ({pct})";

        _roundScored = true;
        _submitEnabled = false;
        _dealEnabled = true;
        _showReveal = true;
    }

    // Identify the Hands feedback under the call: the 5 cards that make
    // the dealer's hand, e.g. "Best 5: K♠ K♥ 7♦ 7♣ A♠"
    private string DealerHandWhy()
    {
        List<Card> pool = DealerPool();
        string cards = string.Join(" ", OrderForShow(HandEvaluator.BestFiveCards(pool)).Select(CardLabel));
        return $"Best 5: {cards}";
    }

    // Pairs/trips first, then high to low (e.g. Q Q 5 5 A)
    private static List<Card> OrderForShow(List<Card> cards)
    {
        Dictionary<Rank, int> counts = cards.GroupBy(c => c.Rank).ToDictionary(g => g.Key, g => g.Count());
        return cards.OrderByDescending(c => counts[c.Rank]).ThenByDescending(c => (int)c.Rank).ToList();
    }

    private static bool IsRedSuit(Card c) => c.Suit is Suit.Hearts or Suit.Diamonds;

    // e.g. "10♥", "A♠"
    private static string CardLabel(Card c)
    {
        string rank = c.Rank switch
        {
            Rank.Ten => "10",
            Rank.Jack => "J",
            Rank.Queen => "Q",
            Rank.King => "K",
            Rank.Ace => "A",
            _ => ((int)c.Rank).ToString()
        };
        string suit = c.Suit switch
        {
            Suit.Spades => "\u2660",
            Suit.Hearts => "\u2665",
            Suit.Diamonds => "\u2666",
            _ => "\u2663"
        };
        return rank + suit;
    }

    // Marks exactly the 2 cards outside the dealer's best 5: Settle the
    // Bets deals with this already done.
    private void MarkCorrectUnusedCards()
    {
        List<Card> bestFive = HandEvaluator.BestFiveCards(DealerPool());
        _dealerCard1Rotated = !bestFive.Contains(_dealerCard1!);
        _dealerCard2Rotated = !bestFive.Contains(_dealerCard2!);
        for (int i = 0; i < CommunityCount; i++)
            _communityRotated[i] = !bestFive.Contains(_community[i]!);
    }

    private void SubmitRound() => SubmitIdentifyHands();

    // Identify the Hands: graded on the 2 marked cards. Right when the 5
    // left standing are the dealer's best hand (any equal-scoring set of 5
    // counts). A miss shows the right 2 dimmed, outlines in red the cards
    // that should have played, and compares the trainee's 5 with the best.
    private void SubmitIdentifyHands()
    {
        if (_roundScored || SbRotatedCount != 2) return;

        List<Card> pool = DealerPool();
        List<Card> best = HandEvaluator.BestFiveCards(pool);
        List<Card> declared = DeclaredDealerHand();
        bool ok = DeclaredHandIsBest();
        string call = HandEvaluator.DescribeHand(pool);

        _idWrongDrops.Clear();
        _rows.Clear();
        if (ok)
        {
            _rows.Add(new BreakdownRow("Dealer's hand", call, call, true, DealerHandWhy()));
        }
        else
        {
            _idWrongDrops.AddRange(MarkedCards().Where(best.Contains));
            string dropped = string.Join(" and ", OrderForShow(_idWrongDrops).Select(CardLabel));
            string bestCards = string.Join(" ", OrderForShow(best).Select(CardLabel));
            _rows.Add(new BreakdownRow("Dealer's hand", $"dropped the {dropped}", call, false,
                $"Your 5 make {HandEvaluator.DescribeHand(declared)}. Best 5: {bestCards}"));
            MarkCorrectUnusedCards();
        }
        _log.AddRows(_rows, r => HandEvaluator.HandRankName(HandEvaluator.BestHandRank(pool)));

        _totalRounds++;
        if (ok) _correctCount++;

        _isCorrect = ok;
        _resultText = ok ? "CORRECT" : "INCORRECT";

        string pct = ((double)_correctCount / _totalRounds).ToString("0.0%");
        _scoreText = $"Score: {_correctCount} / {_totalRounds} ({pct})";

        _roundScored = true;
        _submitEnabled = false;
        _dealEnabled = true;
    }

    private void EndSession()
    {
        if (_mode == TrainerMode.Settle ? _hpPlayed > 0 : _totalRounds > 0)
        {
            _showSessionSummary = true;
            _scrollToSummary = true;
        }
        else
        {
            _started = false;
        }
    }

    private void CloseSummary()
    {
        _showSessionSummary = false;
        _started = false;
    }

    // ============================================================
    // SETTLE THE BETS (Hp prefix) -- Call Only or Call & Pay
    // ============================================================

    // Start screen setting: false = Call Only, true = Call & Pay
    private bool _hpPay;

    private HdPayoutRound _hpRound = null!; // dealt by HpStartGame
    // The dealer's best five of 7 (hole cards + board), for dimming the
    // 2 cards the dealer doesn't use
    private List<Card> _hpDealerBest = new();

    private bool HpDealerUnused(Card c) => !_hpDealerBest.Contains(c);

    // Per wager (Raise, Ante, Odds, Trips Plus, Pocket Bonus): the call
    // ("Win", "Lose", "Push", or "Pay" on the Odds; null = not called yet)
    // and, Call & Pay, the payout entered in cents
    private readonly string?[] _hpCall = new string?[5];
    private readonly int?[] _hpPaid = new int?[5];
    private readonly bool[] _hpOk = new bool[5];

    private int _hpBox = -1;               // row whose payout box is open
    private string _hpBoxText = string.Empty;
    private ElementReference _hpBoxInputRef;
    private bool _hpFocusBox;
    private DateTime _hpEndBlockedUntil;

    private bool _hpScored;
    private string _hpResultText = string.Empty;
    private readonly List<BreakdownRow> _hpRows = new();
    private int _hpCorrect;
    private int _hpPlayed;

    private int HpWagersLeft => _hpCall.Count(c => c is null);

    // Tap-a-hand rank bubble (Call & Pay): 0 = closed, 1 = player,
    // 2 = dealer. _hpPeekUsed: tapped once this session, so the board
    // caption stops alternating with the tap prompt. _hpDealNo restarts
    // the caption fade on each deal.
    private int _hpPeek;
    private bool _hpPeekUsed;
    private int _hpDealNo;

    private void HpTogglePeek(bool dealer)
    {
        if (!_hpPay || _hpScored || _hpBox >= 0) return;
        int which = dealer ? 2 : 1;
        _hpPeek = _hpPeek == which ? 0 : which;
        _hpPeekUsed = true;
    }

    private void HpClosePeek() => _hpPeek = 0;

    private void HpStartGame()
    {
        _hpCorrect = 0;
        _hpPlayed = 0;
        _hpPeekUsed = false;
        HpNewRound();
    }

    // Call & Pay keeps the training boost (more Straights or better, some
    // Bad Beats); Call Only deals the natural mix
    private void HpNewRound()
    {
        _hpRound = HoldemPayouts.Deal(Random.Shared, boost: _hpPay);
        _hpPeek = 0;
        _hpDealNo++;
        _hpDealerBest = HandEvaluator.BestFiveCards(_hpRound.DealerCards.Concat(_hpRound.Board).ToList());
        for (int i = 0; i < 5; i++)
        {
            _hpCall[i] = null;
            _hpPaid[i] = null;
            _hpOk[i] = false;
        }
        _hpBox = -1;
        _hpBoxText = string.Empty;
        _hpScored = false;
        _hpResultText = string.Empty;
        _hpRows.Clear();
    }

    // Raise and Ante can push; so can the Odds. Trips Plus and Pocket
    // Bonus only win or lose. Call & Pay: the Odds is Pay / Push / Lose.
    private IReadOnlyList<WagerPickOption> HpOptionsFor(int i) =>
        i <= HdPayoutRound.Ante ? WagerPick.WinLosePush
        : i == HdPayoutRound.Odds ? (_hpPay ? WagerPick.PayPushLose : WagerPick.WinLosePush)
        : WagerPick.WinLose;

    // Call & Pay rows that take a payout: Odds, Trips Plus, Pocket Bonus
    private static bool HpTyped(int i) => i >= HdPayoutRound.Odds;

    // The right call: "Win", "Lose" or "Push"
    private static string HpCallText(HdPay pay) => pay.IsPush ? "Push" : pay.IsLose ? "Lose" : "Win";

    private void HpPick(int i, string key)
    {
        if (_hpScored) return;
        _hpPeek = 0;

        // Call & Pay: Pay on the Odds, or Win on Trips Plus / Pocket
        // Bonus, opens the payout box
        if (_hpPay && HpTyped(i) && (key == "Pay" || key == "Win"))
        {
            _hpCall[i] = null;
            _hpPaid[i] = null;
            _hpBox = i;
            _hpBoxText = string.Empty;
            _hpFocusBox = true;
            _scrollToTopAfterNext = true;
            return;
        }

        _hpCall[i] = key;
        _hpPaid[i] = null;
    }

    // ---- Payout box ----

    private string HpBoxText
    {
        get => _hpBoxText;
        set => _hpBoxText = HpAmountOnly(value);
    }

    private void HpBoxInput(ChangeEventArgs e) => _hpBoxText = HpAmountOnly(e.Value?.ToString());

    private void HpBoxBackspace()
    {
        if (_hpBoxText.Length > 0) _hpBoxText = _hpBoxText[..^1];
        _hpFocusBox = true;
    }

    private void HpBoxKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") HpBoxEnter();
        else if (e.Key == "Escape") HpBoxCancel();
    }

    // Enter: the amount goes on the row and the box closes; 0 counts as Lose
    private void HpBoxEnter()
    {
        if (_hpBox < 0 || HpCents(_hpBoxText) is not int cents) return;

        int i = _hpBox;
        _hpCall[i] = cents == 0 ? "Lose" : i == HdPayoutRound.Odds ? "Pay" : "Win";
        _hpPaid[i] = cents == 0 ? null : cents;
        HpCloseBox();
    }

    // Cancel: the row goes back to Call (no penalty)
    private void HpBoxCancel()
    {
        if (_hpBox < 0) return;
        _hpCall[_hpBox] = null;
        _hpPaid[_hpBox] = null;
        HpCloseBox();
    }

    private void HpCloseBox()
    {
        _hpBox = -1;
        _hpBoxText = string.Empty;
        _hpEndBlockedUntil = DateTime.UtcNow.AddMilliseconds(500);
    }

    private void HpEndOrCancel()
    {
        if (_hpBox >= 0)
        {
            HpBoxCancel();
            return;
        }
        if (DateTime.UtcNow < _hpEndBlockedUntil) return;
        EndSession();
    }

    // Dollars and cents (Odds pays 3 to 2 on a Flush): digits, one
    // decimal point, at most 2 decimal digits
    private static string HpAmountOnly(string? raw)
    {
        System.Text.StringBuilder sb = new();
        bool dot = false;
        int decimals = 0;
        foreach (char c in raw ?? string.Empty)
        {
            if (char.IsDigit(c))
            {
                if (dot) { if (decimals < 2) { sb.Append(c); decimals++; } }
                else if (sb.Length < 6) sb.Append(c);
            }
            else if (c == '.' && !dot)
            {
                sb.Append(c);
                dot = true;
            }
        }
        return sb.ToString();
    }

    // "7.5" -> 750 cents; null if not a number
    private static int? HpCents(string raw) =>
        decimal.TryParse(raw, System.Globalization.NumberStyles.AllowDecimalPoint, System.Globalization.CultureInfo.InvariantCulture, out decimal d)
            ? (int)Math.Round(d * 100m)
            : null;

    // Button / answer text once a payout is in, e.g. "Pay $7.50", "Win $30"
    private string? HpPickedText(int i) =>
        _hpPaid[i] is int c ? $"{_hpCall[i]} {HoldemPayouts.MoneyCents(c)}" : null;

    // ---- Submit ----

    // Submit also scrolls to the feedback
    private void HpSubmitAndShow()
    {
        HpSubmit();
        if (_hpScored) _scrollToFeedback = true;
    }

    private void HpSubmit()
    {
        if (_hpScored || _hpBox >= 0 || HpWagersLeft > 0) return;

        _hpRows.Clear();
        for (int i = 0; i < 5; i++)
        {
            HdPay pay = _hpRound.Pays[i];
            string right = HpCallText(pay);
            _hpOk[i] = _hpCall[i] switch
            {
                "Lose" => pay.IsLose,
                "Push" => pay.IsPush,
                "Pay" or "Win" => right == "Win" && (!_hpPay || !HpTyped(i) || _hpPaid[i] == pay.Cents),
                _ => false
            };

            // Call & Pay: a missed payout gets its shortcut under the reason
            string tip = _hpPay && HpTyped(i) && !_hpOk[i] && right == "Win"
                ? PayoutShortcut.For(_hpRound.Wagers[i] * 100L, pay.Cents) : "";
            _hpRows.Add(new BreakdownRow(HdPayoutRound.Names[i], HpYouText(i), HpAnswerText(i), _hpOk[i], _hpRound.Why[i], tip));
        }

        _log.AddRows(_hpRows);
        _hpPlayed++;
        if (_hpOk.All(o => o)) _hpCorrect++;

        _hpResultText = BreakdownRow.Summary(_hpRows);
        _hpScored = true;
    }

    // In the breakdown: "Win", "Lose", "Push" or (Call & Pay) "$7.50"
    private string HpYouText(int i) =>
        _hpPaid[i] is int c ? HoldemPayouts.MoneyCents(c) : _hpCall[i] ?? "";

    // The right answer on a missed row: "Win" / "Lose" / "Push", or
    // (Call & Pay, a winning Odds / Trips Plus / Pocket Bonus) "$7.50"
    private string HpAnswerText(int i)
    {
        HdPay pay = _hpRound.Pays[i];
        string right = HpCallText(pay);
        return _hpPay && HpTyped(i) && right == "Win" ? HoldemPayouts.MoneyCents(pay.Cents) : right;
    }

    private void HpNextTop()
    {
        HpNewRound();
        _scrollToTopAfterNext = true;
    }
}
