@code {
    // Menu link for this game tapped while it's already open: return to
    // the start screen, same as the Back button (hidden on phones).
    protected override void OnInitialized()
    {
        GameReset.ResetRequested += OnResetRequested;
    }

    private void OnResetRequested()
    {
        _showSessionSummary = false;
        _started = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameReset.ResetRequested -= OnResetRequested;
    }

    // Scroll back to the top whenever this game switches between its
    // start screen and its play screen (Start, Back, menu, End Session).
    // Without this the browser keeps the old scroll position -- after
    // scrolling down to reach Start, the game would open scrolled down.
    private bool _lastRenderedStarted;

    private bool _scrollToSummary;

    // Bar buttons: Submit also scrolls to the feedback; Next also
    // scrolls back to the top
    private void SubmitAndShow()
    {
        SubmitRound();
        if (_roundScored) _scrollToFeedback = true;
    }

    private void NextFromTop()
    {
        DealAgain();
        _scrollToTopAfterNext = true;
    }

    private bool _scrollToFeedback;
    private bool _scrollToTopAfterNext;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Submit: bring the feedback box into view (if it isn't already).
        // Next: back to the top for the new hand.
        if (_scrollToFeedback)
        {
            _scrollToFeedback = false;
            try { await JS.InvokeVoidAsync("dstRevealFeedback"); } catch { }
        }

        if (_scrollToTopAfterNext)
        {
            _scrollToTopAfterNext = false;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }
        }

        // End Session: bring the Session Summary into view (it's at the
        // bottom of the page, often below the screen on a phone)
        if (_scrollToSummary && _showSessionSummary)
        {
            _scrollToSummary = false;
            try { await JS.InvokeVoidAsync("dstScrollToEl", ".session-summary"); } catch { }
        }

        if (_started != _lastRenderedStarted)
        {
            _lastRenderedStarted = _started;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }

            // Payouts on desktop: open the number pad straight away when
            // the window is tall enough for it (123 still hides / shows it)
            if (_started && _mode == TrainerMode.Payouts)
            {
                bool fits = false;
                try { fits = await JS.InvokeAsync<bool>("dstKeypadFits", 315); } catch { }
                _hpShowKeypad = fits;
                if (fits) StateHasChanged();
            }
        }

        if (_started && _mode == TrainerMode.Payouts)
        {
            // Phones: size the wager box to the space above the keypad
            try { await JS.InvokeVoidAsync("dstFitWagerBox"); } catch { }

            // Cursor into the active payout box (scrolling the wager box
            // to it), or onto Next once the round is scored
            if (_hpFocusInput >= 0)
            {
                int i = _hpFocusInput;
                _hpFocusInput = -1;
                try { await _hpInputRefs[i].FocusAsync(preventScroll: true); } catch { }
                try { await JS.InvokeVoidAsync("dstWagerRowIntoView", i); } catch { }
            }

            if (_hpFocusNext)
            {
                _hpFocusNext = false;
                try { await _hpNextButtonRef.FocusAsync(preventScroll: true); } catch { }
            }
        }
    }

    private const int CommunityCount = 5;

    private static readonly WagerOutcome[] OutcomeChoices = { WagerOutcome.Win, WagerOutcome.Lose, WagerOutcome.Push };

    private enum TrainerMode { IdentifyHands, SettleBets, Payouts }

    private sealed class HandState
    {
        public Card Card1 = null!;
        public Card Card2 = null!;
        public WagerOutcome? WagerSelection; // Settle the Bets mode: this hand's Win/Lose/Push call against the dealer
        public bool WagerWrong;
        public WagerOutcome? ActualOutcome; // set at Submit, to outline the right answer when the call was wrong
        public string RankName = string.Empty; // set at Submit: this hand's poker rank, for the phone result line
        public string Reason = string.Empty;   // set at Submit: why it won, lost or pushed
    }

    private bool _started;
    private int _handCount = 1;
    private const int _handCountSettleBets = 1;   // one player (multiple players removed)
    private TrainerMode _mode = TrainerMode.IdentifyHands;

    // Start screen: which mode card is open (null = all closed). Opening
    // a card also selects its mode, so that card's Start button starts
    // it. The open card stays open after a session, so a returning
    // trainee lands right back on the mode they were using.
    private TrainerMode? _openMode;

    private bool IsModeOpen(TrainerMode mode) => _openMode == mode;

    private void ToggleMode(TrainerMode mode)
    {
        _openMode = _openMode == mode ? null : mode;
        if (_openMode is not null) _mode = mode;
    }

    private Deck _deck = new();
    private readonly Card?[] _community = new Card?[CommunityCount];
    private readonly List<HandState> _hands = new();

    private int _correctCount;
    private int _totalRounds;
    private bool _roundScored;

    private bool _submitEnabled;
    private bool _dealEnabled;
    private string _resultText = string.Empty;
    private bool _isCorrect;
    private string _mistakesText = string.Empty;

    // Settle the Bets mode: each hand's actual poker rank, shown
    // regardless of whether the round overall was correct or not --
    // dark blue if that hand's own wager call was correct, red if
    // wrong (including every hand when the dealer declaration itself
    // was invalid, since that marks every hand wrong).
    private readonly List<(string Text, string Color)> _handRankLines = new();

    // After Submit: one line per question (Identify: the dealer's hand;
    // Settle: each player hand) for the feedback box
    private readonly List<BreakdownRow> _rows = new();
    private string _scoreText = "Score: 0 / 0 (0.0%)";
    private bool _showSessionSummary;

    // Settle the Bets mode state only.
    private Card? _dealerCard1;
    private Card? _dealerCard2;
    private bool _dealerCard1Rotated;
    private bool _dealerCard2Rotated;
    private readonly bool[] _communityRotated = new bool[CommunityCount];

    // Player hands show in Settle the Bets only.
    private bool PlayersVisible => _mode == TrainerMode.SettleBets;

    // Only Identify the Hands lets the trainee mark cards, until Submit.
    // Settle the Bets deals the dealer hand already set.
    private bool CanMarkCards => _mode == TrainerMode.IdentifyHands && !_roundScored;

    // How many of the 7 dealer cards (2 dealer + 5 community) are marked
    // unused. Identify the Hands can only be submitted with exactly 2.
    private int SbRotatedCount =>
        (_dealerCard1Rotated ? 1 : 0) + (_dealerCard2Rotated ? 1 : 0) + _communityRotated.Count(r => r);

    // What happened this session, for the summary (Shared/SessionSummary)
    private SessionLog _log = new();

    // End-of-session summary's Practice Again: a fresh session of the same
    // mode, back at the top of the page (as if started from the start screen)
    private void PracticeAgain()
    {
        _showSessionSummary = false;
        StartGame();
        _lastRenderedStarted = false;
    }

    private void StartGame()
    {
        _log = new SessionLog();
        if (_mode == TrainerMode.Payouts)
        {
            _started = true;
            HpStartGame();
            return;
        }

        _handCount = _mode == TrainerMode.SettleBets
            ? _handCountSettleBets
            : 0; // Identify the Hands: dealer hand only
        _started = true;
        _correctCount = 0;
        _totalRounds = 0;
        _roundScored = false;
        _scoreText = "Score: 0 / 0 (0.0%)";

        DealNewRound();
    }

    private void BackToStart() => _started = false;

    private void DealNewRound()
    {
        _showReveal = false;
        _dealEnabled = false;

        _deck = new Deck();
        _deck.Shuffle();

        for (int i = 0; i < CommunityCount; i++)
            _community[i] = _deck.Draw();

        _hands.Clear();
        for (int h = 0; h < _handCount; h++)
        {
            _hands.Add(new HandState
            {
                Card1 = _deck.Draw(),
                Card2 = _deck.Draw()
            });
        }

        Array.Clear(_communityRotated);
        _dealerCard1Rotated = false;
        _dealerCard2Rotated = false;
        _idWrongDrops.Clear();

        _dealerCard1 = _deck.Draw();
        _dealerCard2 = _deck.Draw();

        foreach (HandState hand in _hands)
        {
            hand.WagerSelection = null;
            hand.WagerWrong = false;
            hand.ActualOutcome = null;
        }

        // Settle the Bets: the dealer's best hand comes already set
        if (_mode == TrainerMode.SettleBets) MarkCorrectUnusedCards();

        _resultText = string.Empty;
        _mistakesText = string.Empty;
        _handRankLines.Clear();
        _rows.Clear();
        _roundScored = false;
        _submitEnabled = true;
    }

    private void DealAgain() => DealNewRound();

    // Settle the Bets: true once every player hand has a Win/Lose/Push
    // called. Submit only shows up at that point.
    private bool AllHandsAnswered => _hands.Count > 0 && _hands.All(h => h.WagerSelection is not null);

    // Settle the Bets: record the call.
    private void PickOutcome(int handIndex, WagerOutcome choice)
    {
        if (_roundScored) return;
        HandState hand = _hands[handIndex];
        hand.WagerSelection = choice;
        hand.WagerWrong = false;
    }

    // Identify the Hands: tap marks / un-marks a card; at most 2 marked
    private void ToggleCommunityRotation(int index)
    {
        if (!CanMarkCards) return;
        if (!_communityRotated[index] && SbRotatedCount >= 2) return;
        _communityRotated[index] = !_communityRotated[index];
    }

    private void ToggleDealerCard(int which)
    {
        if (!CanMarkCards) return;
        bool marked = which == 1 ? _dealerCard1Rotated : _dealerCard2Rotated;
        if (!marked && SbRotatedCount >= 2) return;
        if (which == 1) _dealerCard1Rotated = !_dealerCard1Rotated;
        else _dealerCard2Rotated = !_dealerCard2Rotated;
    }

    // After a wrong Submit: the cards the trainee dropped that the dealer's
    // best hand uses (outlined red on the felt)
    private readonly List<Card> _idWrongDrops = new();

    private bool IdWrongDrop(Card? c) => c is not null && _idWrongDrops.Contains(c);

    // The cards the trainee marked unused
    private List<Card> MarkedCards()
    {
        List<Card> marked = new();
        if (_dealerCard1Rotated) marked.Add(_dealerCard1!);
        if (_dealerCard2Rotated) marked.Add(_dealerCard2!);
        for (int i = 0; i < CommunityCount; i++)
            if (_communityRotated[i]) marked.Add(_community[i]!);
        return marked;
    }

    // The 7 cards the dealer's hand is made from: 2 dealer + 5 community.
    private List<Card> DealerPool() => new()
    {
        _dealerCard1!, _dealerCard2!,
        _community[0]!, _community[1]!, _community[2]!, _community[3]!, _community[4]!
    };

    // The 5 cards left unmarked -- the dealer hand as the trainee set it.
    private List<Card> DeclaredDealerHand()
    {
        List<Card> declared = new();
        if (!_dealerCard1Rotated) declared.Add(_dealerCard1!);
        if (!_dealerCard2Rotated) declared.Add(_dealerCard2!);
        for (int i = 0; i < CommunityCount; i++)
            if (!_communityRotated[i]) declared.Add(_community[i]!);
        return declared;
    }

    // Correct only if the 5 unmarked cards are the dealer's best possible
    // 5-card hand, kickers included. Compared by full hand score, so when
    // two different sets of 5 score exactly the same (e.g. a straight
    // entirely on the board), either one counts.
    private bool DeclaredHandIsBest()
    {
        List<Card> declared = DeclaredDealerHand();
        if (declared.Count != 5) return false;
        long best = HandEvaluator.HandScore(HandEvaluator.BestFiveCards(DealerPool()));
        return HandEvaluator.HandScore(declared) == best;
    }

    // Identify the Hands, Reveal button: set the hand and rank correctly,
    // show them in a pop-up, and score the round as a miss
    private bool _showReveal;
    private List<Card> _revealBest = new();
    private HandRank _revealRank;

    private void RevealIdentify()
    {
        if (_mode != TrainerMode.IdentifyHands || _roundScored) return;

        _revealBest = HandEvaluator.BestFiveCards(DealerPool());
        _revealRank = HandEvaluator.BestHandRank(DealerPool());

        MarkCorrectUnusedCards();
        _idWrongDrops.Clear();

        _totalRounds++;
        _isCorrect = false;
        _resultText = "REVEALED";
        _mistakesText = string.Empty;
        _handRankLines.Clear();
        _rows.Clear();
        _handRankLines.Add(($"Dealer: {HandEvaluator.DescribeHand(DealerPool())}", "txt-bad"));
        _rows.Add(new BreakdownRow("Dealer's hand", "Revealed", HandEvaluator.DescribeHand(DealerPool()), false, DealerHandWhy()));
        _log.AddRows(_rows, r => HandEvaluator.HandRankName(_revealRank));

        string pct = ((double)_correctCount / _totalRounds).ToString("0.0%");
        _scoreText = $"Score: {_correctCount} / {_totalRounds} ({pct})";

        _roundScored = true;
        _submitEnabled = false;
        _dealEnabled = true;
        _showReveal = true;
    }

    // Identify the Hands feedback under the call: the 5 cards that make
    // the dealer's hand, e.g. "Best 5: K♠ K♥ 7♦ 7♣ A♠"
    private string DealerHandWhy()
    {
        List<Card> pool = DealerPool();
        string cards = string.Join(" ", OrderForShow(HandEvaluator.BestFiveCards(pool)).Select(CardLabel));
        return $"Best 5: {cards}";
    }

    // Pairs/trips first, then high to low (e.g. Q Q 5 5 A)
    private static List<Card> OrderForShow(List<Card> cards)
    {
        Dictionary<Rank, int> counts = cards.GroupBy(c => c.Rank).ToDictionary(g => g.Key, g => g.Count());
        return cards.OrderByDescending(c => counts[c.Rank]).ThenByDescending(c => (int)c.Rank).ToList();
    }

    private static bool IsRedSuit(Card c) => c.Suit is Suit.Hearts or Suit.Diamonds;

    // e.g. "10♥", "A♠"
    private static string CardLabel(Card c)
    {
        string rank = c.Rank switch
        {
            Rank.Ten => "10",
            Rank.Jack => "J",
            Rank.Queen => "Q",
            Rank.King => "K",
            Rank.Ace => "A",
            _ => ((int)c.Rank).ToString()
        };
        string suit = c.Suit switch
        {
            Suit.Spades => "\u2660",
            Suit.Hearts => "\u2665",
            Suit.Diamonds => "\u2666",
            _ => "\u2663"
        };
        return rank + suit;
    }

    // Marks exactly the 2 cards outside the dealer's best 5: Settle the
    // Bets deals with this already done.
    private void MarkCorrectUnusedCards()
    {
        List<Card> bestFive = HandEvaluator.BestFiveCards(DealerPool());
        _dealerCard1Rotated = !bestFive.Contains(_dealerCard1!);
        _dealerCard2Rotated = !bestFive.Contains(_dealerCard2!);
        for (int i = 0; i < CommunityCount; i++)
            _communityRotated[i] = !bestFive.Contains(_community[i]!);
    }

    private void SubmitRound()
    {
        if (_mode == TrainerMode.SettleBets)
        {
            SubmitSettleBets();
        }
        else
        {
            SubmitIdentifyHands();
        }
    }

    // Identify the Hands: graded on the 2 marked cards. Right when the 5
    // left standing are the dealer's best hand (any equal-scoring set of 5
    // counts). A miss shows the right 2 dimmed, outlines in red the cards
    // that should have played, and compares the trainee's 5 with the best.
    private void SubmitIdentifyHands()
    {
        if (_roundScored || SbRotatedCount != 2) return;

        List<Card> pool = DealerPool();
        List<Card> best = HandEvaluator.BestFiveCards(pool);
        List<Card> declared = DeclaredDealerHand();
        bool ok = DeclaredHandIsBest();
        string call = HandEvaluator.DescribeHand(pool);

        _idWrongDrops.Clear();
        _rows.Clear();
        if (ok)
        {
            _rows.Add(new BreakdownRow("Dealer's hand", call, call, true, DealerHandWhy()));
        }
        else
        {
            _idWrongDrops.AddRange(MarkedCards().Where(best.Contains));
            string dropped = string.Join(" and ", OrderForShow(_idWrongDrops).Select(CardLabel));
            string bestCards = string.Join(" ", OrderForShow(best).Select(CardLabel));
            _rows.Add(new BreakdownRow("Dealer's hand", $"dropped the {dropped}", call, false,
                $"Your 5 make {HandEvaluator.DescribeHand(declared)}. Best 5: {bestCards}"));
            MarkCorrectUnusedCards();
        }
        _log.AddRows(_rows, r => HandEvaluator.HandRankName(HandEvaluator.BestHandRank(pool)));

        _totalRounds++;
        if (ok) _correctCount++;

        _isCorrect = ok;
        _resultText = ok ? "CORRECT" : "INCORRECT";

        string pct = ((double)_correctCount / _totalRounds).ToString("0.0%");
        _scoreText = $"Score: {_correctCount} / {_totalRounds} ({pct})";

        _roundScored = true;
        _submitEnabled = false;
        _dealEnabled = true;
    }

    // Settle the Bets: the dealer's best hand is set when dealt, so each
    // player's call is graded against it. The round scores as correct
    // only if every call is right.
    private void SubmitSettleBets()
    {
        for (int h = 0; h < _hands.Count; h++)
        {
            if (_hands[h].WagerSelection is null)
            {
                _resultText = "Tap every hand's outcome before submitting.";
                _isCorrect = false;
                return;
            }
        }

        if (_roundScored) return;

        HandRank dealerRank = HandEvaluator.BestHandRank(DealerPool());
        long dealerScore = HandEvaluator.HandScore(DeclaredDealerHand());

        bool allCorrect = true;
        System.Text.StringBuilder mistakes = new();
        string dealerDesc = HandEvaluator.DescribeHand(DeclaredDealerHand());
        _rows.Clear();

        for (int h = 0; h < _hands.Count; h++)
        {
            HandState hand = _hands[h];
            Card[] sevenCards =
            {
                hand.Card1, hand.Card2,
                _community[0]!, _community[1]!, _community[2]!, _community[3]!, _community[4]!
            };

            long playerScore = HandEvaluator.HandScore(HandEvaluator.BestFiveCards(sevenCards));

            WagerOutcome actualOutcome = playerScore > dealerScore ? WagerOutcome.Win
                : playerScore < dealerScore ? WagerOutcome.Lose
                : WagerOutcome.Push;

            hand.ActualOutcome = actualOutcome;

            if (hand.WagerSelection == actualOutcome)
            {
                hand.WagerWrong = false;
            }
            else
            {
                hand.WagerWrong = true;
                allCorrect = false;
                mistakes.AppendLine($"Hand {h + 1}: actually a {actualOutcome}");
            }

            HandRank handRank = HandEvaluator.BestHandRank(sevenCards);
            hand.RankName = HandEvaluator.DescribeHand(sevenCards);

            // Why: a higher rank wins outright; the same rank is decided by
            // the higher cards (pairs, then kickers); identical 5-card
            // hands push
            hand.Reason = handRank != dealerRank
                ? $"{hand.RankName} {(handRank > dealerRank ? "beats" : "loses to")} the dealer's {dealerDesc}."
                : actualOutcome == WagerOutcome.Push
                    ? $"{hand.RankName} is the same 5-card hand as the dealer's {dealerDesc}: push."
                    : $"{hand.RankName} vs the dealer's {dealerDesc}: the {(actualOutcome == WagerOutcome.Win ? "player's" : "dealer's")} cards are higher.";

            _handRankLines.Add(($"Hand {h + 1}: {hand.Reason}", hand.WagerWrong ? "txt-bad" : "txt-ok"));
            _rows.Add(new BreakdownRow(_hands.Count > 1 ? $"Player {h + 1}" : "Player", $"{hand.WagerSelection}", $"{actualOutcome}", !hand.WagerWrong, hand.Reason));
        }
        _handRankLines.Insert(0, ($"Dealer: {dealerDesc}", "txt-ok"));
        _log.AddRows(_rows, r => r.Answer switch { "Win" => "Player wins", "Lose" => "Dealer wins", _ => "Pushes" });
        // The per-hand lines below already say who won and why
        _mistakesText = string.Empty;

        _totalRounds++;
        if (allCorrect) _correctCount++;

        _isCorrect = allCorrect;
        _resultText = BreakdownRow.Summary(_rows);

        string pct = _totalRounds > 0
            ? ((double)_correctCount / _totalRounds).ToString("0.0%")
            : "0.0%";
        _scoreText = $"Score: {_correctCount} / {_totalRounds} ({pct})";

        _roundScored = true;
        _submitEnabled = false;
        _dealEnabled = true;
    }

    private void EndSession()
    {
        if (_mode == TrainerMode.Payouts ? _hpPlayed > 0 : _totalRounds > 0)
        {
            _showSessionSummary = true;
            _scrollToSummary = true;
        }
        else
        {
            _started = false;
        }
    }

    private void CloseSummary()
    {
        _showSessionSummary = false;
        _started = false;
    }

    // ============================================================
    // HOLD'EM PAYOUTS (Hp prefix)
    // ============================================================

    private enum HpMark { None, Lose, Push }

    private HdPayoutRound _hpRound = null!; // dealt by HpStartGame
    // The dealer's best five of 7 (hole cards + board), for dimming the
    // 2 cards the dealer doesn't use
    private List<Card> _hpDealerBest = new();

    private bool HpDealerUnused(Card c) => !_hpDealerBest.Contains(c);

    // Tap-a-hand rank bubble: 0 = closed, 1 = player, 2 = dealer.
    // _hpPeekUsed: tapped once this session, so the board caption stops
    // alternating with the tap prompt. _hpDealNo restarts the caption fade
    // on each deal.
    private int _hpPeek;
    private bool _hpPeekUsed;
    private int _hpDealNo;

    private void HpTogglePeek(bool dealer)
    {
        if (_hpScored) return;
        int which = dealer ? 2 : 1;
        _hpPeek = _hpPeek == which ? 0 : which;
        _hpPeekUsed = true;
    }

    // Closing the bubble puts the cursor back in the active payout box
    // (a PC keyboard keeps typing there)
    private void HpClosePeek()
    {
        _hpPeek = 0;
        _hpFocusInput = _hpActive;
    }
    private readonly string[] _hpAnswer = new string[5];
    private readonly HpMark[] _hpMark = new HpMark[5];
    private readonly bool[] _hpOk = new bool[5];
    private int _hpActive;
    private bool _hpScored;
    private bool _hpShowKeypad;
    private string _hpMessage = string.Empty;
    private string _hpResultText = string.Empty;
    private readonly List<BreakdownRow> _hpRows = new();
    private int _hpCorrect;
    private int _hpPlayed;

    private readonly ElementReference[] _hpInputRefs = new ElementReference[5];
    private ElementReference _hpNextButtonRef;
    private int _hpFocusInput = -1;
    private bool _hpFocusNext;

    // The keypad types into whichever box is active
    private string HpActiveText
    {
        get => _hpAnswer[_hpActive] ?? string.Empty;
        set
        {
            _hpAnswer[_hpActive] = HpAmountOnly(value);
            _hpMark[_hpActive] = HpMark.None;
            _hpMessage = string.Empty;
        }
    }

    private void HpStartGame()
    {
        _hpCorrect = 0;
        _hpPlayed = 0;
        _hpPeekUsed = false;
        HpNewRound();
    }

    private void HpNewRound()
    {
        _hpRound = HoldemPayouts.Deal(Random.Shared);
        _hpPeek = 0;
        _hpDealNo++;
        _hpDealerBest = HandEvaluator.BestFiveCards(_hpRound.DealerCards.Concat(_hpRound.Board).ToList());
        for (int i = 0; i < 5; i++)
        {
            _hpAnswer[i] = string.Empty;
            _hpMark[i] = HpMark.None;
            _hpOk[i] = false;
        }
        _hpActive = 0;
        _hpScored = false;
        _hpMessage = string.Empty;
        _hpResultText = string.Empty;
        _hpRows.Clear();
        _hpFocusInput = 0;
    }

    private void HpSelect(int index)
    {
        if (_hpScored || _hpActive == index) return;
        _hpActive = index;
        _hpFocusInput = index;
    }

    // Dollars and cents (Odds pays 3 to 2 on a Flush): digits, one
    // decimal point, at most 2 decimal digits
    private static string HpAmountOnly(string? raw)
    {
        System.Text.StringBuilder sb = new();
        bool dot = false;
        int decimals = 0;
        foreach (char c in raw ?? string.Empty)
        {
            if (char.IsDigit(c))
            {
                if (dot) { if (decimals < 2) { sb.Append(c); decimals++; } }
                else if (sb.Length < 6) sb.Append(c);
            }
            else if (c == '.' && !dot)
            {
                sb.Append(c);
                dot = true;
            }
        }
        return sb.ToString();
    }

    // "7.5" -> 750 cents; null if not a number
    private static int? HpCents(string raw) =>
        decimal.TryParse(raw, System.Globalization.NumberStyles.AllowDecimalPoint, System.Globalization.CultureInfo.InvariantCulture, out decimal d)
            ? (int)Math.Round(d * 100m)
            : null;

    private string HpBoxValue(int i) => _hpMark[i] switch
    {
        HpMark.Lose => "LOSE",
        HpMark.Push => "PUSH",
        _ => _hpAnswer[i] ?? string.Empty
    };

    private void HpInput(int index, ChangeEventArgs e)
    {
        _hpAnswer[index] = HpAmountOnly(e.Value?.ToString());
        _hpMark[index] = HpMark.None;
        _hpActive = index;
        _hpMessage = string.Empty;
    }

    // Keyboard Enter: on to the next box; on the last box, Submit
    private async Task HpKeyDown(int index, Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _hpScored) return;
        _hpActive = index;
        await HpKeypadEnter();
    }

    private async Task HpKeypadEnter()
    {
        if (_hpScored) return;

        if (_hpActive < 4)
        {
            _hpActive++;
            _hpFocusInput = _hpActive;
        }
        else
        {
            await HpSubmitAndShow();
        }
    }

    // Lose / Push: marks the wager (clearing any amount typed) and moves
    // on to the next wager; tapped again it's undone
    private void HpToggleMark(int index, HpMark mark)
    {
        if (_hpScored) return;
        _hpMessage = string.Empty;

        if (_hpMark[index] == mark)
        {
            _hpMark[index] = HpMark.None;
            _hpActive = index;
            _hpFocusInput = index;
            return;
        }

        _hpMark[index] = mark;
        _hpAnswer[index] = string.Empty;
        int next = index < 4 ? index + 1 : index;
        _hpActive = next;
        _hpFocusInput = next;
    }

    // Submit also scrolls to the feedback; the cursor moves onto Next
    // after a short wait so the same Enter press doesn't also press Next
    private async Task HpSubmitAndShow()
    {
        HpSubmit();
        if (!_hpScored) return;

        _scrollToFeedback = true;
        StateHasChanged();

        await Task.Delay(200);
        _hpFocusNext = true;
    }

    private void HpSubmit()
    {
        if (_hpScored) return;

        for (int i = 0; i < 5; i++)
        {
            if ((_hpAnswer[i] ?? "").Length == 0 && _hpMark[i] == HpMark.None)
            {
                _hpMessage = i <= HdPayoutRound.Odds
                    ? $"Enter the {HdPayoutRound.Names[i]} payout, or tap Push or Lose."
                    : $"Enter the {HdPayoutRound.Names[i]} payout, or tap Lose.";
                _hpActive = i;
                _hpFocusInput = i;
                return;
            }
        }

        _hpRows.Clear();
        for (int i = 0; i < 5; i++)
        {
            HdPay pay = _hpRound.Pays[i];
            int? typed = HpCents(_hpAnswer[i] ?? "");
            _hpOk[i] = _hpMark[i] switch
            {
                HpMark.Lose => pay.IsLose,
                HpMark.Push => pay.IsPush,
                _ => typed is int c && (c == 0 ? pay.IsLose : !pay.IsPush && c == pay.Cents)
            };

            _hpRows.Add(new BreakdownRow(HdPayoutRound.Names[i], HpEnteredMoney(i), HpPayMoney(pay), _hpOk[i], _hpRound.Why[i]));
        }

        _log.AddRows(_hpRows);
        _hpPlayed++;
        if (_hpOk.All(o => o)) _hpCorrect++;

        _hpResultText = BreakdownRow.Summary(_hpRows);
        _hpMessage = string.Empty;
        _hpScored = true;
    }

    private void HpNextTop()
    {
        HpNewRound();
        _scrollToTopAfterNext = true;
    }

    // In the payout box after Submit: "LOSE", "PUSH", "15" or "7.50"
    private string HpEnteredText(int i) => _hpMark[i] switch
    {
        HpMark.Lose => "LOSE",
        HpMark.Push => "PUSH",
        _ => HpCents(_hpAnswer[i] ?? "") is int c ? HoldemPayouts.MoneyCents(c).TrimStart('$') : _hpAnswer[i] ?? ""
    };

    private static string HpPayText(HdPay pay) =>
        pay.IsPush ? "PUSH" : pay.IsLose ? "LOSE" : HoldemPayouts.MoneyCents(pay.Cents).TrimStart('$');

    // In the breakdown: "Lose", "Push", "$15" or "$7.50"
    private string HpEnteredMoney(int i) => _hpMark[i] switch
    {
        HpMark.Lose => "Lose",
        HpMark.Push => "Push",
        _ => HpCents(_hpAnswer[i] ?? "") is int c ? HoldemPayouts.MoneyCents(c) : _hpAnswer[i] ?? ""
    };

    private static string HpPayMoney(HdPay pay) =>
        pay.IsPush ? "Push" : pay.IsLose ? "Lose" : HoldemPayouts.MoneyCents(pay.Cents);

    // Chip color by the largest chip in the wager: $100 black, $25 green,
    // $10 blue, $5 red, $1 grey
    private static string HpChipClass(int wager) =>
        wager >= 100 ? "sp-chip-100" : wager >= 25 ? "sp-chip-25" : wager >= 10 ? "sp-chip-10" : wager >= 5 ? "sp-chip-5" : "sp-chip-1";

}
