@page "/holdem-trainer"
@using DealerSchoolTrainerWeb.Core
@using DealerSchoolTrainerWeb.Games.HoldemTrainer
@implements IDisposable
@inject GameResetService GameReset
@inject IJSRuntime JS

<PageTitle>Heads-Up Hold'em</PageTitle>

@if (!_started)
{
    <div class="start-screen">
        <h1>HEADS-UP HOLD'EM</h1>

        @* Each mode is a collapsible card: tap its title to open its
           settings and its own Start button (one card open at a time).
           Settle the Bets allows 1-6 player hands, defaulting to 1. *@
        <div class="mode-list">
            <ModeCard Title="Identify the Hands"
                      Description="The 5 community cards and the dealer's 2 cards are dealt. Set the hand by tapping the 2 cards that are NOT part of the dealer's best 5-card hand. Once it's right, pick the hand's rank, then Submit."
                      Expanded="@IsModeOpen(TrainerMode.IdentifyHands)"
                      OnToggle="() => ToggleMode(TrainerMode.IdentifyHands)"
                      OnStart="StartGame" />

            <ModeCard Title="Settle the Bets"
                      Description="The dealer's best hand is already set -- its 2 unused cards are marked. Tap each player hand's circle to call Win / Lose / Push against it, then Submit."
                      Expanded="@IsModeOpen(TrainerMode.SettleBets)"
                      OnToggle="() => ToggleMode(TrainerMode.SettleBets)"
                      OnStart="StartGame">
                <CountStepper Label="Number of Hands" Min="1" Max="6" @bind-Value="_handCountSettleBets" />
            </ModeCard>
        </div>
    </div>
}
else
{
    <div class="play-screen">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        @* On phones (see app.css, "Heads-Up Hold'em") this table becomes a
           single column: the current player hand (Settle the Bets only),
           community cards, dealer cards, the rank picker (Identify the
           Hands only), Submit/Deal/End Session, then the feedback. The
           fixed 900px width and the side-positioned feedback apply on
           desktop only. *@
        <div class="hd-table hd-settle @(_mode == TrainerMode.IdentifyHands ? "hd-identify" : "")">
            @* Phones only (hidden on desktop by CSS): one player hand is
               shown at a time. This banner names it; the Previous / Next
               buttons sit beside that hand's answer control below, to save
               a row. Desktop still shows every hand side by side. *@
            @if (PlayersVisible && _hands.Count > 1)
            {
                <div class="hd-pager">
                    <span class="hd-pager-label">Player @(_currentHand + 1) of @_hands.Count</span>
                </div>
            }

            @if (PlayersVisible)
            {
            <div class="hd-hands">
            @for (int h = 0; h < _hands.Count; h++)
            {
                int handIndex = h;
                HandState hand = _hands[handIndex];

                <div class="hd-hand @(handIndex == _currentHand ? "hd-hand-current" : "")">
                    <div class="hd-hand-number" style="color: dimgray; font-size: 0.85rem;">@(handIndex + 1)</div>

                    <div class="hd-hand-cards" style="position: relative; width: 130px; height: 195px;">
                        <img src="images/cards/@(hand.Card1.Code).png" alt="@hand.Card1.Code"
                             style="position: absolute; top: 0; left: 25px; width: 100px; height: 140px;" />
                        <img src="images/cards/@(hand.Card2.Code).png" alt="@hand.Card2.Code"
                             style="position: absolute; top: 45px; left: 0; width: 100px; height: 140px;" />
                    </div>

                    <div class="hd-hand-controls">
                    @if (_hands.Count > 1)
                    {
                        <button class="hd-inline-pager" @onclick="PreviousHand" disabled="@(handIndex <= 0)">Previous</button>
                    }

                    <WagerShape IsDiamond="false" AllowPush="true"
                                Selection="hand.WagerSelection" SelectionChanged="v => hand.WagerSelection = v"
                                Wrong="hand.WagerWrong" OnCycled="() => hand.WagerWrong = false"
                                ShowWrongShading="_roundScored">
                        vs Dealer
                    </WagerShape>

                    @if (_hands.Count > 1)
                    {
                        <button class="hd-inline-pager" @onclick="NextHand" disabled="@(handIndex >= _hands.Count - 1)">Next</button>
                    }
                    </div>
                </div>
            }
            </div>
            }

        <!-- Community cards are centered within a fixed 900px-wide
             reference (the width of a full 6-hand row), so their
             position stays stable regardless of how many hands are
             dealt. The dealer's two cards sit in a second row below. A
             card marked unused by the dealer is turned 45 degrees on
             desktop, dropped and darkened on phones. Identify the Hands:
             the trainee taps to mark the 2 unused cards. Settle the Bets:
             the dealer's best hand comes already marked. -->
        <div class="hd-center">
            <div class="hd-buttons">
                @* Settle the Bets: Submit only appears once every player
                   hand has a Win/Lose/Push called. Identify the Hands: only
                   once the hand is set correctly (the rank picker shows). *@
                @if (_submitEnabled && (_mode == TrainerMode.IdentifyHands ? _dealerHandSet : AllHandsAnswered))
                {
                    <button @onclick="SubmitRound">Submit</button>
                }
                @* Deal only appears after Submit (once the round is scored) *@
                @if (_dealEnabled)
                {
                    <button @onclick="DealAgain">Deal</button>
                }
                <button @onclick="EndSession">End Session</button>
            </div>

            <h3 class="hd-community-title">Community Cards</h3>
            <div class="hd-community hd-community-settle">
                @for (int i = 0; i < _community.Length; i++)
                {
                    int communityIndex = i;
                    Card? c = _community[communityIndex];
                    bool unused = _communityRotated[communityIndex];

                    <div class="hd-community-slot">
                        <img src="images/cards/@(c?.Code).png" alt="@c?.Code"
                             @onclick="() => ToggleCommunityRotation(communityIndex)"
                             class="pai-gow-card hd-card @(unused ? "hd-card-unused" : "")"
                             style="cursor: @(CanMarkCards ? "pointer" : "default"); @(unused ? "transform: rotate(45deg);" : "")" />
                    </div>
                }
            </div>

            <h3 class="hd-dealer-title">Dealer</h3>
            <div class="hd-dealer">
                <img src="images/cards/@(_dealerCard1?.Code).png" alt="@_dealerCard1?.Code"
                     @onclick="() => ToggleDealerCard(1)"
                     class="pai-gow-card hd-card @(_dealerCard1Rotated ? "hd-card-unused" : "")"
                     style="cursor: @(CanMarkCards ? "pointer" : "default"); @(_dealerCard1Rotated ? "transform: rotate(45deg);" : "")" />
                <img src="images/cards/@(_dealerCard2?.Code).png" alt="@_dealerCard2?.Code"
                     @onclick="() => ToggleDealerCard(2)"
                     class="pai-gow-card hd-card @(_dealerCard2Rotated ? "hd-card-unused" : "")"
                     style="cursor: @(CanMarkCards ? "pointer" : "default"); @(_dealerCard2Rotated ? "transform: rotate(45deg);" : "")" />
            </div>

            @* Identify the Hands: until the right 2 cards are marked, a
               caption in place of the rank picker; once they are, the cards
               lock and the rank picker appears. *@
            @if (_mode == TrainerMode.IdentifyHands && !_dealerHandSet)
            {
                <p class="hd-set-caption @(SbRotatedCount == 2 ? "hd-set-caption-wrong" : "")">
                    @(SbRotatedCount == 2
                        ? "Not the dealer's best hand -- adjust your cards."
                        : "Set the Hand to continue: tap the 2 cards that are NOT part of the dealer's best hand.")
                </p>
            }
            else if (_mode == TrainerMode.IdentifyHands)
            {
                <div class="hd-rank-row">
                    <label for="hd-rank">Dealer's hand:</label>
                    <select id="hd-rank" @bind="_dealerRankIndex" disabled="@_roundScored"
                            style="@(_dealerRankWrong ? "background-color: #f8d0d0;" : (_dealerRankIndex > 0 ? "background-color: #d0e0f8;" : ""))">
                        @for (int i = 0; i < RankComboItems.Length; i++)
                        {
                            <option value="@i">@RankComboItems[i]</option>
                        }
                    </select>
                </div>
            }
        </div>

        <!-- Desktop: with player hands showing, the feedback sits at the
             "next" hand slot to the right of the hands (each hand column
             is 130px wide plus a 24px gap, so N hands take N*154px), top
             aligned with the player cards (~36px down). With no player
             hands (Identify the Hands) it sits below the rank picker instead
             (hd-feedback-inline). Phones always show it below. -->
        <div class="feedback-area hd-feedback @(PlayersVisible ? "" : "hd-feedback-inline")" style="--hd-feedback-left: @(_hands.Count * 154)px;">
            <div style="font-weight: bold; color: @(_isCorrect ? "blue" : "red");">@_resultText</div>
            @if (_mistakesText.Length > 0)
            {
                <div style="white-space: pre-line; margin-top: 0.25rem;">@_mistakesText</div>
            }
            @if (_handRankLines.Count > 0)
            {
                <div style="margin-top: 0.25rem;">
                    @foreach ((string text, string color) in _handRankLines)
                    {
                        <p style="margin: 0; font-weight: bold; color: @color; white-space: nowrap;">@text</p>
                    }
                </div>
            }
            <p style="margin: 0.25rem 0 0 0;">@_scoreText</p>
        </div>
        </div>

        @* Reference chart toggle kept at the bottom, out of the way *@
        <div class="button-row rules-row">
            <button @onclick="() => _showHandRankings = !_showHandRankings">@(_showHandRankings ? "Hide" : "Show") Hand Rankings</button>
        </div>

        @if (_showHandRankings)
        {
            <div style="margin: 1rem 0;">
                <img src="images/cards/HandRankings.png" alt="Hold'em Hand Rankings" style="max-width: 500px; width: 100%;" />
            </div>
        }
    </div>
}

@if (_showSessionSummary)
{
    <div class="session-summary">
        <h3>Session Summary</h3>
        <p>Rounds Played: @_totalRounds</p>
        <p>Correct: @_correctCount</p>
        <p>Incorrect: @(_totalRounds - _correctCount)</p>
        <button @onclick="CloseSummary">OK</button>
    </div>
}

@code {
    // Menu link for this game tapped while it's already open: return to
    // the start screen, same as the Back button (hidden on phones).
    protected override void OnInitialized()
    {
        GameReset.ResetRequested += OnResetRequested;
    }

    private void OnResetRequested()
    {
        _showSessionSummary = false;
        _started = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameReset.ResetRequested -= OnResetRequested;
    }

    // Scroll back to the top whenever this game switches between its
    // start screen and its play screen (Start, Back, menu, End Session).
    // Without this the browser keeps the old scroll position -- after
    // scrolling down to reach Start, the game would open scrolled down.
    private bool _lastRenderedStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_started != _lastRenderedStarted)
        {
            _lastRenderedStarted = _started;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }
        }
    }

    private const int CommunityCount = 5;

    private enum TrainerMode { IdentifyHands, SettleBets }

    private static readonly string[] RankComboItems =
    {
        "Select Rank",
        "High Card",
        "Pair",
        "Two Pair",
        "Three of a Kind",
        "Straight",
        "Flush",
        "Full House",
        "Four of a Kind",
        "Straight Flush",
        "Royal Flush"
    };

    private sealed class HandState
    {
        public Card Card1 = null!;
        public Card Card2 = null!;
        public WagerOutcome? WagerSelection; // Settle the Bets mode: this hand's Win/Lose/Push call against the dealer
        public bool WagerWrong;
    }

    private bool _started;
    private int _currentHand; // phone layout only: which player hand is showing
    private int _handCount = 1;
    private int _handCountSettleBets = 1;
    private TrainerMode _mode = TrainerMode.IdentifyHands;

    // Start screen: which mode card is open (null = all closed). Opening
    // a card also selects its mode, so that card's Start button starts
    // it. The open card stays open after a session, so a returning
    // trainee lands right back on the mode they were using.
    private TrainerMode? _openMode;

    private bool IsModeOpen(TrainerMode mode) => _openMode == mode;

    private void ToggleMode(TrainerMode mode)
    {
        _openMode = _openMode == mode ? null : mode;
        if (_openMode is not null) _mode = mode;
    }

    private Deck _deck = new();
    private readonly Card?[] _community = new Card?[CommunityCount];
    private readonly List<HandState> _hands = new();

    private int _correctCount;
    private int _totalRounds;
    private bool _roundScored;

    private bool _submitEnabled;
    private bool _dealEnabled;
    private string _resultText = string.Empty;
    private bool _isCorrect;
    private string _mistakesText = string.Empty;

    // Settle the Bets mode: each hand's actual poker rank, shown
    // regardless of whether the round overall was correct or not --
    // dark blue if that hand's own wager call was correct, red if
    // wrong (including every hand when the dealer declaration itself
    // was invalid, since that marks every hand wrong).
    private readonly List<(string Text, string Color)> _handRankLines = new();
    private string _scoreText = "Score: 0 / 0 (0.0%)";
    private bool _showSessionSummary;
    private bool _showHandRankings;

    // Settle the Bets mode state only.
    private Card? _dealerCard1;
    private Card? _dealerCard2;
    private bool _dealerCard1Rotated;
    private bool _dealerCard2Rotated;
    private readonly bool[] _communityRotated = new bool[CommunityCount];

    // Identify the Hands: the rank picked for the dealer hand (0 =
    // unselected, 1-10 matches HandRank) and whether it was wrong.
    private int _dealerRankIndex;
    private bool _dealerRankWrong;

    // Player hands show in Settle the Bets only.
    private bool PlayersVisible => _mode == TrainerMode.SettleBets;

    // Identify the Hands: set once the trainee's 2 marked cards leave the
    // dealer's best hand (checked after every tap -- no Submit needed).
    // The cards then lock and the rank picker appears.
    private bool _dealerHandSet;

    // Only Identify the Hands lets the trainee mark cards, until the hand
    // is set. Settle the Bets deals the dealer hand already set.
    private bool CanMarkCards => _mode == TrainerMode.IdentifyHands && !_dealerHandSet && !_roundScored;

    // How many of the 7 dealer cards (2 dealer + 5 community) are marked
    // unused. Identify the Hands can only be submitted with exactly 2.
    private int SbRotatedCount =>
        (_dealerCard1Rotated ? 1 : 0) + (_dealerCard2Rotated ? 1 : 0) + _communityRotated.Count(r => r);

    private void StartGame()
    {
        _handCount = _mode == TrainerMode.SettleBets
            ? Math.Clamp(_handCountSettleBets, 1, 6)
            : 0; // Identify the Hands: dealer hand only
        _started = true;
        _correctCount = 0;
        _totalRounds = 0;
        _roundScored = false;
        _scoreText = "Score: 0 / 0 (0.0%)";

        DealNewRound();
    }

    private void BackToStart() => _started = false;

    private void DealNewRound()
    {
        _dealEnabled = false;

        _deck = new Deck();
        _deck.Shuffle();

        for (int i = 0; i < CommunityCount; i++)
            _community[i] = _deck.Draw();

        _hands.Clear();
        for (int h = 0; h < _handCount; h++)
        {
            _hands.Add(new HandState
            {
                Card1 = _deck.Draw(),
                Card2 = _deck.Draw()
            });
        }

        Array.Clear(_communityRotated);
        _dealerCard1Rotated = false;
        _dealerCard2Rotated = false;
        _dealerRankIndex = 0;
        _dealerRankWrong = false;
        _dealerHandSet = false;

        _dealerCard1 = _deck.Draw();
        _dealerCard2 = _deck.Draw();

        foreach (HandState hand in _hands)
        {
            hand.WagerSelection = null;
            hand.WagerWrong = false;
        }

        // Settle the Bets: the dealer's best hand comes already set
        if (_mode == TrainerMode.SettleBets) MarkCorrectUnusedCards();

        _resultText = string.Empty;
        _mistakesText = string.Empty;
        _handRankLines.Clear();
        _roundScored = false;
        _submitEnabled = true;
        _currentHand = 0;
    }

    private void DealAgain() => DealNewRound();

    // Settle the Bets: true once every player hand has a Win/Lose/Push
    // called. Submit only shows up at that point.
    private bool AllHandsAnswered => _hands.Count > 0 && _hands.All(h => h.WagerSelection is not null);

    private void PreviousHand()
    {
        if (_currentHand > 0) _currentHand--;
    }

    private void NextHand()
    {
        if (_currentHand < _hands.Count - 1) _currentHand++;
    }

    private void ToggleCommunityRotation(int index)
    {
        if (!CanMarkCards) return;
        _communityRotated[index] = !_communityRotated[index];
        CheckHandSet();
    }

    private void ToggleDealerCard(int which)
    {
        if (!CanMarkCards) return;
        if (which == 1) _dealerCard1Rotated = !_dealerCard1Rotated;
        else _dealerCard2Rotated = !_dealerCard2Rotated;
        CheckHandSet();
    }

    // Identify the Hands: after each tap, lock in the hand as soon as the
    // 2 marked cards are the right ones. A wrong pair just shows a hint
    // (no penalty) until the trainee adjusts it.
    private void CheckHandSet()
    {
        if (_mode == TrainerMode.IdentifyHands && SbRotatedCount == 2 && DeclaredHandIsBest())
        {
            _dealerHandSet = true;
            _resultText = string.Empty;
        }
    }

    // The 7 cards the dealer's hand is made from: 2 dealer + 5 community.
    private List<Card> DealerPool() => new()
    {
        _dealerCard1!, _dealerCard2!,
        _community[0]!, _community[1]!, _community[2]!, _community[3]!, _community[4]!
    };

    // The 5 cards left unmarked -- the dealer hand as the trainee set it.
    private List<Card> DeclaredDealerHand()
    {
        List<Card> declared = new();
        if (!_dealerCard1Rotated) declared.Add(_dealerCard1!);
        if (!_dealerCard2Rotated) declared.Add(_dealerCard2!);
        for (int i = 0; i < CommunityCount; i++)
            if (!_communityRotated[i]) declared.Add(_community[i]!);
        return declared;
    }

    // Correct only if the 5 unmarked cards are the dealer's best possible
    // 5-card hand, kickers included. Compared by full hand score, so when
    // two different sets of 5 score exactly the same (e.g. a straight
    // entirely on the board), either one counts.
    private bool DeclaredHandIsBest()
    {
        List<Card> declared = DeclaredDealerHand();
        if (declared.Count != 5) return false;
        long best = HandEvaluator.HandScore(HandEvaluator.BestFiveCards(DealerPool()));
        return HandEvaluator.HandScore(declared) == best;
    }

    // Marks exactly the 2 cards outside the dealer's best 5: Settle the
    // Bets deals with this already done.
    private void MarkCorrectUnusedCards()
    {
        List<Card> bestFive = HandEvaluator.BestFiveCards(DealerPool());
        _dealerCard1Rotated = !bestFive.Contains(_dealerCard1!);
        _dealerCard2Rotated = !bestFive.Contains(_dealerCard2!);
        for (int i = 0; i < CommunityCount; i++)
            _communityRotated[i] = !bestFive.Contains(_community[i]!);
    }

    private void SubmitRound()
    {
        if (_mode == TrainerMode.SettleBets)
        {
            SubmitSettleBets();
        }
        else
        {
            SubmitIdentifyHands();
        }
    }

    // Identify the Hands: the hand itself is already set correctly (the
    // rank picker only appears then), so only the rank is scored.
    private void SubmitIdentifyHands()
    {
        if (_roundScored || !_dealerHandSet) return;

        if (_dealerRankIndex <= 0)
        {
            _isCorrect = false;
            _resultText = "Pick the dealer hand's rank before submitting.";
            return;
        }

        HandRank bestRank = HandEvaluator.BestHandRank(DealerPool());
        bool rankCorrect = _dealerRankIndex == (int)bestRank;

        _dealerRankWrong = !rankCorrect;
        _mistakesText = rankCorrect ? string.Empty : $"Rank: actually {HandEvaluator.HandRankName(bestRank)}";
        _handRankLines.Add(($"Dealer: {HandEvaluator.HandRankName(bestRank)}", rankCorrect ? "darkblue" : "red"));

        bool allCorrect = rankCorrect;

        _totalRounds++;
        if (allCorrect) _correctCount++;

        _isCorrect = allCorrect;
        _resultText = allCorrect ? "CORRECT" : "INCORRECT";

        string pct = _totalRounds > 0
            ? ((double)_correctCount / _totalRounds).ToString("0.0%")
            : "0.0%";
        _scoreText = $"Score: {_correctCount} / {_totalRounds} ({pct})";

        _roundScored = true;
        _submitEnabled = false;
        _dealEnabled = true;
    }

    // Settle the Bets: the dealer's best hand is set when dealt, so each
    // player's call is graded against it. The round scores as correct
    // only if every call is right.
    private void SubmitSettleBets()
    {
        for (int h = 0; h < _hands.Count; h++)
        {
            if (_hands[h].WagerSelection is null)
            {
                _resultText = "Tap every hand's outcome before submitting.";
                _isCorrect = false;
                _currentHand = h;
                return;
            }
        }

        if (_roundScored) return;

        HandRank dealerRank = HandEvaluator.BestHandRank(DealerPool());
        long dealerScore = HandEvaluator.HandScore(DeclaredDealerHand());

        bool allCorrect = true;
        System.Text.StringBuilder mistakes = new();

        for (int h = 0; h < _hands.Count; h++)
        {
            HandState hand = _hands[h];
            Card[] sevenCards =
            {
                hand.Card1, hand.Card2,
                _community[0]!, _community[1]!, _community[2]!, _community[3]!, _community[4]!
            };

            long playerScore = HandEvaluator.HandScore(HandEvaluator.BestFiveCards(sevenCards));

            WagerOutcome actualOutcome = playerScore > dealerScore ? WagerOutcome.Win
                : playerScore < dealerScore ? WagerOutcome.Lose
                : WagerOutcome.Push;

            if (hand.WagerSelection == actualOutcome)
            {
                hand.WagerWrong = false;
            }
            else
            {
                hand.WagerWrong = true;
                allCorrect = false;
                mistakes.AppendLine($"Hand {h + 1}: actually a {actualOutcome}");
            }

            HandRank handRank = HandEvaluator.BestHandRank(sevenCards);
            _handRankLines.Add(($"Hand {h + 1}: {HandEvaluator.HandRankName(handRank)}", hand.WagerWrong ? "red" : "darkblue"));
        }
        _handRankLines.Insert(0, ($"Dealer: {HandEvaluator.HandRankName(dealerRank)}", "darkblue"));
        _mistakesText = mistakes.ToString();

        _totalRounds++;
        if (allCorrect) _correctCount++;

        _isCorrect = allCorrect;
        _resultText = allCorrect ? "CORRECT" : "INCORRECT";

        string pct = _totalRounds > 0
            ? ((double)_correctCount / _totalRounds).ToString("0.0%")
            : "0.0%";
        _scoreText = $"Score: {_correctCount} / {_totalRounds} ({pct})";

        _roundScored = true;
        _submitEnabled = false;
        _dealEnabled = true;
    }

    private void EndSession()
    {
        if (_totalRounds > 0)
        {
            _showSessionSummary = true;
        }
        else
        {
            _started = false;
        }
    }

    private void CloseSummary()
    {
        _showSessionSummary = false;
        _started = false;
    }
}
