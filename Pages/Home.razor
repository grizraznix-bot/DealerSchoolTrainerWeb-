@page "/"
@inject IJSRuntime JS

<PageTitle>Dealer School Trainer</PageTitle>

@* Home: what the site is, the games (each one tappable), and how a game
   works -- so a first-time user knows where to start without having to
   find the menu. *@
<div class="home">
    <h1>Dealer School Trainer</h1>

    @* Returning visitor: the mode last practised in this browser, one tap
       back to its start screen (saved by Shared/GameStatus). Not shown
       until something has been played. *@
    @if (_continue is not null)
    {
        <a class="home-continue" href="@_continue.Url">
            <span class="home-continue-text">
                <span class="home-continue-key">CONTINUE</span>
                <b>@_continue.Title</b>
                <small>Last practised @Ago(_continue.At)</small>
            </span>
            <span class="home-continue-go">Go &rsaquo;</span>
        </a>
    }

    <p class="home-lead">Practice the skills you're learning in dealer school: card totals, payouts, hand rankings and settling bets. Go at your own pace, on your phone or computer.</p>

    @* Computers only (hidden on phones and tablets): scan to open the
       trainer on a phone *@
    <div class="home-qr">
        <img src="images/site-qr.png" alt="QR code that opens the Dealer School Trainer" width="132" height="132" />
        <div>
            <b>Practice on your phone</b>
            <span>Scan with your phone's camera to open the trainer, then add it to your home screen to use it like an app.</span>
        </div>
    </div>

    <div class="card-row home-cards felt">
        <img src="images/cards/AS.png" alt="Ace of Spades" class="home-card" />
        <img src="images/cards/KS.png" alt="King of Spades" class="home-card" />
        <img src="images/cards/QS.png" alt="Queen of Spades" class="home-card" />
        <img src="images/cards/JS.png" alt="Jack of Spades" class="home-card" />
        <img src="images/cards/TS.png" alt="10 of Spades" class="home-card" />
    </div>

    @* The games in two groups: the Dealer School course, numbered in the
       order it's taught (shuffling and chips come first, in person), then
       the games beyond Dealer School for working dealers (Hold'em, Single
       Deck Blackjack, Roulette); Progressives and Challenge Mode last, in gold. Each group's title
       sits in a coloured header band. *@
    <div class="home-sec home-sec-course">
        <h2 class="home-heading">Dealer School course</h2>
        <p class="home-sub">The games in the order they're taught.</p>
    </div>

    <div class="home-games">
        <a class="home-game" href="blackjack-trainer">
            <span class="home-game-name"><span class="home-num">1</span>Blackjack</span>
            <span class="home-game-desc">Card totals, 3:2 payouts, and the 21&nbsp;+&nbsp;3 and Lucky Ladies side wagers. New? Start with the tutorial</span>
        </a>
        <a class="home-game" href="three-card-trainer">
            <span class="home-game-name"><span class="home-num">2</span>Three Card Prime</span>
            <span class="home-game-desc">Settle Play, Ante, Pair Bonus, Prime and All 6. Call them, or call and pay</span>
        </a>
        <a class="home-game" href="pai-gow">
            <span class="home-game-name"><span class="home-num">3</span>Pai Gow</span>
            <span class="home-game-desc">Set hands the House Way, then settle Insurance, the Main Wager and Emperor's Treasure</span>
        </a>
    </div>

    <div class="home-sec home-sec-beyond">
        <h2 class="home-heading">Beyond Dealer School</h2>
        <p class="home-sub">More games and pays for working dealers, to prepare for what's next.</p>
    </div>

    <div class="home-games">
        <a class="home-game" href="holdem-trainer">
            <span class="home-game-name">Heads-Up Hold'em</span>
            <span class="home-game-desc">Find the dealer's best hand, then settle Raise, Ante, Odds, Trips Plus and Pocket Bonus</span>
        </a>
        <a class="home-game" href="blackjack-trainer?open=payouts">
            <span class="home-game-name">Single Deck Blackjack</span>
            <span class="home-game-desc">6:5 Blackjack payouts: choose 6:5 in Blackjack Payouts</span>
        </a>
        <a class="home-game" href="roulette">
            <span class="home-game-name">Roulette</span>
            <span class="home-game-desc">Pay the winning chips around the winning number, with math tricks for working out payouts</span>
        </a>
        <a class="home-game home-game-challenge" href="progressives">
            <span class="home-game-name">Progressives</span>
            <span class="home-game-desc">The progressive touchscreen for Blackjack, Three Card Prime, Pai Gow and Hold'em: lock in the wagers, then pay a qualifying hand</span>
        </a>
        <a class="home-game home-game-challenge" href="challenge">
            <span class="home-game-name">Challenge Mode</span>
            <span class="home-game-desc">Timed runs of Blackjack totals, Blackjack payouts and Roulette payouts. One miss ends it. Beat your Top 5</span>
        </a>
        <a class="home-game home-game-challenge" href="tools">
            <span class="home-game-name">Tools</span>
            <span class="home-game-desc">For the training table: table limit sign, pay tables, shuffle timer, Pai Gow number and dice</span>
        </a>
    </div>

    <h2 class="home-heading">How it works</h2>

    <ol class="home-steps">
        <li>Pick a game, choose a mode (and Call Only or Call &amp; Pay where offered), and press <strong>Start</strong>.</li>
        <li>Answer each hand. You'll see right away whether you got it, and the right answer if you didn't.</li>
        <li>Stuck? Tap <strong>Help</strong> for the pay tables and rules, or <strong>Reveal</strong> (where offered) to see the answer.</li>
        <li>Small cards? Tap a hand marked 🔍 to see it enlarged.</li>
        <li>When you're done, tap <strong>End</strong> to see how your session went.</li>
        <li>Use the menu to switch games at any time.</li>
    </ol>

    @* Hidden once the site is running from its home-screen icon *@
    <p class="home-tip install-link">On a phone? <a href="add-to-home-screen">Add the trainer to your home screen</a> to open it full screen, like an app.</p>

    <p class="home-note">Games and procedures vary from casino to casino. Always follow the procedures taught at your property.</p>
</div>

@code {
    private sealed record LastMode(string Title, string Url, DateTime At);

    private LastMode? _continue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            string? json = await JS.InvokeAsync<string?>("localStorage.getItem", GameStatus.ContinueKey);
            if (string.IsNullOrEmpty(json)) return;
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            string title = root.GetProperty("title").GetString() ?? "";
            string url = root.GetProperty("url").GetString() ?? "";
            DateTime at = DateTime.TryParse(root.GetProperty("at").GetString(), null,
                System.Globalization.DateTimeStyles.RoundtripKind, out DateTime t) ? t : DateTime.Now;
            // Only links inside the site
            if (title.Length == 0 || url.Length == 0 || url.Contains("://") || url.StartsWith("/")) return;
            _continue = new LastMode(title, url, at);
            StateHasChanged();
        }
        catch
        {
            // Nothing saved, storage blocked, or an old format: no card
        }
    }

    private static string Ago(DateTime at)
    {
        int days = (DateTime.Now.Date - at.Date).Days;
        return days <= 0 ? "today" : days == 1 ? "yesterday" : $"{days} days ago";
    }
}
