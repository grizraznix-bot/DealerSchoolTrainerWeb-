@page "/tools/pay-tables"
@using DealerSchoolTrainerWeb.Games.ToolData
@inject NavigationManager Nav

<PageTitle>Pay Tables</PageTitle>

@* Pay Tables: the house's pay tables for live practice at the training
   table. Pick the game, then a tab per wager; a wager with two tables
   (a progressive's $5 and $1) shows them side by side. Pai Gow also has
   the House Way (Shared/HouseWayTable). Full Screen, or the phone held
   sideways, fills the screen (app.css, tl-stage). Progressive amounts
   are the base tables, no Dynamic Pays. *@
<div class="play-screen tl-screen has-game-bar">
    <div class="tl-games" role="tablist" aria-label="Game">
        @for (int g = 0; g < Games.Length; g++)
        {
            int gi = g;
            <button type="button" class="tl-game @(gi == _game ? "tl-on" : "")" role="tab" aria-selected="@(gi == _game ? "true" : "false")"
                    @onclick="() => { _game = gi; _tab = 0; }">@Games[gi].Name</button>
        }
    </div>

    <div class="tl-stage tl-stage-pt @(_full ? "tl-full" : "")">
        <div class="tl-strip">
            <button type="button" class="tl-exit" @onclick="ExitStrip">&lsaquo; Exit</button>
            <b>@Games[_game].Name · @Tab.Name</b>
        </div>

        <div class="tl-tabs" role="tablist" aria-label="Wager">
            @for (int t = 0; t < Games[_game].Tabs.Length; t++)
            {
                int ti = t;
                <button type="button" class="tl-tab @(ti == _tab ? "tl-on" : "")" role="tab" aria-selected="@(ti == _tab ? "true" : "false")"
                        @onclick="() => _tab = ti">@Games[_game].Tabs[ti].Short</button>
            }
        </div>

        <div class="tl-pt-body">
            @if (Tab.HouseWay)
            {
                <p class="hw-key">Front = Low hand (2 cards) &middot; Back = High hand (5 cards)</p>
                <HouseWayTable />
            }
            else
            {
                <div class="tl-cols">
                    @foreach (PtTable table in Tab.Tables)
                    {
                        <div class="tl-col">
                            @if (table.Title.Length > 0)
                            {
                                <div class="tl-col-hd @table.TitleClass">@table.Title</div>
                            }
                            <table class="tl-pt">
                                @foreach (var (hand, pay) in table.Rows)
                                {
                                    <tr><td>@hand</td><td>@pay</td></tr>
                                }
                            </table>
                        </div>
                    }
                </div>
                @if (Tab.Note.Length > 0)
                {
                    <p class="tl-note">@Tab.Note</p>
                }
            }
        </div>
    </div>

    <GameBar HelpTitle="Pay Tables" OnEnd='() => Nav.NavigateTo("tools")' EndLabel="Exit">
        <ChildContent>
            <button type="button" class="game-bar-main" @onclick="() => _full = true">Full Screen</button>
        </ChildContent>
        <HelpContent>
            <p>Pick the game, then tap a tab for each wager's pay table.</p>
            <p>Progressive amounts are the base pay tables. A percentage pays from the meter and needs a supervisor.</p>
            <p><b>Full Screen</b>, or turning your phone sideways, fills the screen with the table.</p>
        </HelpContent>
    </GameBar>
</div>

@code {
    private static PtGame[] Games => PayTablesData.Games;

    private int _game, _tab;
    private bool _full;

    private PtTab Tab => Games[_game].Tabs[_tab];

    private void ExitStrip()
    {
        if (_full) _full = false;
        else Nav.NavigateTo("tools");
    }
}
