    // ============================================================
    // SETTLING BETS, CALL & PAY (Pp prefix)
    // ============================================================

    private PgPayoutRound _ppRound = null!; // dealt by PpStartGame

    // Per wager (Insurance, Main Wager, Emperor's Treasure): the call
    // ("Win", "Lose", "Push"; null = not called yet) and the payout entered
    private readonly string?[] _ppCall = new string?[3];
    private readonly int?[] _ppPaid = new int?[3];
    private readonly bool[] _ppOk = new bool[3];

    private int _ppBox = -1;               // row whose payout box is open
    private string _ppBoxText = string.Empty;
    private ElementReference _ppBoxInputRef;
    private bool _ppFocusBox;
    private DateTime _ppEndBlockedUntil;

    private bool _ppScored;
    private string _ppResultText = string.Empty;
    private readonly List<BreakdownRow> _ppRows = new();
    private int _ppCorrect;
    private int _ppPlayed;

    private int PpWagersLeft => _ppCall.Count(c => c is null);

    // Tap-to-zoom (with ranks): 0 = closed, 1 = player, 2 = dealer.
    // _ppPeekUsed: tapped once this session, so the captions stop
    // alternating with the tap prompt. _ppDealNo restarts the caption
    // fade on each deal.
    private int _ppZoom;
    private bool _ppPeekUsed;
    private int _ppDealNo;

    private void PpTogglePeek(bool dealer)
    {
        _ppZoom = dealer ? 2 : 1;
        _ppPeekUsed = true;
    }

    // Closing the zoom puts the cursor back in an open payout box
    private void PpCloseZoom()
    {
        _ppZoom = 0;
        if (_ppBox >= 0) _ppFocusBox = true;
    }

    private void PpStartGame()
    {
        _ppCorrect = 0;
        _ppPlayed = 0;
        _ppPeekUsed = false;
        PpNewRound();
    }

    // Set hands only (no fouls), with the training boost for big
    // Emperor's Treasure hands; Joker Frequency as set on the start screen
    private void PpNewRound()
    {
        _ppRound = PaiGowPayouts.Deal(Random.Shared, ComputeJokerProbability(_sbJokerFrequencyLevel, twoHands: true));
        _ppZoom = 0;
        _ppDealNo++;
        for (int i = 0; i < 3; i++)
        {
            _ppCall[i] = null;
            _ppPaid[i] = null;
            _ppOk[i] = false;
        }
        _ppBox = -1;
        _ppBoxText = string.Empty;
        _ppScored = false;
        _ppResultText = string.Empty;
        _ppRows.Clear();
    }

    // Insurance and Emperor's Treasure take a payout; the Main Wager is a
    // plain call
    private static bool PpTyped(int i) => i != PgPayoutRound.Main;

    // The right call: "Win", "Lose" or "Push"
    private static string PpCallText(PgPay pay) => pay.IsPush ? "Push" : pay.IsLose ? "Lose" : "Win";

    private void PpPick(int i, string key)
    {
        if (_ppScored) return;
        _ppZoom = 0;

        // Win on Insurance / Emperor's Treasure opens the payout box
        if (PpTyped(i) && key == "Win")
        {
            _ppCall[i] = null;
            _ppPaid[i] = null;
            _ppBox = i;
            _ppBoxText = string.Empty;
            _ppFocusBox = true;
            _scrollToTopAfterNext = true;
            return;
        }

        _ppCall[i] = key;
        _ppPaid[i] = null;
    }

    // ---- Payout box ----

    private string PpBoxText
    {
        get => _ppBoxText;
        set => _ppBoxText = PpDigitsOnly(value);
    }

    // Whole dollars, at most 5 digits (the top pay is $75,000); no
    // leading zeros, but a lone 0 stays (0 = Lose)
    private static string PpDigitsOnly(string? raw)
    {
        System.Text.StringBuilder sb = new();
        foreach (char c in raw ?? string.Empty)
        {
            if (char.IsDigit(c) && sb.Length < 5) sb.Append(c);
        }
        string digits = sb.ToString().TrimStart('0');
        return digits.Length == 0 && sb.Length > 0 ? "0" : digits;
    }

    private void PpBoxInput(ChangeEventArgs e) => _ppBoxText = PpDigitsOnly(e.Value?.ToString());

    private void PpBoxKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") PpBoxEnter();
        else if (e.Key == "Escape") PpBoxCancel();
    }

    // Enter: the amount goes on the row and the box closes; 0 counts as Lose
    private void PpBoxEnter()
    {
        if (_ppBox < 0 || _ppBoxText.Length == 0) return;

        int i = _ppBox;
        int amount = int.Parse(_ppBoxText);
        _ppCall[i] = amount == 0 ? "Lose" : "Win";
        _ppPaid[i] = amount == 0 ? null : amount;
        PpCloseBox();
    }

    // Cancel: the row goes back to Call (no penalty)
    private void PpBoxCancel()
    {
        if (_ppBox < 0) return;
        _ppCall[_ppBox] = null;
        _ppPaid[_ppBox] = null;
        PpCloseBox();
    }

    private void PpCloseBox()
    {
        _ppBox = -1;
        _ppBoxText = string.Empty;
        _ppEndBlockedUntil = DateTime.UtcNow.AddMilliseconds(500);
    }

    private void PpEndOrCancel()
    {
        if (_ppBox >= 0)
        {
            PpBoxCancel();
            return;
        }
        if (DateTime.UtcNow < _ppEndBlockedUntil) return;
        EndSession();
    }

    // Button / answer text once a payout is in, e.g. "Win $30"
    private string? PpPickedText(int i) =>
        _ppPaid[i] is int v && _ppCall[i] == "Win" ? $"Win ${v:N0}" : null;

    // ---- Submit ----

    private void PpSubmitAndShow()
    {
        PpSubmit();
        if (_ppScored) _scrollToFeedback = true;
    }

    private void PpSubmit()
    {
        if (_ppScored || _ppBox >= 0 || PpWagersLeft > 0) return;

        _ppRows.Clear();
        for (int i = 0; i < 3; i++)
        {
            PgPay pay = _ppRound.Pays[i];
            bool wins = !pay.IsLose && !pay.IsPush;
            _ppOk[i] = _ppCall[i] switch
            {
                "Lose" => pay.IsLose,
                "Push" => pay.IsPush,
                "Win" => wins && (!PpTyped(i) || _ppPaid[i] == pay.Amount),
                _ => false
            };

            // A missed payout gets the payout shortcut under its reason
            string tip = PpTyped(i) && !_ppOk[i] && wins
                ? PayoutShortcut.For(_ppRound.Wagers[i] * 100L, pay.Amount * 100L) : "";
            _ppRows.Add(new BreakdownRow(PgPayoutRound.Names[i], PpYouText(i), PpAnswerText(i), _ppOk[i], _ppRound.Why[i], tip));
        }

        _log.AddRows(_ppRows);
        _ppPlayed++;
        if (_ppOk.All(o => o)) _ppCorrect++;

        _ppResultText = BreakdownRow.Summary(_ppRows);
        _ppScored = true;
    }

    // In the breakdown: "Win", "Lose", "Push" or "$150"
    private string PpYouText(int i) =>
        _ppPaid[i] is int v && _ppCall[i] == "Win" ? $"${v:N0}" : _ppCall[i] ?? "";

    // The right answer on a missed row: "Win" / "Lose" / "Push", or
    // (a winning Insurance / Emperor's Treasure) "$150"
    private string PpAnswerText(int i)
    {
        PgPay pay = _ppRound.Pays[i];
        string right = PpCallText(pay);
        return PpTyped(i) && right == "Win" ? PaiGowPayouts.Money(pay.Amount) : right;
    }

    private void PpNextTop()
    {
        PpNewRound();
        _scrollToTopAfterNext = true;
    }
}
