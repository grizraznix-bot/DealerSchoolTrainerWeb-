@page "/pai-gow"
@using DealerSchoolTrainerWeb.Core
@using DealerSchoolTrainerWeb.Games.PaiGowTrainer
@implements IDisposable
@inject GameResetService GameReset
@inject IJSRuntime JS

<PageTitle>Pai Gow</PageTitle>

@if (!_started)
{
    <div class="start-screen">
        <h1>PAI GOW</h1>

        @* Two independent trainers on one page. Each mode is a
           collapsible card: tap its title to open its settings and its
           own Start button (one card open at a time). Each mode keeps
           its own Joker Frequency rather than one shared value. *@
        <div class="mode-list">
            <ModeCard Title="Hand Setting"
                      Description="Arrange your 7 cards into a 5-card High hand and a 2-card Low hand per the House Way, then Submit."
                      Expanded="@IsModeOpen(PaiGowMode.HandSetting)"
                      OnToggle="() => ToggleMode(PaiGowMode.HandSetting)"
                      OnStart="StartGame">
                <div class="mode-options">
                    <div class="mode-option-group">
                        <p class="mode-option-label">Joker Frequency</p>
                        <label class="mode-choice">
                            <input type="radio" name="hsJoker" checked="@(_hsJokerFrequencyLevel == 0)" @onchange="() => _hsJokerFrequencyLevel = 0" />
                            Default
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="hsJoker" checked="@(_hsJokerFrequencyLevel == 1)" @onchange="() => _hsJokerFrequencyLevel = 1" />
                            +25%
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="hsJoker" checked="@(_hsJokerFrequencyLevel == 2)" @onchange="() => _hsJokerFrequencyLevel = 2" />
                            +50%
                        </label>
                    </div>
                </div>
            </ModeCard>

            <ModeCard Title="Settling Bets"
                      Description="Both dealer and player hands are already dealt and set. Judge each wager's outcome, flag the hand as Foul if it is one, then Submit."
                      Expanded="@IsModeOpen(PaiGowMode.SettlingBets)"
                      OnToggle="() => ToggleMode(PaiGowMode.SettlingBets)"
                      OnStart="StartGame">
                <div class="mode-options">
                    <div class="mode-option-group">
                        <p class="mode-option-label">Joker Frequency</p>
                        <label class="mode-choice">
                            <input type="radio" name="sbJoker" checked="@(_sbJokerFrequencyLevel == 0)" @onchange="() => _sbJokerFrequencyLevel = 0" />
                            Default
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="sbJoker" checked="@(_sbJokerFrequencyLevel == 1)" @onchange="() => _sbJokerFrequencyLevel = 1" />
                            +25%
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="sbJoker" checked="@(_sbJokerFrequencyLevel == 2)" @onchange="() => _sbJokerFrequencyLevel = 2" />
                            +50%
                        </label>
                    </div>
                    <div class="mode-option-group">
                        <p class="mode-option-label">Foul Frequency</p>
                        <label class="mode-choice">
                            <input type="radio" name="foul" checked="@(_sbFoulFrequencyLevel == 0)" @onchange="() => _sbFoulFrequencyLevel = 0" />
                            Rare (Default)
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="foul" checked="@(_sbFoulFrequencyLevel == 1)" @onchange="() => _sbFoulFrequencyLevel = 1" />
                            Occasional
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="foul" checked="@(_sbFoulFrequencyLevel == 2)" @onchange="() => _sbFoulFrequencyLevel = 2" />
                            Frequent
                        </label>
                    </div>
                </div>
            </ModeCard>
        </div>
    </div>
}
else if (_mode == PaiGowMode.HandSetting)
{
    @* On phones (see app.css, "Pai Gow - Hand Setting") this screen
       becomes one column: Low hand, the 7 cards (wrapping 4 + 3),
       action buttons, score, then the result. *@
    <div class="play-screen hs-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Hand Setting" Correct="_hsCorrectCount" Played="_hsTotalRounds" />

        <div class="hs-top">
            <div class="hs-low felt">
                <h3 class="tight">Low Hand</h3>
                <div class="pg-row">
                    @for (int slot = 1; slot <= 2; slot++)
                    {
                        int lowSlot = slot;
                        int cardAtSlot = HsCardAtLowPosition(lowSlot);

                        <div @onclick="() => HsReturnLowSlotToHand(lowSlot)"
                             class="pai-gow-card hs-low-slot">
                            @if (cardAtSlot >= 0)
                            {
                                <img src="images/cards/@(_hsCards[cardAtSlot].ImageCode).png" alt="@_hsCards[cardAtSlot].Name" class="pg-slot-img" />
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="feedback-area hs-feedback">
                @if (_hsErrorText.Length > 0)
                {
                    <p class="txt-bad">@_hsErrorText</p>
                }

                @if (_hsResultHeader.Length > 0)
                {
                    <p class="result-line hs-result-header @(_hsResultIsCorrect ? "txt-ok" : "txt-bad")">@_hsResultHeader</p>
                }

                @if (_hsShowComparison)
                {
                    <div class="pg-compare">
                        <div class="txt-bold txt-bad">YOUR LOW HAND</div>
                        <div class="txt-bold txt-ok">CORRECT LOW HAND</div>
                        <div class="txt-bad">@_hsYourLowLabel</div>
                        <div class="txt-ok">@_hsCorrectLowLabel</div>
                        <div class="txt-bold txt-bad pg-gap">YOUR HIGH HAND</div>
                        <div class="txt-bold txt-ok pg-gap">CORRECT HIGH HAND</div>
                        <div class="txt-bad">@_hsYourHighDescription</div>
                        <div class="txt-ok">@_hsCorrectHighDescription</div>
                    </div>
                }
                else if (_hsSingleBody.Length > 0)
                {
                    <div class="pre-line txt-bold @(_hsResultIsCorrect ? "txt-ok" : "txt-bad")">@_hsSingleBody</div>
                }
            </div>
        </div>

        <div class="hs-hand felt">
        <h3 class="hs-cards-title">Your 7 Cards</h3>
        <div class="hs-cards">
            @for (int i = 0; i < _hsCards.Count; i++)
            {
                int cardIndex = i;
                bool inLow = _hsCardPosition[cardIndex] != 0;

                <img src="images/cards/@(_hsCards[cardIndex].ImageCode).png" alt="@_hsCards[cardIndex].Name"
                     @onclick="() => HsCardClicked(cardIndex)"
                     class="pai-gow-card hs-card @(inLow ? "hs-card-moved" : "")" />
            }
        </div>
        </div>

        @* First round only: what to do *@
        @if (_hsTotalRounds == 0 && !_hsDealEnabled)
        {
            <p class="first-hint">Tap 2 cards to move them to the Low Hand (tap a Low Hand card to send it back). Sort lines your cards up. Then Submit.</p>
        }

        @* Pinned bottom bar: Help | one step button that changes as the
           hand progresses: Sort -> (once sorted) Submit -> (once scored)
           Next | End Session *@
        <GameBar HelpTitle="House Ways" OnEnd="EndSession">
            <ChildContent>
                @if (_hsSortEnabled)
                {
                    <button class="game-bar-main" @onclick="HsSortHand">Sort</button>
                }
                else if (_hsSubmitEnabled)
                {
                    <button class="game-bar-main" @onclick="HsSubmitHand">Submit</button>
                }
                else if (_hsDealEnabled)
                {
                    <button class="game-bar-main" @onclick="HsDealAgain">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <img src="images/cards/HouseWays.png" alt="Pai Gow House Ways" class="help-image" />
            </HelpContent>
        </GameBar>
    </div>
}
else
{
    @* On phones (see app.css, "Pai Gow - Settling Bets") this screen
       becomes one column: player hands, dealer hands, the Ace-High
       push note, the four wagers (2 x 2), action buttons, then the
       winning-wager results. *@
    <div class="play-screen sb-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Settling Bets" Correct="_sbCorrectCount" Played="_sbTotalRounds" />

        <div class="sb-player felt">
        <h3 class="tight">Player</h3>
        <div class="sb-hand-row">
            <div>
                <div class="caption">High Hand</div>
                <div class="sb-cards pg-row pg-row-gap">
                    @foreach (PaiGowCard c in _sbPlayerHighSorted)
                    {
                        <img src="images/cards/@(c.ImageCode).png" alt="@c.Name" class="sb-card" />
                    }
                </div>
                <div class="caption">Low Hand</div>
                <div class="sb-cards pg-row">
                    @foreach (PaiGowCard c in _sbPlayerLowSorted)
                    {
                        <img src="images/cards/@(c.ImageCode).png" alt="@c.Name" class="sb-card" />
                    }
                </div>
            </div>

            @if (_sbRoundScored)
            {
                <div class="feedback-area sb-hand-labels">
                    <p class="tight">High Hand: @_sbPlayerHighLabel</p>
                    <p class="tight-top">Low Hand: @_sbPlayerLowLabel</p>
                </div>
            }
        </div>
        </div>

        <div class="sb-wager-row">
            <div class="sb-wagers">
            @* Wager buttons: tap for a pop-up of choices. Picking a wager
               result clears Foul; marking Foul clears the wager picks. *@
            <WagerPick Label="Emperor's Treasure"
                       Value="@_sbEmperorsTreasure.Selection?.ToString()"
                       OnPick="k => { _sbEmperorsTreasure.Selection = Enum.Parse<WagerOutcome>(k); _sbEmperorsTreasure.Wrong = false; SbResetFoul(); }"
                       Locked="_sbRoundScored" Wrong="_sbEmperorsTreasure.Wrong" />

            <WagerPick Label="Main Wager" Options="WagerPick.WinLosePush"
                       Value="@_sbMainWager.Selection?.ToString()"
                       OnPick="k => { _sbMainWager.Selection = Enum.Parse<WagerOutcome>(k); _sbMainWager.Wrong = false; SbResetFoul(); }"
                       Locked="_sbRoundScored" Wrong="_sbMainWager.Wrong" />

            <WagerPick Label="Pai Gow Insurance"
                       Value="@_sbInsurance.Selection?.ToString()"
                       OnPick="k => { _sbInsurance.Selection = Enum.Parse<WagerOutcome>(k); _sbInsurance.Wrong = false; SbResetFoul(); }"
                       Locked="_sbRoundScored" Wrong="_sbInsurance.Wrong" />

            <WagerPick Label="Foul" Options="FoulOptions"
                       Value="@(_sbFoulFlagged ? "Foul" : null)"
                       OnPick='k => SbSetFoul(k == "Foul")'
                       Locked="_sbRoundScored" Wrong="_sbFoulWrong" />
            </div>

            @* First round only: what to do *@
            @if (_sbTotalRounds == 0 && !_sbRoundScored)
            {
                <p class="first-hint sb-first-hint">Call each wager Win, Lose or Push, or mark the player's hand Foul, then Submit.</p>
            }

            @* Before Submit: the "tap every wager" reminder, if needed *@
            @if (!_sbRoundScored && _sbResultText.Length > 0)
            {
                <div class="sb-status">
                    <p class="result-line txt-bad">@_sbResultText</p>
                </div>
            }
        </div>

        <p class="sb-push-note">All Hands Push with a Dealer Ace-High Pai Gow</p>

        <div class="sb-dealer felt">
        <h3 class="tight">Dealer</h3>
        <div class="sb-hand-row">
            <div>
                <div class="caption">Low Hand</div>
                <div class="sb-cards pg-row pg-row-gap">
                    @foreach (PaiGowCard c in _sbDealerLowSorted)
                    {
                        <img src="images/cards/@(c.ImageCode).png" alt="@c.Name" class="sb-card" />
                    }
                </div>
                <div class="caption">High Hand</div>
                <div class="sb-cards pg-row">
                    @foreach (PaiGowCard c in _sbDealerHighSorted)
                    {
                        <img src="images/cards/@(c.ImageCode).png" alt="@c.Name" class="sb-card" />
                    }
                </div>
            </div>

            @if (_sbRoundScored)
            {
                <div class="feedback-area sb-hand-labels">
                    <p class="tight">Low Hand: @_sbDealerLowLabel</p>
                    <p class="tight-top">High Hand: @_sbDealerHighLabel</p>
                </div>
            }
        </div>
        </div>

        @* After Submit: the result, then each wager with the right answer
           and why (same style as Roulette's payout breakdown) *@
        @if (_sbRoundScored)
        {
            <div class="sb-feedback">
                <p class="result-line @(_sbIsCorrect ? "txt-ok" : "txt-bad")">@_sbResultText</p>
                <div class="rl-breakdown sb-breakdown">
                    <table>
                        @foreach (SbRow row in _sbRows)
                        {
                            <tr class="sb-row">
                                <td>@row.Wager</td>
                                <td class="@(row.Ok ? "txt-ok" : "txt-bad")">
                                    @if (row.Ok)
                                    {
                                        <text>&#x2713; @row.Answer</text>
                                    }
                                    else
                                    {
                                        <text>&#x2717; You: @row.You &middot; Answer: @row.Answer</text>
                                    }
                                </td>
                            </tr>
                            <tr class="sb-why">
                                <td colspan="2">@row.Why</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        }

        @* Pinned bottom bar: Help | Submit, then Next | End Session *@
        <GameBar HelpTitle="Settling Bets Wager Rules" OnEnd="EndSession">
            <ChildContent>
                @if (!_sbRoundScored)
                {
                    <button class="game-bar-main" @onclick="SbSubmitRound" disabled="@(!_sbSubmitEnabled)">Submit</button>
                }
                else
                {
                    <button class="game-bar-main" @onclick="SbDealAgain" disabled="@(!_sbDealEnabled)">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <img src="images/cards/SettlingBetsWagerRules.png" alt="Pai Gow - Settling Bets Wager Rules" class="help-image" />
            </HelpContent>
        </GameBar>
    </div>
}

@if (_showSessionSummary)
{
    <div class="session-summary">
        <h3>Session Summary</h3>
        @if (_mode == PaiGowMode.HandSetting)
        {
            <p>Rounds Played: @_hsTotalRounds</p>
            <p>Correct: @_hsCorrectCount</p>
            <p>Incorrect: @(_hsTotalRounds - _hsCorrectCount)</p>
        }
        else
        {
            <p>Rounds Played: @_sbTotalRounds</p>
            <p>Correct: @_sbCorrectCount</p>
            <p>Incorrect: @(_sbTotalRounds - _sbCorrectCount)</p>
        }
        <button @onclick="CloseSummary">OK</button>
    </div>
}

@code {
    // Menu link for this game tapped while it's already open: return to
    // the start screen, same as the Back button (hidden on phones).
    protected override void OnInitialized()
    {
        GameReset.ResetRequested += OnResetRequested;
    }

    private void OnResetRequested()
    {
        _showSessionSummary = false;
        _started = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameReset.ResetRequested -= OnResetRequested;
    }

    // Scroll back to the top whenever this game switches between its
    // start screen and its play screen (Start, Back, menu, End Session).
    // Without this the browser keeps the old scroll position -- after
    // scrolling down to reach Start, the game would open scrolled down.
    private bool _lastRenderedStarted;

    private bool _scrollToSummary;
    private bool _scrollToSbFeedback;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // End Session: bring the Session Summary into view (it's at the
        // bottom of the page, often below the screen on a phone)
        if (_scrollToSummary && _showSessionSummary)
        {
            _scrollToSummary = false;
            try { await JS.InvokeVoidAsync("dstScrollToEl", ".session-summary"); } catch { }
        }

        // Settling Bets Submit: bring the wager breakdown into view
        if (_scrollToSbFeedback && _sbRoundScored)
        {
            _scrollToSbFeedback = false;
            try { await JS.InvokeVoidAsync("dstScrollToEl", ".sb-feedback"); } catch { }
        }

        if (_started != _lastRenderedStarted)
        {
            _lastRenderedStarted = _started;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }
        }
    }

    private enum PaiGowMode { HandSetting, SettlingBets }

    // Shared across both modes.
    private bool _started;
    private PaiGowMode _mode = PaiGowMode.HandSetting;

    // Start screen: which mode card is open (null = all closed). Opening
    // a card also selects its mode, so that card's Start button starts
    // it. The open card stays open after a session, so a returning
    // trainee lands right back on the mode they were using.
    private PaiGowMode? _openMode;

    private bool IsModeOpen(PaiGowMode mode) => _openMode == mode;

    private void ToggleMode(PaiGowMode mode)
    {
        _openMode = _openMode == mode ? null : mode;
        if (_openMode is not null) _mode = mode;
    }
    private bool _showSessionSummary;

    private void BackToStart() => _started = false;

    private void CloseSummary()
    {
        _showSessionSummary = false;
        _started = false;
    }

    private void StartGame()
    {
        _started = true;

        if (_mode == PaiGowMode.HandSetting)
        {
            HsStartGame();
        }
        else
        {
            SbStartGame();
        }
    }

    private void EndSession()
    {
        bool anyRoundsPlayed = _mode == PaiGowMode.HandSetting
            ? _hsTotalRounds > 0
            : _sbTotalRounds > 0;

        if (anyRoundsPlayed)
        {
            _showSessionSummary = true;
            _scrollToSummary = true;
        }
        else
        {
            _started = false;
        }
    }

    // Shared pure helper -- identical Joker-inclusion-probability
    // formula used by both modes (natural 7/53 odds boosted by the
    // chosen level), and identical rank-value mapping (Joker and Ace
    // both map to 14) used by both modes' own sorting logic.
    private static double ComputeJokerProbability(int level)
    {
        const double naturalJokerProbability = 7.0 / 53.0;
        double boost = level switch { 1 => 0.25, 2 => 0.50, _ => 0.0 };
        return naturalJokerProbability * (1 + boost);
    }

    private static int CardSortValue(PaiGowCard card) => card.Rank switch
    {
        "JOKER" => 14,
        "A" => 14,
        "K" => 13,
        "Q" => 12,
        "J" => 11,
        "T" => 10,
        _ => int.TryParse(card.Rank, out int n) ? n : 0
    };

    // ============================================================
    // HAND SETTING (Hs prefix)
    // ============================================================

    private const int HsCardCount = 7;

    private int _hsJokerFrequencyLevel;

    private PaiGowDeck _hsDeck = new();
    private readonly PaiGowSolver _hsSolver = new();
    private List<PaiGowCard> _hsCards = new();

    private readonly int[] _hsCardPosition = new int[HsCardCount];

    private int _hsCorrectCount;
    private int _hsTotalRounds;
    private bool _hsRoundScored;

    private bool _hsSortEnabled;
    private bool _hsSubmitEnabled;
    private bool _hsDealEnabled;
    private string _hsErrorText = string.Empty;
    private string _hsResultHeader = string.Empty;
    private bool _hsShowComparison;
    private string _hsSingleBody = string.Empty;
    private string _hsYourLowLabel = string.Empty;
    private string _hsCorrectLowLabel = string.Empty;
    private string _hsYourHighDescription = string.Empty;
    private string _hsCorrectHighDescription = string.Empty;
    private bool _hsResultIsCorrect;
    private string _hsScoreText = "Score: 0 / 0 (0.0%)";

    private void HsStartGame()
    {
        _hsCorrectCount = 0;
        _hsTotalRounds = 0;
        _hsScoreText = "Score: 0 / 0 (0.0%)";

        HsDealNewRound();
    }

    private void HsDealNewRound()
    {
        _hsDealEnabled = false;
        _hsErrorText = string.Empty;
        _hsResultHeader = string.Empty;
        _hsShowComparison = false;
        _hsSingleBody = string.Empty;

        _hsDeck = new PaiGowDeck();

        double jokerProbability = ComputeJokerProbability(_hsJokerFrequencyLevel);

        _hsCards = _hsDeck.DealSevenCardsWithJokerBias(jokerProbability);
        Array.Clear(_hsCardPosition);

        _hsSolver.SetCards(_hsCards);

        _hsRoundScored = false;
        _hsSubmitEnabled = true;
        _hsSortEnabled = true;
    }

    private void HsDealAgain() => HsDealNewRound();

    private int HsCardAtLowPosition(int lowPosition)
    {
        for (int i = 0; i < _hsCards.Count; i++)
        {
            if (_hsCardPosition[i] == lowPosition) return i;
        }
        return -1;
    }

    private void HsCardClicked(int cardIndex)
    {
        if (_hsCardPosition[cardIndex] != 0) return;

        int targetLow;
        if (HsCardAtLowPosition(1) < 0) targetLow = 1;
        else if (HsCardAtLowPosition(2) < 0) targetLow = 2;
        else
        {
            _hsErrorText = "Low hand is full. Click a Low card to return it first.";
            return;
        }

        _hsErrorText = string.Empty;
        _hsCardPosition[cardIndex] = targetLow;
    }

    private void HsReturnLowSlotToHand(int lowPosition)
    {
        int cardIndex = HsCardAtLowPosition(lowPosition);
        if (cardIndex < 0) return;

        _hsCardPosition[cardIndex] = 0;
    }

    private void HsSortHand()
    {
        for (int i = 0; i < _hsCards.Count; i++)
        {
            if (_hsCardPosition[i] != 0)
            {
                _hsErrorText = "Return the Low cards before sorting.";
                return;
            }
        }

        _hsCards = _hsCards.OrderByDescending(CardSortValue).ToList();
        _hsSolver.SetCards(_hsCards);

        _hsErrorText = string.Empty;
        _hsSortEnabled = false;
    }

    private void HsSubmitHand()
    {
        if (_hsRoundScored) return;

        int lowCard1 = HsCardAtLowPosition(1);
        int lowCard2 = HsCardAtLowPosition(2);

        List<int> userHighList = new();
        for (int i = 0; i < _hsCards.Count; i++)
        {
            if (_hsCardPosition[i] == 0) userHighList.Add(i);
        }

        if (lowCard1 < 0 || lowCard2 < 0 || userHighList.Count != 5)
        {
            _hsErrorText = "You must place two cards in the Low hand before submitting.";
            return;
        }

        int[] userHigh = new int[6];
        for (int k = 0; k < 5; k++) userHigh[k + 1] = userHighList[k] + 1;

        PaiGowSubmitResult result = _hsSolver.SubmitHand(lowCard1 + 1, lowCard2 + 1, userHigh);

        if (result.ValidationError is not null)
        {
            _hsErrorText = result.ValidationError;
            return;
        }

        _hsErrorText = string.Empty;
        _hsTotalRounds++;
        if (result.IsCorrect) _hsCorrectCount++;

        _hsRoundScored = true;
        _hsSubmitEnabled = false;
        _hsDealEnabled = true;

        _hsScoreText = $"Score: {_hsCorrectCount} / {_hsTotalRounds} ({(double)_hsCorrectCount / _hsTotalRounds:0.0%})";

        if (result.IsFoul)
        {
            _hsResultIsCorrect = false;
            _hsResultHeader = "INCORRECT HAND - FOUL";
            _hsShowComparison = false;
            _hsSingleBody = $"Your hand is FOUL.\nThe Low Hand is higher than the High Hand.\n\n" +
                          $"LOW HAND: {result.UserLowLabel}\nHIGH HAND: {result.UserHighDescription}";
        }
        else if (result.IsCorrect)
        {
            _hsResultIsCorrect = true;
            _hsResultHeader = "CORRECT";
            _hsShowComparison = false;
            _hsSingleBody = $"LOW HAND\n{result.CorrectLowLabel}\n\nHIGH HAND\n{result.CorrectHighDescription}";
        }
        else
        {
            _hsResultIsCorrect = false;
            _hsResultHeader = "INCORRECT";
            _hsShowComparison = true;
            _hsYourLowLabel = result.UserLowLabel;
            _hsCorrectLowLabel = result.CorrectLowLabel;
            _hsYourHighDescription = result.UserHighDescription;
            _hsCorrectHighDescription = result.CorrectHighDescription;
        }
    }

    // ============================================================
    // SETTLING BETS (Sb prefix)
    // ============================================================

    private sealed class SbWagerState
    {
        public WagerOutcome? Selection;
        public bool Wrong;
    }

    private int _sbJokerFrequencyLevel;
    private int _sbFoulFrequencyLevel;

    private readonly PaiGowSolver _sbPlayerSolver = new();
    private readonly PaiGowSolver _sbDealerSolver = new();

    private List<PaiGowCard> _sbPlayerCards = new();
    private List<PaiGowCard> _sbDealerCards = new();

    private int _sbPlayerLow1, _sbPlayerLow2;
    private int[] _sbPlayerHigh = new int[6];
    private bool _sbIsPlayerFoul;

    private int _sbDealerLow1, _sbDealerLow2;
    private int[] _sbDealerHigh = new int[6];

    private List<PaiGowCard> _sbDealerLowSorted = new();
    private List<PaiGowCard> _sbDealerHighSorted = new();
    private List<PaiGowCard> _sbPlayerLowSorted = new();
    private List<PaiGowCard> _sbPlayerHighSorted = new();

    private readonly SbWagerState _sbInsurance = new();
    private readonly SbWagerState _sbMainWager = new();
    private readonly SbWagerState _sbEmperorsTreasure = new();

    private bool _sbFoulFlagged;
    private bool _sbFoulWrong;

    private int _sbCorrectCount;
    private int _sbTotalRounds;
    private bool _sbRoundScored;

    private bool _sbSubmitEnabled;
    private bool _sbDealEnabled;
    private string _sbResultText = string.Empty;

    private string _sbPlayerLowLabel = string.Empty;
    private string _sbPlayerHighLabel = string.Empty;
    private string _sbDealerLowLabel = string.Empty;
    private string _sbDealerHighLabel = string.Empty;

    // One line per wager in the feedback box after Submit
    private sealed record SbRow(string Wager, string You, string Answer, bool Ok, string Why);
    private readonly List<SbRow> _sbRows = new();
    private bool _sbIsCorrect;
    private string _sbScoreText = "Score: 0 / 0 (0.0%)";

    private void SbStartGame()
    {
        _sbCorrectCount = 0;
        _sbTotalRounds = 0;
        _sbScoreText = "Score: 0 / 0 (0.0%)";

        SbDealNewRound();
    }

    private void SbDealNewRound()
    {
        _sbDealEnabled = false;

        double jokerProbability = ComputeJokerProbability(_sbJokerFrequencyLevel);

        PaiGowDeck sharedDeck = new PaiGowDeck();
        (_sbPlayerCards, _sbDealerCards) = sharedDeck.DealTwoSevenCardHandsWithJokerBias(jokerProbability);

        _sbDealerSolver.SetCards(_sbDealerCards);
        (_sbDealerLow1, _sbDealerLow2, _sbDealerHigh) = _sbDealerSolver.GetCorrectHand();

        _sbDealerLowSorted = SbSortByRankGroupThenRank(new List<PaiGowCard>
        {
            _sbDealerCards[_sbDealerLow1 - 1],
            _sbDealerCards[_sbDealerLow2 - 1]
        });

        List<PaiGowCard> dealerHighCards = new();
        for (int i = 1; i <= 5; i++)
            dealerHighCards.Add(_sbDealerCards[_sbDealerHigh[i] - 1]);
        _sbDealerHighSorted = SbSortByRankGroupThenRank(dealerHighCards);

        _sbPlayerSolver.SetCards(_sbPlayerCards);

        double foulProbability = SbComputeFoulProbability(_sbFoulFrequencyLevel);
        bool shouldBeFoul = Random.Shared.NextDouble() < foulProbability;
        SbGeneratePlayerSplit(shouldBeFoul);

        _sbInsurance.Selection = null; _sbInsurance.Wrong = false;
        _sbMainWager.Selection = null; _sbMainWager.Wrong = false;
        _sbEmperorsTreasure.Selection = null; _sbEmperorsTreasure.Wrong = false;
        _sbFoulFlagged = false;
        _sbFoulWrong = false;

        _sbResultText = string.Empty;
        _sbPlayerLowLabel = string.Empty;
        _sbPlayerHighLabel = string.Empty;
        _sbDealerLowLabel = string.Empty;
        _sbDealerHighLabel = string.Empty;
        _sbRows.Clear();
        _sbRoundScored = false;
        _sbSubmitEnabled = true;
    }

    private void SbDealAgain() => SbDealNewRound();

    // Absolute probabilities (not relative boosts like Joker
    // Frequency) since there's no single well-defined "natural" foul
    // rate to scale from. All three tiers favor practice reps over
    // realism.
    private static double SbComputeFoulProbability(int level) => level switch
    {
        1 => 0.40,
        2 => 0.60,
        _ => 0.20
    };

    private static List<PaiGowCard> SbSortByRankGroupThenRank(List<PaiGowCard> cards)
    {
        Dictionary<int, int> rankCounts = new();
        foreach (PaiGowCard c in cards)
        {
            int rank = CardSortValue(c);
            rankCounts[rank] = rankCounts.GetValueOrDefault(rank) + 1;
        }

        return cards
            .OrderByDescending(c => rankCounts[CardSortValue(c)])
            .ThenByDescending(CardSortValue)
            .ToList();
    }

    private void SbGeneratePlayerSplit(bool shouldBeFoul)
    {
        List<(int Low1, int Low2, int[] High, bool Legal, double HighScore)> candidates = new();

        for (int a = 1; a <= 7; a++)
        {
            for (int b = a + 1; b <= 7; b++)
            {
                int[] high = new int[6];
                int idx = 1;
                for (int c = 1; c <= 7; c++)
                {
                    if (c == a || c == b) continue;
                    high[idx++] = c;
                }

                bool legal = _sbPlayerSolver.IsLegalSplit(a, b, high);
                double highScore = _sbPlayerSolver.ScoreHighHand(high);
                candidates.Add((a, b, high, legal, highScore));
            }
        }

        List<(int Low1, int Low2, int[] High, bool Legal, double HighScore)> pool =
            shouldBeFoul
                ? candidates.Where(c => !c.Legal).ToList()
                : candidates.Where(c => c.Legal).ToList();

        if (pool.Count == 0)
        {
            pool = candidates.Where(c => c.Legal).ToList();
            shouldBeFoul = false;
        }

        List<(int Low1, int Low2, int[] High, bool Legal, double HighScore)> ranked =
            pool.OrderByDescending(c => c.HighScore).ToList();
        int topCount = Math.Max(1, ranked.Count / 3);
        (int Low1, int Low2, int[] High, bool Legal, double HighScore) chosen = ranked[Random.Shared.Next(topCount)];

        _sbPlayerLow1 = chosen.Low1;
        _sbPlayerLow2 = chosen.Low2;
        _sbPlayerHigh = chosen.High;
        _sbIsPlayerFoul = shouldBeFoul;

        _sbPlayerLowSorted = SbSortByRankGroupThenRank(new List<PaiGowCard>
        {
            _sbPlayerCards[_sbPlayerLow1 - 1],
            _sbPlayerCards[_sbPlayerLow2 - 1]
        });

        List<PaiGowCard> playerHighCards = new();
        for (int i = 1; i <= 5; i++)
            playerHighCards.Add(_sbPlayerCards[_sbPlayerHigh[i] - 1]);
        _sbPlayerHighSorted = SbSortByRankGroupThenRank(playerHighCards);
    }

    // Foul button choices: Foul (orange), or Not Foul (clears the flag)
    private static readonly IReadOnlyList<WagerPickOption> FoulOptions = new[]
    {
        new WagerPickOption("Foul", "Foul", "wp-foul"),
        new WagerPickOption("NotFoul", "Not Foul", "")
    };

    // Marking Foul clears the three wager picks (a foul hand isn't
    // settled wager by wager); Not Foul just clears the flag.
    private void SbSetFoul(bool foul)
    {
        _sbFoulWrong = false;
        if (!foul)
        {
            _sbFoulFlagged = false;
            return;
        }

        _sbFoulFlagged = true;
        _sbInsurance.Selection = null; _sbInsurance.Wrong = false;
        _sbMainWager.Selection = null; _sbMainWager.Wrong = false;
        _sbEmperorsTreasure.Selection = null; _sbEmperorsTreasure.Wrong = false;
    }

    private void SbResetFoul()
    {
        _sbFoulFlagged = false;
        _sbFoulWrong = false;
    }

    private void SbSubmitRound()
    {
        if (_sbRoundScored) return;

        _sbRows.Clear();

        // Foul marked: only the Foul call is graded (a fouled hand's
        // wagers aren't settled one by one)
        if (_sbFoulFlagged)
        {
            bool foulCorrect = _sbIsPlayerFoul;
            _sbFoulWrong = !foulCorrect;

            _sbRows.Add(SbFoulRow(true));

            _sbTotalRounds++;
            if (foulCorrect) _sbCorrectCount++;

            _sbIsCorrect = foulCorrect;
            _sbResultText = foulCorrect
                ? "CORRECT \u2014 the player's hand is fouled"
                : "INCORRECT \u2014 the player's hand is not fouled";

            SbFinishRound();
            return;
        }

        if (_sbInsurance.Selection is null || _sbMainWager.Selection is null || _sbEmperorsTreasure.Selection is null)
        {
            _sbResultText = "Tap every wager to select an outcome before submitting.";
            _sbIsCorrect = false;
            return;
        }

        // Best hand that can be made from any 5 of the player's 7 cards --
        // what both side wagers are settled on
        string bestOfSeven = _sbPlayerSolver.BestSevenCardCategoryName();

        // Emperor's Treasure: wins with Three of a Kind or better anywhere
        // in the 7 cards
        bool emperorsActual = _sbPlayerSolver.QualifiesEmperorsTreasure();
        WagerOutcome emperorsOutcome = emperorsActual ? WagerOutcome.Win : WagerOutcome.Lose;
        bool emperorsOk = SbGradeWager(_sbEmperorsTreasure, emperorsOutcome);
        _sbRows.Add(new SbRow("Emperor's Treasure", $"{_sbEmperorsTreasure.Selection}", $"{emperorsOutcome}", emperorsOk,
            $"Best hand in the 7 cards: {_sbPlayerSolver.EmperorsTreasureCategoryName()}. Wins on Three of a Kind or better."));

        // Main Wager: foul loses; dealer Ace-High Pai Gow pushes; otherwise
        // win both hands = Win, lose both = Lose, one each = Push. A tie
        // (copy) goes to the dealer.
        WagerOutcome mainOutcome;
        string mainWhy;
        if (_sbIsPlayerFoul)
        {
            mainOutcome = WagerOutcome.Lose;
            mainWhy = "The player's hand is fouled, so the Main Wager loses.";
        }
        else if (_sbDealerSolver.IsAceHighPaiGow(_sbDealerHigh))
        {
            mainOutcome = WagerOutcome.Push;
            mainWhy = "The dealer has Ace-High Pai Gow, so all hands push.";
        }
        else
        {
            double playerLowScore = _sbPlayerSolver.ScoreLowHand(_sbPlayerLow1, _sbPlayerLow2);
            double playerHighScore = _sbPlayerSolver.ScoreHighHand(_sbPlayerHigh);
            double dealerLowScore = _sbDealerSolver.ScoreLowHand(_sbDealerLow1, _sbDealerLow2);
            double dealerHighScore = _sbDealerSolver.ScoreHighHand(_sbDealerHigh);

            bool winsLow = playerLowScore > dealerLowScore;
            bool winsHigh = playerHighScore > dealerHighScore;

            mainOutcome = (winsLow, winsHigh) switch
            {
                (true, true) => WagerOutcome.Win,
                (false, false) => WagerOutcome.Lose,
                _ => WagerOutcome.Push
            };

            mainWhy = $"High hand: {SbWhoWins(winsHigh, playerHighScore == dealerHighScore)}. "
                    + $"Low hand: {SbWhoWins(winsLow, playerLowScore == dealerLowScore)}.";
        }
        bool mainOk = SbGradeWager(_sbMainWager, mainOutcome);
        _sbRows.Add(new SbRow("Main Wager", $"{_sbMainWager.Selection}", $"{mainOutcome}", mainOk, mainWhy));

        // Pai Gow Insurance: wins only when nothing better than High Card
        // can be made from the 7 cards
        bool insuranceActual = _sbPlayerSolver.QualifiesInsurance();
        WagerOutcome insuranceOutcome = insuranceActual ? WagerOutcome.Win : WagerOutcome.Lose;
        bool insuranceOk = SbGradeWager(_sbInsurance, insuranceOutcome);
        _sbRows.Add(new SbRow("Pai Gow Insurance", $"{_sbInsurance.Selection}", $"{insuranceOutcome}", insuranceOk,
            $"Best hand in the 7 cards: {bestOfSeven}. Wins only on High Card (no pair, straight or flush)."));

        // A fouled hand that wasn't marked Foul is also a miss
        _sbFoulWrong = _sbIsPlayerFoul;
        if (_sbIsPlayerFoul)
        {
            _sbRows.Add(SbFoulRow(false));
        }

        bool allCorrect = emperorsOk && mainOk && insuranceOk && !_sbFoulWrong;

        _sbTotalRounds++;
        if (allCorrect) _sbCorrectCount++;

        _sbIsCorrect = allCorrect;
        int wrong = _sbRows.Count(r => !r.Ok);
        _sbResultText = allCorrect
            ? "CORRECT \u2014 every wager settled right"
            : $"INCORRECT \u2014 {wrong} of {_sbRows.Count} wrong";

        SbFinishRound();
    }

    // Hand labels under the cards, and the buttons, once a round is scored
    private void SbFinishRound()
    {
        string pct = _sbTotalRounds > 0
            ? ((double)_sbCorrectCount / _sbTotalRounds).ToString("0.0%")
            : "0.0%";
        _sbScoreText = $"Score: {_sbCorrectCount} / {_sbTotalRounds} ({pct})";

        _sbPlayerLowLabel = _sbPlayerSolver.LowHandLabel(_sbPlayerLow1, _sbPlayerLow2);
        _sbPlayerHighLabel = _sbPlayerSolver.HighHandDescription(_sbPlayerHigh);
        _sbDealerLowLabel = _sbDealerSolver.LowHandLabel(_sbDealerLow1, _sbDealerLow2);
        _sbDealerHighLabel = _sbDealerSolver.HighHandDescription(_sbDealerHigh);

        _sbRoundScored = true;
        _sbSubmitEnabled = false;
        _sbDealEnabled = true;
        _scrollToSbFeedback = true;
    }

    // The Foul line in the feedback. markedFoul: whether Foul was picked.
    private SbRow SbFoulRow(bool markedFoul)
    {
        string answer = _sbIsPlayerFoul ? "Foul" : "Not foul";
        string you = markedFoul ? "Foul" : "Not marked";
        bool ok = markedFoul == _sbIsPlayerFoul;
        string why = _sbIsPlayerFoul
            ? "The Low hand outranks the High hand."
            : "The High hand outranks the Low hand, so the hand is set legally.";
        return new SbRow("Foul", you, answer, ok, why);
    }

    private static string SbWhoWins(bool playerWins, bool tie) =>
        playerWins ? "player wins" : tie ? "tie (copy), dealer wins" : "dealer wins";

    private static bool SbGradeWager(SbWagerState w, WagerOutcome actual)
    {
        if (w.Selection == actual)
        {
            w.Wrong = false;
            return true;
        }

        w.Wrong = true;
        return false;
    }
}
