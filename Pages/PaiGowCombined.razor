    // it. The open card stays open after a session, so a returning
    // trainee lands right back on the mode they were using.
    private PaiGowMode? _openMode;

    private bool IsModeOpen(PaiGowMode mode) => _openMode == mode;

    private void ToggleMode(PaiGowMode mode)
    {
        _openMode = _openMode == mode ? null : mode;
        if (_openMode is not null) _mode = mode;
    }
    private bool _showSessionSummary;

    private void BackToStart() => _started = false;

    private void CloseSummary()
    {
        _showSessionSummary = false;
        _started = false;
    }

    // What happened this session, for the summary (Shared/SessionSummary)
    private SessionLog _log = new();

    // End-of-session summary's Practice Again: a fresh session of the same
    // mode, back at the top of the page (as if started from the start screen)
    private void PracticeAgain()
    {
        _showSessionSummary = false;
        StartGame();
        _lastRenderedStarted = false;
    }

    private void StartGame()
    {
        _started = true;
        _log = new SessionLog();

        if (_mode == PaiGowMode.HandSetting)
        {
            HsStartGame();
        }
        else if (_mode == PaiGowMode.Payouts)
        {
            PpStartGame();
        }
        else
        {
            SbStartGame();
        }
    }

    private void EndSession()
    {
        bool anyRoundsPlayed = _mode switch
        {
            PaiGowMode.HandSetting => _hsTotalRounds > 0,
            PaiGowMode.Payouts => _ppPlayed > 0,
            _ => _sbTotalRounds > 0
        };

        if (anyRoundsPlayed)
        {
            _showSessionSummary = true;
            _scrollToSummary = true;
        }
        else
        {
            _started = false;
        }
    }

    // Shared pure helper -- identical Joker-inclusion-probability
    // formula used by both modes (natural 7/53 odds boosted by the
    // chosen level), and identical rank-value mapping (Joker and Ace
    // both map to 14) used by both modes' own sorting logic.
    private static double ComputeJokerProbability(int level)
    {
        const double naturalJokerProbability = 7.0 / 53.0;
        double boost = level switch { 1 => 0.25, 2 => 0.50, _ => 0.0 };
        return naturalJokerProbability * (1 + boost);
    }

    private static int CardSortValue(PaiGowCard card) => card.Rank switch
    {
        "JOKER" => 14,
        "A" => 14,
        "K" => 13,
        "Q" => 12,
        "J" => 11,
        "T" => 10,
        _ => int.TryParse(card.Rank, out int n) ? n : 0
    };

    // ============================================================
    // HAND SETTING (Hs prefix)
    // ============================================================

    private const int HsCardCount = 7;

    private int _hsJokerFrequencyLevel;

    // Advanced difficulty: about 1 hand in 3 is built to need one of the
    // House Way's special rules (Games/PaiGowTrainer/PaiGowTrickyHands.cs)
    private bool _hsAdvanced;

    private PaiGowDeck _hsDeck = new();
    private readonly PaiGowSolver _hsSolver = new();
    private List<PaiGowCard> _hsCards = new();

    private readonly int[] _hsCardPosition = new int[HsCardCount];

    private int _hsCorrectCount;
    private int _hsTotalRounds;
    private bool _hsRoundScored;

    private bool _hsSortEnabled;
    private bool _hsSubmitEnabled;
    private bool _hsDealEnabled;
    private string _hsErrorText = string.Empty;
    private string _hsResultText = string.Empty;
    private string _hsHouseWayText = string.Empty; // after Submit: which House Way rule sets this hand, and how
    private readonly List<BreakdownRow> _hsRows = new(); // after Submit: Low and High hand, yours vs the House Way
    private bool _hsResultIsCorrect;
    private string _hsScoreText = "Score: 0 / 0 (0.0%)";

    private void HsStartGame()
    {
        _hsCorrectCount = 0;
        _hsTotalRounds = 0;
        _hsScoreText = "Score: 0 / 0 (0.0%)";

        HsDealNewRound();
    }

    private void HsDealNewRound()
    {
        _hsDealEnabled = false;
        _hsErrorText = string.Empty;
        _hsResultText = string.Empty;
        _hsHouseWayText = string.Empty;
        _hsRows.Clear();

        _hsDeck = new PaiGowDeck();

        double jokerProbability = ComputeJokerProbability(_hsJokerFrequencyLevel);

        _hsCards = _hsAdvanced && Random.Shared.Next(3) == 0
            ? PaiGowTrickyHands.Deal(Random.Shared, out _)
            : _hsDeck.DealSevenCardsWithJokerBias(jokerProbability);
        Array.Clear(_hsCardPosition);

        _hsSolver.SetCards(_hsCards);

        _hsRoundScored = false;
        _hsSubmitEnabled = true;
        _hsSortEnabled = true;
    }

    private void HsDealAgain() => HsDealNewRound();

    private int HsCardAtLowPosition(int lowPosition)
    {
        for (int i = 0; i < _hsCards.Count; i++)
        {
            if (_hsCardPosition[i] == lowPosition) return i;
        }
        return -1;
    }

    private void HsCardClicked(int cardIndex)
    {
        if (_hsCardPosition[cardIndex] != 0) return;

        int targetLow;
        if (HsCardAtLowPosition(1) < 0) targetLow = 1;
        else if (HsCardAtLowPosition(2) < 0) targetLow = 2;
        else
        {
            _hsErrorText = "Low hand is full. Click a Low card to return it first.";
            return;
        }

        _hsErrorText = string.Empty;
        _hsCardPosition[cardIndex] = targetLow;
    }

    private void HsReturnLowSlotToHand(int lowPosition)
    {
        int cardIndex = HsCardAtLowPosition(lowPosition);
        if (cardIndex < 0) return;

        _hsCardPosition[cardIndex] = 0;
    }

    private void HsSortHand()
    {
        for (int i = 0; i < _hsCards.Count; i++)
        {
            if (_hsCardPosition[i] != 0)
            {
                _hsErrorText = "Return the Low cards before sorting.";
                return;
            }
        }

        _hsCards = _hsCards.OrderByDescending(CardSortValue).ToList();
        _hsSolver.SetCards(_hsCards);

        _hsErrorText = string.Empty;
        _hsSortEnabled = false;
    }

    private void HsSubmitHand()
    {
        if (_hsRoundScored) return;

        int lowCard1 = HsCardAtLowPosition(1);
        int lowCard2 = HsCardAtLowPosition(2);

        List<int> userHighList = new();
        for (int i = 0; i < _hsCards.Count; i++)
        {
            if (_hsCardPosition[i] == 0) userHighList.Add(i);
        }

        if (lowCard1 < 0 || lowCard2 < 0 || userHighList.Count != 5)
        {
            _hsErrorText = "You must place two cards in the Low hand before submitting.";
            return;
        }

        int[] userHigh = new int[6];
        for (int k = 0; k < 5; k++) userHigh[k + 1] = userHighList[k] + 1;

        PaiGowSubmitResult result = _hsSolver.SubmitHand(lowCard1 + 1, lowCard2 + 1, userHigh);

        if (result.ValidationError is not null)
        {
            _hsErrorText = result.ValidationError;
            return;
        }

        _hsErrorText = string.Empty;
        _hsTotalRounds++;
        if (result.IsCorrect) _hsCorrectCount++;

        _hsRoundScored = true;
        _hsSubmitEnabled = false;
        _hsDealEnabled = true;

        _hsScoreText = $"Score: {_hsCorrectCount} / {_hsTotalRounds} ({(double)_hsCorrectCount / _hsTotalRounds:0.0%})";
        _hsHouseWayText = _hsSolver.HouseWayReason();

        // Low and High hand: yours vs the House Way hand. A fouled hand
        // (Low outranks High) is wrong on both lines.
        bool lowOk = result.IsCorrect || (!result.IsFoul && result.UserLowLabel == result.CorrectLowLabel);
        bool highOk = result.IsCorrect || (!result.IsFoul && result.UserHighDescription == result.CorrectHighDescription);
        if (!result.IsCorrect && lowOk && highOk) highOk = false;

        _hsRows.Clear();
        _hsRows.Add(new BreakdownRow("Low hand", result.UserLowLabel, result.CorrectLowLabel, lowOk, ""));
        _hsRows.Add(new BreakdownRow("High hand", result.UserHighDescription, result.CorrectHighDescription, highOk,
            result.IsFoul ? "Your Low hand outranks your High hand: that's a foul." : ""));

        _log.AddRows(_hsRows);
        _hsResultIsCorrect = result.IsCorrect;
        _hsResultText = result.IsCorrect ? "CORRECT"
            : result.IsFoul ? "INCORRECT \u2014 foul" : "INCORRECT";
    }

