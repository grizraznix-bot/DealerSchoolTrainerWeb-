@page "/pai-gow"
@using DealerSchoolTrainerWeb.Core
@using DealerSchoolTrainerWeb.Games.PaiGowTrainer
@implements IDisposable
@inject GameResetService GameReset
@inject IJSRuntime JS

<PageTitle>Pai Gow</PageTitle>

@if (!_started)
{
    <div class="start-screen">
        <h1>PAI GOW</h1>

        @* Two independent trainers on one page. Each mode is a
           collapsible card: tap its title to open its settings and its
           own Start button (one card open at a time). Each mode keeps
           its own Joker Frequency rather than one shared value. *@
        <div class="mode-list">
            <ModeCard Title="Hand Setting"
                      Description="Arrange your 7 cards into a 5-card High hand and a 2-card Low hand per the House Way, then Submit."
                      Expanded="@IsModeOpen(PaiGowMode.HandSetting)"
                      OnToggle="() => ToggleMode(PaiGowMode.HandSetting)"
                      OnStart="StartGame">
                <div class="mode-options">
                    <div class="mode-option-group">
                        <p class="mode-option-label">Difficulty</p>
                        <label class="mode-choice">
                            <input type="radio" name="hsLevel" checked="@(!_hsAdvanced)" @onchange="() => _hsAdvanced = false" />
                            <span class="rl-level"><strong>Normal</strong><span class="rl-level-desc">random hands</span></span>
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="hsLevel" checked="@_hsAdvanced" @onchange="() => _hsAdvanced = true" />
                            <span class="rl-level"><strong>Advanced</strong><span class="rl-level-desc">more special-rule hands</span></span>
                        </label>
                    </div>
                    <div class="mode-option-group">
                        <p class="mode-option-label">Joker Frequency</p>
                        <label class="mode-choice">
                            <input type="radio" name="hsJoker" checked="@(_hsJokerFrequencyLevel == 0)" @onchange="() => _hsJokerFrequencyLevel = 0" />
                            Default
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="hsJoker" checked="@(_hsJokerFrequencyLevel == 1)" @onchange="() => _hsJokerFrequencyLevel = 1" />
                            +25%
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="hsJoker" checked="@(_hsJokerFrequencyLevel == 2)" @onchange="() => _hsJokerFrequencyLevel = 2" />
                            +50%
                        </label>
                    </div>
                </div>
            </ModeCard>

            <ModeCard Title="Settling Bets"
                      Description="Both dealer and player hands are already dealt and set. Judge each wager's outcome, flag the hand as Foul if it is one, then Submit."
                      Expanded="@IsModeOpen(PaiGowMode.SettlingBets)"
                      OnToggle="() => ToggleMode(PaiGowMode.SettlingBets)"
                      OnStart="StartGame">
                <div class="mode-options">
                    <div class="mode-option-group">
                        <p class="mode-option-label">Joker Frequency</p>
                        <label class="mode-choice">
                            <input type="radio" name="sbJoker" checked="@(_sbJokerFrequencyLevel == 0)" @onchange="() => _sbJokerFrequencyLevel = 0" />
                            Default
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="sbJoker" checked="@(_sbJokerFrequencyLevel == 1)" @onchange="() => _sbJokerFrequencyLevel = 1" />
                            +25%
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="sbJoker" checked="@(_sbJokerFrequencyLevel == 2)" @onchange="() => _sbJokerFrequencyLevel = 2" />
                            +50%
                        </label>
                    </div>
                    <div class="mode-option-group">
                        <p class="mode-option-label">Foul Frequency</p>
                        <label class="mode-choice">
                            <input type="radio" name="foul" checked="@(_sbFoulFrequencyLevel == 0)" @onchange="() => _sbFoulFrequencyLevel = 0" />
                            Rare (Default)
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="foul" checked="@(_sbFoulFrequencyLevel == 1)" @onchange="() => _sbFoulFrequencyLevel = 1" />
                            Occasional
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="foul" checked="@(_sbFoulFrequencyLevel == 2)" @onchange="() => _sbFoulFrequencyLevel = 2" />
                            Frequent
                        </label>
                    </div>
                </div>
            </ModeCard>

            <ModeCard Title="Pai Gow Payouts"
                      Description="Both hands are dealt and set. Pay each wager: enter the winnings, or tap Push / Lose, then Submit."
                      Expanded="@IsModeOpen(PaiGowMode.Payouts)"
                      OnToggle="() => ToggleMode(PaiGowMode.Payouts)"
                      OnStart="StartGame" />
        </div>
    </div>
}
else if (_mode == PaiGowMode.HandSetting)
{
    @* On phones (see app.css, "Pai Gow - Hand Setting") this screen
       becomes one column: Low hand, the 7 cards (wrapping 4 + 3),
       action buttons, score, then the result. *@
    <div class="play-screen hs-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Hand Setting" Correct="_hsCorrectCount" Played="_hsTotalRounds" />

        <div class="hs-top">
            <div class="hs-low felt">
                <h3 class="tight">Low Hand</h3>
                <div class="pg-row">
                    @for (int slot = 1; slot <= 2; slot++)
                    {
                        int lowSlot = slot;
                        int cardAtSlot = HsCardAtLowPosition(lowSlot);

                        <div @onclick="() => HsReturnLowSlotToHand(lowSlot)"
                             class="pai-gow-card hs-low-slot">
                            @if (cardAtSlot >= 0)
                            {
                                <img src="images/cards/@(_hsCards[cardAtSlot].ImageCode).png" alt="@_hsCards[cardAtSlot].Name" class="pg-slot-img" />
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="feedback-area hs-feedback">
                @if (_hsErrorText.Length > 0)
                {
                    <p class="txt-bad">@_hsErrorText</p>
                }

                @* After Submit: the result, your hand vs the House Way hand, and
                   the House Way rule behind it *@
                @if (_hsRoundScored)
                {
                    <ResultBreakdown ResultText="@_hsResultText" IsCorrect="_hsResultIsCorrect" Rows="_hsRows"
                                     NoteLabel="House Way:" Note="@_hsHouseWayText" />
                }
            </div>
        </div>

        <div class="hs-hand felt">
        <h3 class="hs-cards-title">Your 7 Cards</h3>
        <div class="hs-cards">
            @for (int i = 0; i < _hsCards.Count; i++)
            {
                int cardIndex = i;
                bool inLow = _hsCardPosition[cardIndex] != 0;

                <img src="images/cards/@(_hsCards[cardIndex].ImageCode).png" alt="@_hsCards[cardIndex].Name"
                     @onclick="() => HsCardClicked(cardIndex)"
                     class="pai-gow-card hs-card @(inLow ? "hs-card-moved" : "")" />
            }
        </div>
        </div>

        @* First round only: what to do *@
        @if (_hsTotalRounds == 0 && !_hsDealEnabled)
        {
            <p class="first-hint">Tap 2 cards to move them to the Low Hand (tap a Low Hand card to send it back). Sort lines your cards up. Then Submit.</p>
        }

        @* Pinned bottom bar: Help | one step button that changes as the
           hand progresses: Sort -> (once sorted) Submit -> (once scored)
           Next | End Session *@
        <GameBar HelpTitle="House Ways" OnEnd="EndSession">
            <ChildContent>
                @if (_hsSortEnabled)
                {
                    <button class="game-bar-main" @onclick="HsSortHand">Sort</button>
                }
                else if (_hsSubmitEnabled)
                {
                    <button class="game-bar-main" @onclick="HsSubmitAndShow">Submit</button>
                }
                else if (_hsDealEnabled)
                {
                    <button class="game-bar-main" @onclick="HsNextFromTop">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <img src="images/cards/HouseWays.png" alt="Pai Gow House Ways" class="help-image" />
            </HelpContent>
        </GameBar>
    </div>
}
else if (_mode == PaiGowMode.Payouts)
{
    <div class="play-screen sp-screen tp-screen pp-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Pai Gow Payouts" Correct="_ppCorrect" Played="_ppPlayed" />

        @* Dealer and player, each set into Low (2 cards) and High (5 cards)
           with the hand names; the dealer gets a tag on an Ace-high Pai Gow *@
        <div class="felt pp-felt">
            @foreach (bool isDealer in new[] { true, false })
            {
                List<PaiGowCard> low = isDealer ? _ppRound.DealerLow : _ppRound.PlayerLow;
                List<PaiGowCard> high = isDealer ? _ppRound.DealerHigh : _ppRound.PlayerHigh;
                <div class="pp-row">
                    <div class="pp-name">
                        @(isDealer ? "DEALER" : "PLAYER")
                        @if (isDealer && _ppRound.DealerAceHighPaiGow)
                        {
                            <span class="tp-qtag tp-qtag-no">ACE-HIGH PAI GOW</span>
                        }
                    </div>
                    <div class="pp-group">
                        <div class="pp-cap">LOW &middot; @(isDealer ? _ppRound.DealerLowLabel : _ppRound.PlayerLowLabel)</div>
                        <div class="pp-cards">
                            @foreach (PaiGowCard c in low)
                            {
                                <img src="images/cards/@(c.ImageCode).png" alt="@c.Name" class="pp-card" />
                            }
                        </div>
                    </div>
                    <div class="pp-group">
                        <div class="pp-cap">HIGH &middot; @(isDealer ? _ppRound.DealerHighLabel : _ppRound.PlayerHighLabel)</div>
                        <div class="pp-cards">
                            @foreach (PaiGowCard c in high)
                            {
                                <img src="images/cards/@(c.ImageCode).png" alt="@c.Name" class="pp-card" />
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* The three wagers in settling order (Insurance, Main Wager,
           Emperor's Treasure): chip, name, payout box, then Push (Main
           Wager only) and Lose. Tap a row to key into it. *@
        <div class="pw-wrap">
            <div class="pw-box @(!_ppScored ? "pw-scroll" : "")">
            <div class="sp-wagers">
                @for (int w = 0; w < 3; w++)
                {
                    int wi = w;
                    int wager = _ppRound.Wagers[wi];
                    bool canPush = wi == PgPayoutRound.Main;
                    <div class="sp-wrow @(!_ppScored && _ppActive == wi ? "sp-wrow-on" : "")" @onclick="() => PpSelect(wi)">
                        <div class="sp-chip @PpChipClass(wager)">$@wager</div>
                        <div class="sp-wname">@PgPayoutRound.ShortNames[wi]<small>wager $@wager</small></div>
                        @if (_ppScored)
                        {
                            <div class="sp-ans @(_ppOk[wi] ? "sp-ans-ok" : "sp-ans-bad")">
                                @if (_ppOk[wi])
                                {
                                    <text>&#x2713; @PpEnteredText(wi)</text>
                                }
                                else
                                {
                                    <text>&#x2717; @PpEnteredText(wi) &middot; Ans: @PpPayText(_ppRound.Pays[wi])</text>
                                }
                            </div>
                        }
                        else
                        {
                            @* inputmode="none": phones use the keypad; a PC keyboard
                               types normally. A row marked Lose / Push shows that in
                               its box; typing a number (or Backspace) clears it. *@
                            <input type="text"
                                   class="sp-input @(_ppMark[wi] == PpMark.Lose ? "sp-input-lose" : _ppMark[wi] == PpMark.Push ? "tp-input-push" : "")"
                                   inputmode="none"
                                   autocomplete="off"
                                   value="@PpBoxValue(wi)"
                                   @oninput="e => PpInput(wi, e)"
                                   @onkeydown="e => PpKeyDown(wi, e)"
                                   @onfocus="() => _ppActive = wi"
                                   @ref="_ppInputRefs[wi]"
                                   placeholder="Payout" />
                        }
                        @if (canPush)
                        {
                            <button type="button"
                                    class="sp-lose tp-push @(_ppMark[wi] == PpMark.Push ? "tp-push-on" : "")"
                                    disabled="@_ppScored"
                                    @onclick="() => PpToggleMark(wi, PpMark.Push)"
                                    @onclick:stopPropagation="true">Push</button>
                        }
                        <button type="button"
                                class="sp-lose @(_ppMark[wi] == PpMark.Lose ? "sp-lose-on" : "")"
                                disabled="@_ppScored"
                                @onclick="() => PpToggleMark(wi, PpMark.Lose)"
                                @onclick:stopPropagation="true">Lose</button>
                    </div>
                }
            </div>
            </div>
        </div>

        <div class="sp-hint-row">
            <span class="sp-desk-hint">Type each payout; Tab or Enter moves to the next box.</span>
            <button class="keypad-toggle" @onclick="() => _ppShowKeypad = !_ppShowKeypad">123</button>
        </div>

        @if (!_ppScored)
        {
            <div class="keypad-wrap sp-keypad @(_ppShowKeypad ? "keypad-open" : "")">
                <NumericKeypad AllowDecimal="false" @bind-Value="PpActiveText" OnEnter="PpKeypadEnter" EnterLabel="@(_ppActive < 2 ? "Next ↓" : "Enter")" />
            </div>
        }

        <div class="feedback-area sp-feedback">
            @if (_ppScored)
            {
                <ResultBreakdown ResultText="@_ppResultText" IsCorrect="_ppOk.All(o => o)" Rows="_ppRows"
                                 NoteLabel="@(_ppRound.EnvyTip.Length > 0 ? "Envy tip:" : "")" Note="@_ppRound.EnvyTip" />
            }
            else if (_ppMessage.Length > 0)
            {
                <p class="result-line txt-bad">@_ppMessage</p>
            }
        </div>

        @* Desktop: pay tables always in view (phones: in Help) *@
        <aside class="sp-paytable tp-paytable">
            <table class="sp-pt">
                <tr class="sp-pt-hd"><td>Pai Gow Insurance</td><td></td></tr>
                <tr><td>9 high</td><td>100 to 1</td></tr>
                <tr><td>10 high</td><td>25 to 1</td></tr>
                <tr><td>Jack high</td><td>15 to 1</td></tr>
                <tr><td>Queen high</td><td>6 to 1</td></tr>
                <tr><td>King high</td><td>5 to 1</td></tr>
                <tr><td>Ace high (Joker = Ace)</td><td>3 to 1</td></tr>
                <tr class="sp-pt-hd"><td>Main Wager</td><td></td></tr>
                <tr><td>Win both hands</td><td>1 to 1</td></tr>
                <tr><td>Win one hand</td><td>Push</td></tr>
                <tr><td colspan="2" class="tp-pt-wide">No commission. Dealer Ace-high Pai Gow: all hands push.</td></tr>
            </table>
            <table class="sp-pt">
                <tr class="sp-pt-hd"><td>Emperor's Treasure</td><td></td></tr>
                <tr><td>7-Card SF, no Joker</td><td>2500 to 1</td></tr>
                <tr><td>Royal + A-K suited</td><td>1000 to 1</td></tr>
                <tr><td>7-Card SF with Joker</td><td>750 to 1</td></tr>
                <tr><td>Five Aces</td><td>250 to 1</td></tr>
                <tr><td>Royal Flush</td><td>125 to 1</td></tr>
                <tr><td>Straight Flush</td><td>50 to 1</td></tr>
                <tr><td>Four of a Kind</td><td>25 to 1</td></tr>
                <tr><td>Full House</td><td>5 to 1</td></tr>
                <tr><td>Flush</td><td>4 to 1</td></tr>
                <tr><td>Three of a Kind</td><td>3 to 1</td></tr>
                <tr><td>Straight</td><td>2 to 1</td></tr>
            </table>
            <p class="sp-pt-note">Winnings only.</p>
        </aside>

        <GameBar HelpTitle="Pai Gow Pay Tables" OnEnd="EndSession">
            <ChildContent>
                @if (!_ppScored)
                {
                    <button class="game-bar-main" @onclick="PpSubmitAndShow">Submit</button>
                }
                else
                {
                    <button class="game-bar-main" @onclick="PpNextTop" @ref="_ppNextButtonRef">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <table class="help-table sp-help-table">
                    <tr class="sp-pt-hd"><td>Pai Gow Insurance (player's 7 cards are a Pai Gow; Joker = Ace)</td><td></td></tr>
                    <tr><td>9 high</td><td>100 to 1</td></tr>
                    <tr><td>10 high</td><td>25 to 1</td></tr>
                    <tr><td>Jack high</td><td>15 to 1</td></tr>
                    <tr><td>Queen high</td><td>6 to 1</td></tr>
                    <tr><td>King high</td><td>5 to 1</td></tr>
                    <tr><td>Ace high</td><td>3 to 1</td></tr>
                    <tr class="sp-pt-hd"><td>Main Wager (no commission)</td><td></td></tr>
                    <tr><td>Player wins both hands</td><td>1 to 1</td></tr>
                    <tr><td>Wins one hand</td><td>Push</td></tr>
                    <tr><td>Dealer wins both, or a copy</td><td>Lose</td></tr>
                    <tr><td>Dealer has an Ace-high Pai Gow</td><td>Push</td></tr>
                    <tr class="sp-pt-hd"><td>Emperor's Treasure (player's 7 cards) &middot; Envy</td><td></td></tr>
                    <tr><td>7-Card Straight Flush, no Joker</td><td>2500 to 1 &middot; $1000</td></tr>
                    <tr><td>Royal Flush + A-K suited</td><td>1000 to 1 &middot; $750</td></tr>
                    <tr><td>7-Card Straight Flush with Joker</td><td>750 to 1 &middot; $250</td></tr>
                    <tr><td>Five Aces</td><td>250 to 1 &middot; $100</td></tr>
                    <tr><td>Royal Flush</td><td>125 to 1 &middot; $50</td></tr>
                    <tr><td>Straight Flush</td><td>50 to 1 &middot; $20</td></tr>
                    <tr><td>Four of a Kind</td><td>25 to 1 &middot; $5</td></tr>
                    <tr><td>Full House</td><td>5 to 1</td></tr>
                    <tr><td>Flush</td><td>4 to 1</td></tr>
                    <tr><td>Three of a Kind</td><td>3 to 1</td></tr>
                    <tr><td>Straight</td><td>2 to 1</td></tr>
                </table>
                <p>Enter the winnings only. For a losing or pushed wager, tap Lose or Push (0 also counts as Lose). Envy Bonuses are shown as a tip after Submit; they are not entered.</p>
            </HelpContent>
        </GameBar>
    </div>
}
else
{
    @* Settling Bets in the payout modes' layout: dealer and player, each
       set into Low and High (hand names only after Submit -- they'd give
       the answer away), then one row per wager in settling order with its
       chip and a Call button that pops Win / Lose (/ Push) out beside it,
       and a last row to mark the player's hand Foul. *@
    <div class="play-screen sp-screen tp-screen pp-screen cr-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Settling Bets" Correct="_sbCorrectCount" Played="_sbTotalRounds" />

        <div class="felt pp-felt">
            @foreach (bool isDealer in new[] { true, false })
            {
                List<PaiGowCard> low = isDealer ? _sbDealerLowSorted : _sbPlayerLowSorted;
                List<PaiGowCard> high = isDealer ? _sbDealerHighSorted : _sbPlayerHighSorted;
                string lowLabel = isDealer ? _sbDealerLowLabel : _sbPlayerLowLabel;
                string highLabel = isDealer ? _sbDealerHighLabel : _sbPlayerHighLabel;
                <div class="pp-row">
                    <div class="pp-name">@(isDealer ? "DEALER" : "PLAYER")</div>
                    <div class="pp-group">
                        <div class="pp-cap">LOW@(_sbRoundScored && lowLabel.Length > 0 ? " · " + lowLabel : "")</div>
                        <div class="pp-cards">
                            @foreach (PaiGowCard c in low)
                            {
                                <img src="images/cards/@(c.ImageCode).png" alt="@c.Name" class="pp-card" />
                            }
                        </div>
                    </div>
                    <div class="pp-group">
                        <div class="pp-cap">HIGH@(_sbRoundScored && highLabel.Length > 0 ? " · " + highLabel : "")</div>
                        <div class="pp-cards">
                            @foreach (PaiGowCard c in high)
                            {
                                <img src="images/cards/@(c.ImageCode).png" alt="@c.Name" class="pp-card" />
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Picking a wager result clears Foul; marking Foul clears the wager
           picks (a fouled hand is a floor call, not settled wager by wager) *@
        <div class="sp-wagers">
            @foreach (var (name, wager, options) in SbRowOrder)
            {
                SbWagerState w = wager;
                <CallRow Chip="w.Wager" Name="@name" Sub="@($"wager ${w.Wager}")" Options="options"
                         Value="@w.Selection?.ToString()"
                         OnPick="k => { w.Selection = Enum.Parse<WagerOutcome>(k); w.Wrong = false; SbResetFoul(); }"
                         Locked="_sbRoundScored" Wrong="w.Wrong"
                         AnswerText="@($"{w.Actual}")"
                         LockedText="@SbWagerLockedText(w)" />
            }
            <CallRow Name="Foul hand" Sub="player's hand" Options="FoulOptions"
                     Value="@(_sbFoulFlagged ? "Foul" : _sbNotFoulPicked || _sbRoundScored ? "NotFoul" : null)"
                     OnPick='k => SbSetFoul(k == "Foul")'
                     Locked="_sbRoundScored" Wrong="_sbFoulWrong"
                     AnswerText="@(_sbIsPlayerFoul ? "Foul" : "Not Foul")" />
        </div>

        <p class="cr-note">All Hands Push with a Dealer Ace-High Pai Gow</p>

        @* First round only: what to do *@
        @if (_sbTotalRounds == 0 && !_sbRoundScored)
        {
            <p class="cr-howto">Tap Call on each wager and pick Win, Lose or Push, or mark the player's hand Foul, then Submit.</p>
        }

        <div class="feedback-area sp-feedback">
            @if (_sbRoundScored)
            {
                @* After Submit: the result, then each wager with the right answer and why *@
                <div class="sb-feedback">
                    <ResultBreakdown ResultText="@_sbResultText" IsCorrect="_sbIsCorrect" Rows="_sbRows"
                                     NoteLabel="Floor call:" Note="@_sbFloorNote" />
                </div>
            }
            else if (_sbResultText.Length > 0)
            {
                <p class="result-line txt-bad">@_sbResultText</p>
            }
        </div>

        @* Pinned bottom bar: Help | Submit, then Next | End Session *@
        <GameBar HelpTitle="Settling Bets Wager Rules" OnEnd="EndSession">
            <ChildContent>
                @if (!_sbRoundScored)
                {
                    <button class="game-bar-main" @onclick="SbSubmitAndShow" disabled="@(!_sbSubmitEnabled)">Submit</button>
                }
                else
                {
                    <button class="game-bar-main" @onclick="SbNextFromTop" disabled="@(!_sbDealEnabled)">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <img src="images/cards/SettlingBetsWagerRules.png" alt="Pai Gow - Settling Bets Wager Rules" class="help-image" />
            </HelpContent>
        </GameBar>
    </div>
}

@if (_showSessionSummary)
{
    @switch (_mode)
    {
        case PaiGowMode.HandSetting:
            <SessionSummary ModeKey="pg-handsetting" Rounds="_hsTotalRounds" Correct="_hsCorrectCount" Log="_log"
                            RightText="set right" ConfidentText="You're setting these with confidence" YouVerb="set"
                            OnAgain="PracticeAgain" OnDone="CloseSummary" />
            break;
        case PaiGowMode.Payouts:
            <SessionSummary ModeKey="pg-payouts" Rounds="_ppPlayed" Correct="_ppCorrect" Log="_log"
                            RightText="paid right" ConfidentText="You're paying these with confidence" YouVerb="paid"
                            OnAgain="PracticeAgain" OnDone="CloseSummary" />
            break;
        default:
            <SessionSummary ModeKey="pg-settling" Rounds="_sbTotalRounds" Correct="_sbCorrectCount" Log="_log"
                            RightText="rounds right" ConfidentText="You're calling these with confidence" YouVerb="called"
                            OnAgain="PracticeAgain" OnDone="CloseSummary" />
            break;
    }
}

@code {
    // Menu link for this game tapped while it's already open: return to
    // the start screen, same as the Back button (hidden on phones).
    protected override void OnInitialized()
    {
        GameReset.ResetRequested += OnResetRequested;
    }

    private void OnResetRequested()
    {
        _showSessionSummary = false;
        _started = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameReset.ResetRequested -= OnResetRequested;
    }

    // Scroll back to the top whenever this game switches between its
    // start screen and its play screen (Start, Back, menu, End Session).
    // Without this the browser keeps the old scroll position -- after
    // scrolling down to reach Start, the game would open scrolled down.
    private bool _lastRenderedStarted;

    private bool _scrollToSummary;

    // Bar buttons: Submit also scrolls to the feedback; Next also
    // scrolls back to the top
    private void HsSubmitAndShow()
    {
        HsSubmitHand();
        if (_hsRoundScored) _scrollToFeedback = true;
    }

    private void HsNextFromTop()
    {
        HsDealAgain();
        _scrollToTopAfterNext = true;
    }

    private void SbSubmitAndShow()
    {
        SbSubmitRound();
        if (_sbRoundScored) _scrollToFeedback = true;
    }

    private void SbNextFromTop()
    {
        SbDealAgain();
        _scrollToTopAfterNext = true;
    }

    private bool _scrollToFeedback;
    private bool _scrollToTopAfterNext;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Submit: bring the feedback box into view (if it isn't already).
        // Next: back to the top for the new hand.
        if (_scrollToFeedback)
        {
            _scrollToFeedback = false;
            try { await JS.InvokeVoidAsync("dstRevealFeedback"); } catch { }
        }

        if (_scrollToTopAfterNext)
        {
            _scrollToTopAfterNext = false;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }
        }

        // End Session: bring the Session Summary into view (it's at the
        // bottom of the page, often below the screen on a phone)
        if (_scrollToSummary && _showSessionSummary)
        {
            _scrollToSummary = false;
            try { await JS.InvokeVoidAsync("dstScrollToEl", ".session-summary"); } catch { }
        }

        if (_started != _lastRenderedStarted)
        {
            _lastRenderedStarted = _started;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }

            // Payouts on desktop: open the number pad straight away when
            // the window is tall enough for it (123 still hides / shows it)
            if (_started && _mode == PaiGowMode.Payouts)
            {
                bool fits = false;
                try { fits = await JS.InvokeAsync<bool>("dstKeypadFits", 315); } catch { }
                _ppShowKeypad = fits;
                if (fits) StateHasChanged();
            }
        }

        // Payouts: cursor into the active payout box, or onto Next once
        // the round is scored (so Enter deals the next round)
        // Payouts, phones: size the wager box to the space above the keypad
        if (_started && _mode == PaiGowMode.Payouts)
        {
            try { await JS.InvokeVoidAsync("dstFitWagerBox"); } catch { }
        }

        if (_ppFocusInput >= 0)
        {
            int i = _ppFocusInput;
            _ppFocusInput = -1;
            try { await _ppInputRefs[i].FocusAsync(preventScroll: true); } catch { }
            try { await JS.InvokeVoidAsync("dstWagerRowIntoView", i); } catch { }
        }

        if (_ppFocusNext)
        {
            _ppFocusNext = false;
            try { await _ppNextButtonRef.FocusAsync(preventScroll: true); } catch { }
        }
    }

    private enum PaiGowMode { HandSetting, SettlingBets, Payouts }

