@page "/pai-gow"
@using DealerSchoolTrainerWeb.Core
@using DealerSchoolTrainerWeb.Games.PaiGowTrainer
@implements IDisposable
@inject GameResetService GameReset
@inject IJSRuntime JS

<PageTitle>Pai Gow</PageTitle>

@if (!_started)
{
    <div class="start-screen">
        <h1>PAI GOW</h1>

        @* Each mode is a collapsible card: tap its title to open its
           settings and its own Start button (one card open at a time).
           Settling Bets is played Call Only or Call & Pay. Each mode keeps
           its own Joker Frequency rather than one shared value. *@
        <div class="mode-list">
            <ModeCard Title="Hand Setting"
                      Description="Arrange your 7 cards into a 5-card High hand and a 2-card Low hand per the House Way, then Submit."
                      Expanded="@IsModeOpen(PaiGowMode.HandSetting)"
                      OnToggle="() => ToggleMode(PaiGowMode.HandSetting)"
                      OnStart="StartGame">
                <TileChoice @bind-Second="_hsAdvanced" Label="Difficulty"
                            FirstTitle="Normal" FirstText="Random hands."
                            FirstIcon="@(__b => { TileChoice.MiniCard("♣")(__b); TileChoice.MiniCard("♦")(__b); })"
                            SecondTitle="Advanced" SecondText="More special-rule hands."
                            SecondIcon="@(__b => { TileChoice.MiniCard("♣")(__b); TileChoice.MiniCard("♦")(__b); TileChoice.Chip("#c99a1e", "★")(__b); })" />
                <div class="mode-options">
                    <div class="mode-option-group">
                        <p class="mode-option-label">Joker Frequency</p>
                        <label class="mode-choice">
                            <input type="radio" name="hsJoker" checked="@(_hsJokerFrequencyLevel == 0)" @onchange="() => _hsJokerFrequencyLevel = 0" />
                            Default (about 1 in 8 hands)
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="hsJoker" checked="@(_hsJokerFrequencyLevel == 1)" @onchange="() => _hsJokerFrequencyLevel = 1" />
                            1 in 5 hands
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="hsJoker" checked="@(_hsJokerFrequencyLevel == 2)" @onchange="() => _hsJokerFrequencyLevel = 2" />
                            1 in 3 hands
                        </label>
                    </div>
                </div>
            </ModeCard>

            <ModeCard Title="Settling Bets"
                      Description="Both hands are dealt and set. Settle Insurance, the Main Wager and Emperor's Treasure in order, then Submit."
                      Expanded="@IsModeOpen(PaiGowMode.SettlingBets)"
                      OnToggle="() => ToggleMode(PaiGowMode.SettlingBets)"
                      OnStart="StartGame">
                <PayoutChoice @bind-Pay="_pgPay"
                              CallText="Call each wager, or mark a fouled hand."
                              PayText="Call each wager, then pay the winners." />
                <div class="mode-options">
                    <div class="mode-option-group">
                        <p class="mode-option-label">Joker Frequency</p>
                        <label class="mode-choice">
                            <input type="radio" name="sbJoker" checked="@(_sbJokerFrequencyLevel == 0)" @onchange="() => _sbJokerFrequencyLevel = 0" />
                            Default (about 1 in 4 deals)
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="sbJoker" checked="@(_sbJokerFrequencyLevel == 1)" @onchange="() => _sbJokerFrequencyLevel = 1" />
                            1 in 3 deals
                        </label>
                        <label class="mode-choice">
                            <input type="radio" name="sbJoker" checked="@(_sbJokerFrequencyLevel == 2)" @onchange="() => _sbJokerFrequencyLevel = 2" />
                            1 in 2 deals
                        </label>
                    </div>
                    @* Fouled hands are dealt in Call Only (a floor call, not a payout) *@
                    @if (!_pgPay)
                    {
                        <div class="mode-option-group">
                            <p class="mode-option-label">Foul Frequency</p>
                            <label class="mode-choice">
                                <input type="radio" name="foul" checked="@(_sbFoulFrequencyLevel == 0)" @onchange="() => _sbFoulFrequencyLevel = 0" />
                                Rare (Default)
                            </label>
                            <label class="mode-choice">
                                <input type="radio" name="foul" checked="@(_sbFoulFrequencyLevel == 1)" @onchange="() => _sbFoulFrequencyLevel = 1" />
                                Occasional
                            </label>
                            <label class="mode-choice">
                                <input type="radio" name="foul" checked="@(_sbFoulFrequencyLevel == 2)" @onchange="() => _sbFoulFrequencyLevel = 2" />
                                Frequent
                            </label>
                        </div>
                    }
                </div>
            </ModeCard>
        </div>
    </div>
}
else if (_mode == PaiGowMode.HandSetting)
{
    @* On phones (see app.css, "Pai Gow - Hand Setting") this screen
       becomes one column: Low hand, the 7 cards (wrapping 4 + 3),
       action buttons, score, then the result. *@
    <div class="play-screen hs-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Hand Setting" Correct="_hsCorrectCount" Played="_hsTotalRounds" />

        <div class="hs-top">
            <div class="hs-low felt">
                <h3 class="tight">Low Hand</h3>
                <div class="pg-row">
                    @for (int slot = 1; slot <= 2; slot++)
                    {
                        int lowSlot = slot;
                        int cardAtSlot = HsCardAtLowPosition(lowSlot);

                        <div @onclick="() => HsReturnLowSlotToHand(lowSlot)"
                             class="pai-gow-card hs-low-slot">
                            @if (cardAtSlot >= 0)
                            {
                                <img src="images/cards/@(_hsCards[cardAtSlot].ImageCode).png" alt="@_hsCards[cardAtSlot].Name" class="pg-slot-img" />
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="feedback-area hs-feedback">
                @if (_hsErrorText.Length > 0)
                {
                    <p class="txt-bad">@_hsErrorText</p>
                }

                @* After Submit: the result, your hand vs the House Way hand, and
                   the House Way rule behind it *@
                @if (_hsRoundScored)
                {
                    <ResultBreakdown ResultText="@_hsResultText" IsCorrect="_hsResultIsCorrect" Rows="_hsRows"
                                     NoteLabel="House Way:" Note="@_hsHouseWayText" />
                }
            </div>
        </div>

        <div class="hs-hand felt">
        <h3 class="hs-cards-title">Your 7 Cards</h3>
        <div class="hs-cards">
            @for (int i = 0; i < _hsCards.Count; i++)
            {
                int cardIndex = i;
                bool inLow = _hsCardPosition[cardIndex] != 0;

                <img src="images/cards/@(_hsCards[cardIndex].ImageCode).png" alt="@_hsCards[cardIndex].Name"
                     @onclick="() => HsCardClicked(cardIndex)"
                     class="pai-gow-card hs-card @(inLow ? "hs-card-moved" : "")" />
            }
        </div>
        </div>

        @* First round only: what to do *@
        @if (_hsTotalRounds == 0 && !_hsDealEnabled)
        {
            <p class="first-hint">Tap 2 cards to move them to the Low Hand (tap a Low Hand card to send it back). Sort lines your cards up. Then Submit.</p>
        }

        @* Pinned bottom bar: Help | one step button that changes as the
           hand progresses: Sort -> (once sorted) Submit -> (once scored)
           Next | End Session *@
        <GameBar HelpTitle="House Ways" OnEnd="EndSession">
            <ChildContent>
                @if (_hsSortEnabled)
                {
                    <button class="game-bar-main" @onclick="HsSortHand">Sort</button>
                }
                else if (_hsSubmitEnabled)
                {
                    <button class="game-bar-main" @onclick="HsSubmitAndShow">Submit</button>
                }
                else if (_hsDealEnabled)
                {
                    <button class="game-bar-main" @onclick="HsNextFromTop">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <p class="hw-key">Front = Low hand (2 cards) &middot; Back = High hand (5 cards)</p>
                <p>Advanced deals more hands that need one of the House Way's special rules.</p>
                <table class="help-table sp-help-table hw-table">
                    <tr class="sp-pt-hd"><td colspan="2">Two Pair</td></tr>
                    <tr><td>1</td><td>No Ace: split only if one pair is 7s or better.</td></tr>
                    <tr><td>2</td><td>With an Ace: split only if Jacks or better AND 7s or better.</td></tr>
                    <tr><td>3</td><td>Always split Aces and any other pair.</td></tr>

                    <tr class="sp-pt-hd"><td colspan="2">Three Pair</td></tr>
                    <tr><td>1</td><td>Always play the highest pair in front.</td></tr>

                    <tr class="sp-pt-hd"><td colspan="2">Three of a Kind</td></tr>
                    <tr><td>1</td><td>Always keep three of a kind together, unless they are Aces; then play a pair of Aces in back and one Ace in front.</td></tr>
                    <tr><td>2</td><td>If the dealer has 3 Aces and at the same time has a straight or a flush, the straight or flush will be played.</td></tr>

                    <tr class="sp-pt-hd"><td colspan="2">Straights, Flushes, Straight Flushes and Royal Flushes</td></tr>
                    <tr><td>1</td><td>Keep as the high hand, except:</td></tr>
                    <tr class="hw-sub"><td></td><td><b>a</b>6 and 7 card: play the low straight or flush to place the highest card in front.</td></tr>
                    <tr class="hw-sub"><td></td><td><b>b</b>Play a straight over a flush anytime the second highest hand will be improved. This includes straight flushes and royal flushes.</td></tr>
                    <tr class="hw-sub"><td></td><td><b>c</b>Play two pair (apply the two pair rule) except when both of the pairs are 6s or below.</td></tr>
                    <tr class="hw-sub"><td></td><td><b>d</b>With a Full House, apply the Full House rules.</td></tr>

                    <tr class="sp-pt-hd"><td colspan="2">Full House</td></tr>
                    <tr><td>1</td><td>Always split, playing the pair in front, unless the pair is 2s and you have an Ace and a King to play in front.</td></tr>
                    <tr><td>2</td><td>With an extra pair, play the higher of the two pairs in front.</td></tr>

                    <tr class="sp-pt-hd"><td colspan="2">Four of a Kind</td></tr>
                    <tr><td>1</td><td>Always keep 6s and under together.</td></tr>
                    <tr><td>2</td><td>Always split 7s through 10s, playing a pair in each hand, unless the hand contains an Ace or better to play in front.</td></tr>
                    <tr><td>3</td><td>Always split Jacks through Kings, playing a pair in each hand.</td></tr>
                    <tr><td>4</td><td>Split four Aces unless with another pair:</td></tr>
                    <tr class="hw-sub"><td></td><td><b>a</b>If the other pair is 6s or below, play Aces in front, two pair in back.</td></tr>
                    <tr class="hw-sub"><td></td><td><b>b</b>If the other pair is 7s or above, play four Aces in back, pair in front.</td></tr>

                    <tr class="sp-pt-hd"><td colspan="2">Five Aces</td></tr>
                    <tr><td>1</td><td>Split and play three in back and two in front, unless the hand also contains a pair of Kings; then play 5 Aces in back and Kings in front.</td></tr>

                    <tr class="sp-pt-hd"><td colspan="2">Ranking of the Hands (highest first)</td></tr>
                    <tr><td>1</td><td>Five Aces</td></tr>
                    <tr><td>2</td><td>Royal Flush</td></tr>
                    <tr><td>3</td><td>Straight Flush</td></tr>
                    <tr><td>4</td><td>Four of a Kind</td></tr>
                    <tr><td>5</td><td>Full House</td></tr>
                    <tr><td>6</td><td>Flush</td></tr>
                    <tr><td>7</td><td>Straight (the wheel, A-2-3-4-5, is the 2nd highest)</td></tr>
                    <tr><td>8</td><td>Three of a Kind</td></tr>
                    <tr><td>9</td><td>Two Pair</td></tr>
                    <tr><td>10</td><td>One Pair</td></tr>
                    <tr><td>11</td><td>High Card</td></tr>
                </table>
            </HelpContent>
        </GameBar>
    </div>
}
else if (_mode == PaiGowMode.SettlingBets && _pgPay)
{
    @* Settling Bets, Call & Pay. Laid out from the dealer's side of the
       table: the player's hand on top, the dealer's at the bottom, Low
       beside High. Hand names are not shown on the felt: tap a hand to see
       it enlarged, Low over High, with its Low and High names (and the
       dealer's Ace-high Pai Gow note). Until the first tap this session, each caption fades
       between its name and "Tap ... cards to reveal rank" every 5
       seconds (CSS only; @key restarts it on each deal). After Submit
       the names show on the felt. *@
    <div class="play-screen sp-screen tp-screen pp-screen has-game-bar @(_ppBox >= 0 ? "uc-open" : "")">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Settling Bets" Correct="_ppCorrect" Played="_ppPlayed" />

        <div class="felt pg-felt">
            @foreach (bool isDealer in new[] { false, true })
            {
                bool dealerHand = isDealer;
                List<PaiGowCard> low = isDealer ? _ppRound.DealerLow : _ppRound.PlayerLow;
                List<PaiGowCard> high = isDealer ? _ppRound.DealerHigh : _ppRound.PlayerHigh;
                string lowLabel = isDealer ? _ppRound.DealerLowLabel : _ppRound.PlayerLowLabel;
                string highLabel = isDealer ? _ppRound.DealerHighLabel : _ppRound.PlayerHighLabel;
                string who = isDealer ? "Dealer" : "Player";
                bool zoomOn = _ppZoom == (isDealer ? 2 : 1);
                @if (isDealer)
                {
                    <div class="cr-sep"></div>
                }
                @if (_ppScored || _ppPeekUsed)
                {
                    <div class="cr-cap">
                        @who.ToUpperInvariant()<span class="hz-mag" aria-hidden="true"></span>
                        @if (isDealer && _ppScored && _ppRound.DealerAceHighPaiGow)
                        {
                            <span class="tp-qtag tp-qtag-no pp-cap-tag">ACE-HIGH PAI GOW</span>
                        }
                    </div>
                }
                else
                {
                    <div class="cr-cap pp-alt" @key="@($"{_ppDealNo}-{who}")">
                        <span class="pp-alt-a">@who.ToUpperInvariant()<span class="hz-mag" aria-hidden="true"></span></span>
                        <span class="pp-alt-b">Tap @who cards to reveal rank</span>
                    </div>
                }
                <div class="pg-hand hz-tap @(zoomOn ? "hz-on" : "")"
                     role="button"
                     @onclick="() => PpTogglePeek(dealerHand)">
                    <div class="pg-group">
                        <div class="pg-sub">LOW@(_ppScored && lowLabel.Length > 0 ? " · " + lowLabel : "")</div>
                        <div class="pg-cards">
                            @foreach (PaiGowCard c in low)
                            {
                                <img src="images/cards/@(c.ImageCode).png" alt="@c.Name" />
                            }
                        </div>
                    </div>
                    <div class="pg-group">
                        <div class="pg-sub">HIGH@(_ppScored && highLabel.Length > 0 ? " · " + highLabel : "")</div>
                        <div class="pg-cards">
                            @foreach (PaiGowCard c in high)
                            {
                                <img src="images/cards/@(c.ImageCode).png" alt="@c.Name" />
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        @* Tap-to-zoom: the hand enlarged, Low over High, with each hand's
           rank (and the dealer's Ace-high Pai Gow) *@
        @if (_ppZoom != 0)
        {
            bool zd = _ppZoom == 2;
            <HandZoom Title="@(zd ? "DEALER" : "PLAYER")" OnClose="PpCloseZoom">
                @PgZoomRows(zd ? _ppRound.DealerLow : _ppRound.PlayerLow, zd ? _ppRound.DealerHigh : _ppRound.PlayerHigh,
                            zd ? _ppRound.DealerLowLabel : _ppRound.PlayerLowLabel,
                            zd ? _ppRound.DealerHighLabel : _ppRound.PlayerHighLabel,
                            zd && _ppRound.DealerAceHighPaiGow)
            </HandZoom>
        }

        @* The three wagers in settling order, each with a Call button. The
           Main Wager is a plain call (even money); Win on Insurance or
           Emperor's Treasure opens that row's payout box and hides the
           other rows. *@
        <div class="sp-wagers">
            @for (int w = 0; w < 3; w++)
            {
                int wi = w;
                int wager = _ppRound.Wagers[wi];

                @if (_ppBox >= 0 && wi != _ppBox)
                {
                    continue;
                }

                @if (wi == _ppBox)
                {
                    @* The open payout box: the number pad below; a computer
                       keyboard types straight in, Enter confirms, Esc cancels *@
                    <div class="sp-wrow uc-boxrow">
                        <div class="sp-chip @CallRow.ChipCss(wager)">$@wager</div>
                        <div class="sp-wname @(wi == 2 ? "pp-wname-2" : "")">@PgPayoutRound.ShortNames[wi]<small>wager $@wager</small></div>
                        <label class="uc-amt">
                            <span class="uc-dollar">$</span>
                            <input type="text"
                                   inputmode="none"
                                   autocomplete="off"
                                   aria-label="@($"{PgPayoutRound.Names[wi]} payout")"
                                   placeholder="Payout"
                                   value="@_ppBoxText"
                                   @oninput="PpBoxInput"
                                   @onkeydown="PpBoxKeyDown"
                                   @ref="_ppBoxInputRef" />
                        </label>
                    </div>
                    continue;
                }

                <CallRow ChipAmount="wager"
                         Name="@PgPayoutRound.ShortNames[wi]"
                         Sub="@($"wager ${wager}")"
                         Options="@(wi == PgPayoutRound.Main ? WagerPick.WinLosePush : WagerPick.WinLose)"
                         Value="@_ppCall[wi]"
                         PickedText="@PpPickedText(wi)"
                         OnPick="k => PpPick(wi, k)"
                         Locked="_ppScored" Wrong="!_ppOk[wi]" AnswerText="@PpAnswerText(wi)" />
            }
        </div>

        @if (_ppBox >= 0)
        {
            <div class="uc-keypad">
                <NumericKeypad AllowDecimal="false" @bind-Value="PpBoxText" OnEnter="PpBoxEnter" EnterLabel="Enter" EnterDisabled="@(_ppBoxText.Length == 0)" />
            </div>
        }
        else if (_ppPlayed == 0 && !_ppScored)
        {
            @* First round only: what to do *@
            <p class="cr-howto">Tap Call on each wager. Win on Insurance or Emperor's Treasure opens its payout box.</p>
        }

        <div class="feedback-area sp-feedback">
            @if (_ppScored)
            {
                <ResultBreakdown ResultText="@_ppResultText" IsCorrect="_ppOk.All(o => o)" Rows="_ppRows"
                                 NoteLabel="@(_ppRound.EnvyTip.Length > 0 ? "Envy tip:" : "")" Note="@_ppRound.EnvyTip" />
            }
        </div>

        @* Desktop: pay tables always in view (phones: in Help) *@
        <aside class="sp-paytable tp-paytable">
            <table class="sp-pt">
                <tr class="sp-pt-hd"><td colspan="2">Pai Gow Insurance</td></tr>
                <tr><td>9 high</td><td>100 to 1</td></tr>
                <tr><td>10 high</td><td>25 to 1</td></tr>
                <tr><td>Jack high</td><td>15 to 1</td></tr>
                <tr><td>Queen high</td><td>6 to 1</td></tr>
                <tr><td>King high</td><td>5 to 1</td></tr>
                <tr><td>Ace high (Joker = Ace)</td><td>3 to 1</td></tr>
                <tr class="sp-pt-hd"><td colspan="2">Main Wager</td></tr>
                <tr><td>Win both hands</td><td>1 to 1</td></tr>
                <tr><td>Win one hand</td><td>Push</td></tr>
                <tr><td colspan="2" class="tp-pt-wide">No commission. Dealer Ace-high Pai Gow: all hands push.</td></tr>
            </table>
            <table class="sp-pt">
                <tr class="sp-pt-hd"><td colspan="2">Emperor's Treasure</td></tr>
                <tr><td>7-Card SF, no Joker</td><td>2500 to 1</td></tr>
                <tr><td>Royal + A-K suited</td><td>1000 to 1</td></tr>
                <tr><td>7-Card SF with Joker</td><td>750 to 1</td></tr>
                <tr><td>Five Aces</td><td>250 to 1</td></tr>
                <tr><td>Royal Flush</td><td>125 to 1</td></tr>
                <tr><td>Straight Flush</td><td>50 to 1</td></tr>
                <tr><td>Four of a Kind</td><td>25 to 1</td></tr>
                <tr><td>Full House</td><td>5 to 1</td></tr>
                <tr><td>Flush</td><td>4 to 1</td></tr>
                <tr><td>Three of a Kind</td><td>3 to 1</td></tr>
                <tr><td>Straight</td><td>2 to 1</td></tr>
            </table>
            <p class="sp-pt-note">Winnings only.</p>
        </aside>

        @* Pinned bottom bar: the main button counts the wagers left until
           every one is called; while a payout box is open, End Session
           becomes Cancel *@
        <GameBar HelpTitle="Pai Gow Pay Tables" OnEnd="PpEndOrCancel"
                 EndLabel="@(_ppBox >= 0 ? "Cancel" : "End Session")"
                 EndClass="@(_ppBox >= 0 ? "game-bar-cancel" : "")">
            <ChildContent>
                @if (!_ppScored)
                {
                    int left = PpWagersLeft;
                    @if (left > 0 || _ppBox >= 0)
                    {
                        <button class="game-bar-main" disabled>
                            <span class="gb-left-long">@left @(left == 1 ? "wager" : "wagers") left</span><span class="gb-left-short">@left left</span>
                        </button>
                    }
                    else
                    {
                        <button class="game-bar-main" @onclick="PpSubmitAndShow">Submit</button>
                    }
                }
                else
                {
                    <button class="game-bar-main" @onclick="PpNextTop">Next</button>
                }
            </ChildContent>
            <HelpContent>
                <p>Tap the Player or Dealer cards to see the hand enlarged, Low over High, with its ranks.</p>
                @PgPayTables
                <p>Call the Main Wager Win, Lose or Push (it pays even money). Win on Insurance or Emperor's Treasure opens its payout box: enter the winnings only, then Enter. Entering 0 counts as Lose; Cancel puts the wager back to Call. Envy Bonuses are shown as a tip after Submit; they are not entered.</p>
                <p>For practice, big Emperor's Treasure hands come up more often than at a live table.</p>
            </HelpContent>
        </GameBar>
    </div>
}
else
{
    @* Settling Bets, Call Only, in the payout modes' layout: dealer and player, each
       set into Low and High (hand names only after Submit -- they'd give
       the answer away), then one row per wager in settling order with its
       chip and a Call button that pops Win / Lose (/ Push) out beside it,
       and a last row to mark the player's hand Foul. *@
    <div class="play-screen sp-screen tp-screen pp-screen cr-screen has-game-bar">
        <div class="button-row">
            <button class="back-button" @onclick="BackToStart">Back</button>
        </div>

        <GameStatus Title="Settling Bets" Correct="_sbCorrectCount" Played="_sbTotalRounds" />

        @* Laid out from the dealer's side of the table: the player's hand
           on top, the dealer's at the bottom, each set into Low beside High
           with a small caption over each (hand names only after Submit).
           Captions above the hands instead of a name column on the left
           leave the width for larger cards. *@
        <div class="felt pg-felt">
            @foreach (bool isDealer in new[] { false, true })
            {
                List<PaiGowCard> low = isDealer ? _sbDealerLowSorted : _sbPlayerLowSorted;
                List<PaiGowCard> high = isDealer ? _sbDealerHighSorted : _sbPlayerHighSorted;
                string lowLabel = isDealer ? _sbDealerLowLabel : _sbPlayerLowLabel;
                string highLabel = isDealer ? _sbDealerHighLabel : _sbPlayerHighLabel;
                @if (isDealer)
                {
                    <div class="cr-sep"></div>
                }
                bool dealerHand = isDealer;
                <div class="cr-cap">@(isDealer ? "DEALER" : "PLAYER")<span class="hz-mag" aria-hidden="true"></span></div>
                <div class="pg-hand hz-tap @(_sbZoom == (isDealer ? 2 : 1) ? "hz-on" : "")" role="button"
                     @onclick="() => _sbZoom = dealerHand ? 2 : 1">
                    <div class="pg-group">
                        <div class="pg-sub">LOW@(_sbRoundScored && lowLabel.Length > 0 ? " · " + lowLabel : "")</div>
                        <div class="pg-cards">
                            @foreach (PaiGowCard c in low)
                            {
                                <img src="images/cards/@(c.ImageCode).png" alt="@c.Name" />
                            }
                        </div>
                    </div>
                    <div class="pg-group">
                        <div class="pg-sub">HIGH@(_sbRoundScored && highLabel.Length > 0 ? " · " + highLabel : "")</div>
                        <div class="pg-cards">
                            @foreach (PaiGowCard c in high)
                            {
                                <img src="images/cards/@(c.ImageCode).png" alt="@c.Name" />
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Picking a wager result clears Foul; marking Foul clears the wager
           picks (a fouled hand is a floor call, not settled wager by wager) *@
        <div class="sp-wagers">
            @foreach (var (name, wager, options) in SbRowOrder)
            {
                SbWagerState w = wager;
                <CallRow Chip="true" Name="@name" Options="options"
                         Value="@w.Selection?.ToString()"
                         OnPick="k => { w.Selection = Enum.Parse<WagerOutcome>(k); w.Wrong = false; SbResetFoul(); }"
                         Locked="_sbRoundScored" Wrong="w.Wrong"
                         AnswerText="@($"{w.Actual}")"
                         LockedText="@SbWagerLockedText(w)" />
            }
            @* A fouled hand stops the game until the floor (supervisor)
               is called: the row's button reads Call Floor *@
            <CallRow Name="Foul hand" Sub="player's hand" Options="FoulOptions" CallText="Call Floor"
                     Value="@(_sbFoulFlagged ? "Foul" : _sbNotFoulPicked || _sbRoundScored ? "NotFoul" : null)"
                     OnPick='k => SbSetFoul(k == "Foul")'
                     Locked="_sbRoundScored" Wrong="_sbFoulWrong"
                     AnswerText="@(_sbIsPlayerFoul ? "Foul" : "Not Foul")" />
        </div>

        <p class="cr-note">All Hands Push with a Dealer Ace-High Pai Gow</p>

        @* Tap-to-zoom: the hand enlarged, Low over High (hand names only
           after Submit, like the felt) *@
        @if (_sbZoom != 0)
        {
            bool zd = _sbZoom == 2;
            <HandZoom Title="@(zd ? "DEALER" : "PLAYER")" OnClose="() => _sbZoom = 0">
                @PgZoomRows(zd ? _sbDealerLowSorted : _sbPlayerLowSorted, zd ? _sbDealerHighSorted : _sbPlayerHighSorted,
                            _sbRoundScored ? (zd ? _sbDealerLowLabel : _sbPlayerLowLabel) : "",
                            _sbRoundScored ? (zd ? _sbDealerHighLabel : _sbPlayerHighLabel) : "",
                            false)
            </HandZoom>
        }

        @* First round only: what to do *@
        @if (_sbTotalRounds == 0 && !_sbRoundScored)
        {
            <p class="cr-howto">Tap Call on each wager and pick Win, Lose or Push, then Submit. A fouled hand: tap Call Floor and pick Foul.</p>
        }

        <div class="feedback-area sp-feedback">
            @if (_sbRoundScored)
            {
                @* After Submit: the result, then each wager with the right answer and why *@
                <div class="sb-feedback">
                    <ResultBreakdown ResultText="@_sbResultText" IsCorrect="_sbIsCorrect" Rows="_sbRows"
                                     NoteLabel="Floor call:" Note="@_sbFloorNote" />
                </div>
            }
            else if (_sbResultText.Length > 0)
            {
                <p class="result-line txt-bad">@_sbResultText</p>
            }
        </div>

        @* Pinned bottom bar: the main button counts the wagers left until
           every one is called (or the hand is marked Foul), then Submit *@
        <GameBar HelpTitle="Pai Gow Pay Tables" OnEnd="EndSession">
            <ChildContent>
                @if (!_sbRoundScored)
                {
                    int left = SbWagersLeft;
                    @if (left > 0)
                    {
                        <button class="game-bar-main" disabled>
                            <span class="gb-left-long">@left @(left == 1 ? "wager" : "wagers") left</span><span class="gb-left-short">@left left</span>
                        </button>
                    }
                    else
                    {
                        <button class="game-bar-main" @onclick="SbSubmitAndShow" disabled="@(!_sbSubmitEnabled)">Submit</button>
                    }
                }
                else
                {
                    <button class="game-bar-main" @onclick="SbNextFromTop" disabled="@(!_sbDealEnabled)">Next</button>
                }
            </ChildContent>
            <HelpContent>
                @PgPayTables
                <p>Insurance and Emperor's Treasure win with any hand on their tables; otherwise they lose. A fouled hand stops the game: call the floor (supervisor) before going any further. Tap Call Floor and pick Foul instead of calling the wagers.</p>
                <p>Tap a hand to see it enlarged (ranks show after Submit).</p>
            </HelpContent>
        </GameBar>
    </div>
}

@if (_showSessionSummary)
{
    @switch (_mode)
    {
        case PaiGowMode.HandSetting:
            <SessionSummary ModeKey="pg-handsetting" Rounds="_hsTotalRounds" Correct="_hsCorrectCount" Log="_log"
                            RightText="set right" ConfidentText="You're setting these with confidence" YouVerb="set"
                            OnAgain="PracticeAgain" OnDone="CloseSummary" />
            break;
        case PaiGowMode.SettlingBets when _pgPay:
            @* Each way of playing keeps its own "last time" progress (the
               keys of the old separate modes) *@
            <SessionSummary ModeKey="pg-payouts" Rounds="_ppPlayed" Correct="_ppCorrect" Log="_log"
                            RightText="paid right" ConfidentText="You're paying these with confidence" YouVerb="paid"
                            OnAgain="PracticeAgain" OnDone="CloseSummary" />
            break;
        default:
            <SessionSummary ModeKey="pg-settling" Rounds="_sbTotalRounds" Correct="_sbCorrectCount" Log="_log"
                            RightText="rounds right" ConfidentText="You're calling these with confidence" YouVerb="called"
                            OnAgain="PracticeAgain" OnDone="CloseSummary" />
            break;
    }
}

@code {
    // Menu link for this game tapped while it's already open: return to
    // the start screen, same as the Back button (hidden on phones).
    protected override void OnInitialized()
    {
        GameReset.ResetRequested += OnResetRequested;
    }

    private void OnResetRequested()
    {
        _showSessionSummary = false;
        _started = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameReset.ResetRequested -= OnResetRequested;
    }

    // Scroll back to the top whenever this game switches between its
    // start screen and its play screen (Start, Back, menu, End Session).
    // Without this the browser keeps the old scroll position -- after
    // scrolling down to reach Start, the game would open scrolled down.
    private bool _lastRenderedStarted;

    private bool _scrollToSummary;

    // Bar buttons: Submit also scrolls to the feedback; Next also
    // scrolls back to the top
    private void HsSubmitAndShow()
    {
        HsSubmitHand();
        if (_hsRoundScored) _scrollToFeedback = true;
    }

    private void HsNextFromTop()
    {
        HsDealAgain();
        _scrollToTopAfterNext = true;
    }

    private void SbSubmitAndShow()
    {
        SbSubmitRound();
        if (_sbRoundScored) _scrollToFeedback = true;
    }

    private void SbNextFromTop()
    {
        SbDealAgain();
        _scrollToTopAfterNext = true;
    }

    private bool _scrollToFeedback;
    private bool _scrollToTopAfterNext;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Submit: bring the feedback box into view (if it isn't already).
        // Next: back to the top for the new hand.
        if (_scrollToFeedback)
        {
            _scrollToFeedback = false;
            try { await JS.InvokeVoidAsync("dstRevealFeedback"); } catch { }
        }

        if (_scrollToTopAfterNext)
        {
            _scrollToTopAfterNext = false;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }
        }

        // End Session: bring the Session Summary into view (it's at the
        // bottom of the page, often below the screen on a phone)
        if (_scrollToSummary && _showSessionSummary)
        {
            _scrollToSummary = false;
            try { await JS.InvokeVoidAsync("dstScrollToEl", ".session-summary"); } catch { }
        }

        if (_started != _lastRenderedStarted)
        {
            _lastRenderedStarted = _started;
            try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch { }

        }

        // Call & Pay: the cursor into an open payout box (a computer
        // keyboard types there)
        if (_ppFocusBox && _ppBox >= 0)
        {
            _ppFocusBox = false;
            try { await _ppBoxInputRef.FocusAsync(preventScroll: true); } catch { }
        }
    }

    private enum PaiGowMode { HandSetting, SettlingBets }

    // Settling Bets start-screen setting: false = Call Only, true = Call & Pay
    private bool _pgPay;

    // Shared across both modes.
    private bool _started;
    private PaiGowMode _mode = PaiGowMode.HandSetting;

    // Start screen: which mode card is open (null = all closed). Opening
    // a card also selects its mode, so that card's Start button starts
    // it. The open card stays open after a session, so a returning
    // trainee lands right back on the mode they were using.
    private PaiGowMode? _openMode;

    private bool IsModeOpen(PaiGowMode mode) => _openMode == mode;

    private void ToggleMode(PaiGowMode mode)
    {
        _openMode = _openMode == mode ? null : mode;
        if (_openMode is not null) _mode = mode;
    }
    private bool _showSessionSummary;

    private void BackToStart() => _started = false;

    private void CloseSummary()
    {
        _showSessionSummary = false;
        _started = false;
    }

    // What happened this session, for the summary (Shared/SessionSummary)
    private SessionLog _log = new();

    // End-of-session summary's Practice Again: a fresh session of the same
    // mode, back at the top of the page (as if started from the start screen)
    private void PracticeAgain()
    {
        _showSessionSummary = false;
        StartGame();
        _lastRenderedStarted = false;
    }

    private void StartGame()
    {
        _started = true;
        _log = new SessionLog();

        if (_mode == PaiGowMode.HandSetting)
        {
            HsStartGame();
        }
        else if (_pgPay)
        {
            PpStartGame();
        }
        else
        {
            SbStartGame();
        }
    }

    private void EndSession()
    {
        bool anyRoundsPlayed = _mode switch
        {
            PaiGowMode.HandSetting => _hsTotalRounds > 0,
            _ => _pgPay ? _ppPlayed > 0 : _sbTotalRounds > 0
        };

        if (anyRoundsPlayed)
        {
            _showSessionSummary = true;
            _scrollToSummary = true;
        }
        else
        {
            _started = false;
        }
    }

    // Chance the Joker is dealt, by Joker Frequency level. Default is a
    // real 53-card deck: 7 of 53 for Hand Setting's one hand (about 1 in
    // 8), 14 of 53 for Settling Bets' two hands together (about 1 in 4).
    // The other levels are fixed rates: Hand Setting 1 in 5 / 1 in 3,
    // Settling Bets 1 in 3 / 1 in 2. (Advanced Hand Setting's tricky
    // House Way hands are set hands and don't use this.)
    // Also: identical rank-value mapping (Joker and Ace both map to 14)
    // used by both modes' own sorting logic, below.
    private static double ComputeJokerProbability(int level, bool twoHands) => (level, twoHands) switch
    {
        (1, false) => 1.0 / 5.0,
        (2, false) => 1.0 / 3.0,
        (_, false) => 7.0 / 53.0,
        (1, true) => 1.0 / 3.0,
        (2, true) => 1.0 / 2.0,
        (_, true) => 14.0 / 53.0
    };

    private static int CardSortValue(PaiGowCard card) => card.Rank switch
    {
        "JOKER" => 14,
        "A" => 14,
        "K" => 13,
        "Q" => 12,
        "J" => 11,
        "T" => 10,
        _ => int.TryParse(card.Rank, out int n) ? n : 0
    };

    // ============================================================
    // HAND SETTING (Hs prefix)
    // ============================================================

    private const int HsCardCount = 7;

    private int _hsJokerFrequencyLevel;

    // Advanced difficulty: about 1 hand in 3 is built to need one of the
    // House Way's special rules (Games/PaiGowTrainer/PaiGowTrickyHands.cs)
    private bool _hsAdvanced;

    private PaiGowDeck _hsDeck = new();
    private readonly PaiGowSolver _hsSolver = new();
    private List<PaiGowCard> _hsCards = new();

    private readonly int[] _hsCardPosition = new int[HsCardCount];

    private int _hsCorrectCount;
    private int _hsTotalRounds;
    private bool _hsRoundScored;

    private bool _hsSortEnabled;
    private bool _hsSubmitEnabled;
    private bool _hsDealEnabled;
    private string _hsErrorText = string.Empty;
    private string _hsResultText = string.Empty;
    private string _hsHouseWayText = string.Empty; // after Submit: which House Way rule sets this hand, and how
    private readonly List<BreakdownRow> _hsRows = new(); // after Submit: Low and High hand, yours vs the House Way
    private bool _hsResultIsCorrect;
    private string _hsScoreText = "Score: 0 / 0 (0.0%)";

    private void HsStartGame()
    {
        _hsCorrectCount = 0;
        _hsTotalRounds = 0;
        _hsScoreText = "Score: 0 / 0 (0.0%)";

        HsDealNewRound();
    }

    private void HsDealNewRound()
    {
        _hsDealEnabled = false;
        _hsErrorText = string.Empty;
        _hsResultText = string.Empty;
        _hsHouseWayText = string.Empty;
        _hsRows.Clear();

        _hsDeck = new PaiGowDeck();

        double jokerProbability = ComputeJokerProbability(_hsJokerFrequencyLevel, twoHands: false);

        _hsCards = _hsAdvanced && Random.Shared.Next(3) == 0
            ? PaiGowTrickyHands.Deal(Random.Shared, out _)
            : _hsDeck.DealSevenCardsWithJokerBias(jokerProbability);
        Array.Clear(_hsCardPosition);

        _hsSolver.SetCards(_hsCards);

        _hsRoundScored = false;
        _hsSubmitEnabled = true;
        _hsSortEnabled = true;
    }

    private void HsDealAgain() => HsDealNewRound();

    private int HsCardAtLowPosition(int lowPosition)
    {
        for (int i = 0; i < _hsCards.Count; i++)
        {
            if (_hsCardPosition[i] == lowPosition) return i;
        }
        return -1;
    }

    private void HsCardClicked(int cardIndex)
    {
        if (_hsCardPosition[cardIndex] != 0) return;

        int targetLow;
        if (HsCardAtLowPosition(1) < 0) targetLow = 1;
        else if (HsCardAtLowPosition(2) < 0) targetLow = 2;
        else
        {
            _hsErrorText = "Low hand is full. Click a Low card to return it first.";
            return;
        }

        _hsErrorText = string.Empty;
        _hsCardPosition[cardIndex] = targetLow;
    }

    private void HsReturnLowSlotToHand(int lowPosition)
    {
        int cardIndex = HsCardAtLowPosition(lowPosition);
        if (cardIndex < 0) return;

        _hsCardPosition[cardIndex] = 0;
    }

    private void HsSortHand()
    {
        for (int i = 0; i < _hsCards.Count; i++)
        {
            if (_hsCardPosition[i] != 0)
            {
                _hsErrorText = "Return the Low cards before sorting.";
                return;
            }
        }

        _hsCards = _hsCards.OrderByDescending(CardSortValue).ToList();
        _hsSolver.SetCards(_hsCards);

        _hsErrorText = string.Empty;
        _hsSortEnabled = false;
    }

    private void HsSubmitHand()
    {
        if (_hsRoundScored) return;

        int lowCard1 = HsCardAtLowPosition(1);
        int lowCard2 = HsCardAtLowPosition(2);

        List<int> userHighList = new();
        for (int i = 0; i < _hsCards.Count; i++)
        {
            if (_hsCardPosition[i] == 0) userHighList.Add(i);
        }

        if (lowCard1 < 0 || lowCard2 < 0 || userHighList.Count != 5)
        {
            _hsErrorText = "You must place two cards in the Low hand before submitting.";
            return;
        }

        int[] userHigh = new int[6];
        for (int k = 0; k < 5; k++) userHigh[k + 1] = userHighList[k] + 1;

        PaiGowSubmitResult result = _hsSolver.SubmitHand(lowCard1 + 1, lowCard2 + 1, userHigh);

        if (result.ValidationError is not null)
        {
            _hsErrorText = result.ValidationError;
            return;
        }

        _hsErrorText = string.Empty;
        _hsTotalRounds++;
        if (result.IsCorrect) _hsCorrectCount++;

        _hsRoundScored = true;
        _hsSubmitEnabled = false;
        _hsDealEnabled = true;

        _hsScoreText = $"Score: {_hsCorrectCount} / {_hsTotalRounds} ({(double)_hsCorrectCount / _hsTotalRounds:0.0%})";
        _hsHouseWayText = _hsSolver.HouseWayReason();

        // Low and High hand: yours vs the House Way hand. A fouled hand
        // (Low outranks High) is wrong on both lines.
        bool lowOk = result.IsCorrect || (!result.IsFoul && result.UserLowLabel == result.CorrectLowLabel);
        bool highOk = result.IsCorrect || (!result.IsFoul && result.UserHighDescription == result.CorrectHighDescription);
        if (!result.IsCorrect && lowOk && highOk) highOk = false;

        _hsRows.Clear();
        _hsRows.Add(new BreakdownRow("Low hand", result.UserLowLabel, result.CorrectLowLabel, lowOk, ""));
        _hsRows.Add(new BreakdownRow("High hand", result.UserHighDescription, result.CorrectHighDescription, highOk,
            result.IsFoul ? "Your Low hand outranks your High hand: that's a foul." : ""));

        _log.AddRows(_hsRows);
        _hsResultIsCorrect = result.IsCorrect;
        _hsResultText = result.IsCorrect ? "CORRECT"
            : result.IsFoul ? "INCORRECT \u2014 foul" : "INCORRECT";
    }

    // ============================================================
    // SETTLING BETS (Sb prefix)
    // ============================================================

    private sealed class SbWagerState
    {
        public WagerOutcome? Selection;
        public bool Wrong;
        public WagerOutcome? Actual;   // set at Submit
        public bool Graded;            // false when the round was a floor call
        public int Wager;              // chip amount on the row (real-world betting pattern)
    }

    // Rows in settling order (same as Pai Gow Payouts)
    private (string Name, SbWagerState Wager, IReadOnlyList<WagerPickOption> Options)[] SbRowOrder => new[]
    {
        ("Insurance", _sbInsurance, WagerPick.WinLose),
        ("Main Wager", _sbMainWager, WagerPick.WinLosePush),
        ("Emperor's Treasure", _sbEmperorsTreasure, WagerPick.WinLose)
    };

    // After Submit, a wager that wasn't graded: the hand was fouled (a
    // floor call), or a good hand was marked Foul (shows the right call)
    private string? SbWagerLockedText(SbWagerState w)
    {
        if (!_sbRoundScored || w.Graded) return null;
        return _sbIsPlayerFoul ? "Floor call" : $"Ans: {w.Actual}";
    }

    private int _sbJokerFrequencyLevel;

    // Tap-to-zoom: 0 = closed, 1 = player, 2 = dealer
    private int _sbZoom;
    private int _sbFoulFrequencyLevel;

    private readonly PaiGowSolver _sbPlayerSolver = new();
    private readonly PaiGowSolver _sbDealerSolver = new();

    private List<PaiGowCard> _sbPlayerCards = new();
    private List<PaiGowCard> _sbDealerCards = new();

    private int _sbPlayerLow1, _sbPlayerLow2;
    private int[] _sbPlayerHigh = new int[6];
    private bool _sbIsPlayerFoul;

    private int _sbDealerLow1, _sbDealerLow2;
    private int[] _sbDealerHigh = new int[6];

    private List<PaiGowCard> _sbDealerLowSorted = new();
    private List<PaiGowCard> _sbDealerHighSorted = new();
    private List<PaiGowCard> _sbPlayerLowSorted = new();
    private List<PaiGowCard> _sbPlayerHighSorted = new();

    private readonly SbWagerState _sbInsurance = new();
    private readonly SbWagerState _sbMainWager = new();
    private readonly SbWagerState _sbEmperorsTreasure = new();

    private bool _sbFoulFlagged;
    private bool _sbFoulWrong;

    private int _sbCorrectCount;
    private int _sbTotalRounds;
    private bool _sbRoundScored;

    private bool _sbSubmitEnabled;
    private bool _sbDealEnabled;
    private string _sbResultText = string.Empty;

    private string _sbPlayerLowLabel = string.Empty;
    private string _sbPlayerHighLabel = string.Empty;
    private string _sbDealerLowLabel = string.Empty;
    private string _sbDealerHighLabel = string.Empty;

    // One line per wager in the feedback box after Submit
    private readonly List<BreakdownRow> _sbRows = new();
    private string _sbFloorNote = string.Empty; // set on every fouled hand

    private const string FloorCallNote =
        "notify the supervisor. How a fouled hand is settled is at their discretion.";
    private bool _sbIsCorrect;
    private string _sbScoreText = "Score: 0 / 0 (0.0%)";

    private void SbStartGame()
    {
        _sbCorrectCount = 0;
        _sbTotalRounds = 0;
        _sbScoreText = "Score: 0 / 0 (0.0%)";

        SbDealNewRound();
    }

    private void SbDealNewRound()
    {
        _sbZoom = 0;
        _sbDealEnabled = false;

        double jokerProbability = ComputeJokerProbability(_sbJokerFrequencyLevel, twoHands: true);

        PaiGowDeck sharedDeck = new PaiGowDeck();
        (_sbPlayerCards, _sbDealerCards) = sharedDeck.DealTwoSevenCardHandsWithJokerBias(jokerProbability);

        _sbDealerSolver.SetCards(_sbDealerCards);
        (_sbDealerLow1, _sbDealerLow2, _sbDealerHigh) = _sbDealerSolver.GetCorrectHand();

        _sbDealerLowSorted = SbSortByRankGroupThenRank(new List<PaiGowCard>
        {
            _sbDealerCards[_sbDealerLow1 - 1],
            _sbDealerCards[_sbDealerLow2 - 1]
        });

        List<PaiGowCard> dealerHighCards = new();
        for (int i = 1; i <= 5; i++)
            dealerHighCards.Add(_sbDealerCards[_sbDealerHigh[i] - 1]);
        _sbDealerHighSorted = SbSortByRankGroupThenRank(dealerHighCards);

        _sbPlayerSolver.SetCards(_sbPlayerCards);

        double foulProbability = SbComputeFoulProbability(_sbFoulFrequencyLevel);
        bool shouldBeFoul = Random.Shared.NextDouble() < foulProbability;
        SbGeneratePlayerSplit(shouldBeFoul);

        _sbInsurance.Selection = null; _sbInsurance.Wrong = false;
        _sbMainWager.Selection = null; _sbMainWager.Wrong = false;
        _sbEmperorsTreasure.Selection = null; _sbEmperorsTreasure.Wrong = false;
        foreach (SbWagerState w in new[] { _sbInsurance, _sbMainWager, _sbEmperorsTreasure })
        {
            w.Actual = null;
            w.Graded = false;
        }
        _sbFoulFlagged = false;
        _sbFoulWrong = false;
        _sbNotFoulPicked = false;

        // Chips on the rows, as Pai Gow Payouts bets them
        _sbInsurance.Wager = PaiGowPayouts.SideWager(Random.Shared);
        _sbMainWager.Wager = PaiGowPayouts.MainWager(Random.Shared);
        _sbEmperorsTreasure.Wager = PaiGowPayouts.SideWager(Random.Shared);

        _sbResultText = string.Empty;
        _sbPlayerLowLabel = string.Empty;
        _sbPlayerHighLabel = string.Empty;
        _sbDealerLowLabel = string.Empty;
        _sbDealerHighLabel = string.Empty;
        _sbRows.Clear();
        _sbFloorNote = string.Empty;
        _sbRoundScored = false;
        _sbSubmitEnabled = true;
    }

    private void SbDealAgain() => SbDealNewRound();

    // Absolute probabilities (not relative boosts like Joker
    // Frequency) since there's no single well-defined "natural" foul
    // rate to scale from. All three tiers favor practice reps over
    // realism.
    private static double SbComputeFoulProbability(int level) => level switch
    {
        1 => 0.40,
        2 => 0.60,
        _ => 0.20
    };

    private static List<PaiGowCard> SbSortByRankGroupThenRank(List<PaiGowCard> cards)
    {
        Dictionary<int, int> rankCounts = new();
        foreach (PaiGowCard c in cards)
        {
            int rank = CardSortValue(c);
            rankCounts[rank] = rankCounts.GetValueOrDefault(rank) + 1;
        }

        return cards
            .OrderByDescending(c => rankCounts[CardSortValue(c)])
            .ThenByDescending(CardSortValue)
            .ToList();
    }

    private void SbGeneratePlayerSplit(bool shouldBeFoul)
    {
        List<(int Low1, int Low2, int[] High, bool Legal, double HighScore)> candidates = new();

        for (int a = 1; a <= 7; a++)
        {
            for (int b = a + 1; b <= 7; b++)
            {
                int[] high = new int[6];
                int idx = 1;
                for (int c = 1; c <= 7; c++)
                {
                    if (c == a || c == b) continue;
                    high[idx++] = c;
                }

                bool legal = _sbPlayerSolver.IsLegalSplit(a, b, high);
                double highScore = _sbPlayerSolver.ScoreHighHand(high);
                candidates.Add((a, b, high, legal, highScore));
            }
        }

        List<(int Low1, int Low2, int[] High, bool Legal, double HighScore)> pool =
            shouldBeFoul
                ? candidates.Where(c => !c.Legal).ToList()
                : candidates.Where(c => c.Legal).ToList();

        if (pool.Count == 0)
        {
            pool = candidates.Where(c => c.Legal).ToList();
            shouldBeFoul = false;
        }

        List<(int Low1, int Low2, int[] High, bool Legal, double HighScore)> ranked =
            pool.OrderByDescending(c => c.HighScore).ToList();
        int topCount = Math.Max(1, ranked.Count / 3);
        (int Low1, int Low2, int[] High, bool Legal, double HighScore) chosen = ranked[Random.Shared.Next(topCount)];

        _sbPlayerLow1 = chosen.Low1;
        _sbPlayerLow2 = chosen.Low2;
        _sbPlayerHigh = chosen.High;
        _sbIsPlayerFoul = shouldBeFoul;

        _sbPlayerLowSorted = SbSortByRankGroupThenRank(new List<PaiGowCard>
        {
            _sbPlayerCards[_sbPlayerLow1 - 1],
            _sbPlayerCards[_sbPlayerLow2 - 1]
        });

        List<PaiGowCard> playerHighCards = new();
        for (int i = 1; i <= 5; i++)
            playerHighCards.Add(_sbPlayerCards[_sbPlayerHigh[i] - 1]);
        _sbPlayerHighSorted = SbSortByRankGroupThenRank(playerHighCards);
    }

    // Foul button choices: Foul (orange), or Not Foul (clears the flag)
    private static readonly IReadOnlyList<WagerPickOption> FoulOptions = new[]
    {
        new WagerPickOption("Foul", "Foul", "wp-foul"),
        new WagerPickOption("NotFoul", "Not Foul", "")
    };

    // Marking Foul clears the three wager picks (a foul hand isn't
    // settled wager by wager); Not Foul just clears the flag.
    // Foul row showing Not Foul (picked, until Foul is picked or the next deal)
    private bool _sbNotFoulPicked;

    private void SbSetFoul(bool foul)
    {
        _sbFoulWrong = false;
        _sbNotFoulPicked = !foul;
        if (!foul)
        {
            _sbFoulFlagged = false;
            return;
        }

        _sbFoulFlagged = true;
        _sbInsurance.Selection = null; _sbInsurance.Wrong = false;
        _sbMainWager.Selection = null; _sbMainWager.Wrong = false;
        _sbEmperorsTreasure.Selection = null; _sbEmperorsTreasure.Wrong = false;
    }

    // Call Only: wagers still to call (none once the hand is marked Foul)
    private int SbWagersLeft => _sbFoulFlagged ? 0
        : new[] { _sbInsurance, _sbMainWager, _sbEmperorsTreasure }.Count(w => w.Selection is null);

    private void SbResetFoul()
    {
        _sbFoulFlagged = false;
        _sbFoulWrong = false;
    }

    private void SbSubmitRound()
    {
        if (_sbRoundScored) return;

        _sbRows.Clear();
        _sbFloorNote = string.Empty;

        // A fouled hand is a floor call: marking it Foul is the right
        // answer, and the wagers aren't settled by the dealer (supervisor's
        // discretion). Every fouled hand shows the floor-call note.
        if (_sbFoulFlagged)
        {
            bool foulCorrect = _sbIsPlayerFoul;
            _sbFoulWrong = !foulCorrect;
            _sbRows.Add(SbFoulRow(true));

            if (foulCorrect)
            {
                _sbFloorNote = FloorCallNote;
                _sbResultText = "CORRECT \u2014 the player's hand is fouled";
            }
            else
            {
                // Not a foul: show how each wager should have been settled
                SbAddWagerRows(graded: false);
                _sbResultText = "INCORRECT \u2014 the player's hand is not fouled";
            }

            _sbTotalRounds++;
            if (foulCorrect) _sbCorrectCount++;
            _sbIsCorrect = foulCorrect;

            SbFinishRound();
            return;
        }

        if (_sbInsurance.Selection is null || _sbMainWager.Selection is null || _sbEmperorsTreasure.Selection is null)
        {
            _sbResultText = "Tap every wager to select an outcome before submitting.";
            _sbIsCorrect = false;
            return;
        }

        bool allCorrect;
        if (_sbIsPlayerFoul)
        {
            // Fouled but settled instead of marked Foul: wrong, and the
            // wagers aren't graded (the floor decides how they're settled)
            _sbFoulWrong = true;
            _sbEmperorsTreasure.Wrong = false;
            _sbMainWager.Wrong = false;
            _sbInsurance.Wrong = false;
            _sbRows.Add(SbFoulRow(false));
            _sbFloorNote = FloorCallNote;
            _sbResultText = "INCORRECT \u2014 the player's hand is fouled";
            allCorrect = false;
        }
        else
        {
            _sbFoulWrong = false;
            allCorrect = SbAddWagerRows(graded: true);
            _sbResultText = BreakdownRow.Summary(_sbRows);
        }

        _sbTotalRounds++;
        if (allCorrect) _sbCorrectCount++;
        _sbIsCorrect = allCorrect;

        SbFinishRound();
    }

    // Emperor's Treasure, Main Wager and Pai Gow Insurance lines for the
    // feedback box (for a hand that isn't fouled). graded: false when the
    // hand was wrongly marked Foul -- the lines then just show the right
    // answers (nothing was picked). Returns whether every pick was right.
    private bool SbAddWagerRows(bool graded)
    {
        // Best hand that can be made from any 5 of the player's 7 cards --
        // what both side wagers are settled on
        string bestOfSeven = _sbPlayerSolver.BestSevenCardCategoryName();

        // Emperor's Treasure: wins with Three of a Kind or better anywhere
        // in the 7 cards
        WagerOutcome emperorsOutcome = _sbPlayerSolver.QualifiesEmperorsTreasure() ? WagerOutcome.Win : WagerOutcome.Lose;
        string emperorsWhy = $"Best hand in the 7 cards: {_sbPlayerSolver.EmperorsTreasureCategoryName()}. Wins on Three of a Kind or better.";

        // Main Wager: dealer Ace-High Pai Gow pushes; otherwise win both
        // hands = Win, lose both = Lose, one each = Push. A tie (copy) goes
        // to the dealer.
        WagerOutcome mainOutcome;
        string mainWhy;
        if (_sbDealerSolver.IsAceHighPaiGow(_sbDealerHigh))
        {
            mainOutcome = WagerOutcome.Push;
            mainWhy = "The dealer has Ace-High Pai Gow, so all hands push.";
        }
        else
        {
            double playerLowScore = _sbPlayerSolver.ScoreLowHand(_sbPlayerLow1, _sbPlayerLow2);
            double playerHighScore = _sbPlayerSolver.ScoreHighHand(_sbPlayerHigh);
            double dealerLowScore = _sbDealerSolver.ScoreLowHand(_sbDealerLow1, _sbDealerLow2);
            double dealerHighScore = _sbDealerSolver.ScoreHighHand(_sbDealerHigh);

            bool winsLow = playerLowScore > dealerLowScore;
            bool winsHigh = playerHighScore > dealerHighScore;

            mainOutcome = (winsLow, winsHigh) switch
            {
                (true, true) => WagerOutcome.Win,
                (false, false) => WagerOutcome.Lose,
                _ => WagerOutcome.Push
            };

            mainWhy = $"High hand: {SbWhoWins(winsHigh, playerHighScore == dealerHighScore)}. "
                    + $"Low hand: {SbWhoWins(winsLow, playerLowScore == dealerLowScore)}.";
        }

        // Pai Gow Insurance: wins only when nothing better than High Card
        // can be made from the 7 cards
        WagerOutcome insuranceOutcome = _sbPlayerSolver.QualifiesInsurance() ? WagerOutcome.Win : WagerOutcome.Lose;
        string insuranceWhy = $"Best hand in the 7 cards: {bestOfSeven}. Wins only on High Card (no pair, straight or flush).";

        bool allOk = true;
        allOk &= SbAddWagerRow("Pai Gow Insurance", _sbInsurance, insuranceOutcome, insuranceWhy, graded);
        allOk &= SbAddWagerRow("Main Wager", _sbMainWager, mainOutcome, mainWhy, graded);
        allOk &= SbAddWagerRow("Emperor's Treasure", _sbEmperorsTreasure, emperorsOutcome, emperorsWhy, graded);
        return allOk;
    }

    private bool SbAddWagerRow(string name, SbWagerState wager, WagerOutcome actual, string why, bool graded)
    {
        wager.Actual = actual;
        wager.Graded = graded;
        if (!graded)
        {
            wager.Wrong = false;
            _sbRows.Add(new BreakdownRow(name, "\u2014", $"{actual}", false, why));
            return false;
        }

        bool ok = SbGradeWager(wager, actual);
        _sbRows.Add(new BreakdownRow(name, $"{wager.Selection}", $"{actual}", ok, why));
        return ok;
    }

    // Hand labels under the cards, and the buttons, once a round is scored
    private void SbFinishRound()
    {
        // Summary: graded lines only (not the answer-only lines shown when
        // a good hand was wrongly marked Foul)
        _log.AddRows(_sbRows.Where(r => r.You != "\u2014"));

        string pct = _sbTotalRounds > 0
            ? ((double)_sbCorrectCount / _sbTotalRounds).ToString("0.0%")
            : "0.0%";
        _sbScoreText = $"Score: {_sbCorrectCount} / {_sbTotalRounds} ({pct})";

        _sbPlayerLowLabel = _sbPlayerSolver.LowHandLabel(_sbPlayerLow1, _sbPlayerLow2);
        _sbPlayerHighLabel = _sbPlayerSolver.HighHandDescription(_sbPlayerHigh);
        _sbDealerLowLabel = _sbDealerSolver.LowHandLabel(_sbDealerLow1, _sbDealerLow2);
        _sbDealerHighLabel = _sbDealerSolver.HighHandDescription(_sbDealerHigh);

        _sbRoundScored = true;
        _sbSubmitEnabled = false;
        _sbDealEnabled = true;
    }

    // The Foul line in the feedback. markedFoul: whether Foul was picked.
    private BreakdownRow SbFoulRow(bool markedFoul)
    {
        string answer = _sbIsPlayerFoul ? "Foul" : "Not foul";
        string you = markedFoul ? "Foul" : "Not marked";
        bool ok = markedFoul == _sbIsPlayerFoul;
        string why = _sbIsPlayerFoul
            ? "The Low hand outranks the High hand."
            : "The High hand outranks the Low hand, so the hand is set legally.";
        return new BreakdownRow("Foul", you, answer, ok, why);
    }

    private static string SbWhoWins(bool playerWins, bool tie) =>
        playerWins ? "player wins" : tie ? "tie (copy), dealer wins" : "dealer wins";

    private static bool SbGradeWager(SbWagerState w, WagerOutcome actual)
    {
        if (w.Selection == actual)
        {
            w.Wrong = false;
            return true;
        }

        w.Wrong = true;
        return false;
    }

    // Tap-to-zoom content for a Pai Gow hand: the Low hand's 2 cards on
    // top, the High hand's 5 below (overlapped, every corner showing), each
    // with its name when given (empty = not shown yet)
